# Actual filled triangle, independent of any assigned area.
prop is_in_closed_triangle(p,a,b,c cart(R,R)):
    $geometry::main::is_triangle(a,b,c)
    exist u,v R st {0 <= u, 0 <= v, u+v <= 1, p(1) = a(1)+u*(b(1)-a(1))+v*(c(1)-a(1)), p(2) = a(2)+u*(b(2)-a(2))+v*(c(2)-a(2))}


prop is_in_triangle_interior(p,a,b,c cart(R,R)):
    $geometry::main::is_triangle(a,b,c)
    exist u,v R st {0 < u, 0 < v, u+v < 1, p(1) = a(1)+u*(b(1)-a(1))+v*(c(1)-a(1)), p(2) = a(2)+u*(b(2)-a(2))+v*(c(2)-a(2))}


# A geometric decomposition primitive; does not assert the union is a simple polygon.
prop is_finite_triangle_region_decomposition(region power_set(cart(R,R)), n N+, first,second,third fn(k Z) cart(R,R)):
    forall k Z:
        1 <= k
        k <= n
        =>:
            $geometry::main::is_triangle(first(k),second(k),third(k))
    forall p cart(R,R):
        p $in region
        =>:
            exist k Z st {1 <= k, k <= n, $is_in_closed_triangle(p,first(k),second(k),third(k))}
    forall k Z, p cart(R,R):
        1 <= k
        k <= n
        $is_in_closed_triangle(p,first(k),second(k),third(k))
        =>:
            p $in region
    forall left_index,right_index Z, p cart(R,R):
        1 <= left_index
        left_index <= n
        1 <= right_index
        right_index <= n
        $is_in_triangle_interior(p,first(left_index),second(left_index),third(left_index))
        $is_in_triangle_interior(p,first(right_index),second(right_index),third(right_index))
        =>:
            left_index = right_index


# Area attached to a specified actual-region triangulation; independence of triangulation is a separate theorem.
prop has_triangle_decomposition_area(region power_set(cart(R,R)), n N+, first,second,third fn(k Z) cart(R,R), terms fn(k Z) R, total R):
    $is_finite_triangle_region_decomposition(region,n,first,second,third)
    forall k Z:
        1 <= k
        k <= n
        =>:
            terms(k) > 0
            $area::has_triangle_area(first(k),second(k),third(k),terms(k))
    total = sum(1,n,terms)


thm finite_positive_area_sum:
    ? forall n N+, terms fn(k Z) R:
        forall k Z:
            1 <= k
            k <= n
            =>:
                terms(k) > 0
        =>:
            sum(1,n,terms) > 0
    1 <= n
    terms(1) > 0
    by cases:
        ? sum(1,n,terms) > 0
        case n = 1:
            sum(1,n,terms) = sum(1,1,terms) = terms(1) > 0
        case n != 1:
            by contra:
                ? n > 1
                n <= 1
                n >= 1
                n = 1
                impossible n != 1
            n $in Z
            n >= 2
            let zero = fn(k Z) R {0}
            claim:
                ? forall k Z:
                    2 <= k
                    k <= n
                    =>:
                        zero(k) <= terms(k)
                1 <= k
                terms(k) > 0
                zero(k) = 0 <= terms(k)
            release thm sum_le_sum_from_pointwise(sum(2,n,zero),sum(2,n,terms))
            sum(2,n,zero) = (n-2+1)*0 = 0
            sum(2,n,terms) >= 0
            terms(1) $in R
            sum(2,n,terms) $in R
            have head R = terms(1)
            have remainder R = sum(2,n,terms)
            head > 0
            remainder >= 0
            head+remainder >= head > 0
            sum(1,n,terms) = sum(1,1,terms)+sum(2,n,terms) = terms(1)+sum(2,n,terms) = head+remainder > 0


thm triangle_decomposition_area_positive:
    ? forall region power_set(cart(R,R)), n N+, first,second,third fn(k Z) cart(R,R), terms fn(k Z) R, total R:
        $has_triangle_decomposition_area(region,n,first,second,third,terms,total)
        =>:
            total > 0
    by def $has_triangle_decomposition_area(region,n,first,second,third,terms,total)
    release thm finite_positive_area_sum(n,terms)
    total = sum(1,n,terms) > 0


# Fixed-triangulation uniqueness only; this does not compare different triangulations.
thm fixed_triangle_decomposition_area_unique:
    ? forall region power_set(cart(R,R)), n N+, first,second,third fn(k Z) cart(R,R), left_terms,right_terms fn(k Z) R, left_total,right_total R:
        $has_triangle_decomposition_area(region,n,first,second,third,left_terms,left_total)
        $has_triangle_decomposition_area(region,n,first,second,third,right_terms,right_total)
        =>:
            left_total = right_total
    by def $has_triangle_decomposition_area(region,n,first,second,third,left_terms,left_total)
    by def $has_triangle_decomposition_area(region,n,first,second,third,right_terms,right_total)
    claim:
        ? forall k Z:
            1 <= k
            k <= n
            =>:
                left_terms(k) = right_terms(k)
                left_terms(k) <= right_terms(k)
                right_terms(k) <= left_terms(k)
        $area::has_triangle_area(first(k),second(k),third(k),left_terms(k))
        $area::has_triangle_area(first(k),second(k),third(k),right_terms(k))
        by def $area::has_triangle_area(first(k),second(k),third(k),left_terms(k))
        by def $area::has_triangle_area(first(k),second(k),third(k),right_terms(k))
        2*left_terms(k) = sqrt(geometry::main::det(geometry::main::vec(first(k),second(k)),geometry::main::vec(first(k),third(k)))^2) = 2*right_terms(k)
        left_terms(k) = (2*left_terms(k))/2 = (2*right_terms(k))/2 = right_terms(k)
        left_terms(k) <= right_terms(k)
        right_terms(k) <= left_terms(k)
    release thm sum_le_sum_from_pointwise(sum(1,n,left_terms),sum(1,n,right_terms))
    release thm sum_le_sum_from_pointwise(sum(1,n,right_terms),sum(1,n,left_terms))
    sum(1,n,left_terms) = sum(1,n,right_terms)
    left_total = sum(1,n,left_terms) = sum(1,n,right_terms) = right_total


thm triangle_decomposition_has_positive_area:
    ? forall region power_set(cart(R,R)), n N+, first,second,third fn(k Z) cart(R,R):
        $is_finite_triangle_region_decomposition(region,n,first,second,third)
        =>:
            exist terms fn(k Z) R, total R+ st {$has_triangle_decomposition_area(region,n,first,second,third,terms,total)}
    by def $is_finite_triangle_region_decomposition(region,n,first,second,third)
    let terms = fn(k Z) R {sqrt(geometry::main::det(geometry::main::vec(first(k),second(k)),geometry::main::vec(first(k),third(k)))^2)/2}
    claim:
        ? forall k Z:
            1 <= k
            k <= n
            =>:
                terms(k) > 0
                $area::has_triangle_area(first(k),second(k),third(k),terms(k))
        $geometry::main::is_triangle(first(k),second(k),third(k))
        by def $geometry::main::is_triangle(first(k),second(k),third(k))
        have cross R = geometry::main::det(geometry::main::vec(first(k),second(k)),geometry::main::vec(first(k),third(k)))
        cross != 0
        cross^2 > 0
        sqrt(cross^2) > 0
        geometry::main::det(geometry::main::vec(first(k),second(k)),geometry::main::vec(first(k),third(k)))^2 = cross^2
        terms(k) = sqrt(geometry::main::det(geometry::main::vec(first(k),second(k)),geometry::main::vec(first(k),third(k)))^2)/2 = sqrt(cross^2)/2 > 0
        2*terms(k) = 2*(sqrt(cross^2)/2) = sqrt(cross^2) = sqrt(geometry::main::det(geometry::main::vec(first(k),second(k)),geometry::main::vec(first(k),third(k)))^2)
        by def $area::has_triangle_area(first(k),second(k),third(k),terms(k))
    release thm finite_positive_area_sum(n,terms)
    have total R+ = sum(1,n,terms)
    by def $has_triangle_decomposition_area(region,n,first,second,third,terms,total)
    witness exist values fn(k Z) R, area_value R+ st {$has_triangle_decomposition_area(region,n,first,second,third,values,area_value)} from terms,total


have fn closed_triangle_region(a,b,c cart(R,R): $geometry::main::is_triangle(a,b,c)) power_set(cart(R,R)) = {p cart(R,R): $is_in_closed_triangle(p,a,b,c)}


thm single_triangle_region_decomposition:
    ? forall a,b,c cart(R,R):
        $geometry::main::is_triangle(a,b,c)
        =>:
            exist first,second,third fn(k Z) cart(R,R) st {$is_finite_triangle_region_decomposition(closed_triangle_region(a,b,c),1,first,second,third)}
    let first = fn(k Z) cart(R,R) {a}
    let second = fn(k Z) cart(R,R) {b}
    let third = fn(k Z) cart(R,R) {c}
    have region power_set(cart(R,R)) = closed_triangle_region(a,b,c)
    region = closed_triangle_region(a,b,c) = {p cart(R,R): $is_in_closed_triangle(p,a,b,c)}
    claim:
        ? forall k Z:
            1 <= k
            k <= 1
            =>:
                $geometry::main::is_triangle(first(k),second(k),third(k))
        first(k) = a
        second(k) = b
        third(k) = c
    claim:
        ? forall p cart(R,R):
            p $in region
            =>:
                exist k Z st {1 <= k, k <= 1, $is_in_closed_triangle(p,first(k),second(k),third(k))}
        p $in {q cart(R,R): $is_in_closed_triangle(q,a,b,c)}
        release thm set_builder_member(p,{q cart(R,R): $is_in_closed_triangle(q,a,b,c)})
        $is_in_closed_triangle(p,a,b,c)
        first(1) = a
        second(1) = b
        third(1) = c
        $is_in_closed_triangle(p,first(1),second(1),third(1))
        witness exist k Z st {1 <= k, k <= 1, $is_in_closed_triangle(p,first(k),second(k),third(k))} from 1
    claim:
        ? forall k Z, p cart(R,R):
            1 <= k
            k <= 1
            $is_in_closed_triangle(p,first(k),second(k),third(k))
            =>:
                p $in region
        first(k) = a
        second(k) = b
        third(k) = c
        $is_in_closed_triangle(p,a,b,c)
        p $in {q cart(R,R): $is_in_closed_triangle(q,a,b,c)}
        p $in region
    claim:
        ? forall left_index,right_index Z, p cart(R,R):
            1 <= left_index
            left_index <= 1
            1 <= right_index
            right_index <= 1
            $is_in_triangle_interior(p,first(left_index),second(left_index),third(left_index))
            $is_in_triangle_interior(p,first(right_index),second(right_index),third(right_index))
            =>:
                left_index = right_index
        left_index = 1
        right_index = 1
    by def $is_finite_triangle_region_decomposition(region,1,first,second,third)
    witness exist f,g,h fn(k Z) cart(R,R) st {$is_finite_triangle_region_decomposition(closed_triangle_region(a,b,c),1,f,g,h)} from first,second,third


