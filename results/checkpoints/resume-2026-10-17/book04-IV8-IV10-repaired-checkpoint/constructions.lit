release obj def geometry::main::vec
release obj def geometry::main::dot
release obj def geometry::main::det
release obj def geometry::main::distance_sq
release obj def geometry::main::angle_cos_num
release obj def geometry::main::angle_cos_den
release obj def geometry::main::line_through_points

release obj def geometry::main::circle
release obj def angles::angle_cosine
thm square_coordinate_frame:
    ? forall a,b,c,d cart(R,R):
        $geometry::main::is_square(a,b,c,d)
        =>:
            a != b
            a != d
            c(1) = b(1)+d(1)-a(1)
            c(2) = b(2)+d(2)-a(2)
            geometry::main::distance_sq(a,d) = geometry::main::distance_sq(a,b)
            geometry::main::dot(geometry::main::vec(a,d),geometry::main::vec(a,b)) = 0
    by def $geometry::main::is_square(a,b,c,d)
    $geometry::main::is_rectangle(a,b,c,d)
    by def $geometry::main::is_rectangle(a,b,c,d)
    $geometry::main::is_parallelogram(a,b,c,d)
    by def $geometry::main::is_parallelogram(a,b,c,d)
    $geometry::main::is_parallel(a,b,d,c)
    by def $geometry::main::is_parallel(a,b,d,c)
    $geometry::main::is_parallel(a,d,b,c)
    by def $geometry::main::is_parallel(a,d,b,c)
    $geometry::main::is_right_angle(d,a,b)
    by def $geometry::main::is_right_angle(d,a,b)
    $geometry::main::are_segments_congruent(a,b,b,c)
    by def $geometry::main::are_segments_congruent(a,b,b,c)
    release thm geometry::main::square_orthogonal_parallel_quadrilateral_coordinates(a,b,c,d)
    release thm geometry::main::parallelogram_sides(a,b,c,d)
    geometry::main::distance_sq(a,d) = geometry::main::distance_sq(b,c) = geometry::main::distance_sq(a,b)
    b(1)+d(1)-a(1) = b(1)+(a(1)+c(1)-b(1))-a(1) = c(1)
    b(2)+d(2)-a(2) = b(2)+(a(2)+c(2)-b(2))-a(2) = c(2)

prop is_on_circle(p, o cart(R, R), r R+):
    geometry::main::distance_sq(o, p) = r * r

prop is_tangent_line_at(contact, a, b, o cart(R, R), radius R+):
    a != b
    contact $in geometry::main::line_through_points(a, b)
    contact $in geometry::main::circle(o, radius)
    forall p cart(R, R):
        p $in geometry::main::line_through_points(a, b)
        =>:
            geometry::main::distance_sq(o, p) >= radius^2

thm point_difference_norm_pos:
    ? forall a, b cart(R, R):
        a != b
        =>:
            (b(1) - a(1))^2 + (b(2) - a(2))^2 > 0
    (b(1) - a(1))^2 >= 0
    (b(2) - a(2))^2 >= 0
    (b(1) - a(1))^2 + (b(2) - a(2))^2 >= 0
    by contra:
        ? (b(1) - a(1))^2 + (b(2) - a(2))^2 > 0
        (b(1) - a(1))^2 + (b(2) - a(2))^2 <= 0
        (b(1) - a(1))^2 + (b(2) - a(2))^2 = 0
        (b(1) - a(1))^2 <= (b(1) - a(1))^2 + (b(2) - a(2))^2
        (b(1) - a(1))^2 <= 0
        (b(1) - a(1))^2 = 0
        (b(2) - a(2))^2 <= (b(1) - a(1))^2 + (b(2) - a(2))^2
        (b(2) - a(2))^2 <= 0
        (b(2) - a(2))^2 = 0
        b(1) - a(1) = 0
        b(2) - a(2) = 0
        b(1) = a(1)
        b(2) = a(2)
        release thm tuple_equal_from_coordinates(a, (a(1), a(2)))
        release thm tuple_equal_from_coordinates(b, (b(1), b(2)))
        a = (a(1), a(2)) = (b(1), b(2)) = b
        impossible a != b

thm radial_perpendicular_distance_identity:
    ? forall o, a, q cart(R, R), radius R+:
        $is_on_circle(a, o, radius)
        geometry::main::dot(geometry::main::vec(o, a), geometry::main::vec(a, q)) = 0
        =>:
            geometry::main::distance_sq(o, q) = radius^2+geometry::main::distance_sq(a, q)
    by def $is_on_circle(a, o, radius)
    release thm geometry::main::perpendicular_dot_expand(o, a, a, q)
    (a(1)-o(1))*(q(1)-a(1))+(a(2)-o(2))*(q(2)-a(2)) = 0
    release thm geometry::main::distance_sq_coordinate_formula(o, q)
    release thm geometry::main::distance_sq_coordinate_formula(o, a)
    release thm geometry::main::distance_sq_coordinate_formula(a, q)
    geometry::main::distance_sq(o, q) = (q(1)-o(1))^2+(q(2)-o(2))^2 = ((a(1)-o(1))+(q(1)-a(1)))^2+((a(2)-o(2))+(q(2)-a(2)))^2 = ((a(1)-o(1))^2+(a(2)-o(2))^2)+((q(1)-a(1))^2+(q(2)-a(2))^2)+2*((a(1)-o(1))*(q(1)-a(1))+(a(2)-o(2))*(q(2)-a(2))) = geometry::main::distance_sq(o, a)+geometry::main::distance_sq(a, q)+2*0 = geometry::main::distance_sq(o, a)+geometry::main::distance_sq(a, q) = radius*radius+geometry::main::distance_sq(a, q) = radius^2+geometry::main::distance_sq(a, q)

# A radius perpendicular to a line at its circumference point certifies tangency.
# The contact can lie anywhere on the line, not just at a named endpoint.
thm radius_perpendicular_at_line_point_gives_tangency:
    ? forall o,contact,a,b cart(R,R), radius R+:
        a != b
        contact $in geometry::main::line_through_points(a,b)
        $is_on_circle(contact,o,radius)
        geometry::main::dot(geometry::main::vec(o,contact),geometry::main::vec(a,b)) = 0
        =>:
            $is_tangent_line_at(contact,a,b,o,radius)
    by def $is_on_circle(contact,o,radius)
    geometry::main::circle(o,radius) = {p cart(R,R): geometry::main::distance_sq(o,p) = radius*radius}
    contact $in geometry::main::circle(o,radius)
    claim:
        ? forall q cart(R,R):
            q $in geometry::main::line_through_points(a,b)
            =>:
                geometry::main::distance_sq(o,q) >= radius^2
        geometry::main::line_through_points(a,b) = {p cart(R,R): geometry::main::det(geometry::main::vec(a,p),geometry::main::vec(a,b)) = 0}
        q $in geometry::main::line_through_points(a,b)
        contact $in geometry::main::line_through_points(a,b)
        q $in {p cart(R,R): geometry::main::det(geometry::main::vec(a,p),geometry::main::vec(a,b)) = 0}
        contact $in {p cart(R,R): geometry::main::det(geometry::main::vec(a,p),geometry::main::vec(a,b)) = 0}
        release thm set_builder_member(q,{p cart(R,R): geometry::main::det(geometry::main::vec(a,p),geometry::main::vec(a,b)) = 0})
        release thm set_builder_member(contact,{p cart(R,R): geometry::main::det(geometry::main::vec(a,p),geometry::main::vec(a,b)) = 0})
        release thm geometry::main::collinear_det_expand(a,q,b)
        release thm geometry::main::collinear_det_expand(a,contact,b)
        have ux R = contact(1)-o(1)
        have uy R = contact(2)-o(2)
        have vx R = b(1)-a(1)
        have vy R = b(2)-a(2)
        have wx R = q(1)-contact(1)
        have wy R = q(2)-contact(2)
        (q(1)-a(1))*vy-(q(2)-a(2))*vx = geometry::main::det(geometry::main::vec(a,q),geometry::main::vec(a,b)) = 0
        (contact(1)-a(1))*vy-(contact(2)-a(2))*vx = geometry::main::det(geometry::main::vec(a,contact),geometry::main::vec(a,b)) = 0
        wx = q(1)-contact(1) = (q(1)-a(1))-(contact(1)-a(1))
        wy = q(2)-contact(2) = (q(2)-a(2))-(contact(2)-a(2))
        wx*vy-wy*vx = (q(1)-contact(1))*vy-(q(2)-contact(2))*vx = ((q(1)-a(1))*vy-(q(2)-a(2))*vx)-((contact(1)-a(1))*vy-(contact(2)-a(2))*vx) = 0-0 = 0
        vx*wy-vy*wx = -(wx*vy-wy*vx) = 0
        release thm geometry::main::perpendicular_dot_expand(o,contact,a,b)
        ux*vx+uy*vy = (contact(1)-o(1))*(b(1)-a(1))+(contact(2)-o(2))*(b(2)-a(2)) = geometry::main::dot(geometry::main::vec(o,contact),geometry::main::vec(a,b)) = 0
        release thm point_difference_norm_pos(a,b)
        vx^2+vy^2 = (b(1)-a(1))^2+(b(2)-a(2))^2 > 0
        (vx^2+vy^2)*(ux*wx+uy*wy) = (ux*vx+uy*vy)*(vx*wx+vy*wy)+(vx*uy-vy*ux)*(vx*wy-vy*wx) = 0*(vx*wx+vy*wy)+(vx*uy-vy*ux)*0 = 0
        ux*wx+uy*wy = ((vx^2+vy^2)*(ux*wx+uy*wy))/(vx^2+vy^2) = 0/(vx^2+vy^2) = 0
        release thm geometry::main::perpendicular_dot_expand(o,contact,contact,q)
        geometry::main::dot(geometry::main::vec(o,contact),geometry::main::vec(contact,q)) = (contact(1)-o(1))*(q(1)-contact(1))+(contact(2)-o(2))*(q(2)-contact(2)) = ux*wx+uy*wy = 0
        release thm radial_perpendicular_distance_identity(o,contact,q,radius)
        release thm geometry::main::distance_sq_nonnegative(contact,q)
        geometry::main::distance_sq(o,q) = radius^2+geometry::main::distance_sq(contact,q) >= radius^2
    by def $is_tangent_line_at(contact,a,b,o,radius)

thm book04_proposition_8:
    ? forall a,b,c,d cart(R,R):
        $geometry::main::is_square(a,b,c,d)
        =>:
            exist o,ab,bc,cd,da cart(R,R), radius R+ st {2*o(1) = a(1)+c(1), 2*o(2) = a(2)+c(2), $geometry::main::is_on_segment(ab,a,b), $is_tangent_line_at(ab,a,b,o,radius), $geometry::main::is_on_segment(bc,b,c), $is_tangent_line_at(bc,b,c,o,radius), $geometry::main::is_on_segment(cd,c,d), $is_tangent_line_at(cd,c,d,o,radius), $geometry::main::is_on_segment(da,d,a), $is_tangent_line_at(da,d,a,o,radius)}
    release thm square_coordinate_frame(a,b,c,d)
    by def $geometry::main::is_square(a,b,c,d)
    $geometry::main::is_rectangle(a,b,c,d)
    by def $geometry::main::is_rectangle(a,b,c,d)
    $geometry::main::is_parallelogram(a,b,c,d)
    by def $geometry::main::is_parallelogram(a,b,c,d)
    $geometry::main::is_parallel(a,d,b,c)
    by def $geometry::main::is_parallel(a,d,b,c)
    $geometry::main::is_parallel(a,b,d,c)
    by def $geometry::main::is_parallel(a,b,d,c)
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have side_sq R+ = geometry::main::distance_sq(a,b)
    have quarter_side_sq R+ = side_sq/4
    have radius R+ = sqrt(quarter_side_sq)
    radius^2 = (sqrt(quarter_side_sq))^2 = quarter_side_sq = side_sq/4
    have x R = b(1)-a(1)
    have y R = b(2)-a(2)
    have z R = d(1)-a(1)
    have w R = d(2)-a(2)
    release thm geometry::main::distance_sq_coordinate_formula(a,b)
    release thm geometry::main::distance_sq_coordinate_formula(a,d)
    x^2+y^2 = (b(1)-a(1))^2+(b(2)-a(2))^2 = geometry::main::distance_sq(a,b) = side_sq
    z^2+w^2 = (d(1)-a(1))^2+(d(2)-a(2))^2 = geometry::main::distance_sq(a,d) = geometry::main::distance_sq(a,b) = side_sq
    release thm geometry::main::perpendicular_dot_expand(a,d,a,b)
    x*z+y*w = (b(1)-a(1))*(d(1)-a(1))+(b(2)-a(2))*(d(2)-a(2)) = (d(1)-a(1))*(b(1)-a(1))+(d(2)-a(2))*(b(2)-a(2)) = geometry::main::dot(geometry::main::vec(a,d),geometry::main::vec(a,b)) = 0
    have o cart(R,R) = ((a(1)+c(1))/2,(a(2)+c(2))/2)
    have ab cart(R,R) = ((a(1)+b(1))/2,(a(2)+b(2))/2)
    ab(1)-o(1) = ((a(1)+b(1))/2)-((a(1)+c(1))/2) = ((a(1)+b(1))/2)-((a(1)+(b(1)+d(1)-a(1)))/2) = (-(d(1)-a(1))/2) = (-z/2)
    b(1)-a(1) = b(1)-a(1) = ((b(1)-a(1))) = (x)
    ab(2)-o(2) = ((a(2)+b(2))/2)-((a(2)+c(2))/2) = ((a(2)+b(2))/2)-((a(2)+(b(2)+d(2)-a(2)))/2) = (-(d(2)-a(2))/2) = (-w/2)
    b(2)-a(2) = b(2)-a(2) = ((b(2)-a(2))) = (y)
    release thm geometry::main::distance_sq_coordinate_formula(o,ab)
    geometry::main::distance_sq(o,ab) = (-z/2)^2+(-w/2)^2 = (z^2+w^2)/4 = side_sq/4 = radius^2 = radius*radius
    by def $is_on_circle(ab,o,radius)
    release thm geometry::main::perpendicular_dot_expand(o,ab,a,b)
    geometry::main::dot(geometry::main::vec(o,ab),geometry::main::vec(a,b)) = (-z/2)*(x)+(-w/2)*(y) = -(x*z+y*w)/2 = 0
    ab(1) = (a(1)+b(1))/2 = (1-1/2)*a(1)+(1/2)*b(1)
    ab(2) = (a(2)+b(2))/2 = (1-1/2)*a(2)+(1/2)*b(2)
    witness exist t R st {0 <= t, t <= 1, ab(1) = (1-t)*a(1)+t*b(1), ab(2) = (1-t)*a(2)+t*b(2)} from 1/2
    by def $geometry::main::is_on_segment(ab,a,b)
    release thm geometry::main::collinear_det_expand(a,ab,b)
    geometry::main::det(geometry::main::vec(a,ab),geometry::main::vec(a,b)) = (ab(1)-a(1))*(b(2)-a(2))-(ab(2)-a(2))*(b(1)-a(1)) = ((a(1)+b(1))/2-a(1))*(b(2)-a(2))-((a(2)+b(2))/2-a(2))*(b(1)-a(1)) = 0
    geometry::main::line_through_points(a,b) = {p cart(R,R): geometry::main::det(geometry::main::vec(a,p),geometry::main::vec(a,b)) = 0}
    ab $in geometry::main::line_through_points(a,b)
    release thm radius_perpendicular_at_line_point_gives_tangency(o,ab,a,b,radius)
    have bc cart(R,R) = ((b(1)+c(1))/2,(b(2)+c(2))/2)
    bc(1)-o(1) = ((b(1)+c(1))/2)-((a(1)+c(1))/2) = ((b(1)+(b(1)+d(1)-a(1)))/2)-((a(1)+(b(1)+d(1)-a(1)))/2) = ((b(1)-a(1))/2) = (x/2)
    c(1)-b(1) = (b(1)+d(1)-a(1))-b(1) = ((d(1)-a(1))) = (z)
    bc(2)-o(2) = ((b(2)+c(2))/2)-((a(2)+c(2))/2) = ((b(2)+(b(2)+d(2)-a(2)))/2)-((a(2)+(b(2)+d(2)-a(2)))/2) = ((b(2)-a(2))/2) = (y/2)
    c(2)-b(2) = (b(2)+d(2)-a(2))-b(2) = ((d(2)-a(2))) = (w)
    release thm geometry::main::distance_sq_coordinate_formula(o,bc)
    geometry::main::distance_sq(o,bc) = (x/2)^2+(y/2)^2 = (x^2+y^2)/4 = side_sq/4 = radius^2 = radius*radius
    by def $is_on_circle(bc,o,radius)
    release thm geometry::main::perpendicular_dot_expand(o,bc,b,c)
    geometry::main::dot(geometry::main::vec(o,bc),geometry::main::vec(b,c)) = (x/2)*(z)+(y/2)*(w) = (x*z+y*w)/2 = 0
    bc(1) = (b(1)+c(1))/2 = (1-1/2)*b(1)+(1/2)*c(1)
    bc(2) = (b(2)+c(2))/2 = (1-1/2)*b(2)+(1/2)*c(2)
    witness exist t R st {0 <= t, t <= 1, bc(1) = (1-t)*b(1)+t*c(1), bc(2) = (1-t)*b(2)+t*c(2)} from 1/2
    by def $geometry::main::is_on_segment(bc,b,c)
    release thm geometry::main::collinear_det_expand(b,bc,c)
    geometry::main::det(geometry::main::vec(b,bc),geometry::main::vec(b,c)) = (bc(1)-b(1))*(c(2)-b(2))-(bc(2)-b(2))*(c(1)-b(1)) = ((b(1)+c(1))/2-b(1))*(c(2)-b(2))-((b(2)+c(2))/2-b(2))*(c(1)-b(1)) = 0
    geometry::main::line_through_points(b,c) = {p cart(R,R): geometry::main::det(geometry::main::vec(b,p),geometry::main::vec(b,c)) = 0}
    bc $in geometry::main::line_through_points(b,c)
    release thm radius_perpendicular_at_line_point_gives_tangency(o,bc,b,c,radius)
    have cd cart(R,R) = ((c(1)+d(1))/2,(c(2)+d(2))/2)
    cd(1)-o(1) = ((c(1)+d(1))/2)-((a(1)+c(1))/2) = (((b(1)+d(1)-a(1))+d(1))/2)-((a(1)+(b(1)+d(1)-a(1)))/2) = ((d(1)-a(1))/2) = (z/2)
    d(1)-c(1) = d(1)-(b(1)+d(1)-a(1)) = (-(b(1)-a(1))) = (-x)
    cd(2)-o(2) = ((c(2)+d(2))/2)-((a(2)+c(2))/2) = (((b(2)+d(2)-a(2))+d(2))/2)-((a(2)+(b(2)+d(2)-a(2)))/2) = ((d(2)-a(2))/2) = (w/2)
    d(2)-c(2) = d(2)-(b(2)+d(2)-a(2)) = (-(b(2)-a(2))) = (-y)
    release thm geometry::main::distance_sq_coordinate_formula(o,cd)
    geometry::main::distance_sq(o,cd) = (z/2)^2+(w/2)^2 = (z^2+w^2)/4 = side_sq/4 = radius^2 = radius*radius
    by def $is_on_circle(cd,o,radius)
    release thm geometry::main::perpendicular_dot_expand(o,cd,c,d)
    geometry::main::dot(geometry::main::vec(o,cd),geometry::main::vec(c,d)) = (z/2)*(-x)+(w/2)*(-y) = -(x*z+y*w)/2 = 0
    cd(1) = (c(1)+d(1))/2 = (1-1/2)*c(1)+(1/2)*d(1)
    cd(2) = (c(2)+d(2))/2 = (1-1/2)*c(2)+(1/2)*d(2)
    witness exist t R st {0 <= t, t <= 1, cd(1) = (1-t)*c(1)+t*d(1), cd(2) = (1-t)*c(2)+t*d(2)} from 1/2
    by def $geometry::main::is_on_segment(cd,c,d)
    release thm geometry::main::collinear_det_expand(c,cd,d)
    geometry::main::det(geometry::main::vec(c,cd),geometry::main::vec(c,d)) = (cd(1)-c(1))*(d(2)-c(2))-(cd(2)-c(2))*(d(1)-c(1)) = ((c(1)+d(1))/2-c(1))*(d(2)-c(2))-((c(2)+d(2))/2-c(2))*(d(1)-c(1)) = 0
    geometry::main::line_through_points(c,d) = {p cart(R,R): geometry::main::det(geometry::main::vec(c,p),geometry::main::vec(c,d)) = 0}
    cd $in geometry::main::line_through_points(c,d)
    release thm radius_perpendicular_at_line_point_gives_tangency(o,cd,c,d,radius)
    have da cart(R,R) = ((d(1)+a(1))/2,(d(2)+a(2))/2)
    da(1)-o(1) = ((d(1)+a(1))/2)-((a(1)+c(1))/2) = ((d(1)+a(1))/2)-((a(1)+(b(1)+d(1)-a(1)))/2) = (-(b(1)-a(1))/2) = (-x/2)
    a(1)-d(1) = a(1)-d(1) = (-(d(1)-a(1))) = (-z)
    da(2)-o(2) = ((d(2)+a(2))/2)-((a(2)+c(2))/2) = ((d(2)+a(2))/2)-((a(2)+(b(2)+d(2)-a(2)))/2) = (-(b(2)-a(2))/2) = (-y/2)
    a(2)-d(2) = a(2)-d(2) = (-(d(2)-a(2))) = (-w)
    release thm geometry::main::distance_sq_coordinate_formula(o,da)
    geometry::main::distance_sq(o,da) = (-x/2)^2+(-y/2)^2 = (x^2+y^2)/4 = side_sq/4 = radius^2 = radius*radius
    by def $is_on_circle(da,o,radius)
    release thm geometry::main::perpendicular_dot_expand(o,da,d,a)
    geometry::main::dot(geometry::main::vec(o,da),geometry::main::vec(d,a)) = (-x/2)*(-z)+(-y/2)*(-w) = (x*z+y*w)/2 = 0
    da(1) = (d(1)+a(1))/2 = (1-1/2)*d(1)+(1/2)*a(1)
    da(2) = (d(2)+a(2))/2 = (1-1/2)*d(2)+(1/2)*a(2)
    witness exist t R st {0 <= t, t <= 1, da(1) = (1-t)*d(1)+t*a(1), da(2) = (1-t)*d(2)+t*a(2)} from 1/2
    by def $geometry::main::is_on_segment(da,d,a)
    release thm geometry::main::collinear_det_expand(d,da,a)
    geometry::main::det(geometry::main::vec(d,da),geometry::main::vec(d,a)) = (da(1)-d(1))*(a(2)-d(2))-(da(2)-d(2))*(a(1)-d(1)) = ((d(1)+a(1))/2-d(1))*(a(2)-d(2))-((d(2)+a(2))/2-d(2))*(a(1)-d(1)) = 0
    geometry::main::line_through_points(d,a) = {p cart(R,R): geometry::main::det(geometry::main::vec(d,p),geometry::main::vec(d,a)) = 0}
    da $in geometry::main::line_through_points(d,a)
    release thm radius_perpendicular_at_line_point_gives_tangency(o,da,d,a,radius)
    witness exist center,contact_ab,contact_bc,contact_cd,contact_da cart(R,R), r R+ st {2*center(1) = a(1)+c(1), 2*center(2) = a(2)+c(2), $geometry::main::is_on_segment(contact_ab,a,b), $is_tangent_line_at(contact_ab,a,b,center,r), $geometry::main::is_on_segment(contact_bc,b,c), $is_tangent_line_at(contact_bc,b,c,center,r), $geometry::main::is_on_segment(contact_cd,c,d), $is_tangent_line_at(contact_cd,c,d,center,r), $geometry::main::is_on_segment(contact_da,d,a), $is_tangent_line_at(contact_da,d,a,center,r)} from o,ab,bc,cd,da,radius

thm book04_proposition_9:
    ? forall a,b,c,d cart(R,R):
        $geometry::main::is_square(a,b,c,d)
        =>:
            exist o cart(R,R), radius R+ st {a $in geometry::main::circle(o,radius), b $in geometry::main::circle(o,radius), c $in geometry::main::circle(o,radius), d $in geometry::main::circle(o,radius)}
    release thm square_coordinate_frame(a,b,c,d)
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have side_sq R+ = geometry::main::distance_sq(a,b)
    have half_side_sq R+ = side_sq/2
    have radius R+ = sqrt(half_side_sq)
    radius^2 = (sqrt(half_side_sq))^2 = half_side_sq = side_sq/2
    have x R = b(1)-a(1)
    have y R = b(2)-a(2)
    have z R = d(1)-a(1)
    have w R = d(2)-a(2)
    release thm geometry::main::distance_sq_coordinate_formula(a,b)
    release thm geometry::main::distance_sq_coordinate_formula(a,d)
    x^2+y^2 = (b(1)-a(1))^2+(b(2)-a(2))^2 = geometry::main::distance_sq(a,b) = side_sq
    z^2+w^2 = (d(1)-a(1))^2+(d(2)-a(2))^2 = geometry::main::distance_sq(a,d) = geometry::main::distance_sq(a,b) = side_sq
    release thm geometry::main::perpendicular_dot_expand(a,d,a,b)
    x*z+y*w = (b(1)-a(1))*(d(1)-a(1))+(b(2)-a(2))*(d(2)-a(2)) = (d(1)-a(1))*(b(1)-a(1))+(d(2)-a(2))*(b(2)-a(2)) = geometry::main::dot(geometry::main::vec(a,d),geometry::main::vec(a,b)) = 0
    have o cart(R,R) = ((a(1)+c(1))/2,(a(2)+c(2))/2)
    o(1) = (a(1)+c(1))/2 = (a(1)+(b(1)+d(1)-a(1)))/2 = (b(1)+d(1))/2
    o(1)-a(1) = (b(1)+d(1))/2-a(1) = ((b(1)-a(1))+(d(1)-a(1)))/2 = (x+z)/2
    c(1)-a(1) = (b(1)+d(1)-a(1))-a(1) = (b(1)-a(1))+(d(1)-a(1)) = x+z
    o(2) = (a(2)+c(2))/2 = (a(2)+(b(2)+d(2)-a(2)))/2 = (b(2)+d(2))/2
    o(2)-a(2) = (b(2)+d(2))/2-a(2) = ((b(2)-a(2))+(d(2)-a(2)))/2 = (y+w)/2
    c(2)-a(2) = (b(2)+d(2)-a(2))-a(2) = (b(2)-a(2))+(d(2)-a(2)) = y+w
    geometry::main::circle(o,radius) = {p cart(R,R): geometry::main::distance_sq(o,p) = radius*radius}
    a(1)-a(1) = 0
    a(1)-o(1) = (a(1)-a(1))-(o(1)-a(1)) = (0)-(x+z)/2 = (-x-z)/2
    a(2)-a(2) = 0
    a(2)-o(2) = (a(2)-a(2))-(o(2)-a(2)) = (0)-(y+w)/2 = (-y-w)/2
    release thm geometry::main::distance_sq_coordinate_formula(o,a)
    geometry::main::distance_sq(o,a) = (a(1)-o(1))^2+(a(2)-o(2))^2 = ((-x-z)/2)^2+((-y-w)/2)^2 = ((x^2+y^2)+(z^2+w^2)+2*(x*z+y*w))/4 = (side_sq+side_sq+2*0)/4 = side_sq/2 = radius^2 = radius*radius
    a $in geometry::main::circle(o,radius)
    b(1)-a(1) = x
    b(1)-o(1) = (b(1)-a(1))-(o(1)-a(1)) = (x)-(x+z)/2 = (x-z)/2
    b(2)-a(2) = y
    b(2)-o(2) = (b(2)-a(2))-(o(2)-a(2)) = (y)-(y+w)/2 = (y-w)/2
    release thm geometry::main::distance_sq_coordinate_formula(o,b)
    geometry::main::distance_sq(o,b) = (b(1)-o(1))^2+(b(2)-o(2))^2 = ((x-z)/2)^2+((y-w)/2)^2 = ((x^2+y^2)+(z^2+w^2)-2*(x*z+y*w))/4 = (side_sq+side_sq-2*0)/4 = side_sq/2 = radius^2 = radius*radius
    b $in geometry::main::circle(o,radius)
    c(1)-a(1) = x+z
    c(1)-o(1) = (c(1)-a(1))-(o(1)-a(1)) = (x+z)-(x+z)/2 = (x+z)/2
    c(2)-a(2) = y+w
    c(2)-o(2) = (c(2)-a(2))-(o(2)-a(2)) = (y+w)-(y+w)/2 = (y+w)/2
    release thm geometry::main::distance_sq_coordinate_formula(o,c)
    geometry::main::distance_sq(o,c) = (c(1)-o(1))^2+(c(2)-o(2))^2 = ((x+z)/2)^2+((y+w)/2)^2 = ((x^2+y^2)+(z^2+w^2)+2*(x*z+y*w))/4 = (side_sq+side_sq+2*0)/4 = side_sq/2 = radius^2 = radius*radius
    c $in geometry::main::circle(o,radius)
    d(1)-a(1) = z
    d(1)-o(1) = (d(1)-a(1))-(o(1)-a(1)) = (z)-(x+z)/2 = (z-x)/2
    d(2)-a(2) = w
    d(2)-o(2) = (d(2)-a(2))-(o(2)-a(2)) = (w)-(y+w)/2 = (w-y)/2
    release thm geometry::main::distance_sq_coordinate_formula(o,d)
    geometry::main::distance_sq(o,d) = (d(1)-o(1))^2+(d(2)-o(2))^2 = ((z-x)/2)^2+((w-y)/2)^2 = ((x^2+y^2)+(z^2+w^2)-2*(x*z+y*w))/4 = (side_sq+side_sq-2*0)/4 = side_sq/2 = radius^2 = radius*radius
    d $in geometry::main::circle(o,radius)
    witness exist center cart(R,R), r R+ st {a $in geometry::main::circle(center,r), b $in geometry::main::circle(center,r), c $in geometry::main::circle(center,r), d $in geometry::main::circle(center,r)} from o,radius

thm golden_cut_parameter_exists:
    ? exist t R+ st {t < 1, t^2 = 1-t}
    have root R+ = sqrt(5)
    root^2 = sqrt(5)^2 = 5
    by contra:
        ? root > 1
        root <= 1
        1-root >= 0
        1+root > 0
        (1-root)*(1+root) >= 0
        (1-root)*(1+root) = 1-root^2 = -4
        impossible (1-root)*(1+root) >= 0
    by contra:
        ? root < 3
        root >= 3
        root-3 >= 0
        root+3 > 0
        (root-3)*(root+3) >= 0
        (root-3)*(root+3) = root^2-9 = -4
        impossible (root-3)*(root+3) >= 0
    root-1 > 0
    have t R+ = (root-1)/2
    root-1 < 3-1 = 2
    (root-1)/2 < 2/2 = 1
    t = (root-1)/2 < 1
    t^2 = ((root-1)/2)^2 = (root^2-2*root+1)/4 = (5-2*root+1)/4 = 1-(root-1)/2 = 1-t
    witness exist k R+ st {k < 1, k^2 = 1-k} from t

thm golden_triangle_positive_height:
    ? forall t R+:
        t < 1
        =>:
            exist height R+ st {height^2 = 1-((1+t)/2)^2}
    have u R = (1+t)/2
    0 < (1+t)/2
    1+t < 1+1 = 2
    (1+t)/2 < 2/2 = 1
    0 < u < 1
    1-u > 0
    1+u > 0
    (1-u)*(1+u) > 0
    1-u^2 = (1-u)*(1+u) > 0
    have height_sq R+ = 1-u^2
    have height R+ = sqrt(height_sq)
    height^2 = (sqrt(height_sq))^2 = height_sq = 1-u^2 = 1-((1+t)/2)^2
    witness exist h R+ st {h^2 = 1-((1+t)/2)^2} from height

thm golden_triangle_metric_certificate:
    ? forall t,height R+, a,b,d cart(R,R):
        t < 1
        t^2 = 1-t
        height^2 = 1-((1+t)/2)^2
        a = (0,0)
        b = (1,0)
        d = ((1+t)/2,height)
        =>:
            $geometry::main::is_triangle(a,b,d)
            geometry::main::distance_sq(a,b) = 1
            geometry::main::distance_sq(a,d) = 1
            geometry::main::distance_sq(b,d) = t^2
    a(1) = 0
    a(2) = 0
    b(1) = 1
    b(2) = 0
    d(1) = (1+t)/2
    d(2) = height
    release thm geometry::main::collinear_det_expand(a,b,d)
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d)) = (b(1)-a(1))*(d(2)-a(2))-(b(2)-a(2))*(d(1)-a(1)) = (1-0)*(height-0)-(0-0)*((1+t)/2-0) = height
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d)) != 0
    by def $geometry::main::is_triangle(a,b,d)
    d(1)-a(1) = (1+t)/2-0 = (1+t)/2
    d(2)-a(2) = height-0 = height
    d(1)-b(1) = (1+t)/2-1
    d(2)-b(2) = height-0 = height
    release thm geometry::main::distance_sq_coordinate_formula(a,b)
    release thm geometry::main::distance_sq_coordinate_formula(a,d)
    release thm geometry::main::distance_sq_coordinate_formula(b,d)
    geometry::main::distance_sq(a,b) = (b(1)-a(1))^2+(b(2)-a(2))^2 = (1-0)^2+(0-0)^2 = 1
    geometry::main::distance_sq(a,d) = (d(1)-a(1))^2+(d(2)-a(2))^2 = ((1+t)/2)^2+height^2 = ((1+t)/2)^2+(1-((1+t)/2)^2) = 1
    geometry::main::distance_sq(b,d) = (d(1)-b(1))^2+(d(2)-b(2))^2 = ((1+t)/2-1)^2+height^2 = ((1+t)/2-1)^2+(1-((1+t)/2)^2) = 1-t = t^2

thm golden_triangle_metric_construction:
    ? exist a,b,d cart(R,R), t R+ st {$geometry::main::is_triangle(a,b,d), t < 1, t^2 = 1-t, geometry::main::distance_sq(a,b) = 1, geometry::main::distance_sq(a,d) = 1, geometry::main::distance_sq(b,d) = t^2}
    release thm golden_cut_parameter_exists
    obtain t from exist t R+ st {t < 1, t^2 = 1-t}
    release thm golden_triangle_positive_height(t)
    obtain height from exist h R+ st {h^2 = 1-((1+t)/2)^2}
    have a cart(R,R) = (0,0)
    have b cart(R,R) = (1,0)
    have d cart(R,R) = ((1+t)/2,height)
    release thm golden_triangle_metric_certificate(t,height,a,b,d)
    witness exist first,second,third cart(R,R), ratio R+ st {$geometry::main::is_triangle(first,second,third), ratio < 1, ratio^2 = 1-ratio, geometry::main::distance_sq(first,second) = 1, geometry::main::distance_sq(first,third) = 1, geometry::main::distance_sq(second,third) = ratio^2} from a,b,d,t

thm cosine_strictly_decreasing_on_principal_range:
    ? forall x, y R:
        0 <= x
        x < y
        y <= pi
        =>:
            cos(x) > cos(y)
    have h R = (x + y) / 2
    have k R = (y - x) / 2
    y > x >= 0
    x + y >= y > 0
    h = (x + y) / 2 > 0 / 2 = 0
    x < y <= pi
    x + y < pi + pi
    h = (x + y) / 2 < (pi + pi) / 2 = pi
    y - x > 0
    k = (y - x) / 2 > 0 / 2 = 0
    y - x <= pi - 0 = pi
    pi > 0
    pi / 2 < pi
    k = (y - x) / 2 <= pi / 2 < pi
    sin(h) > 0
    sin(k) > 0
    sin(h) * sin(k) > 0
    2 * (sin(h) * sin(k)) > 0
    2 * sin(h) * sin(k) = 2 * (sin(h) * sin(k)) > 0
    x = (x + y) / 2 - (y - x) / 2 = h - k
    y = (x + y) / 2 + (y - x) / 2 = h + k
    cos(x) = cos(h - k) = cos(h) * cos(k) + sin(h) * sin(k)
    cos(y) = cos(h + k) = cos(h) * cos(k) - sin(h) * sin(k)
    cos(x) - cos(y) = (cos(h) * cos(k) + sin(h) * sin(k)) - (cos(h) * cos(k) - sin(h) * sin(k)) = 2 * sin(h) * sin(k) > 0
    cos(x) = (cos(x) - cos(y)) + cos(y) > 0 + cos(y) = cos(y)


thm cosine_weakly_decreasing_on_principal_range:
    ? forall x, y R:
        0 <= x
        x <= y
        y <= pi
        =>:
            cos(x) >= cos(y)
    by cases:
        ? cos(x) >= cos(y)
        case x < y:
            release thm cosine_strictly_decreasing_on_principal_range(x, y)
            cos(x) >= cos(y)
        case x >= y:
            x = y
            cos(x) = cos(y)
            cos(x) >= cos(y)


thm arccos_strictly_decreasing:
    ? forall x, y R:
        (-1) <= x
        x <= 1
        (-1) <= y
        y <= 1
        x < y
        =>:
            arccos(x) > arccos(y)
    by contra:
        ? arccos(x) > arccos(y)
        arccos(x) <= arccos(y)
        0 <= arccos(x) <= pi
        0 <= arccos(y) <= pi
        release thm cosine_weakly_decreasing_on_principal_range(arccos(x), arccos(y))
        x = cos(arccos(x)) >= cos(arccos(y)) = y
        impossible x < y


thm golden_triangle_cosine_certificate:
    ? forall a,b,d cart(R,R), t R+:
        $geometry::main::is_triangle(a,b,d)
        a != b
        b != a
        a != d
        d != a
        b != d
        d != b
        t < 1
        t^2 = 1-t
        geometry::main::distance_sq(a,b) = 1
        geometry::main::distance_sq(a,d) = 1
        geometry::main::distance_sq(b,d) = t^2
        =>:
            angles::angle_cosine(b,a,d) = (1+t)/2
            angles::angle_cosine(a,b,d) = t/2
            angles::angle_cosine(a,d,b) = t/2
    release thm geometry_lemmas::triangle_vertices_distinct(a,b,d)
    release thm geometry::main::distance_sq_symmetric(a,b)
    release thm geometry::main::distance_sq_symmetric(a,d)
    release thm geometry::main::distance_sq_symmetric(b,d)
    geometry::main::distance_sq(b,a) = geometry::main::distance_sq(a,b) = 1
    geometry::main::distance_sq(d,a) = geometry::main::distance_sq(a,d) = 1
    geometry::main::distance_sq(d,b) = geometry::main::distance_sq(b,d) = t^2
    release thm geometry::main::dot_from_cosine_law(b,a,d)
    geometry::main::angle_cos_num(b,a,d) = geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,d)) = (geometry::main::distance_sq(b,a)+geometry::main::distance_sq(a,d)-geometry::main::distance_sq(b,d))/2 = (1+1-t^2)/2 = (2-(1-t))/2 = (1+t)/2
    geometry::main::angle_cos_den(b,a,d) = geometry::main::distance_sq(a,b)*geometry::main::distance_sq(a,d) = 1*1 = 1
    angles::angle_cosine(b,a,d) = geometry::main::angle_cos_num(b,a,d)/sqrt(geometry::main::angle_cos_den(b,a,d)) = ((1+t)/2)/sqrt(1) = (1+t)/2
    release thm geometry::main::dot_from_cosine_law(a,b,d)
    geometry::main::angle_cos_num(a,b,d) = geometry::main::dot(geometry::main::vec(b,a),geometry::main::vec(b,d)) = (geometry::main::distance_sq(a,b)+geometry::main::distance_sq(b,d)-geometry::main::distance_sq(a,d))/2 = (1+t^2-1)/2 = t^2/2
    geometry::main::angle_cos_den(a,b,d) = geometry::main::distance_sq(b,a)*geometry::main::distance_sq(b,d) = 1*t^2 = t^2
    sqrt(t^2) = t
    sqrt(geometry::main::angle_cos_den(a,b,d)) = sqrt(t^2) = t
    sqrt(geometry::main::angle_cos_den(a,b,d)) != 0
    angles::angle_cosine(a,b,d) = geometry::main::angle_cos_num(a,b,d)/sqrt(geometry::main::angle_cos_den(a,b,d)) = (t^2/2)/sqrt(t^2) = (t^2/2)/t = t/2
    release thm geometry::main::dot_from_cosine_law(a,d,b)
    geometry::main::angle_cos_num(a,d,b) = geometry::main::dot(geometry::main::vec(d,a),geometry::main::vec(d,b)) = (geometry::main::distance_sq(a,d)+geometry::main::distance_sq(d,b)-geometry::main::distance_sq(a,b))/2 = (1+t^2-1)/2 = t^2/2
    geometry::main::angle_cos_den(a,d,b) = geometry::main::distance_sq(d,a)*geometry::main::distance_sq(d,b) = 1*t^2 = t^2
    sqrt(geometry::main::angle_cos_den(a,d,b)) = sqrt(t^2) = t
    sqrt(geometry::main::angle_cos_den(a,d,b)) != 0
    angles::angle_cosine(a,d,b) = geometry::main::angle_cos_num(a,d,b)/sqrt(geometry::main::angle_cos_den(a,d,b)) = (t^2/2)/sqrt(t^2) = (t^2/2)/t = t/2

thm golden_triangle_angle_relation:
    ? forall t R+:
        t < 1
        t^2 = 1-t
        (-1) <= t/2
        t/2 <= 1
        (-1) <= (1+t)/2
        (1+t)/2 <= 1
        =>:
            arccos(t/2) = 2*arccos((1+t)/2)
    have u R = (1+t)/2
    0 < (1+t)/2
    1+t < 1+1 = 2
    (1+t)/2 < 2/2 = 1
    0 < u < 1
    0 < t/2 < 1/2 < 1
    release thm arccos_strictly_decreasing(0,u)
    arccos(u) < arccos(0) = pi/2
    have alpha R = arccos(u)
    0 <= arccos(u) <= pi
    0 <= alpha
    2*alpha < 2*(pi/2) = pi
    0 <= 2*alpha
    2*alpha <= pi
    cos(alpha) = cos(arccos(u)) = u
    cos(2*alpha) = 2*cos(alpha)^2-1 = 2*u^2-1 = 2*((1+t)/2)^2-1 = (t^2+2*t-1)/2 = ((1-t)+2*t-1)/2 = t/2
    arccos(t/2) = arccos(cos(2*alpha)) = 2*alpha = 2*arccos(u) = 2*arccos((1+t)/2)

# An isosceles triangle with each base angle twice its apex angle.
prop is_golden_triangle(a,b,d cart(R,R)):
    a != b
    b != a
    a != d
    d != a
    b != d
    d != b
    $geometry::main::is_triangle(a,b,d)
    geometry::main::distance_sq(a,b) = geometry::main::distance_sq(a,d)
    (-1) <= angles::angle_cosine(b,a,d)
    angles::angle_cosine(b,a,d) <= 1
    (-1) <= angles::angle_cosine(a,b,d)
    angles::angle_cosine(a,b,d) <= 1
    (-1) <= angles::angle_cosine(a,d,b)
    angles::angle_cosine(a,d,b) <= 1
    arccos(angles::angle_cosine(a,b,d)) = 2*arccos(angles::angle_cosine(b,a,d))
    arccos(angles::angle_cosine(a,d,b)) = 2*arccos(angles::angle_cosine(b,a,d))

thm book04_proposition_10:
    ? exist a,b,d cart(R,R) st {$is_golden_triangle(a,b,d)}
    release thm golden_triangle_metric_construction
    obtain a,b,d,t from exist a,b,d cart(R,R), t R+ st {$geometry::main::is_triangle(a,b,d), t < 1, t^2 = 1-t, geometry::main::distance_sq(a,b) = 1, geometry::main::distance_sq(a,d) = 1, geometry::main::distance_sq(b,d) = t^2}
    release thm geometry_lemmas::triangle_vertices_distinct(a,b,d)
    a != b
    b != a
    a != d
    d != a
    b != d
    d != b
    release thm golden_triangle_cosine_certificate(a,b,d,t)
    0 < t/2
    t/2 < 1/2 < 1
    (-1) <= t/2
    t/2 <= 1
    0 < (1+t)/2
    1+t < 1+1 = 2
    (1+t)/2 < 2/2 = 1
    (-1) <= (1+t)/2
    (1+t)/2 <= 1
    release thm golden_triangle_angle_relation(t)
    angles::angle_cosine(b,a,d) = (1+t)/2
    angles::angle_cosine(a,b,d) = t/2
    angles::angle_cosine(a,d,b) = t/2
    (-1) <= angles::angle_cosine(b,a,d) <= 1
    (-1) <= angles::angle_cosine(a,b,d) <= 1
    (-1) <= angles::angle_cosine(a,d,b) <= 1
    arccos(angles::angle_cosine(a,b,d)) = arccos(t/2) = 2*arccos((1+t)/2) = 2*arccos(angles::angle_cosine(b,a,d))
    arccos(angles::angle_cosine(a,d,b)) = arccos(t/2) = 2*arccos((1+t)/2) = 2*arccos(angles::angle_cosine(b,a,d))
    geometry::main::distance_sq(a,b) = 1 = geometry::main::distance_sq(a,d)
    by def $is_golden_triangle(a,b,d)
    witness exist first,second,third cart(R,R) st {$is_golden_triangle(first,second,third)} from a,b,d

sketch:
    release thm book04_proposition_10
    obtain a,b,d from exist a,b,d cart(R,R) st {$is_golden_triangle(a,b,d)}
    by def $is_golden_triangle(a,b,d)
    $geometry::main::is_triangle(a,b,d)
    geometry::main::distance_sq(a,b) = geometry::main::distance_sq(a,d)
    arccos(angles::angle_cosine(a,b,d)) = 2*arccos(angles::angle_cosine(b,a,d))
    arccos(angles::angle_cosine(a,d,b)) = 2*arccos(angles::angle_cosine(b,a,d))
