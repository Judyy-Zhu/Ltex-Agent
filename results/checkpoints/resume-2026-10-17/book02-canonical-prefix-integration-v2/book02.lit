thm coordinate_rectangle_area:
    ? forall width,height R+:
        $area::has_parallelogram_area((0,0),(width,0),(width,height),(0,height),width*height)
        $geometry::main::is_right_angle((0,height),(0,0),(width,0))
        geometry::main::distance_sq((0,0),(width,0)) = width^2
        geometry::main::distance_sq((0,0),(0,height)) = height^2
    have a cart(R,R) = (0,0)
    a(1) = 0
    a(2) = 0
    have b cart(R,R) = (width,0)
    b(1) = width
    b(2) = 0
    have c cart(R,R) = (width,height)
    c(1) = width
    c(2) = height
    have d cart(R,R) = (0,height)
    d(1) = 0
    d(2) = height
    width*height > 0
    width*height != 0
    release thm geometry::main::collinear_det_expand(a,b,d)
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d)) = (b(1)-a(1))*(d(2)-a(2))-(b(2)-a(2))*(d(1)-a(1)) = (width-0)*(height-0)-(0-0)*(0-0) = width*height != 0
    by def $geometry::main::is_triangle(a,b,d)
    release thm geometry_lemmas::triangle_vertices_distinct(a,b,d)
    release thm affine_parallelogram_area(a,b,c,d)
    obtain half from exist common R+ st {$area::has_triangle_area(a,b,d,common), $area::has_parallelogram_area(a,b,c,d,2*common)}
    release thm geometry::main::vec_coordinate_formula(a,b)
    release thm geometry::main::vec_coordinate_formula(a,d)
    geometry::main::dot(geometry::main::vec(a,d),geometry::main::vec(a,b)) = (d(1)-a(1))*(b(1)-a(1))+(d(2)-a(2))*(b(2)-a(2)) = (0-0)*(width-0)+(height-0)*(0-0) = 0
    by def $geometry::main::is_right_angle(d,a,b)
    geometry::main::distance_sq(a,b) = geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,b)) = (b(1)-a(1))*(b(1)-a(1))+(b(2)-a(2))*(b(2)-a(2)) = (b(1)-a(1))^2+(b(2)-a(2))^2 = (width-0)^2+(0-0)^2 = width^2
    geometry::main::distance_sq(a,d) = geometry::main::dot(geometry::main::vec(a,d),geometry::main::vec(a,d)) = (d(1)-a(1))*(d(1)-a(1))+(d(2)-a(2))*(d(2)-a(2)) = (d(1)-a(1))^2+(d(2)-a(2))^2 = (0-0)^2+(height-0)^2 = height^2
    release thm rectangle_area_is_side_product(a,b,c,d,width,height,2*half)
    $area::has_parallelogram_area(a,b,c,d,width*height)
    $area::has_parallelogram_area((0,0),(width,0),(width,height),(0,height),width*height)
    $geometry::main::is_right_angle((0,height),(0,0),(width,0))
    geometry::main::distance_sq((0,0),(width,0)) = width^2
    geometry::main::distance_sq((0,0),(0,height)) = height^2

prop is_strict_finite_segment_partition(a,b cart(R,R), n N+, parameter fn(k Z) R, points fn(k Z) cart(R,R)):
    a != b
    parameter(0) = 0
    parameter(n) = 1
    points(0) = a
    points(n) = b
    forall k Z:
        0 <= k
        k <= n
        =>:
            0 <= parameter(k)
            parameter(k) <= 1
            points(k)(1) = a(1)+parameter(k)*(b(1)-a(1))
            points(k)(2) = a(2)+parameter(k)*(b(2)-a(2))
    forall k Z:
        1 <= k
        k <= n
        =>:
            parameter(k-1) < parameter(k)

thm finite_scaled_partition_telescopes:
    ? forall n N+, parameter fn(k Z) R, terms fn(k Z) R, scale R:
        forall k Z:
            terms(k) = scale*(parameter(k)-parameter(k-1))
        =>:
            sum(1,n,terms) = scale*(parameter(n)-parameter(0))
    by induc m from 1:
        ? sum(1,m,terms) = scale*(parameter(m)-parameter(0))
        ? from m = 1:
            1-1 = 0
            terms(1) = scale*(parameter(1)-parameter(1-1)) = scale*(parameter(1)-parameter(0))
            sum(1,m,terms) = sum(1,1,terms) = terms(1) = scale*(parameter(1)-parameter(0)) = scale*(parameter(m)-parameter(0))
        ? induc:
            m >= 1
            m $in Z
            (m+1)-1 = m
            terms(m+1) = scale*(parameter(m+1)-parameter((m+1)-1)) = scale*(parameter(m+1)-parameter(m))
            sum(1,m+1,terms) = sum(1,m,terms)+terms(m+1) = scale*(parameter(m)-parameter(0))+scale*(parameter(m+1)-parameter(m)) = scale*(parameter(m+1)-parameter(0))
    n $in Z
    n >= 1
    sum(1,n,terms) = scale*(parameter(n)-parameter(0))

thm finite_partition_piece_length:
    ? forall a,b cart(R,R), n N+, parameter fn(j Z) R, points fn(j Z) cart(R,R), k Z:
        $is_strict_finite_segment_partition(a,b,n,parameter,points)
        1 <= k
        k <= n
        =>:
            geometry::main::distance_sq(points(k-1),points(k)) > 0
            sqrt(geometry::main::distance_sq(points(k-1),points(k))) = (parameter(k)-parameter(k-1))*sqrt(geometry::main::distance_sq(a,b))
    by def $is_strict_finite_segment_partition(a,b,n,parameter,points)
    a != b
    0 <= k
    0 <= k-1
    k-1 < k <= n
    k-1 <= n
    points(k-1)(1) = a(1)+parameter(k-1)*(b(1)-a(1))
    points(k-1)(2) = a(2)+parameter(k-1)*(b(2)-a(2))
    points(k)(1) = a(1)+parameter(k)*(b(1)-a(1))
    points(k)(2) = a(2)+parameter(k)*(b(2)-a(2))
    parameter(k-1) < parameter(k)
    parameter(k)-parameter(k-1) > 0
    have delta R+ = parameter(k)-parameter(k-1)
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have squared R+ = geometry::main::distance_sq(a,b)
    release thm affine_pair_squared_distance(a,b,points(k-1),points(k),parameter(k-1),parameter(k))
    delta^2 > 0
    delta^2*squared > 0
    geometry::main::distance_sq(points(k-1),points(k)) = (parameter(k)-parameter(k-1))^2*geometry::main::distance_sq(a,b) = delta^2*squared > 0
    sqrt(geometry::main::distance_sq(points(k-1),points(k))) = sqrt(delta^2*squared) = sqrt(delta^2)*sqrt(squared) = |delta|*sqrt(squared) = delta*sqrt(squared) = (parameter(k)-parameter(k-1))*sqrt(geometry::main::distance_sq(a,b))

prop is_finite_piece_rectangle_family(n N+, width R+, points fn(k Z) cart(R,R), areas fn(k Z) R):
    forall k Z:
        1 <= k
        k <= n
        =>:
            exist height R+ st {height^2 = geometry::main::distance_sq(points(k-1),points(k)), areas(k) = width*height, $area::has_parallelogram_area((0,0),(width,0),(width,height),(0,height),width*height), $geometry::main::is_right_angle((0,height),(0,0),(width,0)), geometry::main::distance_sq((0,0),(width,0)) = width^2, geometry::main::distance_sq((0,0),(0,height)) = height^2}

thm finite_partition_constructs_rectangles:
    ? forall a,b cart(R,R), n N+, parameter fn(j Z) R, points fn(j Z) cart(R,R), width,whole R+, areas fn(j Z) R:
        $is_strict_finite_segment_partition(a,b,n,parameter,points)
        whole = sqrt(geometry::main::distance_sq(a,b))
        forall k Z:
            areas(k) = width*whole*(parameter(k)-parameter(k-1))
        =>:
            $is_finite_piece_rectangle_family(n,width,points,areas)
            sum(1,n,areas) = width*whole
    by def $is_strict_finite_segment_partition(a,b,n,parameter,points)
    claim:
        ? forall k Z:
            1 <= k
            k <= n
            =>:
                exist height R+ st {height^2 = geometry::main::distance_sq(points(k-1),points(k)), areas(k) = width*height, $area::has_parallelogram_area((0,0),(width,0),(width,height),(0,height),width*height), $geometry::main::is_right_angle((0,height),(0,0),(width,0)), geometry::main::distance_sq((0,0),(width,0)) = width^2, geometry::main::distance_sq((0,0),(0,height)) = height^2}
        release thm finite_partition_piece_length(a,b,n,parameter,points,k)
        have height R+ = sqrt(geometry::main::distance_sq(points(k-1),points(k)))
        height^2 = sqrt(geometry::main::distance_sq(points(k-1),points(k)))^2 = geometry::main::distance_sq(points(k-1),points(k))
        height = sqrt(geometry::main::distance_sq(points(k-1),points(k))) = (parameter(k)-parameter(k-1))*sqrt(geometry::main::distance_sq(a,b)) = (parameter(k)-parameter(k-1))*whole
        areas(k) = width*whole*(parameter(k)-parameter(k-1)) = width*((parameter(k)-parameter(k-1))*whole) = width*height
        release thm coordinate_rectangle_area(width,height)
        witness exist chosen_height R+ st {chosen_height^2 = geometry::main::distance_sq(points(k-1),points(k)), areas(k) = width*chosen_height, $area::has_parallelogram_area((0,0),(width,0),(width,chosen_height),(0,chosen_height),width*chosen_height), $geometry::main::is_right_angle((0,chosen_height),(0,0),(width,0)), geometry::main::distance_sq((0,0),(width,0)) = width^2, geometry::main::distance_sq((0,0),(0,chosen_height)) = chosen_height^2} from height
    by def $is_finite_piece_rectangle_family(n,width,points,areas)
    release thm finite_scaled_partition_telescopes(n,parameter,areas,width*whole)
    parameter(n) = 1
    parameter(0) = 0
    sum(1,n,areas) = (width*whole)*(parameter(n)-parameter(0)) = (width*whole)*(1-0) = width*whole

thm book02_proposition_01_constructed_figures:
    ? forall u,v,a,b cart(R,R), n N+, parameter fn(j Z) R, points fn(j Z) cart(R,R):
        u != v
        $is_strict_finite_segment_partition(a,b,n,parameter,points)
        =>:
            exist width,whole R+, areas fn(j Z) R st {width^2 = geometry::main::distance_sq(u,v), whole^2 = geometry::main::distance_sq(a,b), $area::has_parallelogram_area((0,0),(width,0),(width,whole),(0,whole),width*whole), $geometry::main::is_right_angle((0,whole),(0,0),(width,0)), geometry::main::distance_sq((0,0),(width,0)) = width^2, geometry::main::distance_sq((0,0),(0,whole)) = whole^2, $is_finite_piece_rectangle_family(n,width,points,areas), sum(1,n,areas) = width*whole}
    by def $is_strict_finite_segment_partition(a,b,n,parameter,points)
    a != b
    release thm geometry::main::distance_sq_positive_of_ne(u,v)
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have width R+ = sqrt(geometry::main::distance_sq(u,v))
    have whole R+ = sqrt(geometry::main::distance_sq(a,b))
    width^2 = sqrt(geometry::main::distance_sq(u,v))^2 = geometry::main::distance_sq(u,v)
    whole^2 = sqrt(geometry::main::distance_sq(a,b))^2 = geometry::main::distance_sq(a,b)
    let areas = fn(k Z) R {width*whole*(parameter(k)-parameter(k-1))}
    forall k Z:
        areas(k) = width*whole*(parameter(k)-parameter(k-1))
    release thm finite_partition_constructs_rectangles(a,b,n,parameter,points,width,whole,areas)
    release thm coordinate_rectangle_area(width,whole)
    witness exist out_width,out_whole R+, out_areas fn(j Z) R st {out_width^2 = geometry::main::distance_sq(u,v), out_whole^2 = geometry::main::distance_sq(a,b), $area::has_parallelogram_area((0,0),(out_width,0),(out_width,out_whole),(0,out_whole),out_width*out_whole), $geometry::main::is_right_angle((0,out_whole),(0,0),(out_width,0)), geometry::main::distance_sq((0,0),(out_width,0)) = out_width^2, geometry::main::distance_sq((0,0),(0,out_whole)) = out_whole^2, $is_finite_piece_rectangle_family(n,out_width,points,out_areas), sum(1,n,out_areas) = out_width*out_whole} from width,whole,areas

sketch:
    have u cart(R,R) = (0,0)
    have v cart(R,R) = (0,3)
    u(2) = 0
    v(2) = 3
    have a cart(R,R) = (0,0)
    have b cart(R,R) = (4,0)
    a(1) = 0
    a(2) = 0
    b(1) = 4
    b(2) = 0
    by contra:
        ? a != b
        a = b
        0 = a(1) = b(1) = 4
        impossible 0 != 4
    by contra:
        ? u != v
        u = v
        0 = u(2) = v(2) = 3
        impossible 0 != 3
    let parameter = fn(k Z) R {k^2/16}
    let points = fn(k Z) cart(R,R) {(0+parameter(k)*(4),0)}
    parameter(0) = 0^2/16 = 0
    parameter(4) = 4^2/16 = 1
    0+parameter(0)*(4) = 0+0*(4) = 0
    0+parameter(4)*(4) = 0+1*(4) = 4
    points(0) = (0+parameter(0)*(4),0) = (0+0*(4),0) = (0,0) = a
    points(4) = (0+parameter(4)*(4),0) = (0+1*(4),0) = (4,0) = b
    claim:
        ? forall k Z:
            0 <= k
            k <= 4
            =>:
                0 <= parameter(k)
                parameter(k) <= 1
                points(k)(1) = a(1)+parameter(k)*(b(1)-a(1))
                points(k)(2) = a(2)+parameter(k)*(b(2)-a(2))
        k^2 >= 0
        k^2 <= 4^2 = 16
        parameter(k) = k^2/16 >= 0/16 = 0
        parameter(k) = k^2/16 <= 16/16 = 1
        points(k)(1) = 0+parameter(k)*(4) = 0+parameter(k)*(4-0) = a(1)+parameter(k)*(b(1)-a(1))
        points(k)(2) = 0 = 0+parameter(k)*(0-0) = a(2)+parameter(k)*(b(2)-a(2))
    claim:
        ? forall k Z:
            1 <= k
            k <= 4
            =>:
                parameter(k-1) < parameter(k)
        2*k-1 >= 2*1-1 = 1 > 0
        parameter(k)-parameter(k-1) = k^2/16-(k-1)^2/16 = (2*k-1)/16 >= 1/16 > 0
        parameter(k) = (parameter(k)-parameter(k-1))+parameter(k-1) > 0+parameter(k-1) = parameter(k-1)
    by def $is_strict_finite_segment_partition(a,b,4,parameter,points)
    release thm book02_proposition_01_constructed_figures(u,v,a,b,4,parameter,points)

sketch:
    have u cart(R,R) = (0,0)
    have v cart(R,R) = (0,3)
    u(2) = 0
    v(2) = 3
    have a cart(R,R) = (4,0)
    have b cart(R,R) = (0,0)
    a(1) = 4
    a(2) = 0
    b(1) = 0
    b(2) = 0
    by contra:
        ? a != b
        a = b
        4 = a(1) = b(1) = 0
        impossible 4 != 0
    by contra:
        ? u != v
        u = v
        0 = u(2) = v(2) = 3
        impossible 0 != 3
    let parameter = fn(k Z) R {k^2/16}
    let points = fn(k Z) cart(R,R) {(4+parameter(k)*(-4),0)}
    parameter(0) = 0^2/16 = 0
    parameter(4) = 4^2/16 = 1
    4+parameter(0)*(-4) = 4+0*(-4) = 4
    4+parameter(4)*(-4) = 4+1*(-4) = 0
    points(0) = (4+parameter(0)*(-4),0) = (4+0*(-4),0) = (4,0) = a
    points(4) = (4+parameter(4)*(-4),0) = (4+1*(-4),0) = (0,0) = b
    claim:
        ? forall k Z:
            0 <= k
            k <= 4
            =>:
                0 <= parameter(k)
                parameter(k) <= 1
                points(k)(1) = a(1)+parameter(k)*(b(1)-a(1))
                points(k)(2) = a(2)+parameter(k)*(b(2)-a(2))
        k^2 >= 0
        k^2 <= 4^2 = 16
        parameter(k) = k^2/16 >= 0/16 = 0
        parameter(k) = k^2/16 <= 16/16 = 1
        points(k)(1) = 4+parameter(k)*(-4) = 4+parameter(k)*(0-4) = a(1)+parameter(k)*(b(1)-a(1))
        points(k)(2) = 0 = 0+parameter(k)*(0-0) = a(2)+parameter(k)*(b(2)-a(2))
    claim:
        ? forall k Z:
            1 <= k
            k <= 4
            =>:
                parameter(k-1) < parameter(k)
        2*k-1 >= 2*1-1 = 1 > 0
        parameter(k)-parameter(k-1) = k^2/16-(k-1)^2/16 = (2*k-1)/16 >= 1/16 > 0
        parameter(k) = (parameter(k)-parameter(k-1))+parameter(k-1) > 0+parameter(k-1) = parameter(k-1)
    by def $is_strict_finite_segment_partition(a,b,4,parameter,points)
    release thm book02_proposition_01_constructed_figures(u,v,a,b,4,parameter,points)
