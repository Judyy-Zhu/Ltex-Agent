thm opposite_endpoint_projection_identity:
    ? forall a,b,c cart(R,R):
        geometry::main::dot(geometry::main::vec(c,b),geometry::main::vec(c,a)) = geometry::main::distance_sq(a,c)-geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,c))
