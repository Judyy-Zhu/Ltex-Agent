            exist ad_c,ad_d,db_c,db_d,ac_c,ac_d,cd_c,cd_d cart(R,R), first_area,second_area,half_area,offset_area R+ st {$geometry::main::is_square(a,d,ad_c,ad_d), $area::has_parallelogram_area(a,d,ad_c,ad_d,first_area), $geometry::main::is_square(d,b,db_c,db_d), $area::has_parallelogram_area(d,b,db_c,db_d,second_area), $geometry::main::is_square(a,c,ac_c,ac_d), $area::has_parallelogram_area(a,c,ac_c,ac_d,half_area), $geometry::main::is_square(c,d,cd_c,cd_d), $area::has_parallelogram_area(c,d,cd_c,cd_d,offset_area), first_area+second_area = 2*(half_area+offset_area)}
