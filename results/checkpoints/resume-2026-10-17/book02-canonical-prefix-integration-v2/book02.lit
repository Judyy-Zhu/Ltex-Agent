thm book02_proposition_03:
    ? forall a,b,c,p,q,r,s,u,v,w,z,sq_c,sq_d cart(R,R), first,second,total R+:
        $is_on_segment(c,a,b)
        c != a
        c != b
        $area::has_parallelogram_area(p,q,r,s,first)
        $geometry::main::is_right_angle(s,p,q)
        geometry::main::distance_sq(p,q) = geometry::main::distance_sq(a,b)
        geometry::main::distance_sq(p,s) = geometry::main::distance_sq(c,b)
        $area::has_parallelogram_area(u,v,w,z,second)
        $geometry::main::is_right_angle(z,u,v)
        geometry::main::distance_sq(u,v) = geometry::main::distance_sq(a,c)
        geometry::main::distance_sq(u,z) = geometry::main::distance_sq(c,b)
        $geometry::main::is_square(c,b,sq_c,sq_d)
        $area::has_parallelogram_area(c,b,sq_c,sq_d,total)
        =>:
            first = second+total
    by def $is_on_segment(c,a,b)
    release thm strict_segment_cut_has_interior_parameter(a,b,c)
    obtain t from exist k R+ st {k < 1, c(1) = (1-k)*a(1)+k*b(1), c(2) = (1-k)*a(2)+k*b(2)}
    0 < t
    release thm interior_affine_cut_lengths_add(a,b,c,t)
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have whole R+ = sqrt(geometry::main::distance_sq(a,b))
    have left_piece R+ = sqrt(geometry::main::distance_sq(a,c))
    have right_piece R+ = sqrt(geometry::main::distance_sq(c,b))
    whole^2 = sqrt(geometry::main::distance_sq(a,b))^2 = geometry::main::distance_sq(a,b)
    left_piece^2 = sqrt(geometry::main::distance_sq(a,c))^2 = geometry::main::distance_sq(a,c)
    right_piece^2 = sqrt(geometry::main::distance_sq(c,b))^2 = geometry::main::distance_sq(c,b)
    geometry::main::distance_sq(p,q) = whole^2
    geometry::main::distance_sq(p,s) = right_piece^2
    geometry::main::distance_sq(u,v) = left_piece^2
    geometry::main::distance_sq(u,z) = right_piece^2
    release thm rectangle_area_is_side_product(p,q,r,s,whole,right_piece,first)
    release thm rectangle_area_is_side_product(u,v,w,z,left_piece,right_piece,second)
    release thm square_area_is_squared_side(c,b,sq_c,sq_d,total)
    total = geometry::main::distance_sq(c,b) = right_piece^2
    left_piece+right_piece = sqrt(geometry::main::distance_sq(a,c))+sqrt(geometry::main::distance_sq(c,b)) = sqrt(geometry::main::distance_sq(a,b)) = whole
    whole = left_piece+right_piece
    first = whole*right_piece = (left_piece+right_piece)*right_piece = left_piece*right_piece+right_piece^2 = second+total

thm book02_proposition_03_constructed_figures:
    ? forall a,b,c cart(R,R):
        $is_on_segment(c,a,b)
        c != a
        c != b
        =>:
            exist p,q,r,s,u,v,w,z,sq_c,sq_d cart(R,R), first,second,total R+ st {$area::has_parallelogram_area(p,q,r,s,first), $geometry::main::is_right_angle(s,p,q), geometry::main::distance_sq(p,q) = geometry::main::distance_sq(a,b), geometry::main::distance_sq(p,s) = geometry::main::distance_sq(c,b), $area::has_parallelogram_area(u,v,w,z,second), $geometry::main::is_right_angle(z,u,v), geometry::main::distance_sq(u,v) = geometry::main::distance_sq(a,c), geometry::main::distance_sq(u,z) = geometry::main::distance_sq(c,b), $geometry::main::is_square(c,b,sq_c,sq_d), $area::has_parallelogram_area(c,b,sq_c,sq_d,total), first = second+total}
    by def $is_on_segment(c,a,b)
    release thm strict_segment_cut_has_interior_parameter(a,b,c)
    obtain t from exist k R+ st {k < 1, c(1) = (1-k)*a(1)+k*b(1), c(2) = (1-k)*a(2)+k*b(2)}
    0 < t
    release thm interior_affine_cut_lengths_add(a,b,c,t)
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have whole R+ = sqrt(geometry::main::distance_sq(a,b))
    have left_piece R+ = sqrt(geometry::main::distance_sq(a,c))
    have right_piece R+ = sqrt(geometry::main::distance_sq(c,b))
    whole^2 = sqrt(geometry::main::distance_sq(a,b))^2 = geometry::main::distance_sq(a,b)
    left_piece^2 = sqrt(geometry::main::distance_sq(a,c))^2 = geometry::main::distance_sq(a,c)
    right_piece^2 = sqrt(geometry::main::distance_sq(c,b))^2 = geometry::main::distance_sq(c,b)
    release thm actual_rectangle_from_positive_lengths(whole,right_piece)
    obtain p,q,r,s from exist out_a,out_b,out_c,out_d cart(R,R) st {$area::has_parallelogram_area(out_a,out_b,out_c,out_d,whole*right_piece), $geometry::main::is_right_angle(out_d,out_a,out_b), geometry::main::distance_sq(out_a,out_b) = whole^2, geometry::main::distance_sq(out_a,out_d) = right_piece^2}
    release thm actual_rectangle_from_positive_lengths(left_piece,right_piece)
    obtain u,v,w,z from exist out_a,out_b,out_c,out_d cart(R,R) st {$area::has_parallelogram_area(out_a,out_b,out_c,out_d,left_piece*right_piece), $geometry::main::is_right_angle(out_d,out_a,out_b), geometry::main::distance_sq(out_a,out_b) = left_piece^2, geometry::main::distance_sq(out_a,out_d) = right_piece^2}
    release thm proposition_46(c,b)
    obtain sq_c,sq_d from exist third,fourth cart(R,R) st {$geometry::main::is_square(c,b,third,fourth), $area::is_proper_parallelogram(c,b,third,fourth)}
    release thm proper_square_area_exists(c,b,sq_c,sq_d)
    obtain total from exist value R+ st {$area::has_parallelogram_area(c,b,sq_c,sq_d,value)}
    have first R+ = whole*right_piece
    have second R+ = left_piece*right_piece
    geometry::main::distance_sq(p,q) = whole^2 = geometry::main::distance_sq(a,b)
    geometry::main::distance_sq(p,s) = right_piece^2 = geometry::main::distance_sq(c,b)
    geometry::main::distance_sq(u,v) = left_piece^2 = geometry::main::distance_sq(a,c)
    geometry::main::distance_sq(u,z) = right_piece^2 = geometry::main::distance_sq(c,b)
    $area::has_parallelogram_area(p,q,r,s,first)
    $area::has_parallelogram_area(u,v,w,z,second)
    release thm book02_proposition_03(a,b,c,p,q,r,s,u,v,w,z,sq_c,sq_d,first,second,total)
    witness exist out_p,out_q,out_r,out_s,out_u,out_v,out_w,out_z,out_sq_c,out_sq_d cart(R,R), out_first,out_second,out_total R+ st {$area::has_parallelogram_area(out_p,out_q,out_r,out_s,out_first), $geometry::main::is_right_angle(out_s,out_p,out_q), geometry::main::distance_sq(out_p,out_q) = geometry::main::distance_sq(a,b), geometry::main::distance_sq(out_p,out_s) = geometry::main::distance_sq(c,b), $area::has_parallelogram_area(out_u,out_v,out_w,out_z,out_second), $geometry::main::is_right_angle(out_z,out_u,out_v), geometry::main::distance_sq(out_u,out_v) = geometry::main::distance_sq(a,c), geometry::main::distance_sq(out_u,out_z) = geometry::main::distance_sq(c,b), $geometry::main::is_square(c,b,out_sq_c,out_sq_d), $area::has_parallelogram_area(c,b,out_sq_c,out_sq_d,out_total), out_first = out_second+out_total} from p,q,r,s,u,v,w,z,sq_c,sq_d,first,second,total

