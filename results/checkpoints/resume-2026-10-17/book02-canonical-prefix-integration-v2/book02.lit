thm golden_cut_parameter_exists:
    ? exist t R+ st {t < 1, t^2 = 1-t}
    have root R+ = sqrt(5)
    root^2 = sqrt(5)^2 = 5
    by contra:
        ? root > 1
        root <= 1
        1-root >= 0
        1+root > 0
        (1-root)*(1+root) >= 0
        (1-root)*(1+root) = 1-root^2 = -4
        impossible (1-root)*(1+root) >= 0
    by contra:
        ? root < 3
        root >= 3
        root-3 >= 0
        root+3 > 0
        (root-3)*(root+3) >= 0
        (root-3)*(root+3) = root^2-9 = -4
        impossible (root-3)*(root+3) >= 0
    root-1 > 0
    have t R+ = (root-1)/2
    root-1 < 3-1 = 2
    (root-1)/2 < 2/2 = 1
    t = (root-1)/2 < 1
    t^2 = ((root-1)/2)^2 = (root^2-2*root+1)/4 = (5-2*root+1)/4 = 1-(root-1)/2 = 1-t
    witness exist k R+ st {k < 1, k^2 = 1-k} from t

thm book02_proposition_11_constructed_figures:
    ? forall a,b cart(R,R):
        a != b
        =>:
            exist h,p,q,r,s,ac,ad cart(R,R), equal_area R+ st {$is_on_segment(h,a,b), h != a, h != b, $area::has_parallelogram_area(p,q,r,s,equal_area), $geometry::main::is_right_angle(s,p,q), geometry::main::distance_sq(p,q) = geometry::main::distance_sq(a,b), geometry::main::distance_sq(p,s) = geometry::main::distance_sq(h,b), $geometry::main::is_square(a,h,ac,ad), $area::has_parallelogram_area(a,h,ac,ad,equal_area)}
    release thm golden_cut_parameter_exists
    obtain t from exist k R+ st {k < 1, k^2 = 1-k}
    have h cart(R,R) = ((1-t)*a(1)+t*b(1),(1-t)*a(2)+t*b(2))
    h(1) = (1-t)*a(1)+t*b(1)
    h(2) = (1-t)*a(2)+t*b(2)
    0 < t
    release thm interior_affine_cut_lengths_ratio(a,b,h,t)
    witness exist k R st {0 <= k, k <= 1, h(1) = (1-k)*a(1)+k*b(1), h(2) = (1-k)*a(2)+k*b(2)} from t
    by def $is_on_segment(h,a,b)
    by contra:
        ? h != a
        h = a
        release thm geometry::main::distance_sq_coordinate_formula(a,h)
        geometry::main::distance_sq(a,h) = (h(1)-a(1))^2+(h(2)-a(2))^2 = (a(1)-a(1))^2+(a(2)-a(2))^2 = 0
        impossible geometry::main::distance_sq(a,h) > 0
    by contra:
        ? h != b
        h = b
        release thm geometry::main::distance_sq_coordinate_formula(h,b)
        geometry::main::distance_sq(h,b) = (b(1)-h(1))^2+(b(2)-h(2))^2 = (b(1)-b(1))^2+(b(2)-b(2))^2 = 0
        impossible geometry::main::distance_sq(h,b) > 0
    a != h
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have whole R+ = sqrt(geometry::main::distance_sq(a,b))
    have piece R+ = sqrt(geometry::main::distance_sq(h,b))
    have other R+ = sqrt(geometry::main::distance_sq(a,h))
    whole^2 = sqrt(geometry::main::distance_sq(a,b))^2 = geometry::main::distance_sq(a,b)
    piece^2 = sqrt(geometry::main::distance_sq(h,b))^2 = geometry::main::distance_sq(h,b)
    other^2 = sqrt(geometry::main::distance_sq(a,h))^2 = geometry::main::distance_sq(a,h)
    other = sqrt(geometry::main::distance_sq(a,h)) = t*sqrt(geometry::main::distance_sq(a,b)) = t*whole
    piece = sqrt(geometry::main::distance_sq(h,b)) = (1-t)*sqrt(geometry::main::distance_sq(a,b)) = (1-t)*whole
    other^2 = (t*whole)^2 = t^2*whole^2 = (1-t)*whole^2 = whole*((1-t)*whole) = whole*piece
    release thm actual_rectangle_from_positive_lengths(whole,piece)
    obtain p,q,r,s from exist out_a,out_b,out_c,out_d cart(R,R) st {$area::has_parallelogram_area(out_a,out_b,out_c,out_d,whole*piece), $geometry::main::is_right_angle(out_d,out_a,out_b), geometry::main::distance_sq(out_a,out_b) = whole^2, geometry::main::distance_sq(out_a,out_d) = piece^2}
    release thm proposition_46(a,h)
    obtain ac,ad from exist third,fourth cart(R,R) st {$geometry::main::is_square(a,h,third,fourth), $area::is_proper_parallelogram(a,h,third,fourth)}
    release thm proper_square_area_exists(a,h,ac,ad)
    obtain equal_area from exist value R+ st {$area::has_parallelogram_area(a,h,ac,ad,value)}
    release thm square_area_is_squared_side(a,h,ac,ad,equal_area)
    equal_area = geometry::main::distance_sq(a,h) = other^2 = whole*piece
    $area::has_parallelogram_area(p,q,r,s,equal_area)
    geometry::main::distance_sq(p,q) = whole^2 = geometry::main::distance_sq(a,b)
    geometry::main::distance_sq(p,s) = piece^2 = geometry::main::distance_sq(h,b)
    witness exist out_h,out_p,out_q,out_r,out_s,out_ac,out_ad cart(R,R), out_area R+ st {$is_on_segment(out_h,a,b), out_h != a, out_h != b, $area::has_parallelogram_area(out_p,out_q,out_r,out_s,out_area), $geometry::main::is_right_angle(out_s,out_p,out_q), geometry::main::distance_sq(out_p,out_q) = geometry::main::distance_sq(a,b), geometry::main::distance_sq(out_p,out_s) = geometry::main::distance_sq(out_h,b), $geometry::main::is_square(a,out_h,out_ac,out_ad), $area::has_parallelogram_area(a,out_h,out_ac,out_ad,out_area)} from h,p,q,r,s,ac,ad,equal_area

