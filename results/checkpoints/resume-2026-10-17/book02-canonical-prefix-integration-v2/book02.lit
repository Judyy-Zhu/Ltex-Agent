thm interior_affine_point_is_strict_cut:
    ? forall a,c,d cart(R,R), t R:
        a != c
        0 < t
        t < 1
        d(1) = a(1)+t*(c(1)-a(1))
        d(2) = a(2)+t*(c(2)-a(2))
        =>:
            d != a
            d != c
            $is_on_segment(d,a,c)
