    geometry::main::distance_sq(p,s) = height^2 = geometry::main::distance_sq(a,d)
    release thm three_squares_on_triangle(a,b,c)
    obtain ab_c,ab_d,bc_c,bc_d,ac_c,ac_d,first_area,opposite_area,second_area from exist out_ab_c,out_ab_d,out_bc_c,out_bc_d,out_ac_c,out_ac_d cart(R,R), out_first,out_second,out_opposite R+ st {$geometry::main::is_square(a,b,out_ab_c,out_ab_d), $area::has_parallelogram_area(a,b,out_ab_c,out_ab_d,out_first), $geometry::main::is_square(b,c,out_bc_c,out_bc_d), $area::has_parallelogram_area(b,c,out_bc_c,out_bc_d,out_second), $geometry::main::is_square(a,c,out_ac_c,out_ac_d), $area::has_parallelogram_area(a,c,out_ac_c,out_ac_d,out_opposite)}
    release thm square_area_is_squared_side(a,b,ab_c,ab_d,first_area)
    release thm square_area_is_squared_side(b,c,bc_c,bc_d,opposite_area)
    release thm square_area_is_squared_side(a,c,ac_c,ac_d,second_area)
    release thm geometry::main::distance_sq_symmetric(a,b)
    first_area = geometry::main::distance_sq(a,b) = geometry::main::distance_sq(b,a)
    opposite_area = geometry::main::distance_sq(b,c) = geometry::main::distance_sq(b,a)+geometry::main::distance_sq(a,c)-2*sqrt(geometry::main::distance_sq(a,c))*sqrt(geometry::main::distance_sq(a,d)) = first_area+second_area-2*width*height = first_area+second_area-2*(width*height) = first_area+second_area-2*rectangle_area
    2*rectangle_area > 0
    first_area+second_area-2*rectangle_area < first_area+second_area-0 = first_area+second_area
    opposite_area = first_area+second_area-2*rectangle_area < first_area+second_area
    witness exist out_d,out_p,out_q,out_r,out_s,out_ab_c,out_ab_d,out_bc_c,out_bc_d,out_ac_c,out_ac_d cart(R,R), out_first_area,out_opposite_area,out_second_area,out_rectangle_area R+ st {$is_on_segment(out_d,a,c), out_d != a, out_d != c, $geometry::main::is_right_angle(b,out_d,c), geometry::main::dot(geometry::main::vec(out_d,b),geometry::main::vec(a,c)) = 0, $area::has_parallelogram_area(out_p,out_q,out_r,out_s,out_rectangle_area), $geometry::main::is_right_angle(out_s,out_p,out_q), geometry::main::distance_sq(out_p,out_q) = geometry::main::distance_sq(a,c), geometry::main::distance_sq(out_p,out_s) = geometry::main::distance_sq(a,out_d), $geometry::main::is_square(a,b,out_ab_c,out_ab_d), $area::has_parallelogram_area(a,b,out_ab_c,out_ab_d,out_first_area), $geometry::main::is_square(b,c,out_bc_c,out_bc_d), $area::has_parallelogram_area(b,c,out_bc_c,out_bc_d,out_opposite_area), $geometry::main::is_square(a,c,out_ac_c,out_ac_d), $area::has_parallelogram_area(a,c,out_ac_c,out_ac_d,out_second_area), out_opposite_area = out_first_area+out_second_area-2*out_rectangle_area, out_opposite_area < out_first_area+out_second_area} from d,p,q,r,s,ab_c,ab_d,bc_c,bc_d,ac_c,ac_d,first_area,opposite_area,second_area,rectangle_area

thm book02_proposition_13_constructed_figures:
    ? forall a,b,c cart(R,R):
        $is_acute_triangle(a,b,c)
        =>:
            exist d,p,q,r,s,ab_c,ab_d,bc_c,bc_d,ac_c,ac_d cart(R,R), first_area,opposite_area,second_area,rectangle_area R+ st {$is_on_segment(d,a,c), d != a, d != c, $geometry::main::is_right_angle(b,d,c), geometry::main::dot(geometry::main::vec(d,b),geometry::main::vec(a,c)) = 0, $area::has_parallelogram_area(p,q,r,s,rectangle_area), $geometry::main::is_right_angle(s,p,q), geometry::main::distance_sq(p,q) = geometry::main::distance_sq(a,c), geometry::main::distance_sq(p,s) = geometry::main::distance_sq(a,d), $geometry::main::is_square(a,b,ab_c,ab_d), $area::has_parallelogram_area(a,b,ab_c,ab_d,first_area), $geometry::main::is_square(b,c,bc_c,bc_d), $area::has_parallelogram_area(b,c,bc_c,bc_d,opposite_area), $geometry::main::is_square(a,c,ac_c,ac_d), $area::has_parallelogram_area(a,c,ac_c,ac_d,second_area), opposite_area = first_area+second_area-2*rectangle_area, opposite_area < first_area+second_area}
    by def $is_acute_triangle(a,b,c)
    $geometry::main::is_triangle(a,b,c)
    release thm geometry_lemmas::triangle_vertices_distinct(a,b,c)
    ray_angle(b,a,c) < pi/2
    ray_angle(b,c,a) < pi/2
    release thm acute_measure_implies_positive_dot(b,a,c)
    release thm acute_measure_implies_positive_dot(b,c,a)
    release thm acute_endpoint_dots_constructed_figures(a,b,c)

sketch:
    have a cart(R,R) = (0,0)
