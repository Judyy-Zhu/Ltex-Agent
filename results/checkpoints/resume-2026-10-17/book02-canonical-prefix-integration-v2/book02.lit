    release thm angles::angle_den_positive(p,q,r)
    have den R+ = sqrt(geometry::main::angle_cos_den(p,q,r))
    have numerator R = geometry::main::angle_cos_num(p,q,r)
    numerator = geometry::main::angle_cos_num(p,q,r) = geometry::main::dot(geometry::main::vec(q,p),geometry::main::vec(q,r)) < 0
    numerator/den < 0/den = 0
