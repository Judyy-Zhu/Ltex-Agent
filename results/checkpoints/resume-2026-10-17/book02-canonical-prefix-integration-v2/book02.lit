    a(2) = 0
    have b cart(R,R) = (1,2)
    b(1) = 1
    b(2) = 2
    have c cart(R,R) = (4,0)
    c(1) = 4
    c(2) = 0
    by contra:
        ? a != b
        a = b
        0 = a(1) = b(1) = 1
        impossible 0 != 1
    by contra:
        ? a != c
        a = c
        0 = a(1) = c(1) = 4
        impossible 0 != 4
    by contra:
        ? b != c
        b = c
        1 = b(1) = c(1) = 4
        impossible 1 != 4
    release thm geometry::main::collinear_det_expand(a,b,c)
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c)) = (b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1)) = (1-0)*(0-0)-(2-0)*(4-0) = -8
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c)) != 0
    by def $geometry::main::is_triangle(a,b,c)
    release thm geometry::main::perpendicular_dot_expand(a,b,a,c)
    geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,c)) = (b(1)-a(1))*(c(1)-a(1))+(b(2)-a(2))*(c(2)-a(2)) = (1-0)*(4-0)+(2-0)*(0-0) = 4
    geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,c)) > 0
    release thm positive_dot_implies_acute_measure(b,a,c)
    release thm geometry::main::perpendicular_dot_expand(b,a,b,c)
    geometry::main::dot(geometry::main::vec(b,a),geometry::main::vec(b,c)) = (a(1)-b(1))*(c(1)-b(1))+(a(2)-b(2))*(c(2)-b(2)) = (0-1)*(4-1)+(0-2)*(0-2) = 1
    geometry::main::dot(geometry::main::vec(b,a),geometry::main::vec(b,c)) > 0
    release thm positive_dot_implies_acute_measure(a,b,c)
    release thm geometry::main::perpendicular_dot_expand(c,b,c,a)
    geometry::main::dot(geometry::main::vec(c,b),geometry::main::vec(c,a)) = (b(1)-c(1))*(a(1)-c(1))+(b(2)-c(2))*(a(2)-c(2)) = (1-4)*(0-4)+(2-0)*(0-0) = 12
    geometry::main::dot(geometry::main::vec(c,b),geometry::main::vec(c,a)) > 0
    release thm positive_dot_implies_acute_measure(b,c,a)
    by def $is_acute_triangle(a,b,c)
    release thm book02_proposition_13_constructed_figures(a,b,c)

