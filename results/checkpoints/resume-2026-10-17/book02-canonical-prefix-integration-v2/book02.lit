            geometry::main::distance_sq(b,c) = geometry::main::distance_sq(b,a)+geometry::main::distance_sq(a,c)-2*sqrt(geometry::main::distance_sq(a,c))*sqrt(geometry::main::distance_sq(a,d))
    release thm geometry::main::distance_sq_positive_of_ne(a,c)
    a(1) = a(1)+0*(c(1)-a(1))
    a(2) = a(2)+0*(c(2)-a(2))
    release thm affine_pair_squared_distance(a,c,a,d,0,t)
    have squared R+ = geometry::main::distance_sq(a,c)
    have magnitude R+ = t
    t != 0
