thm negative_dot_implies_obtuse_measure:
    ? forall p,q,r cart(R,R):
        p != q
        r != q
        geometry::main::dot(geometry::main::vec(q,p),geometry::main::vec(q,r)) < 0
        =>:
            ray_angle(p,q,r) > pi/2
    release thm ray_angle_range(p,q,r)
