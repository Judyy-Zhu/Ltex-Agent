    sqrt(geometry::main::distance_sq(a,d)) = sqrt(magnitude^2*squared) = sqrt(magnitude^2)*sqrt(squared) = |magnitude|*sqrt(squared) = magnitude*sqrt(squared)
    sqrt(geometry::main::distance_sq(a,c))*sqrt(geometry::main::distance_sq(a,d)) = sqrt(squared)*(magnitude*sqrt(squared)) = magnitude*sqrt(squared)^2 = magnitude*squared = t*squared = t*geometry::main::distance_sq(a,c) = geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,c))
