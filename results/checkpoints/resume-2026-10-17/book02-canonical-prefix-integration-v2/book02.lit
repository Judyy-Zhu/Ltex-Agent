thm interior_affine_cut_lengths_ratio:
    ? forall a,b,c cart(R,R), t R:
        a != b
        0 < t
        t < 1
        c(1) = (1-t)*a(1)+t*b(1)
        c(2) = (1-t)*a(2)+t*b(2)
        =>:
            sqrt(geometry::main::distance_sq(a,c))+sqrt(geometry::main::distance_sq(c,b)) = sqrt(geometry::main::distance_sq(a,b))
            sqrt(geometry::main::distance_sq(a,c)) = t*sqrt(geometry::main::distance_sq(a,b))
            sqrt(geometry::main::distance_sq(c,b)) = (1-t)*sqrt(geometry::main::distance_sq(a,b))
            geometry::main::distance_sq(a,c) > 0
            geometry::main::distance_sq(c,b) > 0
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    release thm geometry::main::distance_sq_symmetric(a,b)
    release thm geometry::main::distance_sq_symmetric(a,c)
    c(1) = (1-t)*a(1)+t*b(1) = a(1)+t*(b(1)-a(1))
    c(2) = (1-t)*a(2)+t*b(2) = a(2)+t*(b(2)-a(2))
    release thm geometry::main::affine_distance_from_parameter(a,b,c,t)
    have s R+ = 1-t
    c(1) = (1-t)*a(1)+t*b(1) = b(1)+(1-t)*(a(1)-b(1)) = b(1)+s*(a(1)-b(1))
    c(2) = (1-t)*a(2)+t*b(2) = b(2)+(1-t)*(a(2)-b(2)) = b(2)+s*(a(2)-b(2))
    release thm geometry::main::affine_distance_from_parameter(b,a,c,s)
    have squared R+ = geometry::main::distance_sq(a,b)
    geometry::main::distance_sq(a,c) = geometry::main::distance_sq(c,a) = t^2*geometry::main::distance_sq(a,b) = t^2*squared
    geometry::main::distance_sq(c,b) = s^2*geometry::main::distance_sq(b,a) = s^2*geometry::main::distance_sq(a,b) = s^2*squared
    t > 0
    t != 0
    t^2 > 0
    s^2 > 0
    t^2*squared > 0
    s^2*squared > 0
    geometry::main::distance_sq(a,c) > 0
    geometry::main::distance_sq(c,b) > 0
    sqrt(geometry::main::distance_sq(a,c)) = sqrt(t^2*squared) = sqrt(t^2)*sqrt(squared) = |t|*sqrt(squared) = t*sqrt(squared)
    sqrt(geometry::main::distance_sq(c,b)) = sqrt(s^2*squared) = sqrt(s^2)*sqrt(squared) = |s|*sqrt(squared) = s*sqrt(squared)
    have length R+ = sqrt(squared)
    sqrt(geometry::main::distance_sq(a,c)) = t*length
    sqrt(geometry::main::distance_sq(c,b)) = s*length
    sqrt(geometry::main::distance_sq(a,c))+sqrt(geometry::main::distance_sq(c,b)) = t*length+s*length = (t+s)*length = (t+(1-t))*length = length = sqrt(squared) = sqrt(geometry::main::distance_sq(a,b))
    sqrt(geometry::main::distance_sq(a,c)) = t*length = t*sqrt(squared) = t*sqrt(geometry::main::distance_sq(a,b))
    sqrt(geometry::main::distance_sq(c,b)) = s*length = (1-t)*length = (1-t)*sqrt(squared) = (1-t)*sqrt(geometry::main::distance_sq(a,b))

thm affine_pair_squared_distance:
    ? forall a,b,p,q cart(R,R), s,t R:
        p(1) = a(1)+s*(b(1)-a(1))
        p(2) = a(2)+s*(b(2)-a(2))
        q(1) = a(1)+t*(b(1)-a(1))
        q(2) = a(2)+t*(b(2)-a(2))
        =>:
            geometry::main::distance_sq(p,q) = (t-s)^2*geometry::main::distance_sq(a,b)
    have dx R = b(1)-a(1)
    have dy R = b(2)-a(2)
    q(1)-p(1) = (a(1)+t*(b(1)-a(1)))-(a(1)+s*(b(1)-a(1))) = (t-s)*(b(1)-a(1)) = (t-s)*dx
    q(2)-p(2) = (a(2)+t*(b(2)-a(2)))-(a(2)+s*(b(2)-a(2))) = (t-s)*(b(2)-a(2)) = (t-s)*dy
    (q(1)-p(1))^2 = ((t-s)*dx)^2 = (t-s)^2*dx^2
    (q(2)-p(2))^2 = ((t-s)*dy)^2 = (t-s)^2*dy^2
    release thm geometry::main::distance_sq_coordinate_formula(p,q)
    release thm geometry::main::distance_sq_coordinate_formula(a,b)
    geometry::main::distance_sq(a,b) = (b(1)-a(1))^2+(b(2)-a(2))^2 = dx^2+dy^2
    geometry::main::distance_sq(p,q) = (q(1)-p(1))^2+(q(2)-p(2))^2 = (t-s)^2*dx^2+(t-s)^2*dy^2 = (t-s)^2*(dx^2+dy^2) = (t-s)^2*geometry::main::distance_sq(a,b)

prop is_midpoint(m, a, b cart(R, R)):
    m(1) = (a(1) + b(1)) / 2
    m(2) = (a(2) + b(2)) / 2

thm book02_proposition_05:
    ? forall a,b,c,d,p,q,r,s,cd_c,cd_d,cb_c,cb_d cart(R,R), rectangle_area,difference_area,half_area R+:
        $is_midpoint(c,a,b)
        $is_on_segment(d,a,b)
        d != a
        d != b
        d != c
        $area::has_parallelogram_area(p,q,r,s,rectangle_area)
        $geometry::main::is_right_angle(s,p,q)
        geometry::main::distance_sq(p,q) = geometry::main::distance_sq(a,d)
        geometry::main::distance_sq(p,s) = geometry::main::distance_sq(d,b)
        $geometry::main::is_square(c,d,cd_c,cd_d)
        $area::has_parallelogram_area(c,d,cd_c,cd_d,difference_area)
        $geometry::main::is_square(c,b,cb_c,cb_d)
        $area::has_parallelogram_area(c,b,cb_c,cb_d,half_area)
        =>:
            rectangle_area+difference_area = half_area
    by def $is_on_segment(d,a,b)
    by def $is_midpoint(c,a,b)
    release thm strict_segment_cut_has_interior_parameter(a,b,d)
    obtain t from exist k R+ st {k < 1, d(1) = (1-k)*a(1)+k*b(1), d(2) = (1-k)*a(2)+k*b(2)}
    0 < t
    release thm interior_affine_cut_lengths_ratio(a,b,d,t)
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have whole R+ = sqrt(geometry::main::distance_sq(a,b))
    have first_length R+ = sqrt(geometry::main::distance_sq(a,d))
    have second_length R+ = sqrt(geometry::main::distance_sq(d,b))
    whole^2 = sqrt(geometry::main::distance_sq(a,b))^2 = geometry::main::distance_sq(a,b)
    first_length^2 = sqrt(geometry::main::distance_sq(a,d))^2 = geometry::main::distance_sq(a,d)
    second_length^2 = sqrt(geometry::main::distance_sq(d,b))^2 = geometry::main::distance_sq(d,b)
    first_length = sqrt(geometry::main::distance_sq(a,d)) = t*sqrt(geometry::main::distance_sq(a,b)) = t*whole
    second_length = sqrt(geometry::main::distance_sq(d,b)) = (1-t)*sqrt(geometry::main::distance_sq(a,b)) = (1-t)*whole
    geometry::main::distance_sq(p,q) = first_length^2
    geometry::main::distance_sq(p,s) = second_length^2
    release thm rectangle_area_is_side_product(p,q,r,s,first_length,second_length,rectangle_area)
    have squared R+ = geometry::main::distance_sq(a,b)
    rectangle_area = first_length*second_length = (t*whole)*((1-t)*whole) = (t*(1-t))*whole^2 = (t*(1-t))*squared
    c(1) = (a(1)+b(1))/2 = a(1)+(1/2)*(b(1)-a(1))
    d(1) = (1-t)*a(1)+t*b(1) = a(1)+t*(b(1)-a(1))
    b(1) = a(1)+1*(b(1)-a(1))
    c(2) = (a(2)+b(2))/2 = a(2)+(1/2)*(b(2)-a(2))
    d(2) = (1-t)*a(2)+t*b(2) = a(2)+t*(b(2)-a(2))
    b(2) = a(2)+1*(b(2)-a(2))
    release thm affine_pair_squared_distance(a,b,c,d,1/2,t)
    release thm affine_pair_squared_distance(a,b,c,b,1/2,1)
    release thm square_area_is_squared_side(c,d,cd_c,cd_d,difference_area)
    release thm square_area_is_squared_side(c,b,cb_c,cb_d,half_area)
    difference_area = geometry::main::distance_sq(c,d) = (t-1/2)^2*geometry::main::distance_sq(a,b) = (t-1/2)^2*squared
    half_area = geometry::main::distance_sq(c,b) = (1-1/2)^2*geometry::main::distance_sq(a,b) = (1/4)*squared
    rectangle_area+difference_area = (t*(1-t))*squared+(t-1/2)^2*squared = (t*(1-t)+(t-1/2)^2)*squared = (1/4)*squared = half_area

thm book02_proposition_05_constructed_figures:
    ? forall a,b,c,d cart(R,R):
        $is_midpoint(c,a,b)
        $is_on_segment(d,a,b)
        d != a
        d != b
        d != c
        =>:
            exist p,q,r,s,cd_c,cd_d,cb_c,cb_d cart(R,R), rectangle_area,difference_area,half_area R+ st {$area::has_parallelogram_area(p,q,r,s,rectangle_area), $geometry::main::is_right_angle(s,p,q), geometry::main::distance_sq(p,q) = geometry::main::distance_sq(a,d), geometry::main::distance_sq(p,s) = geometry::main::distance_sq(d,b), $geometry::main::is_square(c,d,cd_c,cd_d), $area::has_parallelogram_area(c,d,cd_c,cd_d,difference_area), $geometry::main::is_square(c,b,cb_c,cb_d), $area::has_parallelogram_area(c,b,cb_c,cb_d,half_area), rectangle_area+difference_area = half_area}
    by def $is_on_segment(d,a,b)
    by def $is_midpoint(c,a,b)
    release thm strict_segment_cut_has_interior_parameter(a,b,d)
    obtain t from exist k R+ st {k < 1, d(1) = (1-k)*a(1)+k*b(1), d(2) = (1-k)*a(2)+k*b(2)}
    0 < t
    release thm interior_affine_cut_lengths_ratio(a,b,d,t)
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have whole R+ = sqrt(geometry::main::distance_sq(a,b))
    have first_length R+ = sqrt(geometry::main::distance_sq(a,d))
    have second_length R+ = sqrt(geometry::main::distance_sq(d,b))
    whole^2 = sqrt(geometry::main::distance_sq(a,b))^2 = geometry::main::distance_sq(a,b)
    first_length^2 = sqrt(geometry::main::distance_sq(a,d))^2 = geometry::main::distance_sq(a,d)
    second_length^2 = sqrt(geometry::main::distance_sq(d,b))^2 = geometry::main::distance_sq(d,b)
    c != d
    by contra:
        ? c != b
        c = b
        a(1) = 2*((a(1)+b(1))/2)-b(1) = 2*c(1)-b(1) = 2*b(1)-b(1) = b(1)
        a(2) = 2*((a(2)+b(2))/2)-b(2) = 2*c(2)-b(2) = 2*b(2)-b(2) = b(2)
        a = (a(1),a(2)) = (b(1),b(2)) = b
        impossible a != b
    release thm actual_rectangle_from_positive_lengths(first_length,second_length)
    obtain p,q,r,s from exist out_a,out_b,out_c,out_d cart(R,R) st {$area::has_parallelogram_area(out_a,out_b,out_c,out_d,first_length*second_length), $geometry::main::is_right_angle(out_d,out_a,out_b), geometry::main::distance_sq(out_a,out_b) = first_length^2, geometry::main::distance_sq(out_a,out_d) = second_length^2}
    release thm proposition_46(c,d)
    obtain cd_c,cd_d from exist third,fourth cart(R,R) st {$geometry::main::is_square(c,d,third,fourth), $area::is_proper_parallelogram(c,d,third,fourth)}
    release thm proper_square_area_exists(c,d,cd_c,cd_d)
    obtain difference_area from exist value R+ st {$area::has_parallelogram_area(c,d,cd_c,cd_d,value)}
    release thm proposition_46(c,b)
    obtain cb_c,cb_d from exist third,fourth cart(R,R) st {$geometry::main::is_square(c,b,third,fourth), $area::is_proper_parallelogram(c,b,third,fourth)}
    release thm proper_square_area_exists(c,b,cb_c,cb_d)
    obtain half_area from exist value R+ st {$area::has_parallelogram_area(c,b,cb_c,cb_d,value)}
    have rectangle_area R+ = first_length*second_length
    $area::has_parallelogram_area(p,q,r,s,rectangle_area)
    geometry::main::distance_sq(p,q) = first_length^2 = geometry::main::distance_sq(a,d)
    geometry::main::distance_sq(p,s) = second_length^2 = geometry::main::distance_sq(d,b)
    release thm book02_proposition_05(a,b,c,d,p,q,r,s,cd_c,cd_d,cb_c,cb_d,rectangle_area,difference_area,half_area)
    witness exist out_p,out_q,out_r,out_s,out_cd_c,out_cd_d,out_cb_c,out_cb_d cart(R,R), out_rectangle_area,out_difference_area,out_half_area R+ st {$area::has_parallelogram_area(out_p,out_q,out_r,out_s,out_rectangle_area), $geometry::main::is_right_angle(out_s,out_p,out_q), geometry::main::distance_sq(out_p,out_q) = geometry::main::distance_sq(a,d), geometry::main::distance_sq(out_p,out_s) = geometry::main::distance_sq(d,b), $geometry::main::is_square(c,d,out_cd_c,out_cd_d), $area::has_parallelogram_area(c,d,out_cd_c,out_cd_d,out_difference_area), $geometry::main::is_square(c,b,out_cb_c,out_cb_d), $area::has_parallelogram_area(c,b,out_cb_c,out_cb_d,out_half_area), out_rectangle_area+out_difference_area = out_half_area} from p,q,r,s,cd_c,cd_d,cb_c,cb_d,rectangle_area,difference_area,half_area

