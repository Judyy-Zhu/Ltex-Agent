thm book02_proposition_04:
    ? forall a,b,c,p,q,r,s,ab_c,ab_d,ac_c,ac_d,cb_c,cb_d cart(R,R), rectangle_area,whole_area,left_area,right_area R+:
        $is_on_segment(c,a,b)
        c != a
        c != b
        $area::has_parallelogram_area(p,q,r,s,rectangle_area)
        $geometry::main::is_right_angle(s,p,q)
        geometry::main::distance_sq(p,q) = geometry::main::distance_sq(a,c)
        geometry::main::distance_sq(p,s) = geometry::main::distance_sq(c,b)
        $geometry::main::is_square(a,b,ab_c,ab_d)
        $area::has_parallelogram_area(a,b,ab_c,ab_d,whole_area)
        $geometry::main::is_square(a,c,ac_c,ac_d)
        $area::has_parallelogram_area(a,c,ac_c,ac_d,left_area)
        $geometry::main::is_square(c,b,cb_c,cb_d)
        $area::has_parallelogram_area(c,b,cb_c,cb_d,right_area)
        =>:
            whole_area = left_area+right_area+2*rectangle_area
    by def $is_on_segment(c,a,b)
    release thm strict_segment_cut_has_interior_parameter(a,b,c)
    obtain t from exist k R+ st {k < 1, c(1) = (1-k)*a(1)+k*b(1), c(2) = (1-k)*a(2)+k*b(2)}
    0 < t
    release thm interior_affine_cut_lengths_add(a,b,c,t)
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have whole R+ = sqrt(geometry::main::distance_sq(a,b))
    have left_piece R+ = sqrt(geometry::main::distance_sq(a,c))
    have right_piece R+ = sqrt(geometry::main::distance_sq(c,b))
    whole^2 = sqrt(geometry::main::distance_sq(a,b))^2 = geometry::main::distance_sq(a,b)
    left_piece^2 = sqrt(geometry::main::distance_sq(a,c))^2 = geometry::main::distance_sq(a,c)
    right_piece^2 = sqrt(geometry::main::distance_sq(c,b))^2 = geometry::main::distance_sq(c,b)
    geometry::main::distance_sq(p,q) = left_piece^2
    geometry::main::distance_sq(p,s) = right_piece^2
    release thm rectangle_area_is_side_product(p,q,r,s,left_piece,right_piece,rectangle_area)
    release thm square_area_is_squared_side(a,b,ab_c,ab_d,whole_area)
    release thm square_area_is_squared_side(a,c,ac_c,ac_d,left_area)
    release thm square_area_is_squared_side(c,b,cb_c,cb_d,right_area)
    whole_area = geometry::main::distance_sq(a,b) = whole^2
    left_area = geometry::main::distance_sq(a,c) = left_piece^2
    right_area = geometry::main::distance_sq(c,b) = right_piece^2
    left_piece+right_piece = sqrt(geometry::main::distance_sq(a,c))+sqrt(geometry::main::distance_sq(c,b)) = sqrt(geometry::main::distance_sq(a,b)) = whole
    whole = left_piece+right_piece
    whole_area = whole^2 = (left_piece+right_piece)^2 = left_piece^2+right_piece^2+2*(left_piece*right_piece) = left_area+right_area+2*rectangle_area

thm three_squares_on_strict_cut:
    ? forall a,b,c cart(R,R):
        $is_on_segment(c,a,b)
        c != a
        c != b
        =>:
            exist ab_c,ab_d,cb_c,cb_d,ac_c,ac_d cart(R,R), first,second,opposite R+ st {$geometry::main::is_square(a,b,ab_c,ab_d), $area::has_parallelogram_area(a,b,ab_c,ab_d,first), $geometry::main::is_square(c,b,cb_c,cb_d), $area::has_parallelogram_area(c,b,cb_c,cb_d,second), $geometry::main::is_square(a,c,ac_c,ac_d), $area::has_parallelogram_area(a,c,ac_c,ac_d,opposite)}
    by def $is_on_segment(c,a,b)
    a != c
    release thm proposition_46(a,b)
    obtain ab_c,ab_d from exist u,v cart(R,R) st {$geometry::main::is_square(a,b,u,v), $area::is_proper_parallelogram(a,b,u,v)}
    release thm proper_square_area_exists(a,b,ab_c,ab_d)
    obtain first from exist value R+ st {$area::has_parallelogram_area(a,b,ab_c,ab_d,value)}
    release thm proposition_46(c,b)
    obtain cb_c,cb_d from exist u,v cart(R,R) st {$geometry::main::is_square(c,b,u,v), $area::is_proper_parallelogram(c,b,u,v)}
    release thm proper_square_area_exists(c,b,cb_c,cb_d)
    obtain second from exist value R+ st {$area::has_parallelogram_area(c,b,cb_c,cb_d,value)}
    release thm proposition_46(a,c)
    obtain ac_c,ac_d from exist u,v cart(R,R) st {$geometry::main::is_square(a,c,u,v), $area::is_proper_parallelogram(a,c,u,v)}
    release thm proper_square_area_exists(a,c,ac_c,ac_d)
    obtain opposite from exist value R+ st {$area::has_parallelogram_area(a,c,ac_c,ac_d,value)}
    witness exist out_ab_c,out_ab_d,out_cb_c,out_cb_d,out_ac_c,out_ac_d cart(R,R), out_first,out_second,out_opposite R+ st {$geometry::main::is_square(a,b,out_ab_c,out_ab_d), $area::has_parallelogram_area(a,b,out_ab_c,out_ab_d,out_first), $geometry::main::is_square(c,b,out_cb_c,out_cb_d), $area::has_parallelogram_area(c,b,out_cb_c,out_cb_d,out_second), $geometry::main::is_square(a,c,out_ac_c,out_ac_d), $area::has_parallelogram_area(a,c,out_ac_c,out_ac_d,out_opposite)} from ab_c,ab_d,cb_c,cb_d,ac_c,ac_d,first,second,opposite

thm book02_proposition_04_constructed_figures:
    ? forall a,b,c cart(R,R):
        $is_on_segment(c,a,b)
        c != a
        c != b
        =>:
            exist p,q,r,s,ab_c,ab_d,ac_c,ac_d,cb_c,cb_d cart(R,R), rectangle_area,whole_area,left_area,right_area R+ st {$area::has_parallelogram_area(p,q,r,s,rectangle_area), $geometry::main::is_right_angle(s,p,q), geometry::main::distance_sq(p,q) = geometry::main::distance_sq(a,c), geometry::main::distance_sq(p,s) = geometry::main::distance_sq(c,b), $geometry::main::is_square(a,b,ab_c,ab_d), $area::has_parallelogram_area(a,b,ab_c,ab_d,whole_area), $geometry::main::is_square(a,c,ac_c,ac_d), $area::has_parallelogram_area(a,c,ac_c,ac_d,left_area), $geometry::main::is_square(c,b,cb_c,cb_d), $area::has_parallelogram_area(c,b,cb_c,cb_d,right_area), whole_area = left_area+right_area+2*rectangle_area}
    by def $is_on_segment(c,a,b)
    release thm strict_segment_cut_has_interior_parameter(a,b,c)
    obtain t from exist k R+ st {k < 1, c(1) = (1-k)*a(1)+k*b(1), c(2) = (1-k)*a(2)+k*b(2)}
    0 < t
    release thm interior_affine_cut_lengths_add(a,b,c,t)
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have whole R+ = sqrt(geometry::main::distance_sq(a,b))
    have left_piece R+ = sqrt(geometry::main::distance_sq(a,c))
    have right_piece R+ = sqrt(geometry::main::distance_sq(c,b))
    whole^2 = sqrt(geometry::main::distance_sq(a,b))^2 = geometry::main::distance_sq(a,b)
    left_piece^2 = sqrt(geometry::main::distance_sq(a,c))^2 = geometry::main::distance_sq(a,c)
    right_piece^2 = sqrt(geometry::main::distance_sq(c,b))^2 = geometry::main::distance_sq(c,b)
    release thm actual_rectangle_from_positive_lengths(left_piece,right_piece)
    obtain p,q,r,s from exist out_a,out_b,out_c,out_d cart(R,R) st {$area::has_parallelogram_area(out_a,out_b,out_c,out_d,left_piece*right_piece), $geometry::main::is_right_angle(out_d,out_a,out_b), geometry::main::distance_sq(out_a,out_b) = left_piece^2, geometry::main::distance_sq(out_a,out_d) = right_piece^2}
    release thm three_squares_on_strict_cut(a,b,c)
    obtain ab_c,ab_d,cb_c,cb_d,ac_c,ac_d,whole_area,right_area,left_area from exist ab_c,ab_d,cb_c,cb_d,ac_c,ac_d cart(R,R), first,second,opposite R+ st {$geometry::main::is_square(a,b,ab_c,ab_d), $area::has_parallelogram_area(a,b,ab_c,ab_d,first), $geometry::main::is_square(c,b,cb_c,cb_d), $area::has_parallelogram_area(c,b,cb_c,cb_d,second), $geometry::main::is_square(a,c,ac_c,ac_d), $area::has_parallelogram_area(a,c,ac_c,ac_d,opposite)}
    have rectangle_area R+ = left_piece*right_piece
    $area::has_parallelogram_area(p,q,r,s,rectangle_area)
    geometry::main::distance_sq(p,q) = left_piece^2 = geometry::main::distance_sq(a,c)
    geometry::main::distance_sq(p,s) = right_piece^2 = geometry::main::distance_sq(c,b)
    release thm book02_proposition_04(a,b,c,p,q,r,s,ab_c,ab_d,ac_c,ac_d,cb_c,cb_d,rectangle_area,whole_area,left_area,right_area)
    witness exist out_p,out_q,out_r,out_s,out_ab_c,out_ab_d,out_ac_c,out_ac_d,out_cb_c,out_cb_d cart(R,R), out_rectangle_area,out_whole_area,out_left_area,out_right_area R+ st {$area::has_parallelogram_area(out_p,out_q,out_r,out_s,out_rectangle_area), $geometry::main::is_right_angle(out_s,out_p,out_q), geometry::main::distance_sq(out_p,out_q) = geometry::main::distance_sq(a,c), geometry::main::distance_sq(out_p,out_s) = geometry::main::distance_sq(c,b), $geometry::main::is_square(a,b,out_ab_c,out_ab_d), $area::has_parallelogram_area(a,b,out_ab_c,out_ab_d,out_whole_area), $geometry::main::is_square(a,c,out_ac_c,out_ac_d), $area::has_parallelogram_area(a,c,out_ac_c,out_ac_d,out_left_area), $geometry::main::is_square(c,b,out_cb_c,out_cb_d), $area::has_parallelogram_area(c,b,out_cb_c,out_cb_d,out_right_area), out_whole_area = out_left_area+out_right_area+2*out_rectangle_area} from p,q,r,s,ab_c,ab_d,ac_c,ac_d,cb_c,cb_d,rectangle_area,whole_area,left_area,right_area

