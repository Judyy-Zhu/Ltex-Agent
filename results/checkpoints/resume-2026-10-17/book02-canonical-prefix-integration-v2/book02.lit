thm orthogonal_projection_to_line:
    ? forall a,b,c cart(R,R):
        a != c
        =>:
            exist d cart(R,R), t R st {d(1) = a(1)+t*(c(1)-a(1)), d(2) = a(2)+t*(c(2)-a(2)), t*geometry::main::distance_sq(a,c) = geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,c)), geometry::main::dot(geometry::main::vec(d,b),geometry::main::vec(a,c)) = 0}
    release thm geometry::main::distance_sq_positive_of_ne(a,c)
    release thm geometry::main::distance_sq_coordinate_formula(a,c)
    release thm geometry::main::perpendicular_dot_expand(a,b,a,c)
    have squared R+ = geometry::main::distance_sq(a,c)
    squared != 0
    have projection R = geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,c))
    have t R = projection/squared
    t*squared = (projection/squared)*squared = projection
    t*geometry::main::distance_sq(a,c) = t*squared = projection = geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,c))
    have d cart(R,R) = (a(1)+t*(c(1)-a(1)),a(2)+t*(c(2)-a(2)))
    d(1) = a(1)+t*(c(1)-a(1))
    d(2) = a(2)+t*(c(2)-a(2))
    b(1)-d(1) = b(1)-(a(1)+t*(c(1)-a(1))) = b(1)-a(1)-t*(c(1)-a(1))
    b(2)-d(2) = b(2)-(a(2)+t*(c(2)-a(2))) = b(2)-a(2)-t*(c(2)-a(2))
    release thm geometry::main::perpendicular_dot_expand(d,b,a,c)
    geometry::main::dot(geometry::main::vec(d,b),geometry::main::vec(a,c)) = (b(1)-d(1))*(c(1)-a(1))+(b(2)-d(2))*(c(2)-a(2)) = (b(1)-a(1)-t*(c(1)-a(1)))*(c(1)-a(1))+(b(2)-a(2)-t*(c(2)-a(2)))*(c(2)-a(2)) = ((b(1)-a(1))*(c(1)-a(1))+(b(2)-a(2))*(c(2)-a(2)))-t*((c(1)-a(1))^2+(c(2)-a(2))^2) = projection-t*squared = 0
    witness exist foot cart(R,R), parameter R st {foot(1) = a(1)+parameter*(c(1)-a(1)), foot(2) = a(2)+parameter*(c(2)-a(2)), parameter*geometry::main::distance_sq(a,c) = geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,c)), geometry::main::dot(geometry::main::vec(foot,b),geometry::main::vec(a,c)) = 0} from d,t

thm negative_projection_length_product:
    ? forall a,b,c,d cart(R,R), t R:
        a != c
        t < 0
        d(1) = a(1)+t*(c(1)-a(1))
        d(2) = a(2)+t*(c(2)-a(2))
        t*geometry::main::distance_sq(a,c) = geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,c))
        =>:
            geometry::main::distance_sq(a,d) > 0
            sqrt(geometry::main::distance_sq(a,c))*sqrt(geometry::main::distance_sq(a,d)) = -geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,c))
            geometry::main::distance_sq(b,c) = geometry::main::distance_sq(b,a)+geometry::main::distance_sq(a,c)+2*(sqrt(geometry::main::distance_sq(a,c))*sqrt(geometry::main::distance_sq(a,d))) = geometry::main::distance_sq(b,a)+geometry::main::distance_sq(a,c)+2*sqrt(geometry::main::distance_sq(a,c))*sqrt(geometry::main::distance_sq(a,d))
    release thm geometry::main::distance_sq_positive_of_ne(a,c)
    a(1) = a(1)+0*(c(1)-a(1))
    a(2) = a(2)+0*(c(2)-a(2))
    release thm affine_pair_squared_distance(a,c,a,d,0,t)
    have squared R+ = geometry::main::distance_sq(a,c)
    have magnitude R+ = -t
    t != 0
    t^2 > 0
    t^2*squared > 0
    geometry::main::distance_sq(a,d) = (t-0)^2*geometry::main::distance_sq(a,c) = t^2*squared > 0
    geometry::main::distance_sq(a,d) = t^2*squared = (-t)^2*squared = magnitude^2*squared
    sqrt(geometry::main::distance_sq(a,d)) = sqrt(magnitude^2*squared) = sqrt(magnitude^2)*sqrt(squared) = |magnitude|*sqrt(squared) = magnitude*sqrt(squared)
    sqrt(geometry::main::distance_sq(a,c))*sqrt(geometry::main::distance_sq(a,d)) = sqrt(squared)*(magnitude*sqrt(squared)) = magnitude*sqrt(squared)^2 = magnitude*squared = (-t)*squared = -(t*squared) = -(t*geometry::main::distance_sq(a,c)) = -geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,c))
    have rectangle_product R+ = sqrt(geometry::main::distance_sq(a,c))*sqrt(geometry::main::distance_sq(a,d))
    have inner R = geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,c))
    rectangle_product = sqrt(geometry::main::distance_sq(a,c))*sqrt(geometry::main::distance_sq(a,d)) = -geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,c)) = -inner
    inner = -(-inner) = -rectangle_product
    have side_sum R = geometry::main::distance_sq(b,a)+geometry::main::distance_sq(a,c)
    release thm geometry::main::cosine_law(b,a,c)
    geometry::main::distance_sq(b,c) = geometry::main::distance_sq(b,a)+geometry::main::distance_sq(a,c)-2*geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,c)) = side_sum-2*inner = side_sum-2*(-rectangle_product) = side_sum+2*rectangle_product
    side_sum+2*rectangle_product = (geometry::main::distance_sq(b,a)+geometry::main::distance_sq(a,c))+2*rectangle_product = (geometry::main::distance_sq(b,a)+geometry::main::distance_sq(a,c))+2*(sqrt(geometry::main::distance_sq(a,c))*sqrt(geometry::main::distance_sq(a,d))) = geometry::main::distance_sq(b,a)+geometry::main::distance_sq(a,c)+2*sqrt(geometry::main::distance_sq(a,c))*sqrt(geometry::main::distance_sq(a,d))

thm negative_affine_point_is_external:
    ? forall a,c,d cart(R,R), t R:
        a != c
        t < 0
        d(1) = a(1)+t*(c(1)-a(1))
        d(2) = a(2)+t*(c(2)-a(2))
        =>:
            d != a
            d != c
            $is_on_segment(a,d,c)
    t != 0
    1-t > 1-0 = 1 > 0
    have divisor R+ = 1-t
    divisor != 0
    by contra:
        ? d != a
        d = a
        t*(c(1)-a(1)) = d(1)-a(1) = a(1)-a(1) = 0
        c(1)-a(1) = (t*(c(1)-a(1)))/t = 0/t = 0
        c(1) = (c(1)-a(1))+a(1) = 0+a(1) = a(1)
        t*(c(2)-a(2)) = d(2)-a(2) = a(2)-a(2) = 0
        c(2)-a(2) = (t*(c(2)-a(2)))/t = 0/t = 0
        c(2) = (c(2)-a(2))+a(2) = 0+a(2) = a(2)
        c = (c(1),c(2)) = (a(1),a(2)) = a
        impossible a != c
    by contra:
        ? d != c
        d = c
        divisor*(c(1)-a(1)) = (1-t)*(c(1)-a(1)) = c(1)-(a(1)+t*(c(1)-a(1))) = c(1)-d(1) = c(1)-c(1) = 0
        c(1)-a(1) = (divisor*(c(1)-a(1)))/divisor = 0/divisor = 0
        c(1) = (c(1)-a(1))+a(1) = 0+a(1) = a(1)
        divisor*(c(2)-a(2)) = (1-t)*(c(2)-a(2)) = c(2)-(a(2)+t*(c(2)-a(2))) = c(2)-d(2) = c(2)-c(2) = 0
        c(2)-a(2) = (divisor*(c(2)-a(2)))/divisor = 0/divisor = 0
        c(2) = (c(2)-a(2))+a(2) = 0+a(2) = a(2)
        c = (c(1),c(2)) = (a(1),a(2)) = a
        impossible a != c
    -t > 0
    have k R+ = (-t)/divisor
    1-k = 1-((-t)/divisor) = (divisor+t)/divisor = ((1-t)+t)/divisor = 1/divisor > 0
    k < 1
    0 <= k
    k <= 1
    (1-k)*d(1)+k*c(1) = (1/divisor)*(a(1)+t*(c(1)-a(1)))+((-t)/divisor)*c(1) = ((1-t)*a(1))/divisor = (divisor*a(1))/divisor = a(1)
    (1-k)*d(2)+k*c(2) = (1/divisor)*(a(2)+t*(c(2)-a(2)))+((-t)/divisor)*c(2) = ((1-t)*a(2))/divisor = (divisor*a(2))/divisor = a(2)
    witness exist parameter R st {0 <= parameter, parameter <= 1, a(1) = (1-parameter)*d(1)+parameter*c(1), a(2) = (1-parameter)*d(2)+parameter*c(2)} from k
    by def $is_on_segment(a,d,c)

thm projection_foot_has_right_angle:
    ? forall a,b,c,d cart(R,R), t R:
        $geometry::main::is_triangle(a,b,c)
        d != c
        d(1) = a(1)+t*(c(1)-a(1))
        d(2) = a(2)+t*(c(2)-a(2))
        geometry::main::dot(geometry::main::vec(d,b),geometry::main::vec(a,c)) = 0
        =>:
            $geometry::main::is_right_angle(b,d,c)
    release thm geometry_lemmas::triangle_vertices_distinct(a,b,c)
    by def $geometry::main::is_triangle(a,b,c)
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c)) != 0
    by contra:
        ? b != d
        b = d
        b(1)-a(1) = d(1)-a(1) = (a(1)+t*(c(1)-a(1)))-a(1) = t*(c(1)-a(1))
        b(2)-a(2) = d(2)-a(2) = (a(2)+t*(c(2)-a(2)))-a(2) = t*(c(2)-a(2))
        release thm geometry::main::collinear_det_expand(a,b,c)
        geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c)) = (b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1)) = (t*(c(1)-a(1)))*(c(2)-a(2))-(t*(c(2)-a(2)))*(c(1)-a(1)) = 0
        impossible geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c)) != 0
    c != d
    c(1)-d(1) = c(1)-(a(1)+t*(c(1)-a(1))) = (1-t)*(c(1)-a(1))
    c(2)-d(2) = c(2)-(a(2)+t*(c(2)-a(2))) = (1-t)*(c(2)-a(2))
    release thm geometry::main::perpendicular_dot_expand(d,b,a,c)
    release thm geometry::main::perpendicular_dot_expand(d,b,d,c)
    geometry::main::dot(geometry::main::vec(d,b),geometry::main::vec(d,c)) = (b(1)-d(1))*(c(1)-d(1))+(b(2)-d(2))*(c(2)-d(2)) = (b(1)-d(1))*((1-t)*(c(1)-a(1)))+(b(2)-d(2))*((1-t)*(c(2)-a(2))) = (1-t)*((b(1)-d(1))*(c(1)-a(1))+(b(2)-d(2))*(c(2)-a(2))) = (1-t)*geometry::main::dot(geometry::main::vec(d,b),geometry::main::vec(a,c)) = (1-t)*0 = 0
    by def $geometry::main::is_right_angle(b,d,c)

thm three_squares_on_triangle:
    ? forall a,b,c cart(R,R):
        $geometry::main::is_triangle(a,b,c)
        =>:
            exist ab_c,ab_d,bc_c,bc_d,ac_c,ac_d cart(R,R), first,second,opposite R+ st {$geometry::main::is_square(a,b,ab_c,ab_d), $area::has_parallelogram_area(a,b,ab_c,ab_d,first), $geometry::main::is_square(b,c,bc_c,bc_d), $area::has_parallelogram_area(b,c,bc_c,bc_d,second), $geometry::main::is_square(a,c,ac_c,ac_d), $area::has_parallelogram_area(a,c,ac_c,ac_d,opposite)}
    release thm geometry_lemmas::triangle_vertices_distinct(a,b,c)
    release thm proposition_46(a,b)
    obtain ab_c,ab_d from exist u,v cart(R,R) st {$geometry::main::is_square(a,b,u,v), $area::is_proper_parallelogram(a,b,u,v)}
    release thm proper_square_area_exists(a,b,ab_c,ab_d)
    obtain first from exist value R+ st {$area::has_parallelogram_area(a,b,ab_c,ab_d,value)}
    release thm proposition_46(b,c)
    obtain bc_c,bc_d from exist u,v cart(R,R) st {$geometry::main::is_square(b,c,u,v), $area::is_proper_parallelogram(b,c,u,v)}
    release thm proper_square_area_exists(b,c,bc_c,bc_d)
    obtain second from exist value R+ st {$area::has_parallelogram_area(b,c,bc_c,bc_d,value)}
    release thm proposition_46(a,c)
    obtain ac_c,ac_d from exist u,v cart(R,R) st {$geometry::main::is_square(a,c,u,v), $area::is_proper_parallelogram(a,c,u,v)}
    release thm proper_square_area_exists(a,c,ac_c,ac_d)
    obtain opposite from exist value R+ st {$area::has_parallelogram_area(a,c,ac_c,ac_d,value)}
    witness exist out_ab_c,out_ab_d,out_bc_c,out_bc_d,out_ac_c,out_ac_d cart(R,R), out_first,out_second,out_opposite R+ st {$geometry::main::is_square(a,b,out_ab_c,out_ab_d), $area::has_parallelogram_area(a,b,out_ab_c,out_ab_d,out_first), $geometry::main::is_square(b,c,out_bc_c,out_bc_d), $area::has_parallelogram_area(b,c,out_bc_c,out_bc_d,out_second), $geometry::main::is_square(a,c,out_ac_c,out_ac_d), $area::has_parallelogram_area(a,c,out_ac_c,out_ac_d,out_opposite)} from ab_c,ab_d,bc_c,bc_d,ac_c,ac_d,first,second,opposite

thm obtuse_dot_triangle_constructed_figures:
    ? forall a,b,c cart(R,R):
        $geometry::main::is_triangle(a,b,c)
        geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,c)) < 0
        =>:
            exist d,p,q,r,s,ab_c,ab_d,bc_c,bc_d,ac_c,ac_d cart(R,R), first_area,opposite_area,second_area,rectangle_area R+ st {$is_on_segment(a,d,c), d != a, $geometry::main::is_right_angle(b,d,c), geometry::main::dot(geometry::main::vec(d,b),geometry::main::vec(a,c)) = 0, $area::has_parallelogram_area(p,q,r,s,rectangle_area), $geometry::main::is_right_angle(s,p,q), geometry::main::distance_sq(p,q) = geometry::main::distance_sq(a,c), geometry::main::distance_sq(p,s) = geometry::main::distance_sq(a,d), $geometry::main::is_square(a,b,ab_c,ab_d), $area::has_parallelogram_area(a,b,ab_c,ab_d,first_area), $geometry::main::is_square(b,c,bc_c,bc_d), $area::has_parallelogram_area(b,c,bc_c,bc_d,opposite_area), $geometry::main::is_square(a,c,ac_c,ac_d), $area::has_parallelogram_area(a,c,ac_c,ac_d,second_area), opposite_area = first_area+second_area+2*rectangle_area, opposite_area > first_area+second_area}
    release thm geometry_lemmas::triangle_vertices_distinct(a,b,c)
    release thm orthogonal_projection_to_line(a,b,c)
    obtain d,t from exist foot cart(R,R), parameter R st {foot(1) = a(1)+parameter*(c(1)-a(1)), foot(2) = a(2)+parameter*(c(2)-a(2)), parameter*geometry::main::distance_sq(a,c) = geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,c)), geometry::main::dot(geometry::main::vec(foot,b),geometry::main::vec(a,c)) = 0}
    release thm geometry::main::distance_sq_positive_of_ne(a,c)
    by contra:
        ? t < 0
        t >= 0
        t*geometry::main::distance_sq(a,c) >= 0
        t*geometry::main::distance_sq(a,c) = geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(a,c)) < 0
        impossible t*geometry::main::distance_sq(a,c) >= 0
    release thm negative_affine_point_is_external(a,c,d,t)
    release thm projection_foot_has_right_angle(a,b,c,d,t)
    release thm negative_projection_length_product(a,b,c,d,t)
    have width R+ = sqrt(geometry::main::distance_sq(a,c))
    have height R+ = sqrt(geometry::main::distance_sq(a,d))
    width^2 = sqrt(geometry::main::distance_sq(a,c))^2 = geometry::main::distance_sq(a,c)
    height^2 = sqrt(geometry::main::distance_sq(a,d))^2 = geometry::main::distance_sq(a,d)
    release thm actual_rectangle_from_positive_lengths(width,height)
    obtain p,q,r,s from exist out_a,out_b,out_c,out_d cart(R,R) st {$area::has_parallelogram_area(out_a,out_b,out_c,out_d,width*height), $geometry::main::is_right_angle(out_d,out_a,out_b), geometry::main::distance_sq(out_a,out_b) = width^2, geometry::main::distance_sq(out_a,out_d) = height^2}
    have rectangle_area R+ = width*height
    $area::has_parallelogram_area(p,q,r,s,rectangle_area)
    geometry::main::distance_sq(p,q) = width^2 = geometry::main::distance_sq(a,c)
    geometry::main::distance_sq(p,s) = height^2 = geometry::main::distance_sq(a,d)
    release thm three_squares_on_triangle(a,b,c)
    obtain ab_c,ab_d,bc_c,bc_d,ac_c,ac_d,first_area,opposite_area,second_area from exist out_ab_c,out_ab_d,out_bc_c,out_bc_d,out_ac_c,out_ac_d cart(R,R), out_first,out_second,out_opposite R+ st {$geometry::main::is_square(a,b,out_ab_c,out_ab_d), $area::has_parallelogram_area(a,b,out_ab_c,out_ab_d,out_first), $geometry::main::is_square(b,c,out_bc_c,out_bc_d), $area::has_parallelogram_area(b,c,out_bc_c,out_bc_d,out_second), $geometry::main::is_square(a,c,out_ac_c,out_ac_d), $area::has_parallelogram_area(a,c,out_ac_c,out_ac_d,out_opposite)}
    release thm square_area_is_squared_side(a,b,ab_c,ab_d,first_area)
    release thm square_area_is_squared_side(b,c,bc_c,bc_d,opposite_area)
    release thm square_area_is_squared_side(a,c,ac_c,ac_d,second_area)
    release thm geometry::main::distance_sq_symmetric(a,b)
    first_area = geometry::main::distance_sq(a,b) = geometry::main::distance_sq(b,a)
    opposite_area = geometry::main::distance_sq(b,c) = geometry::main::distance_sq(b,a)+geometry::main::distance_sq(a,c)+2*sqrt(geometry::main::distance_sq(a,c))*sqrt(geometry::main::distance_sq(a,d)) = first_area+second_area+2*width*height = first_area+second_area+2*(width*height) = first_area+second_area+2*rectangle_area
    2*rectangle_area > 0
    opposite_area > first_area+second_area
    witness exist out_d,out_p,out_q,out_r,out_s,out_ab_c,out_ab_d,out_bc_c,out_bc_d,out_ac_c,out_ac_d cart(R,R), out_first_area,out_opposite_area,out_second_area,out_rectangle_area R+ st {$is_on_segment(a,out_d,c), out_d != a, $geometry::main::is_right_angle(b,out_d,c), geometry::main::dot(geometry::main::vec(out_d,b),geometry::main::vec(a,c)) = 0, $area::has_parallelogram_area(out_p,out_q,out_r,out_s,out_rectangle_area), $geometry::main::is_right_angle(out_s,out_p,out_q), geometry::main::distance_sq(out_p,out_q) = geometry::main::distance_sq(a,c), geometry::main::distance_sq(out_p,out_s) = geometry::main::distance_sq(a,out_d), $geometry::main::is_square(a,b,out_ab_c,out_ab_d), $area::has_parallelogram_area(a,b,out_ab_c,out_ab_d,out_first_area), $geometry::main::is_square(b,c,out_bc_c,out_bc_d), $area::has_parallelogram_area(b,c,out_bc_c,out_bc_d,out_opposite_area), $geometry::main::is_square(a,c,out_ac_c,out_ac_d), $area::has_parallelogram_area(a,c,out_ac_c,out_ac_d,out_second_area), out_opposite_area = out_first_area+out_second_area+2*out_rectangle_area, out_opposite_area > out_first_area+out_second_area} from d,p,q,r,s,ab_c,ab_d,bc_c,bc_d,ac_c,ac_d,first_area,opposite_area,second_area,rectangle_area

thm absolute_value_lower_bound:
    ? forall n R:
        -|n| <= n
    by cases:
        ? -|n| <= n
        case n >= 0:
            |n| = n
            -n = 0 - n <= 0 - 0 = 0 <= n
            -|n| = -n <= n
        case n < 0:
            |n| = -n
            -|n| = -(-n) = n


thm unit_ratio_from_square_bound:
    ? forall n R, den R+:
        n^2 <= den
        =>:
            (-1) <= n / sqrt(den)
            n / sqrt(den) <= 1
    have d R+ = sqrt(den)
    sqrt(n^2) = |n|
    |n| = sqrt(n^2) <= sqrt(den) = d
    release thm absolute_value_lower_bound(n)
    by cases:
        ? n <= |n|
        case n >= 0:
            |n| = n
            n = |n|
        case n < 0:
            |n| = -n
            -n = 0 - n >= 0 - 0 = 0
            n <= 0 <= -n = |n|
    -d <= -|n| <= n
    n <= |n| <= d
    n / d >= (-d) / d = -1
    n / d <= d / d = 1
    n / sqrt(den) = n / d
    (-1) <= n / sqrt(den)
    n / sqrt(den) <= 1



thm angle_cosine_bounded:
    ? forall p, q, r cart(R, R):
        p != q
        r != q
        =>:
            (-1) <= angles::angle_cosine(p, q, r)
            angles::angle_cosine(p, q, r) <= 1
    release thm angles::angle_den_positive(p, q, r)
    have n R = geometry::main::angle_cos_num(p, q, r)
    have den R+ = geometry::main::angle_cos_den(p, q, r)
    have delta R = geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, r))
    release thm geometry::main::dot_squared_plus_det_squared(geometry::main::vec(q, p), geometry::main::vec(q, r))
    release thm geometry::main::vec_dot_self_is_distance(q, p)
    release thm geometry::main::vec_dot_self_is_distance(q, r)
    n = geometry::main::angle_cos_num(p, q, r) = geometry::main::dot(geometry::main::vec(q, p), geometry::main::vec(q, r))
    geometry::main::dot(geometry::main::vec(q, p), geometry::main::vec(q, r))^2 = n^2
    geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, r))^2 = delta^2
    den = geometry::main::angle_cos_den(p, q, r) = geometry::main::distance_sq(q, p) * geometry::main::distance_sq(q, r) = geometry::main::dot(geometry::main::vec(q, p), geometry::main::vec(q, p)) * geometry::main::dot(geometry::main::vec(q, r), geometry::main::vec(q, r)) = geometry::main::dot(geometry::main::vec(q, p), geometry::main::vec(q, r))^2 + geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, r))^2 = n^2 + delta^2
    delta^2 >= 0
    n^2 <= n^2 + delta^2 = den
    release thm unit_ratio_from_square_bound(n, den)
    angles::angle_cosine(p, q, r) = geometry::main::angle_cos_num(p, q, r) / sqrt(geometry::main::angle_cos_den(p, q, r)) = n / sqrt(den)
    (-1) <= angles::angle_cosine(p, q, r)
    angles::angle_cosine(p, q, r) <= 1



have fn ray_angle(p, q, r cart(R, R): p != q, r != q) R = arccos(angles::angle_cosine(p, q, r))



thm ray_angle_range:
    ? forall p, q, r cart(R, R):
        p != q
        r != q
        =>:
            0 <= ray_angle(p, q, r)
            ray_angle(p, q, r) <= pi
    ray_angle(p, q, r) = arccos(angles::angle_cosine(p, q, r))
    0 <= arccos(angles::angle_cosine(p, q, r)) <= pi



thm obtuse_measure_implies_negative_dot:
    ? forall p,q,r cart(R,R):
        p != q
        r != q
        ray_angle(p,q,r) > pi/2
        =>:
            geometry::main::dot(geometry::main::vec(q,p),geometry::main::vec(q,r)) < 0
    release thm ray_angle_range(p,q,r)
    release thm angle_cosine_bounded(p,q,r)
    release thm angles::angle_den_positive(p,q,r)
    have theta R = ray_angle(p,q,r)
    theta > pi/2
    theta <= pi
    0 <= pi/2
    cos(theta) < cos(pi/2) = 0
    angles::angle_cosine(p,q,r) = cos(arccos(angles::angle_cosine(p,q,r))) = cos(ray_angle(p,q,r)) = cos(theta) < 0
    have den R+ = sqrt(geometry::main::angle_cos_den(p,q,r))
    have numerator R = geometry::main::angle_cos_num(p,q,r)
    numerator/den = geometry::main::angle_cos_num(p,q,r)/sqrt(geometry::main::angle_cos_den(p,q,r)) = angles::angle_cosine(p,q,r) < 0
    (numerator/den)*den < 0*den = 0
    geometry::main::dot(geometry::main::vec(q,p),geometry::main::vec(q,r)) = geometry::main::angle_cos_num(p,q,r) = numerator = (numerator/den)*den < 0

