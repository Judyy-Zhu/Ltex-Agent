thm extend_by_cut_piece:
    ? forall a,b,c,d cart(R,R):
        $is_on_segment(c,a,b)
        c != a
        c != b
        d(1) = 2*b(1)-c(1)
        d(2) = 2*b(2)-c(2)
        =>:
            a != d
            b != d
            $is_on_segment(b,a,d)
            sqrt(geometry::main::distance_sq(a,d)) = sqrt(geometry::main::distance_sq(a,b))+sqrt(geometry::main::distance_sq(c,b))
    by def $is_on_segment(c,a,b)
    release thm strict_segment_cut_has_interior_parameter(a,b,c)
    obtain t from exist k R+ st {k < 1, c(1) = (1-k)*a(1)+k*b(1), c(2) = (1-k)*a(2)+k*b(2)}
    0 < t
    release thm interior_affine_cut_lengths_ratio(a,b,c,t)
    2-t > 2-1 = 1
    have extension R+ = 2-t
    extension > 1
    c(1) = (1-t)*a(1)+t*b(1) = a(1)+t*(b(1)-a(1))
    d(1) = 2*b(1)-c(1) = 2*b(1)-(a(1)+t*(b(1)-a(1))) = a(1)+(2-t)*(b(1)-a(1)) = a(1)+extension*(b(1)-a(1))
    c(2) = (1-t)*a(2)+t*b(2) = a(2)+t*(b(2)-a(2))
    d(2) = 2*b(2)-c(2) = 2*b(2)-(a(2)+t*(b(2)-a(2))) = a(2)+(2-t)*(b(2)-a(2)) = a(2)+extension*(b(2)-a(2))
    release thm exterior_affine_lengths_ratio(a,b,d,extension)
    by contra:
        ? a != d
        a = d
        release thm geometry::main::distance_sq_coordinate_formula(a,d)
        geometry::main::distance_sq(a,d) = (d(1)-a(1))^2+(d(2)-a(2))^2 = (d(1)-d(1))^2+(d(2)-d(2))^2 = 0
        impossible geometry::main::distance_sq(a,d) > 0
    release thm geometry::main::distance_sq_symmetric(b,d)
    geometry::main::distance_sq(b,d) = geometry::main::distance_sq(d,b) > 0
    by contra:
        ? b != d
        b = d
        release thm geometry::main::distance_sq_coordinate_formula(b,d)
        geometry::main::distance_sq(b,d) = (d(1)-b(1))^2+(d(2)-b(2))^2 = (d(1)-d(1))^2+(d(2)-d(2))^2 = 0
        impossible geometry::main::distance_sq(b,d) > 0
    extension > 0
    extension != 0
    1/extension > 0/extension = 0
    1/extension < extension/extension = 1
    have k R+ = 1/extension
    k < 1
    (1-k)*a(1)+k*d(1) = (1-k)*a(1)+k*(a(1)+extension*(b(1)-a(1))) = a(1)+(k*extension)*(b(1)-a(1)) = a(1)+((1/extension)*extension)*(b(1)-a(1)) = b(1)
    (1-k)*a(2)+k*d(2) = (1-k)*a(2)+k*(a(2)+extension*(b(2)-a(2))) = a(2)+(k*extension)*(b(2)-a(2)) = a(2)+((1/extension)*extension)*(b(2)-a(2)) = b(2)
    witness exist value R st {0 <= value, value <= 1, b(1) = (1-value)*a(1)+value*d(1), b(2) = (1-value)*a(2)+value*d(2)} from k
    by def $is_on_segment(b,a,d)
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have whole R+ = sqrt(geometry::main::distance_sq(a,b))
    sqrt(geometry::main::distance_sq(a,d)) = extension*sqrt(geometry::main::distance_sq(a,b)) = extension*whole
    sqrt(geometry::main::distance_sq(c,b)) = (1-t)*sqrt(geometry::main::distance_sq(a,b)) = (1-t)*whole
    sqrt(geometry::main::distance_sq(a,d)) = extension*whole = (2-t)*whole = whole+(1-t)*whole = sqrt(geometry::main::distance_sq(a,b))+sqrt(geometry::main::distance_sq(c,b))

thm book02_proposition_08:
    ? forall a,b,c,d,p,q,r,s,ac_c,ac_d,ad_c,ad_d cart(R,R), rectangle_area,left_area,combined_area R+:
        $is_on_segment(c,a,b)
        c != a
        c != b
        d(1) = 2*b(1)-c(1)
        d(2) = 2*b(2)-c(2)
        $area::has_parallelogram_area(p,q,r,s,rectangle_area)
        $geometry::main::is_right_angle(s,p,q)
        geometry::main::distance_sq(p,q) = geometry::main::distance_sq(a,b)
        geometry::main::distance_sq(p,s) = geometry::main::distance_sq(c,b)
        $geometry::main::is_square(a,c,ac_c,ac_d)
        $area::has_parallelogram_area(a,c,ac_c,ac_d,left_area)
        $geometry::main::is_square(a,d,ad_c,ad_d)
        $area::has_parallelogram_area(a,d,ad_c,ad_d,combined_area)
        =>:
            4*rectangle_area+left_area = combined_area
    by def $is_on_segment(c,a,b)
    release thm strict_segment_cut_has_interior_parameter(a,b,c)
    obtain t from exist k R+ st {k < 1, c(1) = (1-k)*a(1)+k*b(1), c(2) = (1-k)*a(2)+k*b(2)}
    0 < t
    release thm interior_affine_cut_lengths_ratio(a,b,c,t)
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have whole R+ = sqrt(geometry::main::distance_sq(a,b))
    have right_piece R+ = sqrt(geometry::main::distance_sq(c,b))
    have squared R+ = geometry::main::distance_sq(a,b)
    whole^2 = sqrt(geometry::main::distance_sq(a,b))^2 = squared
    right_piece^2 = sqrt(geometry::main::distance_sq(c,b))^2 = geometry::main::distance_sq(c,b)
    right_piece = sqrt(geometry::main::distance_sq(c,b)) = (1-t)*sqrt(geometry::main::distance_sq(a,b)) = (1-t)*whole
    geometry::main::distance_sq(p,q) = squared = whole^2
    geometry::main::distance_sq(p,s) = right_piece^2
    release thm rectangle_area_is_side_product(p,q,r,s,whole,right_piece,rectangle_area)
    rectangle_area = whole*right_piece = whole*((1-t)*whole) = (1-t)*whole^2 = (1-t)*squared
    c(1) = (1-t)*a(1)+t*b(1) = a(1)+t*(b(1)-a(1))
    d(1) = 2*b(1)-c(1) = 2*b(1)-(a(1)+t*(b(1)-a(1))) = a(1)+(2-t)*(b(1)-a(1))
    a(1) = a(1)+0*(b(1)-a(1))
    c(2) = (1-t)*a(2)+t*b(2) = a(2)+t*(b(2)-a(2))
    d(2) = 2*b(2)-c(2) = 2*b(2)-(a(2)+t*(b(2)-a(2))) = a(2)+(2-t)*(b(2)-a(2))
    a(2) = a(2)+0*(b(2)-a(2))
    release thm affine_pair_squared_distance(a,b,a,c,0,t)
    release thm affine_pair_squared_distance(a,b,a,d,0,2-t)
    release thm square_area_is_squared_side(a,c,ac_c,ac_d,left_area)
    release thm square_area_is_squared_side(a,d,ad_c,ad_d,combined_area)
    left_area = geometry::main::distance_sq(a,c) = (t-0)^2*geometry::main::distance_sq(a,b) = t^2*squared
    combined_area = geometry::main::distance_sq(a,d) = ((2-t)-0)^2*geometry::main::distance_sq(a,b) = (2-t)^2*squared
    4*rectangle_area+left_area = 4*((1-t)*squared)+t^2*squared = (4*(1-t)+t^2)*squared = (2-t)^2*squared = combined_area

thm book02_proposition_08_constructed_figures:
    ? forall a,b,c cart(R,R):
        $is_on_segment(c,a,b)
        c != a
        c != b
        =>:
            exist d,p,q,r,s,ac_c,ac_d,ad_c,ad_d cart(R,R), rectangle_area,left_area,combined_area R+ st {d(1) = 2*b(1)-c(1), d(2) = 2*b(2)-c(2), $area::has_parallelogram_area(p,q,r,s,rectangle_area), $geometry::main::is_right_angle(s,p,q), geometry::main::distance_sq(p,q) = geometry::main::distance_sq(a,b), geometry::main::distance_sq(p,s) = geometry::main::distance_sq(c,b), $geometry::main::is_square(a,c,ac_c,ac_d), $area::has_parallelogram_area(a,c,ac_c,ac_d,left_area), $geometry::main::is_square(a,d,ad_c,ad_d), $area::has_parallelogram_area(a,d,ad_c,ad_d,combined_area), $is_on_segment(b,a,d), sqrt(geometry::main::distance_sq(a,d)) = sqrt(geometry::main::distance_sq(a,b))+sqrt(geometry::main::distance_sq(c,b)), 4*rectangle_area+left_area = combined_area}
    by def $is_on_segment(c,a,b)
    release thm strict_segment_cut_has_interior_parameter(a,b,c)
    obtain t from exist k R+ st {k < 1, c(1) = (1-k)*a(1)+k*b(1), c(2) = (1-k)*a(2)+k*b(2)}
    0 < t
    release thm interior_affine_cut_lengths_ratio(a,b,c,t)
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have whole R+ = sqrt(geometry::main::distance_sq(a,b))
    have right_piece R+ = sqrt(geometry::main::distance_sq(c,b))
    have squared R+ = geometry::main::distance_sq(a,b)
    whole^2 = sqrt(geometry::main::distance_sq(a,b))^2 = squared
    right_piece^2 = sqrt(geometry::main::distance_sq(c,b))^2 = geometry::main::distance_sq(c,b)
    right_piece = sqrt(geometry::main::distance_sq(c,b)) = (1-t)*sqrt(geometry::main::distance_sq(a,b)) = (1-t)*whole
    have d cart(R,R) = (2*b(1)-c(1),2*b(2)-c(2))
    d(1) = 2*b(1)-c(1)
    d(2) = 2*b(2)-c(2)
    release thm extend_by_cut_piece(a,b,c,d)
    a != c
    release thm actual_rectangle_from_positive_lengths(whole,right_piece)
    obtain p,q,r,s from exist out_a,out_b,out_c,out_d cart(R,R) st {$area::has_parallelogram_area(out_a,out_b,out_c,out_d,whole*right_piece), $geometry::main::is_right_angle(out_d,out_a,out_b), geometry::main::distance_sq(out_a,out_b) = whole^2, geometry::main::distance_sq(out_a,out_d) = right_piece^2}
    release thm proposition_46(a,c)
    obtain ac_c,ac_d from exist third,fourth cart(R,R) st {$geometry::main::is_square(a,c,third,fourth), $area::is_proper_parallelogram(a,c,third,fourth)}
    release thm proper_square_area_exists(a,c,ac_c,ac_d)
    obtain left_area from exist value R+ st {$area::has_parallelogram_area(a,c,ac_c,ac_d,value)}
    release thm proposition_46(a,d)
    obtain ad_c,ad_d from exist third,fourth cart(R,R) st {$geometry::main::is_square(a,d,third,fourth), $area::is_proper_parallelogram(a,d,third,fourth)}
    release thm proper_square_area_exists(a,d,ad_c,ad_d)
    obtain combined_area from exist value R+ st {$area::has_parallelogram_area(a,d,ad_c,ad_d,value)}
    have rectangle_area R+ = whole*right_piece
    $area::has_parallelogram_area(p,q,r,s,rectangle_area)
    geometry::main::distance_sq(p,q) = whole^2 = squared = geometry::main::distance_sq(a,b)
    geometry::main::distance_sq(p,s) = right_piece^2 = geometry::main::distance_sq(c,b)
    release thm book02_proposition_08(a,b,c,d,p,q,r,s,ac_c,ac_d,ad_c,ad_d,rectangle_area,left_area,combined_area)
    witness exist out_d,out_p,out_q,out_r,out_s,out_ac_c,out_ac_d,out_ad_c,out_ad_d cart(R,R), out_rectangle_area,out_left_area,out_combined_area R+ st {out_d(1) = 2*b(1)-c(1), out_d(2) = 2*b(2)-c(2), $area::has_parallelogram_area(out_p,out_q,out_r,out_s,out_rectangle_area), $geometry::main::is_right_angle(out_s,out_p,out_q), geometry::main::distance_sq(out_p,out_q) = geometry::main::distance_sq(a,b), geometry::main::distance_sq(out_p,out_s) = geometry::main::distance_sq(c,b), $geometry::main::is_square(a,c,out_ac_c,out_ac_d), $area::has_parallelogram_area(a,c,out_ac_c,out_ac_d,out_left_area), $geometry::main::is_square(a,out_d,out_ad_c,out_ad_d), $area::has_parallelogram_area(a,out_d,out_ad_c,out_ad_d,out_combined_area), $is_on_segment(b,a,out_d), sqrt(geometry::main::distance_sq(a,out_d)) = sqrt(geometry::main::distance_sq(a,b))+sqrt(geometry::main::distance_sq(c,b)), 4*out_rectangle_area+out_left_area = out_combined_area} from d,p,q,r,s,ac_c,ac_d,ad_c,ad_d,rectangle_area,left_area,combined_area

sketch:
    have a cart(R,R) = (0,0)
    a(1) = 0
    a(2) = 0
    have b cart(R,R) = (5,0)
    b(1) = 5
    b(2) = 0
    have c cart(R,R) = (2,0)
    c(1) = 2
    c(2) = 0
    by contra:
        ? a != b
        a = b
        0 = a(1) = b(1) = 5
        impossible 0 != 5
    by contra:
        ? c != a
        c = a
        2 = c(1) = a(1) = 0
        impossible 2 != 0
    by contra:
        ? c != b
        c = b
        2 = c(1) = b(1) = 5
        impossible 2 != 5
    witness exist k R st {0 <= k, k <= 1, c(1) = (1-k)*a(1)+k*b(1), c(2) = (1-k)*a(2)+k*b(2)} from 2/5
    by def $is_on_segment(c,a,b)
    release thm book02_proposition_08_constructed_figures(a,b,c)

sketch:
    have a cart(R,R) = (5,0)
    a(1) = 5
    a(2) = 0
    have b cart(R,R) = (0,0)
    b(1) = 0
    b(2) = 0
    have c cart(R,R) = (2,0)
    c(1) = 2
    c(2) = 0
    by contra:
        ? a != b
        a = b
        5 = a(1) = b(1) = 0
        impossible 5 != 0
    by contra:
        ? c != a
        c = a
        2 = c(1) = a(1) = 5
        impossible 2 != 5
    by contra:
        ? c != b
        c = b
        2 = c(1) = b(1) = 0
        impossible 2 != 0
    witness exist k R st {0 <= k, k <= 1, c(1) = (1-k)*a(1)+k*b(1), c(2) = (1-k)*a(2)+k*b(2)} from 3/5
    by def $is_on_segment(c,a,b)
    release thm book02_proposition_08_constructed_figures(a,b,c)

thm midpoint_four_square_area_identity:
    ? forall a,b,c,d,ad_c,ad_d,db_c,db_d,ac_c,ac_d,cd_c,cd_d cart(R,R), t R, first_area,second_area,half_area,offset_area R+:
        a != b
        $is_midpoint(c,a,b)
        d(1) = a(1)+t*(b(1)-a(1))
        d(2) = a(2)+t*(b(2)-a(2))
        $geometry::main::is_square(a,d,ad_c,ad_d)
        $area::has_parallelogram_area(a,d,ad_c,ad_d,first_area)
        $geometry::main::is_square(d,b,db_c,db_d)
        $area::has_parallelogram_area(d,b,db_c,db_d,second_area)
        $geometry::main::is_square(a,c,ac_c,ac_d)
        $area::has_parallelogram_area(a,c,ac_c,ac_d,half_area)
        $geometry::main::is_square(c,d,cd_c,cd_d)
        $area::has_parallelogram_area(c,d,cd_c,cd_d,offset_area)
        =>:
            first_area+second_area = 2*(half_area+offset_area)
    by def $is_midpoint(c,a,b)
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have squared R+ = geometry::main::distance_sq(a,b)
    a(1) = a(1)+0*(b(1)-a(1))
    b(1) = a(1)+1*(b(1)-a(1))
    c(1) = (a(1)+b(1))/2 = a(1)+(1/2)*(b(1)-a(1))
    a(2) = a(2)+0*(b(2)-a(2))
    b(2) = a(2)+1*(b(2)-a(2))
    c(2) = (a(2)+b(2))/2 = a(2)+(1/2)*(b(2)-a(2))
    release thm affine_pair_squared_distance(a,b,a,d,0,t)
    release thm square_area_is_squared_side(a,d,ad_c,ad_d,first_area)
    first_area = geometry::main::distance_sq(a,d) = (t-0)^2*geometry::main::distance_sq(a,b) = (t^2)*squared
    release thm affine_pair_squared_distance(a,b,d,b,t,1)
    release thm square_area_is_squared_side(d,b,db_c,db_d,second_area)
    second_area = geometry::main::distance_sq(d,b) = (1-t)^2*geometry::main::distance_sq(a,b) = ((1-t)^2)*squared
    release thm affine_pair_squared_distance(a,b,a,c,0,1/2)
    release thm square_area_is_squared_side(a,c,ac_c,ac_d,half_area)
    half_area = geometry::main::distance_sq(a,c) = (1/2-0)^2*geometry::main::distance_sq(a,b) = (1/4)*squared
    release thm affine_pair_squared_distance(a,b,c,d,1/2,t)
    release thm square_area_is_squared_side(c,d,cd_c,cd_d,offset_area)
    offset_area = geometry::main::distance_sq(c,d) = (t-1/2)^2*geometry::main::distance_sq(a,b) = ((t-1/2)^2)*squared
    first_area+second_area = t^2*squared+(1-t)^2*squared = (t^2+(1-t)^2)*squared = 2*((1/4)*squared+(t-1/2)^2*squared) = 2*(half_area+offset_area)

thm book02_proposition_09:
    ? forall a,b,c,d,ad_c,ad_d,db_c,db_d,ac_c,ac_d,cd_c,cd_d cart(R,R), first_area,second_area,half_area,offset_area R+:
        $is_midpoint(c,a,b)
        $is_on_segment(d,a,b)
        d != a
        d != b
        d != c
        $geometry::main::is_square(a,d,ad_c,ad_d)
        $area::has_parallelogram_area(a,d,ad_c,ad_d,first_area)
        $geometry::main::is_square(d,b,db_c,db_d)
        $area::has_parallelogram_area(d,b,db_c,db_d,second_area)
        $geometry::main::is_square(a,c,ac_c,ac_d)
        $area::has_parallelogram_area(a,c,ac_c,ac_d,half_area)
        $geometry::main::is_square(c,d,cd_c,cd_d)
        $area::has_parallelogram_area(c,d,cd_c,cd_d,offset_area)
        =>:
            first_area+second_area = 2*(half_area+offset_area)
    by def $is_on_segment(d,a,b)
    release thm strict_segment_cut_has_interior_parameter(a,b,d)
    obtain t from exist k R+ st {k < 1, d(1) = (1-k)*a(1)+k*b(1), d(2) = (1-k)*a(2)+k*b(2)}
    d(1) = (1-t)*a(1)+t*b(1) = a(1)+t*(b(1)-a(1))
    d(2) = (1-t)*a(2)+t*b(2) = a(2)+t*(b(2)-a(2))
    release thm midpoint_four_square_area_identity(a,b,c,d,ad_c,ad_d,db_c,db_d,ac_c,ac_d,cd_c,cd_d,t,first_area,second_area,half_area,offset_area)

thm book02_proposition_10:
    ? forall a,b,c,d,ad_c,ad_d,db_c,db_d,ac_c,ac_d,cd_c,cd_d cart(R,R), first_area,second_area,half_area,offset_area R+:
        $is_midpoint(c,a,b)
        $is_on_segment(b,a,d)
        b != a
        b != d
        $geometry::main::is_square(a,d,ad_c,ad_d)
        $area::has_parallelogram_area(a,d,ad_c,ad_d,first_area)
        $geometry::main::is_square(d,b,db_c,db_d)
        $area::has_parallelogram_area(d,b,db_c,db_d,second_area)
        $geometry::main::is_square(a,c,ac_c,ac_d)
        $area::has_parallelogram_area(a,c,ac_c,ac_d,half_area)
        $geometry::main::is_square(c,d,cd_c,cd_d)
        $area::has_parallelogram_area(c,d,cd_c,cd_d,offset_area)
        =>:
            first_area+second_area = 2*(half_area+offset_area)
    by def $is_on_segment(b,a,d)
    a != b
    release thm strict_extension_has_parameter(a,b,d)
    obtain t from exist k R+ st {k > 1, d(1) = a(1)+k*(b(1)-a(1)), d(2) = a(2)+k*(b(2)-a(2))}
    release thm midpoint_four_square_area_identity(a,b,c,d,ad_c,ad_d,db_c,db_d,ac_c,ac_d,cd_c,cd_d,t,first_area,second_area,half_area,offset_area)

thm four_squares_on_midpoint_cut_edges:
    ? forall a,b,c,d cart(R,R):
        a != d
        d != b
        a != c
        c != d
        =>:
            exist ad_c,ad_d,db_c,db_d,ac_c,ac_d,cd_c,cd_d cart(R,R), first_area,second_area,half_area,offset_area R+ st {$geometry::main::is_square(a,d,ad_c,ad_d), $area::has_parallelogram_area(a,d,ad_c,ad_d,first_area), $geometry::main::is_square(d,b,db_c,db_d), $area::has_parallelogram_area(d,b,db_c,db_d,second_area), $geometry::main::is_square(a,c,ac_c,ac_d), $area::has_parallelogram_area(a,c,ac_c,ac_d,half_area), $geometry::main::is_square(c,d,cd_c,cd_d), $area::has_parallelogram_area(c,d,cd_c,cd_d,offset_area)}
    release thm proposition_46(a,d)
    obtain ad_c,ad_d from exist third,fourth cart(R,R) st {$geometry::main::is_square(a,d,third,fourth), $area::is_proper_parallelogram(a,d,third,fourth)}
    release thm proper_square_area_exists(a,d,ad_c,ad_d)
    obtain first_area from exist value R+ st {$area::has_parallelogram_area(a,d,ad_c,ad_d,value)}
    release thm proposition_46(d,b)
    obtain db_c,db_d from exist third,fourth cart(R,R) st {$geometry::main::is_square(d,b,third,fourth), $area::is_proper_parallelogram(d,b,third,fourth)}
    release thm proper_square_area_exists(d,b,db_c,db_d)
    obtain second_area from exist value R+ st {$area::has_parallelogram_area(d,b,db_c,db_d,value)}
    release thm proposition_46(a,c)
    obtain ac_c,ac_d from exist third,fourth cart(R,R) st {$geometry::main::is_square(a,c,third,fourth), $area::is_proper_parallelogram(a,c,third,fourth)}
    release thm proper_square_area_exists(a,c,ac_c,ac_d)
