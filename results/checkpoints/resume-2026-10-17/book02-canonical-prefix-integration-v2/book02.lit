        geometry::main::distance_sq(d,c) = (c(1)-d(1))^2+(c(2)-d(2))^2 = (c(1)-c(1))^2+(c(2)-c(2))^2 = 0
        impossible geometry::main::distance_sq(d,c) > 0
    0 <= t
    t <= 1
    witness exist parameter R st {0 <= parameter, parameter <= 1, d(1) = (1-parameter)*a(1)+parameter*c(1), d(2) = (1-parameter)*a(2)+parameter*c(2)} from t
    by def $is_on_segment(d,a,c)

