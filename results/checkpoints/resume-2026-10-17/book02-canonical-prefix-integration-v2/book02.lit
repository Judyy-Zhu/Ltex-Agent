thm strict_extension_has_parameter:
    ? forall a,b,d cart(R,R):
        $is_on_segment(b,a,d)
        b != a
        b != d
        =>:
            exist t R+ st {t > 1, d(1) = a(1)+t*(b(1)-a(1)), d(2) = a(2)+t*(b(2)-a(2))}
    release thm strict_segment_cut_has_interior_parameter(a,d,b)
    obtain k from exist value R+ st {value < 1, b(1) = (1-value)*a(1)+value*d(1), b(2) = (1-value)*a(2)+value*d(2)}
    k > 0
    k != 0
    1/k > k/k = 1
    have t R+ = 1/k
    t = 1/k > 1
    d(1) = ((1-k)*a(1)+k*d(1)-(1-k)*a(1))/k = (b(1)-(1-k)*a(1))/k = a(1)+(1/k)*(b(1)-a(1)) = a(1)+t*(b(1)-a(1))
    d(2) = ((1-k)*a(2)+k*d(2)-(1-k)*a(2))/k = (b(2)-(1-k)*a(2))/k = a(2)+(1/k)*(b(2)-a(2)) = a(2)+t*(b(2)-a(2))
    witness exist value R+ st {value > 1, d(1) = a(1)+value*(b(1)-a(1)), d(2) = a(2)+value*(b(2)-a(2))} from t

thm exterior_affine_lengths_ratio:
    ? forall a,b,d cart(R,R), t R+:
        a != b
        t > 1
        d(1) = a(1)+t*(b(1)-a(1))
        d(2) = a(2)+t*(b(2)-a(2))
        =>:
            geometry::main::distance_sq(a,d) > 0
            geometry::main::distance_sq(d,b) > 0
            sqrt(geometry::main::distance_sq(a,d)) = t*sqrt(geometry::main::distance_sq(a,b))
            sqrt(geometry::main::distance_sq(d,b)) = (t-1)*sqrt(geometry::main::distance_sq(a,b))
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have squared R+ = geometry::main::distance_sq(a,b)
    have extra R+ = t-1
    a(1) = a(1)+0*(b(1)-a(1))
    a(2) = a(2)+0*(b(2)-a(2))
    b(1) = a(1)+1*(b(1)-a(1))
    b(2) = a(2)+1*(b(2)-a(2))
    release thm affine_pair_squared_distance(a,b,a,d,0,t)
    release thm affine_pair_squared_distance(a,b,d,b,t,1)
    geometry::main::distance_sq(a,d) = (t-0)^2*geometry::main::distance_sq(a,b) = t^2*squared
    geometry::main::distance_sq(d,b) = (1-t)^2*geometry::main::distance_sq(a,b) = (t-1)^2*squared = extra^2*squared
    t^2 > 0
    extra^2 > 0
    t^2*squared > 0
    extra^2*squared > 0
    geometry::main::distance_sq(a,d) > 0
    geometry::main::distance_sq(d,b) > 0
    sqrt(geometry::main::distance_sq(a,d)) = sqrt(t^2*squared) = sqrt(t^2)*sqrt(squared) = |t|*sqrt(squared) = t*sqrt(squared) = t*sqrt(geometry::main::distance_sq(a,b))
    sqrt(geometry::main::distance_sq(d,b)) = sqrt(extra^2*squared) = sqrt(extra^2)*sqrt(squared) = |extra|*sqrt(squared) = extra*sqrt(squared) = (t-1)*sqrt(squared) = (t-1)*sqrt(geometry::main::distance_sq(a,b))

thm book02_proposition_06:
    ? forall a,b,c,d,p,q,r,s,cd_c,cd_d,cb_c,cb_d cart(R,R), rectangle_area,combined_area,half_area R+:
        $is_midpoint(c,a,b)
        $is_on_segment(b,a,d)
        b != a
        b != d
        $area::has_parallelogram_area(p,q,r,s,rectangle_area)
        $geometry::main::is_right_angle(s,p,q)
        geometry::main::distance_sq(p,q) = geometry::main::distance_sq(a,d)
        geometry::main::distance_sq(p,s) = geometry::main::distance_sq(d,b)
        $geometry::main::is_square(c,d,cd_c,cd_d)
        $area::has_parallelogram_area(c,d,cd_c,cd_d,combined_area)
        $geometry::main::is_square(c,b,cb_c,cb_d)
        $area::has_parallelogram_area(c,b,cb_c,cb_d,half_area)
        =>:
            rectangle_area+half_area = combined_area
    by def $is_on_segment(b,a,d)
    a != b
    by def $is_midpoint(c,a,b)
    release thm strict_extension_has_parameter(a,b,d)
    obtain t from exist k R+ st {k > 1, d(1) = a(1)+k*(b(1)-a(1)), d(2) = a(2)+k*(b(2)-a(2))}
    0 < t
    release thm exterior_affine_lengths_ratio(a,b,d,t)
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have whole R+ = sqrt(geometry::main::distance_sq(a,b))
    have first_length R+ = sqrt(geometry::main::distance_sq(a,d))
    have second_length R+ = sqrt(geometry::main::distance_sq(d,b))
    whole^2 = sqrt(geometry::main::distance_sq(a,b))^2 = geometry::main::distance_sq(a,b)
    first_length^2 = sqrt(geometry::main::distance_sq(a,d))^2 = geometry::main::distance_sq(a,d)
    second_length^2 = sqrt(geometry::main::distance_sq(d,b))^2 = geometry::main::distance_sq(d,b)
    first_length = sqrt(geometry::main::distance_sq(a,d)) = t*sqrt(geometry::main::distance_sq(a,b)) = t*whole
    second_length = sqrt(geometry::main::distance_sq(d,b)) = (t-1)*sqrt(geometry::main::distance_sq(a,b)) = (t-1)*whole
    geometry::main::distance_sq(p,q) = first_length^2
    geometry::main::distance_sq(p,s) = second_length^2
    release thm rectangle_area_is_side_product(p,q,r,s,first_length,second_length,rectangle_area)
    have squared R+ = geometry::main::distance_sq(a,b)
    rectangle_area = first_length*second_length = (t*whole)*((t-1)*whole) = (t*(t-1))*whole^2 = (t*(t-1))*squared
    c(1) = (a(1)+b(1))/2 = a(1)+(1/2)*(b(1)-a(1))
    b(1) = a(1)+1*(b(1)-a(1))
    c(2) = (a(2)+b(2))/2 = a(2)+(1/2)*(b(2)-a(2))
    b(2) = a(2)+1*(b(2)-a(2))
    release thm affine_pair_squared_distance(a,b,c,d,1/2,t)
    release thm affine_pair_squared_distance(a,b,c,b,1/2,1)
    release thm square_area_is_squared_side(c,d,cd_c,cd_d,combined_area)
    release thm square_area_is_squared_side(c,b,cb_c,cb_d,half_area)
    combined_area = geometry::main::distance_sq(c,d) = (t-1/2)^2*geometry::main::distance_sq(a,b) = (t-1/2)^2*squared
    half_area = geometry::main::distance_sq(c,b) = (1-1/2)^2*geometry::main::distance_sq(a,b) = (1/4)*squared
    rectangle_area+half_area = (t*(t-1))*squared+(1/4)*squared = (t*(t-1)+1/4)*squared = (t-1/2)^2*squared = combined_area

thm book02_proposition_06_constructed_figures:
    ? forall a,b,c,d cart(R,R):
        $is_midpoint(c,a,b)
        $is_on_segment(b,a,d)
        b != a
        b != d
        =>:
            exist p,q,r,s,cd_c,cd_d,cb_c,cb_d cart(R,R), rectangle_area,combined_area,half_area R+ st {$area::has_parallelogram_area(p,q,r,s,rectangle_area), $geometry::main::is_right_angle(s,p,q), geometry::main::distance_sq(p,q) = geometry::main::distance_sq(a,d), geometry::main::distance_sq(p,s) = geometry::main::distance_sq(d,b), $geometry::main::is_square(c,d,cd_c,cd_d), $area::has_parallelogram_area(c,d,cd_c,cd_d,combined_area), $geometry::main::is_square(c,b,cb_c,cb_d), $area::has_parallelogram_area(c,b,cb_c,cb_d,half_area), rectangle_area+half_area = combined_area}
    by def $is_on_segment(b,a,d)
    a != b
    by def $is_midpoint(c,a,b)
    release thm strict_extension_has_parameter(a,b,d)
    obtain t from exist k R+ st {k > 1, d(1) = a(1)+k*(b(1)-a(1)), d(2) = a(2)+k*(b(2)-a(2))}
    0 < t
    release thm exterior_affine_lengths_ratio(a,b,d,t)
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    have whole R+ = sqrt(geometry::main::distance_sq(a,b))
    have first_length R+ = sqrt(geometry::main::distance_sq(a,d))
    have second_length R+ = sqrt(geometry::main::distance_sq(d,b))
    whole^2 = sqrt(geometry::main::distance_sq(a,b))^2 = geometry::main::distance_sq(a,b)
    first_length^2 = sqrt(geometry::main::distance_sq(a,d))^2 = geometry::main::distance_sq(a,d)
    second_length^2 = sqrt(geometry::main::distance_sq(d,b))^2 = geometry::main::distance_sq(d,b)
    c(1) = (a(1)+b(1))/2 = a(1)+(1/2)*(b(1)-a(1))
    c(2) = (a(2)+b(2))/2 = a(2)+(1/2)*(b(2)-a(2))
    release thm affine_pair_squared_distance(a,b,c,d,1/2,t)
    t-1/2 > 1-1/2 = 1/2 > 0
    have delta R+ = t-1/2
    delta^2 > 0
    delta^2*geometry::main::distance_sq(a,b) > 0
    geometry::main::distance_sq(c,d) = (t-1/2)^2*geometry::main::distance_sq(a,b) = delta^2*geometry::main::distance_sq(a,b) > 0
    by contra:
        ? c != d
        c = d
        release thm geometry::main::distance_sq_coordinate_formula(c,d)
        geometry::main::distance_sq(c,d) = (d(1)-c(1))^2+(d(2)-c(2))^2 = (d(1)-d(1))^2+(d(2)-d(2))^2 = 0
        impossible geometry::main::distance_sq(c,d) > 0
    by contra:
        ? c != b
        c = b
        a(1) = 2*((a(1)+b(1))/2)-b(1) = 2*c(1)-b(1) = 2*b(1)-b(1) = b(1)
        a(2) = 2*((a(2)+b(2))/2)-b(2) = 2*c(2)-b(2) = 2*b(2)-b(2) = b(2)
        a = (a(1),a(2)) = (b(1),b(2)) = b
        impossible a != b
    release thm actual_rectangle_from_positive_lengths(first_length,second_length)
    obtain p,q,r,s from exist out_a,out_b,out_c,out_d cart(R,R) st {$area::has_parallelogram_area(out_a,out_b,out_c,out_d,first_length*second_length), $geometry::main::is_right_angle(out_d,out_a,out_b), geometry::main::distance_sq(out_a,out_b) = first_length^2, geometry::main::distance_sq(out_a,out_d) = second_length^2}
    release thm proposition_46(c,d)
    obtain cd_c,cd_d from exist third,fourth cart(R,R) st {$geometry::main::is_square(c,d,third,fourth), $area::is_proper_parallelogram(c,d,third,fourth)}
    release thm proper_square_area_exists(c,d,cd_c,cd_d)
    obtain combined_area from exist value R+ st {$area::has_parallelogram_area(c,d,cd_c,cd_d,value)}
    release thm proposition_46(c,b)
    obtain cb_c,cb_d from exist third,fourth cart(R,R) st {$geometry::main::is_square(c,b,third,fourth), $area::is_proper_parallelogram(c,b,third,fourth)}
    release thm proper_square_area_exists(c,b,cb_c,cb_d)
    obtain half_area from exist value R+ st {$area::has_parallelogram_area(c,b,cb_c,cb_d,value)}
    have rectangle_area R+ = first_length*second_length
    $area::has_parallelogram_area(p,q,r,s,rectangle_area)
    geometry::main::distance_sq(p,q) = first_length^2 = geometry::main::distance_sq(a,d)
    geometry::main::distance_sq(p,s) = second_length^2 = geometry::main::distance_sq(d,b)
    release thm book02_proposition_06(a,b,c,d,p,q,r,s,cd_c,cd_d,cb_c,cb_d,rectangle_area,combined_area,half_area)
    witness exist out_p,out_q,out_r,out_s,out_cd_c,out_cd_d,out_cb_c,out_cb_d cart(R,R), out_rectangle_area,out_combined_area,out_half_area R+ st {$area::has_parallelogram_area(out_p,out_q,out_r,out_s,out_rectangle_area), $geometry::main::is_right_angle(out_s,out_p,out_q), geometry::main::distance_sq(out_p,out_q) = geometry::main::distance_sq(a,d), geometry::main::distance_sq(out_p,out_s) = geometry::main::distance_sq(d,b), $geometry::main::is_square(c,d,out_cd_c,out_cd_d), $area::has_parallelogram_area(c,d,out_cd_c,out_cd_d,out_combined_area), $geometry::main::is_square(c,b,out_cb_c,out_cb_d), $area::has_parallelogram_area(c,b,out_cb_c,out_cb_d,out_half_area), out_rectangle_area+out_half_area = out_combined_area} from p,q,r,s,cd_c,cd_d,cb_c,cb_d,rectangle_area,combined_area,half_area

