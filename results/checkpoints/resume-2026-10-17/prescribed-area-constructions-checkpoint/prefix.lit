    have q cart(R,R) = (0,0)
    have p cart(R,R) = (4,0)
    have r cart(R,R) = (-1,2)
    q(1) = 0
    q(2) = 0
    p(1) = 4
    p(2) = 0
    r(1) = -1
    r(2) = 2
    release thm geometry::main::collinear_det_expand(q,p,r)
    geometry::main::det(geometry::main::vec(q,p),geometry::main::vec(q,r)) = (p(1)-q(1))*(r(2)-q(2))-(p(2)-q(2))*(r(1)-q(1)) = (4-0)*(2-0)-(0-0)*(-1-0) = 8 != 0
    by def $geometry::main::is_triangle(q,p,r)
    release thm parallelogram_with_prescribed_area_and_angle(p,q,r,7/3)
    have other cart(R,R) = (1,2)
    other(1) = 1
    other(2) = 2
    release thm geometry::main::collinear_det_expand(q,p,other)
    geometry::main::det(geometry::main::vec(q,p),geometry::main::vec(q,other)) = (p(1)-q(1))*(other(2)-q(2))-(p(2)-q(2))*(other(1)-q(1)) = (4-0)*(2-0)-(0-0)*(1-0) = 8 != 0
    by def $geometry::main::is_triangle(q,p,other)
    release thm parallelogram_with_prescribed_area_and_angle(p,q,other,7/3)
