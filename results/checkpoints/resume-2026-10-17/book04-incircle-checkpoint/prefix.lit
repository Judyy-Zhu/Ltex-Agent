    by def $entry::is_on_segment(ab,a,b)
    release thm geometry::main::collinear_det_expand(a,ab,b)
    geometry::main::det(geometry::main::vec(a,ab),geometry::main::vec(a,b)) = (ab(1)-a(1))*(b(2)-a(2))-(ab(2)-a(2))*(b(1)-a(1)) = (1-(0))*(0-(0))-(0-(0))*(4-(0)) = 0
    geometry::main::line_through_points(a,b) = {q cart(R,R): geometry::main::det(geometry::main::vec(a,q),geometry::main::vec(a,b)) = 0}
    ab $in geometry::main::line_through_points(a,b)
    release thm geometry::main::distance_sq_coordinate_formula(center,ab)
    geometry::main::distance_sq(center,ab) = (ab(1)-center(1))^2+(ab(2)-center(2))^2 = (1-1)^2+(0-1)^2 = 1
    by def $is_on_circle(ab,center,1)
    release thm geometry::main::perpendicular_dot_expand(center,ab,a,b)
    geometry::main::dot(geometry::main::vec(center,ab),geometry::main::vec(a,b)) = (ab(1)-center(1))*(b(1)-a(1))+(ab(2)-center(2))*(b(2)-a(2)) = (1-1)*(4-(0))+(0-1)*(0-(0)) = 0
    release thm radius_perpendicular_at_line_point_gives_tangency(center,ab,a,b,1)
    witness exist t R st {0 <= t, t <= 1, bc(1) = (1-t)*b(1)+t*c(1), bc(2) = (1-t)*b(2)+t*c(2)} from 3/5
    by def $entry::is_on_segment(bc,b,c)
    release thm geometry::main::collinear_det_expand(b,bc,c)
    geometry::main::det(geometry::main::vec(b,bc),geometry::main::vec(b,c)) = (bc(1)-b(1))*(c(2)-b(2))-(bc(2)-b(2))*(c(1)-b(1)) = (8/5-(4))*(3-(0))-(9/5-(0))*(0-(4)) = 0
    geometry::main::line_through_points(b,c) = {q cart(R,R): geometry::main::det(geometry::main::vec(b,q),geometry::main::vec(b,c)) = 0}
    bc $in geometry::main::line_through_points(b,c)
    release thm geometry::main::distance_sq_coordinate_formula(center,bc)
    geometry::main::distance_sq(center,bc) = (bc(1)-center(1))^2+(bc(2)-center(2))^2 = (8/5-1)^2+(9/5-1)^2 = 1
    by def $is_on_circle(bc,center,1)
    release thm geometry::main::perpendicular_dot_expand(center,bc,b,c)
    geometry::main::dot(geometry::main::vec(center,bc),geometry::main::vec(b,c)) = (bc(1)-center(1))*(c(1)-b(1))+(bc(2)-center(2))*(c(2)-b(2)) = (8/5-1)*(0-(4))+(9/5-1)*(3-(0)) = 0
    release thm radius_perpendicular_at_line_point_gives_tangency(center,bc,b,c,1)
    witness exist t R st {0 <= t, t <= 1, ca(1) = (1-t)*c(1)+t*a(1), ca(2) = (1-t)*c(2)+t*a(2)} from 2/3
    by def $entry::is_on_segment(ca,c,a)
    release thm geometry::main::collinear_det_expand(c,ca,a)
    geometry::main::det(geometry::main::vec(c,ca),geometry::main::vec(c,a)) = (ca(1)-c(1))*(a(2)-c(2))-(ca(2)-c(2))*(a(1)-c(1)) = (0-(0))*(0-(3))-(1-(3))*(0-(0)) = 0
    geometry::main::line_through_points(c,a) = {q cart(R,R): geometry::main::det(geometry::main::vec(c,q),geometry::main::vec(c,a)) = 0}
    ca $in geometry::main::line_through_points(c,a)
    release thm geometry::main::distance_sq_coordinate_formula(center,ca)
    geometry::main::distance_sq(center,ca) = (ca(1)-center(1))^2+(ca(2)-center(2))^2 = (0-1)^2+(1-1)^2 = 1
    by def $is_on_circle(ca,center,1)
    release thm geometry::main::perpendicular_dot_expand(center,ca,c,a)
    geometry::main::dot(geometry::main::vec(center,ca),geometry::main::vec(c,a)) = (ca(1)-center(1))*(a(1)-c(1))+(ca(2)-center(2))*(a(2)-c(2)) = (0-1)*(0-(0))+(1-1)*(0-(3)) = 0
    release thm radius_perpendicular_at_line_point_gives_tangency(center,ca,c,a,1)
    witness exist first,second,third cart(R,R) st {$entry::is_on_segment(first,a,b), $entry::is_on_segment(second,b,c), $entry::is_on_segment(third,c,a), $is_tangent_line_at(first,a,b,center,1), $is_tangent_line_at(second,b,c,center,1), $is_tangent_line_at(third,c,a,center,1)} from ab,bc,ca
    by def $circle_inscribed_in_triangle(a,b,c,center,1)

prop is_collinear(p, q, r cart(R, R)):
    geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, r)) = 0

claim:
    ? forall a,b cart(R,R):
        geometry::main::distance_sq(a,b) >= 0
    release thm geometry::main::distance_sq_nonnegative(a,b)

have fn distance(a,b cart(R,R)) R = sqrt(geometry::main::distance_sq(a,b))

thm distance_nonnegative_and_square:
    ? forall a,b cart(R,R):
        distance(a,b) >= 0
        distance(a,b)*distance(a,b) = geometry::main::distance_sq(a,b)
    release thm geometry::main::distance_sq_nonnegative(a,b)
    distance(a,b) = sqrt(geometry::main::distance_sq(a,b))
    sqrt(geometry::main::distance_sq(a,b)) >= 0
    sqrt(geometry::main::distance_sq(a,b))^2 = geometry::main::distance_sq(a,b)
    distance(a,b)*distance(a,b) = sqrt(geometry::main::distance_sq(a,b))*sqrt(geometry::main::distance_sq(a,b)) = sqrt(geometry::main::distance_sq(a,b))^2 = geometry::main::distance_sq(a,b)

thm dot_neg_left:
    ? forall a, b, c, d cart(R, R):
        geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(c, d)) = (a(1) - b(1)) * (d(1) - c(1)) + (a(2) - b(2)) * (d(2) - c(2))
    geometry::main::vec(a, b) = (b(1) - a(1), b(2) - a(2))
    geometry::main::vec(b, a) = (a(1) - b(1), a(2) - b(2))
    geometry::main::vec(c, d) = (d(1) - c(1), d(2) - c(2))
    geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(c, d)) = (a(1) - b(1)) * (d(1) - c(1)) + (a(2) - b(2)) * (d(2) - c(2))
    geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(c, d)) = (b(1) - a(1)) * (d(1) - c(1)) + (b(2) - a(2)) * (d(2) - c(2))
    (a(1) - b(1)) * (d(1) - c(1)) + (a(2) - b(2)) * (d(2) - c(2)) = -((b(1) - a(1)) * (d(1) - c(1)) + (b(2) - a(2)) * (d(2) - c(2)))
    geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(c, d)) = -((b(1) - a(1)) * (d(1) - c(1)) + (b(2) - a(2)) * (d(2) - c(2)))
    -((b(1) - a(1)) * (d(1) - c(1)) + (b(2) - a(2)) * (d(2) - c(2))) = -(geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(c, d)))
    geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(c, d)) = -(geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(c, d)))

thm multiply_both_sides:
    ? forall a, b, c R:
        a = b
        =>:
            a * c = b * c

thm add_equalities:
    ? forall a, b, c, d R:
        a = b
        c = d
        =>:
            a + c = b + d

thm strict_triangle_one_side:
    ? forall a, b, c cart(R, R):
        not $is_collinear(a, b, c)
        =>:
            distance(a, b) + distance(b, c) > distance(a, c)
    release thm distance_nonnegative_and_square(a,b)
    release thm distance_nonnegative_and_square(b,c)
    release thm distance_nonnegative_and_square(a,c)
    distance(a,b) $in R
    distance(b,c) $in R
    distance(a,c) $in R
    geometry::main::distance_sq(a,b) $in R
    geometry::main::distance_sq(b,c) $in R
    geometry::main::distance_sq(a,c) $in R
    by contra:
        ? geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) != 0
        geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) = 0
        by def $is_collinear(a, b, c)
        impossible not $is_collinear(a, b, c)
    release thm geometry::main::collinear_det_expand(a, b, c)
    release thm geometry::main::perpendicular_dot_expand(a, b, b, c)
    release thm geometry::main::distance_sq_coordinate_formula(a, b)
    release thm geometry::main::distance_sq_coordinate_formula(b, c)
    release thm geometry::main::distance_sq_coordinate_formula(a, c)
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) != 0
    release thm geometry::main::vec_coordinate_formula(a, b)
    release thm geometry::main::vec_coordinate_formula(b, c)
    geometry::main::vec(a,b)(1) = b(1)-a(1)
    geometry::main::vec(a,b)(2) = b(2)-a(2)
    geometry::main::vec(b,c)(1) = c(1)-b(1)
    geometry::main::vec(b,c)(2) = c(2)-b(2)
    geometry::main::vec(a,b)(1)*geometry::main::vec(b,c)(2) = (b(1)-a(1))*(c(2)-b(2))
    geometry::main::vec(a,b)(2)*geometry::main::vec(b,c)(1) = (b(2)-a(2))*(c(1)-b(1))
    release thm geometry::main::det_coordinate_formula(geometry::main::vec(a, b), geometry::main::vec(b, c))
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(b, c)) = (b(1) - a(1)) * (c(2) - b(2)) - (b(2) - a(2)) * (c(1) - b(1))
    (b(1) - a(1)) * (c(2) - b(2)) - (b(2) - a(2)) * (c(1) - b(1)) = (b(1) - a(1)) * (c(2) - a(2)) - (b(2) - a(2)) * (c(1) - a(1))
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(b, c)) = (b(1) - a(1)) * (c(2) - a(2)) - (b(2) - a(2)) * (c(1) - a(1))
    (b(1) - a(1)) * (c(2) - a(2)) - (b(2) - a(2)) * (c(1) - a(1)) = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(b, c)) = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(b, c)) != 0
    geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(b,c)) $in R
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(b,c)) $in R
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(b, c))^2 > 0
    release thm geometry::main::dot_squared_plus_det_squared(geometry::main::vec(a, b), geometry::main::vec(b, c))
    release thm geometry::main::vec_dot_self_is_distance(a, b)
    release thm geometry::main::vec_dot_self_is_distance(b, c)
    geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c))^2 + geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(b, c))^2 = geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, b)) * geometry::main::dot(geometry::main::vec(b, c), geometry::main::vec(b, c))
    geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, b)) = geometry::main::distance_sq(a, b)
    geometry::main::dot(geometry::main::vec(b, c), geometry::main::vec(b, c)) = geometry::main::distance_sq(b, c)
    geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, b)) * geometry::main::dot(geometry::main::vec(b, c), geometry::main::vec(b, c)) = geometry::main::distance_sq(a, b) * geometry::main::distance_sq(b, c)
    geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c))^2 + geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(b, c))^2 = geometry::main::distance_sq(a, b) * geometry::main::distance_sq(b, c)
    geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c))^2 < geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c))^2 + geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(b, c))^2
    geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c))^2 < geometry::main::distance_sq(a, b) * geometry::main::distance_sq(b, c)
    release thm geometry::main::distance_sq_nonnegative(a, b)
    release thm geometry::main::distance_sq_nonnegative(b, c)
    release thm geometry::main::distance_sq_nonnegative(a, c)
    distance(a, b) >= 0
    distance(b, c) >= 0
    distance(a, c) >= 0
    distance(a, b)^2 = geometry::main::distance_sq(a, b)
    distance(b, c)^2 = geometry::main::distance_sq(b, c)
    distance(a, c)^2 = geometry::main::distance_sq(a, c)
    distance(a, b) * distance(b, c) >= 0
    (distance(a, b) * distance(b, c))^2 = distance(a, b)^2 * distance(b, c)^2
    distance(a, b)^2 * distance(b, c)^2 = geometry::main::distance_sq(a, b) * geometry::main::distance_sq(b, c)
    (distance(a, b) * distance(b, c))^2 = geometry::main::distance_sq(a, b) * geometry::main::distance_sq(b, c)
    by contra:
        ? geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c)) < distance(a, b) * distance(b, c)
        geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c)) >= distance(a, b) * distance(b, c)
        geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c))^2 >= (distance(a, b) * distance(b, c))^2
        impossible geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c))^2 < geometry::main::distance_sq(a, b) * geometry::main::distance_sq(b, c)
    release thm geometry::main::cosine_law(a, b, c)
    release thm dot_neg_left(a, b, b, c)
    geometry::main::distance_sq(a, c) = geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c) - 2 * geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c))
    geometry::main::dot(geometry::main::vec(b,a),geometry::main::vec(b,c)) = (a(1)-b(1))*(c(1)-b(1))+(a(2)-b(2))*(c(2)-b(2)) = -((b(1)-a(1))*(c(1)-b(1))+(b(2)-a(2))*(c(2)-b(2))) = -(geometry::main::dot(geometry::main::vec(a,b),geometry::main::vec(b,c)))
    release thm multiply_both_sides(geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c)), -(geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c))), -2)
    geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c)) * (-2) = -(geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c))) * (-2)
    -2 * geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c)) = geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c)) * (-2)
    -(geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c))) * (-2) = 2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c))
    -2 * geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c)) = 2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c))
    release thm add_equalities(-2 * geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c)), 2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c)), geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c), geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c))
    -2 * geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c)) + (geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c)) = 2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c)) + (geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c))
    geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c) - 2 * geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c)) = -2 * geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c)) + (geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c))
    2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c)) + (geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c)) = geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c) + 2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c))
    geometry::main::distance_sq(a, c) = geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c) - 2 * geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c)) = -2 * geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c)) + (geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c)) = 2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c)) + (geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c)) = geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c) + 2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c))
    geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c)) + geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c)) < (distance(a, b) * distance(b, c)) + (distance(a, b) * distance(b, c))
    2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c)) < 2 * (distance(a, b) * distance(b, c))
    2 * (distance(a, b) * distance(b, c)) = 2 * distance(a, b) * distance(b, c)
    2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c)) < 2 * distance(a, b) * distance(b, c)
    geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c) + 2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(b, c)) < geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c) + 2 * distance(a, b) * distance(b, c)
    geometry::main::distance_sq(a, c) < geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c) + 2 * distance(a, b) * distance(b, c)
    (distance(a, b) + distance(b, c))^2 = distance(a, b)^2 + distance(b, c)^2 + 2 * distance(a, b) * distance(b, c)
    release thm add_equalities(distance(a, b)^2, geometry::main::distance_sq(a, b), distance(b, c)^2, geometry::main::distance_sq(b, c))
    distance(a, b)^2 + distance(b, c)^2 = geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c)
    release thm add_equalities(distance(a, b)^2 + distance(b, c)^2, geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c), 2 * distance(a, b) * distance(b, c), 2 * distance(a, b) * distance(b, c))
    distance(a, b)^2 + distance(b, c)^2 + 2 * distance(a, b) * distance(b, c) = geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c) + 2 * distance(a, b) * distance(b, c)
    geometry::main::distance_sq(a, b) + geometry::main::distance_sq(b, c) + 2 * distance(a, b) * distance(b, c) = distance(a, b)^2 + distance(b, c)^2 + 2 * distance(a, b) * distance(b, c) = (distance(a, b) + distance(b, c))^2
    distance(a, c)^2 < (distance(a, b) + distance(b, c))^2
    by contra:
        ? distance(a, b) + distance(b, c) > distance(a, c)
        distance(a, b) + distance(b, c) <= distance(a, c)
        distance(a, b) + distance(b, c) >= 0
        (distance(a, b) + distance(b, c))^2 <= distance(a, c)^2
        impossible distance(a, c)^2 < (distance(a, b) + distance(b, c))^2

thm positive_weighted_triangle_interior:
    ? forall a,b,c,p cart(R,R), alpha,beta,gamma,total R+:
        total = alpha+beta+gamma
        $geometry::main::is_triangle(a,b,c)
        p(1) = (alpha*a(1)+beta*b(1)+gamma*c(1))/total
        p(2) = (alpha*a(2)+beta*b(2)+gamma*c(2))/total
        =>:
            $working::is_in_triangle_interior(p,a,b,c)
    have u R+ = beta/total
    have v R+ = gamma/total
    u+v = beta/total+gamma/total = (beta+gamma)/total
    beta+gamma < (beta+gamma)+alpha = alpha+beta+gamma = total
    (beta+gamma)/total < total/total = 1
    p(1) = (alpha*a(1)+beta*b(1)+gamma*c(1))/total = (alpha*a(1)+beta*b(1)+gamma*c(1))/total
    p(2) = (alpha*a(2)+beta*b(2)+gamma*c(2))/total = (alpha*a(2)+beta*b(2)+gamma*c(2))/total
    a(1)+u*(b(1)-a(1))+v*(c(1)-a(1)) = a(1)+(beta/total)*(b(1)-a(1))+(gamma/total)*(c(1)-a(1))
    a(1)+(beta/total)*(b(1)-a(1))+(gamma/total)*(c(1)-a(1)) = (total*a(1)+beta*(b(1)-a(1))+gamma*(c(1)-a(1)))/total
    (total*a(1)+beta*(b(1)-a(1))+gamma*(c(1)-a(1)))/total = ((alpha+beta+gamma)*a(1)+beta*(b(1)-a(1))+gamma*(c(1)-a(1)))/total = (alpha*a(1)+beta*b(1)+gamma*c(1))/total = p(1)
    a(2)+u*(b(2)-a(2))+v*(c(2)-a(2)) = a(2)+(beta/total)*(b(2)-a(2))+(gamma/total)*(c(2)-a(2))
    a(2)+(beta/total)*(b(2)-a(2))+(gamma/total)*(c(2)-a(2)) = (total*a(2)+beta*(b(2)-a(2))+gamma*(c(2)-a(2)))/total
    (total*a(2)+beta*(b(2)-a(2))+gamma*(c(2)-a(2)))/total = ((alpha+beta+gamma)*a(2)+beta*(b(2)-a(2))+gamma*(c(2)-a(2)))/total = (alpha*a(2)+beta*b(2)+gamma*c(2))/total = p(2)
    witness exist x,y R st {0 < x, 0 < y, x+y < 1, p(1) = a(1)+x*(b(1)-a(1))+y*(c(1)-a(1)), p(2) = a(2)+x*(b(2)-a(2))+y*(c(2)-a(2))} from u,v
    by def $working::is_in_triangle_interior(p,a,b,c)

# Put the first vertex at the origin, and write the other vertices (x,y), (z,w).
# alpha, beta, gamma are the lengths opposite those three vertices.
thm incenter_side_projection_identity:
    ? forall x,y,z,w R, alpha,beta,gamma,perimeter R+:
        perimeter = alpha+beta+gamma
        gamma^2 = x^2+y^2
        beta^2 = z^2+w^2
        alpha^2 = (z-x)^2+(w-y)^2
        =>:
            ((beta*x+gamma*z)/perimeter)*x+((beta*y+gamma*w)/perimeter)*y = gamma*(beta+gamma-alpha)/2
    alpha^2 = (z-x)^2+(w-y)^2 = z^2+w^2+x^2+y^2-2*(x*z+y*w)
    beta^2+gamma^2-alpha^2 = (z^2+w^2)+(x^2+y^2)-alpha^2
    (z^2+w^2)+(x^2+y^2)-alpha^2 = (z^2+w^2)+(x^2+y^2)-((z-x)^2+(w-y)^2) = 2*(x*z+y*w)
    2*(x*z+y*w) = beta^2+gamma^2-alpha^2
    2*((beta*x+gamma*z)*x+(beta*y+gamma*w)*y) = 2*beta*(x^2+y^2)+gamma*(2*(x*z+y*w))
    2*beta*(x^2+y^2)+gamma*(2*(x*z+y*w)) = 2*beta*gamma^2+gamma*(beta^2+gamma^2-alpha^2)
    2*beta*gamma^2+gamma*(beta^2+gamma^2-alpha^2) = gamma*(beta+gamma-alpha)*(alpha+beta+gamma)
    ((beta*x+gamma*z)/perimeter)*x+((beta*y+gamma*w)/perimeter)*y = ((beta*x+gamma*z)*x+(beta*y+gamma*w)*y)/perimeter
    ((beta*x+gamma*z)*x+(beta*y+gamma*w)*y)/perimeter = (2*((beta*x+gamma*z)*x+(beta*y+gamma*w)*y))/(2*perimeter)
    (2*((beta*x+gamma*z)*x+(beta*y+gamma*w)*y))/(2*perimeter) = (gamma*(beta+gamma-alpha)*(alpha+beta+gamma))/(2*perimeter) = (gamma*(beta+gamma-alpha)*perimeter)/(2*perimeter) = gamma*(beta+gamma-alpha)/2

thm orthogonal_projection_distance_identity:
    ? forall x,y,u,v,t R:
        u*x+v*y = t*(x^2+y^2)
        =>:
            ((u-t*x)^2+(v-t*y)^2)*(x^2+y^2) = (x*v-y*u)^2
    ((u-t*x)^2+(v-t*y)^2)*(x^2+y^2)-(x*v-y*u)^2 = (u*x+v*y-t*(x^2+y^2))^2
    u*x+v*y-t*(x^2+y^2) = 0
    (u*x+v*y-t*(x^2+y^2))^2 = 0
    ((u-t*x)^2+(v-t*y)^2)*(x^2+y^2) = (x*v-y*u)^2

thm incenter_side_distance_identity:
    ? forall x,y,z,w,u,v,t R, alpha,beta,gamma,perimeter R+:
        perimeter = alpha+beta+gamma
        gamma^2 = x^2+y^2
        beta^2 = z^2+w^2
        alpha^2 = (z-x)^2+(w-y)^2
        u = (beta*x+gamma*z)/perimeter
        v = (beta*y+gamma*w)/perimeter
        t = (beta+gamma-alpha)/(2*gamma)
        =>:
            (u-t*x)^2+(v-t*y)^2 = ((x*w-y*z)/perimeter)^2
    release thm incenter_side_projection_identity(x,y,z,w,alpha,beta,gamma,perimeter)
    u*x+v*y = ((beta*x+gamma*z)/perimeter)*x+((beta*y+gamma*w)/perimeter)*y = gamma*(beta+gamma-alpha)/2
    t*(x^2+y^2) = ((beta+gamma-alpha)/(2*gamma))*(x^2+y^2) = ((beta+gamma-alpha)/(2*gamma))*gamma^2 = gamma*(beta+gamma-alpha)/2
    u*x+v*y = t*(x^2+y^2)
    release thm orthogonal_projection_distance_identity(x,y,u,v,t)
    x*v-y*u = x*((beta*y+gamma*w)/perimeter)-y*((beta*x+gamma*z)/perimeter) = gamma*((x*w-y*z)/perimeter)
    (x*v-y*u)^2 = (gamma*((x*w-y*z)/perimeter))^2 = gamma^2*((x*w-y*z)/perimeter)^2
    ((u-t*x)^2+(v-t*y)^2)*gamma^2 = ((u-t*x)^2+(v-t*y)^2)*(x^2+y^2) = (x*v-y*u)^2 = gamma^2*((x*w-y*z)/perimeter)^2
    gamma^2 > 0
    (u-t*x)^2+(v-t*y)^2 = (((u-t*x)^2+(v-t*y)^2)*gamma^2)/(gamma^2) = (gamma^2*((x*w-y*z)/perimeter)^2)/(gamma^2) = ((x*w-y*z)/perimeter)^2

thm triangle_contact_parameter_interior:
    ? forall alpha,beta,gamma R+, t R:
        alpha < beta+gamma
        beta < alpha+gamma
        t = (beta+gamma-alpha)/(2*gamma)
        =>:
            0 < t
            t < 1
    0 < beta+gamma-alpha
    beta+gamma < (alpha+gamma)+gamma
    beta+gamma-alpha < ((alpha+gamma)+gamma)-alpha = 2*gamma
    2*gamma > 0
    0 < (beta+gamma-alpha)/(2*gamma)
    (beta+gamma-alpha)/(2*gamma) < (2*gamma)/(2*gamma) = 1

thm incenter_side_geometric_certificate:
    ? forall a,b,c,o,h cart(R,R), alpha,beta,gamma,perimeter R+, t R:
        a != b
        perimeter = alpha+beta+gamma
        alpha < beta+gamma
        beta < alpha+gamma
        gamma^2 = geometry::main::distance_sq(a,b)
        beta^2 = geometry::main::distance_sq(a,c)
        alpha^2 = geometry::main::distance_sq(b,c)
        o(1)-a(1) = (beta*(b(1)-a(1))+gamma*(c(1)-a(1)))/perimeter
        o(2)-a(2) = (beta*(b(2)-a(2))+gamma*(c(2)-a(2)))/perimeter
        t = (beta+gamma-alpha)/(2*gamma)
        h(1) = a(1)+t*(b(1)-a(1))
        h(2) = a(2)+t*(b(2)-a(2))
        =>:
            0 < t
            t < 1
            h $in geometry::main::line_through_points(a,b)
            geometry::main::dot(geometry::main::vec(o,h),geometry::main::vec(a,b)) = 0
            geometry::main::distance_sq(o,h) = (geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c))/perimeter)^2
    release thm triangle_contact_parameter_interior(alpha,beta,gamma,t)
    have x R = b(1)-a(1)
    have y R = b(2)-a(2)
    have z R = c(1)-a(1)
    have w R = c(2)-a(2)
    have u R = o(1)-a(1)
    have v R = o(2)-a(2)
    release thm geometry::main::distance_sq_coordinate_formula(a,b)
    release thm geometry::main::distance_sq_coordinate_formula(a,c)
    release thm geometry::main::distance_sq_coordinate_formula(b,c)
    gamma^2 = geometry::main::distance_sq(a,b) = (b(1)-a(1))^2+(b(2)-a(2))^2 = x^2+y^2
    beta^2 = geometry::main::distance_sq(a,c) = (c(1)-a(1))^2+(c(2)-a(2))^2 = z^2+w^2
    z-x = (c(1)-a(1))-(b(1)-a(1)) = c(1)-b(1)
    w-y = (c(2)-a(2))-(b(2)-a(2)) = c(2)-b(2)
    alpha^2 = geometry::main::distance_sq(b,c) = (c(1)-b(1))^2+(c(2)-b(2))^2 = (z-x)^2+(w-y)^2
    u = o(1)-a(1) = (beta*(b(1)-a(1))+gamma*(c(1)-a(1)))/perimeter = (beta*x+gamma*z)/perimeter
    v = o(2)-a(2) = (beta*(b(2)-a(2))+gamma*(c(2)-a(2)))/perimeter = (beta*y+gamma*w)/perimeter
    release thm incenter_side_projection_identity(x,y,z,w,alpha,beta,gamma,perimeter)
    release thm incenter_side_distance_identity(x,y,z,w,u,v,t,alpha,beta,gamma,perimeter)
    u*x+v*y = ((beta*x+gamma*z)/perimeter)*x+((beta*y+gamma*w)/perimeter)*y = gamma*(beta+gamma-alpha)/2
    t*(x^2+y^2) = ((beta+gamma-alpha)/(2*gamma))*gamma^2 = gamma*(beta+gamma-alpha)/2
    h(1)-o(1) = (a(1)+t*(b(1)-a(1)))-o(1) = t*(b(1)-a(1))-(o(1)-a(1)) = t*x-u
    h(2)-o(2) = (a(2)+t*(b(2)-a(2)))-o(2) = t*(b(2)-a(2))-(o(2)-a(2)) = t*y-v
    release thm geometry::main::perpendicular_dot_expand(o,h,a,b)
    geometry::main::dot(geometry::main::vec(o,h),geometry::main::vec(a,b)) = (h(1)-o(1))*(b(1)-a(1))+(h(2)-o(2))*(b(2)-a(2)) = (t*x-u)*x+(t*y-v)*y = t*(x^2+y^2)-(u*x+v*y) = 0
    release thm geometry::main::collinear_det_expand(a,h,b)
    h(1)-a(1) = t*(b(1)-a(1)) = t*x
    h(2)-a(2) = t*(b(2)-a(2)) = t*y
    geometry::main::det(geometry::main::vec(a,h),geometry::main::vec(a,b)) = (h(1)-a(1))*(b(2)-a(2))-(h(2)-a(2))*(b(1)-a(1)) = (t*x)*y-(t*y)*x = 0
    geometry::main::line_through_points(a,b) = {q cart(R,R): geometry::main::det(geometry::main::vec(a,q),geometry::main::vec(a,b)) = 0}
    h $in geometry::main::line_through_points(a,b)
    release thm geometry::main::distance_sq_coordinate_formula(o,h)
    geometry::main::distance_sq(o,h) = (h(1)-o(1))^2+(h(2)-o(2))^2 = (t*x-u)^2+(t*y-v)^2 = (u-t*x)^2+(v-t*y)^2 = ((x*w-y*z)/perimeter)^2
    release thm geometry::main::collinear_det_expand(a,b,c)
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c)) = (b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1)) = x*w-y*z
    geometry::main::distance_sq(o,h) = ((x*w-y*z)/perimeter)^2 = (geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c))/perimeter)^2

thm collinear_third:
    ? forall p, q, r cart(R, R):
        geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, r)) = 0
        =>:
            geometry::main::det(geometry::main::vec(r, p), geometry::main::vec(r, q)) = 0
    geometry::main::vec(p, q) = (q(1) - p(1), q(2) - p(2))
    geometry::main::vec(p, r) = (r(1) - p(1), r(2) - p(2))
    geometry::main::vec(r, p) = (p(1) - r(1), p(2) - r(2))
    geometry::main::vec(r, q) = (q(1) - r(1), q(2) - r(2))
    geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, r)) = (q(1) - p(1)) * (r(2) - p(2)) - (q(2) - p(2)) * (r(1) - p(1))
    geometry::main::det(geometry::main::vec(r, p), geometry::main::vec(r, q)) = (p(1) - r(1)) * (q(2) - r(2)) - (p(2) - r(2)) * (q(1) - r(1))
    (p(1) - r(1)) * (q(2) - r(2)) - (p(2) - r(2)) * (q(1) - r(1)) = (q(1) - p(1)) * (r(2) - p(2)) - (q(2) - p(2)) * (r(1) - p(1))
    geometry::main::det(geometry::main::vec(r, p), geometry::main::vec(r, q)) = 0

thm collinear_third_prop:
    ? forall p, q, r cart(R, R):
        $is_collinear(p, q, r)
        =>:
            $is_collinear(r, p, q)
    release thm collinear_third(p, q, r)

thm collinear_symmetric:
    ? forall p, q, r cart(R, R):
        geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, r)) = 0
        =>:
            geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, r)) = 0
    release thm geometry::main::collinear_det_expand(q,p,r)
    release thm geometry::main::collinear_det_expand(p,q,r)
    geometry::main::det(geometry::main::vec(q,p),geometry::main::vec(q,r)) = (p(1)-q(1))*(r(2)-q(2))-(p(2)-q(2))*(r(1)-q(1)) = -((q(1)-p(1))*(r(2)-p(2))-(q(2)-p(2))*(r(1)-p(1))) = -(geometry::main::det(geometry::main::vec(p,q),geometry::main::vec(p,r))) = 0

thm collinear_symmetric_prop:
    ? forall p, q, r cart(R, R):
        $is_collinear(p, q, r)
        =>:
            $is_collinear(q, p, r)
    release thm collinear_symmetric(p, q, r)

thm distance_symmetric:
    ? forall a,b cart(R,R):
        distance(a,b) = distance(b,a)
    release thm geometry::main::distance_sq_nonnegative(a,b)
    release thm geometry::main::distance_sq_nonnegative(b,a)
    release thm geometry::main::distance_sq_symmetric(a,b)
    distance(a,b) = sqrt(geometry::main::distance_sq(a,b)) = sqrt(geometry::main::distance_sq(b,a)) = distance(b,a)

thm triangle_inequality:
    ? forall a, b, c cart(R, R):
        not $is_collinear(a, b, c)
        =>:
            exist d_ab, d_bc, d_ac R st {d_ab >= 0, d_bc >= 0, d_ac >= 0, d_ab * d_ab = geometry::main::distance_sq(a, b), d_bc * d_bc = geometry::main::distance_sq(b, c), d_ac * d_ac = geometry::main::distance_sq(a, c), d_ab + d_bc > d_ac, d_bc + d_ac > d_ab, d_ab + d_ac > d_bc}
    release thm distance_nonnegative_and_square(a,b)
    release thm distance_nonnegative_and_square(b,c)
    release thm distance_nonnegative_and_square(a,c)
    distance(a,b) $in R
    distance(b,c) $in R
    distance(a,c) $in R
    release thm strict_triangle_one_side(a, b, c)
    by contra:
        ? not $is_collinear(a, c, b)
        $is_collinear(a, c, b)
        release thm collinear_third_prop(a, c, b)
        $is_collinear(b, a, c)
        release thm collinear_symmetric_prop(b, a, c)
        $is_collinear(a, b, c)
        impossible not $is_collinear(a, b, c)
    release thm strict_triangle_one_side(a, c, b)
    by contra:
        ? not $is_collinear(b, a, c)
        $is_collinear(b, a, c)
        release thm collinear_symmetric_prop(b, a, c)
        $is_collinear(a, b, c)
        impossible not $is_collinear(a, b, c)
    release thm strict_triangle_one_side(b, a, c)
    release thm geometry::main::distance_sq_nonnegative(a, b)
    release thm geometry::main::distance_sq_nonnegative(b, c)
    release thm geometry::main::distance_sq_nonnegative(a, c)
    distance(a, b) >= 0
    distance(b, c) >= 0
    distance(a, c) >= 0
    distance(a, b)^2 = geometry::main::distance_sq(a, b)
    distance(b, c)^2 = geometry::main::distance_sq(b, c)
    distance(a, c)^2 = geometry::main::distance_sq(a, c)
    release thm distance_symmetric(b, c)
    release thm distance_symmetric(a, b)
    distance(a,c)+distance(c,b) = distance(a,c)+distance(b,c)
    distance(b,a)+distance(a,c) = distance(a,b)+distance(a,c)
    distance(a, c) + distance(b, c) > distance(a, b)
    distance(b, c) + distance(a, c) = distance(a, c) + distance(b, c)
    distance(b, c) + distance(a, c) > distance(a, b)
    distance(a, b) + distance(a, c) > distance(b, c)
    witness exist d_ab, d_bc, d_ac R st {d_ab >= 0, d_bc >= 0, d_ac >= 0, d_ab * d_ab = geometry::main::distance_sq(a, b), d_bc * d_bc = geometry::main::distance_sq(b, c), d_ac * d_ac = geometry::main::distance_sq(a, c), d_ab + d_bc > d_ac, d_bc + d_ac > d_ab, d_ab + d_ac > d_bc} from distance(a, b), distance(b, c), distance(a, c):
        distance(a, b) * distance(a, b) = geometry::main::distance_sq(a, b)
        distance(b, c) * distance(b, c) = geometry::main::distance_sq(b, c)
        distance(a, c) * distance(a, c) = geometry::main::distance_sq(a, c)

thm proper_triangle_positive_side_lengths:
    ? forall a,b,c cart(R,R):
        $geometry::main::is_triangle(a,b,c)
        =>:
            exist alpha,beta,gamma R+ st {alpha^2 = geometry::main::distance_sq(b,c), beta^2 = geometry::main::distance_sq(a,c), gamma^2 = geometry::main::distance_sq(a,b), alpha < beta+gamma, beta < alpha+gamma, gamma < alpha+beta}
    by def $geometry::main::is_triangle(a,b,c)
    by contra:
        ? not $is_collinear(a,b,c)
        $is_collinear(a,b,c)
        by def $is_collinear(a,b,c)
        impossible geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c)) != 0
    release thm geometry_lemmas::triangle_vertices_distinct(a,b,c)
    release thm triangle_inequality(a,b,c)
    obtain ab,bc,ac from exist d_ab,d_bc,d_ac R st {d_ab >= 0, d_bc >= 0, d_ac >= 0, d_ab*d_ab = geometry::main::distance_sq(a,b), d_bc*d_bc = geometry::main::distance_sq(b,c), d_ac*d_ac = geometry::main::distance_sq(a,c), d_ab+d_bc > d_ac, d_bc+d_ac > d_ab, d_ab+d_ac > d_bc}
    release thm geometry::main::distance_sq_positive_of_ne(a,b)
    release thm geometry::main::distance_sq_positive_of_ne(b,c)
    release thm geometry::main::distance_sq_positive_of_ne(a,c)
    by contra:
        ? ab > 0
        ab <= 0
        ab = 0
        geometry::main::distance_sq(a,b) = ab*ab = 0
        impossible geometry::main::distance_sq(a,b) > 0
    by contra:
        ? bc > 0
        bc <= 0
        bc = 0
        geometry::main::distance_sq(b,c) = bc*bc = 0
        impossible geometry::main::distance_sq(b,c) > 0
    by contra:
        ? ac > 0
        ac <= 0
        ac = 0
        geometry::main::distance_sq(a,c) = ac*ac = 0
        impossible geometry::main::distance_sq(a,c) > 0
    bc^2 = bc*bc = geometry::main::distance_sq(b,c)
    ac^2 = ac*ac = geometry::main::distance_sq(a,c)
    ab^2 = ab*ab = geometry::main::distance_sq(a,b)
    bc < ab+ac = ac+ab
    ac < ab+bc = bc+ab
    ab < bc+ac
    witness exist alpha,beta,gamma R+ st {alpha^2 = geometry::main::distance_sq(b,c), beta^2 = geometry::main::distance_sq(a,c), gamma^2 = geometry::main::distance_sq(a,b), alpha < beta+gamma, beta < alpha+gamma, gamma < alpha+beta} from bc,ac,ab

thm book04_proposition_4:
    ? forall a,b,c cart(R,R):
        $geometry::main::is_triangle(a,b,c)
        =>:
            exist o cart(R,R), radius R+ st {$circle_inscribed_in_triangle(a,b,c,o,radius)}
    release thm proper_triangle_positive_side_lengths(a,b,c)
    obtain alpha,beta,gamma from exist alpha,beta,gamma R+ st {alpha^2 = geometry::main::distance_sq(b,c), beta^2 = geometry::main::distance_sq(a,c), gamma^2 = geometry::main::distance_sq(a,b), alpha < beta+gamma, beta < alpha+gamma, gamma < alpha+beta}
    alpha < beta+gamma = gamma+beta
    beta < alpha+gamma = gamma+alpha
    gamma < alpha+beta = beta+alpha
    release thm geometry_lemmas::triangle_vertices_distinct(a,b,c)
    by def $geometry::main::is_triangle(a,b,c)
    have perimeter R+ = alpha+beta+gamma
    have determinant R = geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c))
    determinant != 0
    determinant^2 > 0
    have magnitude R+ = sqrt(determinant^2)
    have radius R+ = magnitude/perimeter
    radius^2 = (magnitude/perimeter)^2 = magnitude^2/perimeter^2 = (sqrt(determinant^2))^2/perimeter^2 = determinant^2/perimeter^2 = (determinant/perimeter)^2
    have o cart(R,R) = ((alpha*a(1)+beta*b(1)+gamma*c(1))/perimeter,(alpha*a(2)+beta*b(2)+gamma*c(2))/perimeter)
    o(1) = (alpha*a(1)+beta*b(1)+gamma*c(1))/perimeter
    o(2) = (alpha*a(2)+beta*b(2)+gamma*c(2))/perimeter
    release thm positive_weighted_triangle_interior(a,b,c,o,alpha,beta,gamma,perimeter)
    perimeter = alpha+beta+gamma = alpha+beta+gamma
    release thm geometry::main::distance_sq_symmetric(a,b)
    release thm geometry::main::distance_sq_symmetric(a,c)
    release thm geometry::main::distance_sq_symmetric(b,c)
    gamma^2 = geometry::main::distance_sq(a,b)
    beta^2 = geometry::main::distance_sq(a,c)
    alpha^2 = geometry::main::distance_sq(b,c)
    have t_first R = (beta+gamma-alpha)/(2*gamma)
    have first cart(R,R) = (a(1)+t_first*(b(1)-a(1)),a(2)+t_first*(b(2)-a(2)))
    first(1) = a(1)+t_first*(b(1)-a(1))
    o(1)-a(1) = (alpha*a(1)+beta*b(1)+gamma*c(1))/perimeter-a(1) = (alpha*a(1)+beta*b(1)+gamma*c(1)-perimeter*a(1))/perimeter
    (alpha*a(1)+beta*b(1)+gamma*c(1)-perimeter*a(1))/perimeter = (alpha*a(1)+beta*b(1)+gamma*c(1)-(alpha+beta+gamma)*a(1))/perimeter = (beta*(b(1)-a(1))+gamma*(c(1)-a(1)))/perimeter
    first(2) = a(2)+t_first*(b(2)-a(2))
    o(2)-a(2) = (alpha*a(2)+beta*b(2)+gamma*c(2))/perimeter-a(2) = (alpha*a(2)+beta*b(2)+gamma*c(2)-perimeter*a(2))/perimeter
    (alpha*a(2)+beta*b(2)+gamma*c(2)-perimeter*a(2))/perimeter = (alpha*a(2)+beta*b(2)+gamma*c(2)-(alpha+beta+gamma)*a(2))/perimeter = (beta*(b(2)-a(2))+gamma*(c(2)-a(2)))/perimeter
    release thm incenter_side_geometric_certificate(a,b,c,o,first,alpha,beta,gamma,perimeter,t_first)
    release thm geometry::main::collinear_det_expand(a,b,c)
    release thm geometry::main::collinear_det_expand(a,b,c)
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c)) = (b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1)) = (b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1)) = determinant
    geometry::main::distance_sq(o,first) = (geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c))/perimeter)^2 = (determinant/perimeter)^2 = radius^2 = radius*radius
    by def $is_on_circle(first,o,radius)
    release thm radius_perpendicular_at_line_point_gives_tangency(o,first,a,b,radius)
    first(1) = a(1)+t_first*(b(1)-a(1)) = (1-t_first)*a(1)+t_first*b(1)
    first(2) = a(2)+t_first*(b(2)-a(2)) = (1-t_first)*a(2)+t_first*b(2)
    witness exist t R st {0 <= t, t <= 1, first(1) = (1-t)*a(1)+t*b(1), first(2) = (1-t)*a(2)+t*b(2)} from t_first
    by def $entry::is_on_segment(first,a,b)
    perimeter = alpha+beta+gamma = beta+gamma+alpha
    release thm geometry::main::distance_sq_symmetric(b,c)
    release thm geometry::main::distance_sq_symmetric(b,a)
    release thm geometry::main::distance_sq_symmetric(c,a)
    alpha^2 = geometry::main::distance_sq(b,c)
    gamma^2 = geometry::main::distance_sq(b,a)
    beta^2 = geometry::main::distance_sq(c,a)
    have t_second R = (gamma+alpha-beta)/(2*alpha)
    have second cart(R,R) = (b(1)+t_second*(c(1)-b(1)),b(2)+t_second*(c(2)-b(2)))
    second(1) = b(1)+t_second*(c(1)-b(1))
    o(1)-b(1) = (alpha*a(1)+beta*b(1)+gamma*c(1))/perimeter-b(1) = (alpha*a(1)+beta*b(1)+gamma*c(1)-perimeter*b(1))/perimeter
    (alpha*a(1)+beta*b(1)+gamma*c(1)-perimeter*b(1))/perimeter = (alpha*a(1)+beta*b(1)+gamma*c(1)-(alpha+beta+gamma)*b(1))/perimeter = (gamma*(c(1)-b(1))+alpha*(a(1)-b(1)))/perimeter
    second(2) = b(2)+t_second*(c(2)-b(2))
    o(2)-b(2) = (alpha*a(2)+beta*b(2)+gamma*c(2))/perimeter-b(2) = (alpha*a(2)+beta*b(2)+gamma*c(2)-perimeter*b(2))/perimeter
    (alpha*a(2)+beta*b(2)+gamma*c(2)-perimeter*b(2))/perimeter = (alpha*a(2)+beta*b(2)+gamma*c(2)-(alpha+beta+gamma)*b(2))/perimeter = (gamma*(c(2)-b(2))+alpha*(a(2)-b(2)))/perimeter
    release thm incenter_side_geometric_certificate(b,c,a,o,second,beta,gamma,alpha,perimeter,t_second)
    release thm geometry::main::collinear_det_expand(b,c,a)
    release thm geometry::main::collinear_det_expand(a,b,c)
    geometry::main::det(geometry::main::vec(b,c),geometry::main::vec(b,a)) = (c(1)-b(1))*(a(2)-b(2))-(c(2)-b(2))*(a(1)-b(1)) = (b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1)) = determinant
    geometry::main::distance_sq(o,second) = (geometry::main::det(geometry::main::vec(b,c),geometry::main::vec(b,a))/perimeter)^2 = (determinant/perimeter)^2 = radius^2 = radius*radius
    by def $is_on_circle(second,o,radius)
    release thm radius_perpendicular_at_line_point_gives_tangency(o,second,b,c,radius)
    second(1) = b(1)+t_second*(c(1)-b(1)) = (1-t_second)*b(1)+t_second*c(1)
    second(2) = b(2)+t_second*(c(2)-b(2)) = (1-t_second)*b(2)+t_second*c(2)
    witness exist t R st {0 <= t, t <= 1, second(1) = (1-t)*b(1)+t*c(1), second(2) = (1-t)*b(2)+t*c(2)} from t_second
    by def $entry::is_on_segment(second,b,c)
    perimeter = alpha+beta+gamma = gamma+alpha+beta
    release thm geometry::main::distance_sq_symmetric(c,a)
    release thm geometry::main::distance_sq_symmetric(c,b)
    release thm geometry::main::distance_sq_symmetric(a,b)
    beta^2 = geometry::main::distance_sq(c,a)
    alpha^2 = geometry::main::distance_sq(c,b)
    gamma^2 = geometry::main::distance_sq(a,b)
    have t_third R = (alpha+beta-gamma)/(2*beta)
    have third cart(R,R) = (c(1)+t_third*(a(1)-c(1)),c(2)+t_third*(a(2)-c(2)))
    third(1) = c(1)+t_third*(a(1)-c(1))
    o(1)-c(1) = (alpha*a(1)+beta*b(1)+gamma*c(1))/perimeter-c(1) = (alpha*a(1)+beta*b(1)+gamma*c(1)-perimeter*c(1))/perimeter
    (alpha*a(1)+beta*b(1)+gamma*c(1)-perimeter*c(1))/perimeter = (alpha*a(1)+beta*b(1)+gamma*c(1)-(alpha+beta+gamma)*c(1))/perimeter = (alpha*(a(1)-c(1))+beta*(b(1)-c(1)))/perimeter
    third(2) = c(2)+t_third*(a(2)-c(2))
    o(2)-c(2) = (alpha*a(2)+beta*b(2)+gamma*c(2))/perimeter-c(2) = (alpha*a(2)+beta*b(2)+gamma*c(2)-perimeter*c(2))/perimeter
    (alpha*a(2)+beta*b(2)+gamma*c(2)-perimeter*c(2))/perimeter = (alpha*a(2)+beta*b(2)+gamma*c(2)-(alpha+beta+gamma)*c(2))/perimeter = (alpha*(a(2)-c(2))+beta*(b(2)-c(2)))/perimeter
    release thm incenter_side_geometric_certificate(c,a,b,o,third,gamma,alpha,beta,perimeter,t_third)
    release thm geometry::main::collinear_det_expand(c,a,b)
    release thm geometry::main::collinear_det_expand(a,b,c)
    geometry::main::det(geometry::main::vec(c,a),geometry::main::vec(c,b)) = (a(1)-c(1))*(b(2)-c(2))-(a(2)-c(2))*(b(1)-c(1)) = (b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1)) = determinant
    geometry::main::distance_sq(o,third) = (geometry::main::det(geometry::main::vec(c,a),geometry::main::vec(c,b))/perimeter)^2 = (determinant/perimeter)^2 = radius^2 = radius*radius
    by def $is_on_circle(third,o,radius)
    release thm radius_perpendicular_at_line_point_gives_tangency(o,third,c,a,radius)
    third(1) = c(1)+t_third*(a(1)-c(1)) = (1-t_third)*c(1)+t_third*a(1)
    third(2) = c(2)+t_third*(a(2)-c(2)) = (1-t_third)*c(2)+t_third*a(2)
    witness exist t R st {0 <= t, t <= 1, third(1) = (1-t)*c(1)+t*a(1), third(2) = (1-t)*c(2)+t*a(2)} from t_third
    by def $entry::is_on_segment(third,c,a)
    witness exist contact_ab,contact_bc,contact_ca cart(R,R) st {$entry::is_on_segment(contact_ab,a,b), $entry::is_on_segment(contact_bc,b,c), $entry::is_on_segment(contact_ca,c,a), $is_tangent_line_at(contact_ab,a,b,o,radius), $is_tangent_line_at(contact_bc,b,c,o,radius), $is_tangent_line_at(contact_ca,c,a,o,radius)} from first,second,third
    by def $circle_inscribed_in_triangle(a,b,c,o,radius)
    witness exist center cart(R,R), r R+ st {$circle_inscribed_in_triangle(a,b,c,center,r)} from o,radius

sketch:
    have a cart(R,R) = (2,-1)
    have b cart(R,R) = (6,-1)
    have c cart(R,R) = (2,2)
    a(1) = 2
    a(2) = -1
    b(1) = 6
    b(2) = -1
    c(1) = 2
    c(2) = 2
    release thm geometry::main::collinear_det_expand(a,b,c)
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c)) = (b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1)) = (6-2)*(2-(-1))-((-1)-(-1))*(2-2) = 12
    by def $geometry::main::is_triangle(a,b,c)
    release thm book04_proposition_4(a,b,c)
    obtain o,radius from exist o cart(R,R), radius R+ st {$circle_inscribed_in_triangle(a,b,c,o,radius)}
    by def $circle_inscribed_in_triangle(a,b,c,o,radius)
    $working::is_in_triangle_interior(o,a,b,c)
    obtain first,second,third from exist first,second,third cart(R,R) st {$entry::is_on_segment(first,a,b), $entry::is_on_segment(second,b,c), $entry::is_on_segment(third,c,a), $is_tangent_line_at(first,a,b,o,radius), $is_tangent_line_at(second,b,c,o,radius), $is_tangent_line_at(third,c,a,o,radius)}
    $entry::is_on_segment(first,a,b)
    $entry::is_on_segment(second,b,c)
    $entry::is_on_segment(third,c,a)
    $is_tangent_line_at(first,a,b,o,radius)
    $is_tangent_line_at(second,b,c,o,radius)
    $is_tangent_line_at(third,c,a,o,radius)
