    geometry::main::det(geometry::main::vec(vertices(0),vertices(1)),geometry::main::vec(vertices(0),vertices(2))) = (vertices(1)(1)-vertices(0)(1))*(vertices(2)(2)-vertices(0)(2))-(vertices(1)(2)-vertices(0)(2))*(vertices(2)(1)-vertices(0)(1)) = (3-0)*(3-0)-(0-0)*(0-0) = 9
    by def $geometry::main::is_triangle(vertices(0),vertices(1),vertices(2))
