# Analytic operations used in this book are the existing geometry definitions.
release obj def geometry::main::vec
release obj def geometry::main::dot
release obj def geometry::main::det
release obj def geometry::main::distance_sq
release obj def geometry::main::angle_cos_num
release obj def geometry::main::angle_cos_den
release obj def geometry::main::line_through_points

# Book I, Proposition 1: construct an equilateral triangle on a given nonzero segment.
# The source draws two circles with centers at the endpoints and radius equal
# to the given segment, then joins an intersection point to the endpoints.
# In the real plane the oriented apex formula supplies that intersection.
# Its equal-distance laws and nonzero determinant establish a genuine triangle;
# its membership in both prescribed circles verifies the construction.
have fn equilateral_vertex(a, b cart(R, R): a != b) cart(R, R) = ((a(1) + b(1)) / 2 - sqrt(3) * (b(2) - a(2)) / 2, (a(2) + b(2)) / 2 + sqrt(3) * (b(1) - a(1)) / 2)


thm proposition_1:
    ? forall a, b cart(R, R):
        a != b
        =>:
            exist z cart(R, R) st {$geometry::main::is_equilateral(a, b, z)}
    have c cart(R, R) = equilateral_vertex(a, b)
    have x R = b(1) - a(1)
    have y R = b(2) - a(2)
    equilateral_vertex(a, b) = ((a(1) + b(1)) / 2 - sqrt(3) * (b(2) - a(2)) / 2, (a(2) + b(2)) / 2 + sqrt(3) * (b(1) - a(1)) / 2)
    c = ((a(1) + b(1)) / 2 - sqrt(3) * (b(2) - a(2)) / 2, (a(2) + b(2)) / 2 + sqrt(3) * (b(1) - a(1)) / 2)
    c(1) = (a(1) + b(1)) / 2 - sqrt(3) * y / 2
    c(2) = (a(2) + b(2)) / 2 + sqrt(3) * x / 2
    release thm geometry::main::vec_coordinate_formula(a, b)
    geometry::main::vec(a, b)(1) = x
    geometry::main::vec(a, b)(2) = y
    release thm geometry::main::distance_sq_coordinate_formula(a, b)
    geometry::main::distance_sq(a, b) = (b(1) - a(1))^2 + (b(2) - a(2))^2 = x^2 + y^2
    release thm geometry::main::distance_sq_positive_of_ne(a, b)
    x^2 + y^2 > 0
    sqrt(3)^2 = 3
    sqrt(3) > 0
    c(1) - a(1) = ((a(1) + b(1)) / 2 - sqrt(3) * y / 2) - a(1) = (b(1) - a(1)) / 2 - sqrt(3) * y / 2 = x / 2 - sqrt(3) * y / 2
    c(2) - a(2) = ((a(2) + b(2)) / 2 + sqrt(3) * x / 2) - a(2) = (b(2) - a(2)) / 2 + sqrt(3) * x / 2 = y / 2 + sqrt(3) * x / 2
    c(1) - b(1) = ((a(1) + b(1)) / 2 - sqrt(3) * y / 2) - b(1) = -(b(1) - a(1)) / 2 - sqrt(3) * y / 2 = -x / 2 - sqrt(3) * y / 2
    c(2) - b(2) = ((a(2) + b(2)) / 2 + sqrt(3) * x / 2) - b(2) = -(b(2) - a(2)) / 2 + sqrt(3) * x / 2 = -y / 2 + sqrt(3) * x / 2
    geometry::main::vec(a, c)(1) = x / 2 - sqrt(3) * y / 2
    geometry::main::vec(a, c)(2) = y / 2 + sqrt(3) * x / 2
    geometry::main::vec(b, c)(1) = -x / 2 - sqrt(3) * y / 2
    geometry::main::vec(b, c)(2) = -y / 2 + sqrt(3) * x / 2
    (x / 2 - sqrt(3) * y / 2)^2 + (y / 2 + sqrt(3) * x / 2)^2 = (1 + sqrt(3)^2) * (x^2 + y^2) / 4 = x^2 + y^2
    (-x / 2 - sqrt(3) * y / 2)^2 + (-y / 2 + sqrt(3) * x / 2)^2 = (1 + sqrt(3)^2) * (x^2 + y^2) / 4 = x^2 + y^2
    release thm geometry::main::distance_sq_coordinate_formula(a, c)
    geometry::main::distance_sq(a, c) = (c(1) - a(1))^2 + (c(2) - a(2))^2 = (x / 2 - sqrt(3) * y / 2)^2 + (y / 2 + sqrt(3) * x / 2)^2 = x^2 + y^2
    release thm geometry::main::distance_sq_coordinate_formula(b, c)
    geometry::main::distance_sq(b, c) = (c(1) - b(1))^2 + (c(2) - b(2))^2 = (-x / 2 - sqrt(3) * y / 2)^2 + (-y / 2 + sqrt(3) * x / 2)^2 = x^2 + y^2
    release thm geometry::main::distance_sq_symmetric(c, a)
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) = x * (y / 2 + sqrt(3) * x / 2) - y * (x / 2 - sqrt(3) * y / 2) = sqrt(3) * (x^2 + y^2) / 2
    have norm_sq R+ = x^2 + y^2
    sqrt(3) $in R+
    sqrt(3) * norm_sq $in R+
    sqrt(3) * norm_sq / 2 $in R+
    sqrt(3) * (x^2 + y^2) / 2 = sqrt(3) * norm_sq / 2 > 0
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) != 0
    by def $geometry::main::is_triangle(a, b, c)
    by def $geometry::main::are_segments_congruent(a, b, b, c)
    by def $geometry::main::are_segments_congruent(b, c, c, a)
    by def $geometry::main::is_equilateral(a, b, c)
    release obj def geometry::main::circle
    have radius R+ = sqrt(geometry::main::distance_sq(a, b))
    sqrt(geometry::main::distance_sq(a, b))^2 = geometry::main::distance_sq(a, b)
    radius^2 = sqrt(geometry::main::distance_sq(a, b))^2 = geometry::main::distance_sq(a, b)
    geometry::main::distance_sq(a, c) = radius * radius
    geometry::main::distance_sq(b, c) = radius * radius
    c $in geometry::main::circle(a, radius)
    c $in geometry::main::circle(b, radius)
    witness exist z cart(R, R) st {$geometry::main::is_equilateral(a, b, z)} from c

# Book I, Proposition 2: copy a given nonzero segment from any starting point.
# The source uses I.1, extended sides, two circles and subtraction of equal
# lengths. This analytic proof selects a point on the horizontal ray at the
# positive input length, verifies the circle membership and equal length,
# and includes the case where the new start is an input endpoint.
# This statement verifies the geometric output, rather than an operational
# program for a collapsing compass.
thm proposition_2:
    ? forall a, b, c cart(R, R):
        b != c
        =>:
            exist d cart(R, R) st {a != d, $geometry::main::are_segments_congruent(a, d, b, c)}
    release thm geometry::main::distance_sq_positive_of_ne(b, c)
    have radius R+ = sqrt(geometry::main::distance_sq(b, c))
    sqrt(geometry::main::distance_sq(b, c))^2 = geometry::main::distance_sq(b, c)
    radius^2 = sqrt(geometry::main::distance_sq(b, c))^2 = geometry::main::distance_sq(b, c)
    have endpoint cart(R, R) = (a(1) + radius, a(2))
    endpoint(1) = a(1) + radius
    endpoint(2) = a(2)
    release thm geometry::main::distance_sq_coordinate_formula(a, endpoint)
    geometry::main::distance_sq(a, endpoint) = (endpoint(1) - a(1))^2 + (endpoint(2) - a(2))^2 = ((a(1) + radius) - a(1))^2 + (a(2) - a(2))^2 = radius^2 = geometry::main::distance_sq(b, c)
    by contra:
        ? a != endpoint
        a = endpoint
        a(1) = endpoint(1)
        a(1) = endpoint(1) = a(1) + radius
        radius = (a(1) + radius) - a(1) = endpoint(1) - a(1) = a(1) - a(1) = 0
        impossible radius > 0
    by def $geometry::main::are_segments_congruent(a, endpoint, b, c)
    release obj def geometry::main::circle
    geometry::main::distance_sq(a, endpoint) = radius * radius
    endpoint $in geometry::main::circle(a, radius)
    witness exist d cart(R, R) st {a != d, $geometry::main::are_segments_congruent(a, d, b, c)} from endpoint

# Book I, Proposition 3: cut a shorter given length from a longer segment.
# The source transfers the length by I.2 and intersects its circle with the
# longer segment. The analytic witness has affine parameter equal to the
# positive square root of the ratio of squared lengths. It lies strictly
# between the longer segment endpoints and has the prescribed length.
thm proposition_3:
    ? forall a, b, c, d cart(R, R):
        a != b
        c != d
        geometry::main::distance_sq(c, d) < geometry::main::distance_sq(a, b)
        =>:
            exist z cart(R, R) st {a != z, z != b, $geometry::main::is_on_segment(z, a, b), $geometry::main::are_segments_congruent(a, z, c, d)}
    release thm geometry::main::distance_sq_positive_of_ne(a, b)
    release thm geometry::main::distance_sq_positive_of_ne(c, d)
    have long_sq R+ = geometry::main::distance_sq(a, b)
    have short_sq R+ = geometry::main::distance_sq(c, d)
    have ratio R+ = short_sq / long_sq
    short_sq < long_sq
    ratio = short_sq / long_sq < long_sq / long_sq = 1
    have t R+ = sqrt(ratio)
    sqrt(ratio)^2 = ratio
    t^2 = sqrt(ratio)^2 = ratio
    by contra:
        ? t < 1
        t >= 1
        t^2 = t * t
        t * t >= t * 1 = t >= 1
        impossible t^2 < 1
    have cut cart(R, R) = (a(1) + t * (b(1) - a(1)), a(2) + t * (b(2) - a(2)))
    cut(1) = a(1) + t * (b(1) - a(1)) = (1 - t) * a(1) + t * b(1)
    cut(2) = a(2) + t * (b(2) - a(2)) = (1 - t) * a(2) + t * b(2)
    witness exist k R st {0 <= k, k <= 1, cut(1) = (1 - k) * a(1) + k * b(1), cut(2) = (1 - k) * a(2) + k * b(2)} from t
    by def $geometry::main::is_on_segment(cut, a, b)
    release thm geometry::main::affine_distance_from_parameter(a, b, cut, t)
    release thm geometry::main::distance_sq_symmetric(a, cut)
    geometry::main::distance_sq(a, cut) = t^2 * geometry::main::distance_sq(a, b) = ratio * long_sq = (short_sq / long_sq) * long_sq = short_sq = geometry::main::distance_sq(c, d)
    by contra:
        ? a != cut
        a = cut
        release thm geometry::main::distance_sq_coordinate_formula(a, cut)
        cut(1) = a(1)
        cut(2) = a(2)
        cut(1) - a(1) = a(1) - a(1) = 0
        cut(2) - a(2) = a(2) - a(2) = 0
        geometry::main::distance_sq(a, cut) = (cut(1) - a(1))^2 + (cut(2) - a(2))^2 = 0^2 + 0^2 = 0
        short_sq = geometry::main::distance_sq(a, cut) = 0
        impossible short_sq > 0
    by contra:
        ? cut != b
        cut = b
        geometry::main::distance_sq(a, cut) = geometry::main::distance_sq(a, b)
        geometry::main::distance_sq(c, d) = geometry::main::distance_sq(a, cut) = geometry::main::distance_sq(a, b)
        impossible geometry::main::distance_sq(c, d) < geometry::main::distance_sq(a, b)
    by def $geometry::main::are_segments_congruent(a, cut, c, d)
    witness exist z cart(R, R) st {a != z, z != b, $geometry::main::is_on_segment(z, a, b), $geometry::main::are_segments_congruent(a, z, c, d)} from cut

# Book I.4: SAS with all three source conclusions. The signed cosine
# hypothesis gives equal included dot products; the library SAS law and
# reusable angle bridge give triangle congruence and the remaining angles.
thm proposition_4:
    ? forall p, q, r, u, v, w cart(R, R):
        $geometry::main::is_triangle(p, q, r)
        $geometry::main::is_triangle(u, v, w)
        $geometry::main::are_segments_congruent(p, q, u, v)
        $geometry::main::are_segments_congruent(q, r, v, w)
        $geometry::main::are_angles_congruent(p, q, r, u, v, w)
        =>:
            $geometry::main::are_triangles_congruent(p, q, r, u, v, w)
            $geometry::main::are_angles_congruent(q, p, r, v, u, w)
            $geometry::main::are_angles_congruent(p, r, q, u, w, v)
    claim:
        ? forall x, y R:
            x^2 = y^2
            x * y >= 0
            =>:
                x = y
        by contra:
            ? x = y
            x != y
            x - y != 0
            (x - y) * (x + y) = x^2 - y^2 = 0
            x + y = 0 / (x - y) = 0
            y = -x
            x * y = x * (-x) = -(x^2)
            x^2 = -(-(x^2)) = -(x * y) <= 0
            x^2 >= 0
            x^2 = 0
            x = 0
            y = -x = 0
            x = y
            impossible x != y
    release thm geometry_lemmas::triangle_vertices_distinct(p, q, r)
    release thm geometry_lemmas::triangle_vertices_distinct(u, v, w)
    release thm geometry::main::distance_sq_symmetric(p, q)
    release thm geometry::main::distance_sq_symmetric(u, v)
    geometry::main::distance_sq(q, p) = geometry::main::distance_sq(p, q) = geometry::main::distance_sq(u, v) = geometry::main::distance_sq(v, u)
    have first R = geometry::main::angle_cos_num(p, q, r)
    have second R = geometry::main::angle_cos_num(u, v, w)
    geometry::main::angle_cos_den(p, q, r) > 0
    geometry::main::angle_cos_den(p, q, r) $in R+
    have denominator R+ = geometry::main::angle_cos_den(p, q, r)
    geometry::main::angle_cos_den(p, q, r) = geometry::main::distance_sq(q, p) * geometry::main::distance_sq(q, r)
    geometry::main::angle_cos_den(u, v, w) = geometry::main::distance_sq(v, u) * geometry::main::distance_sq(v, w) = geometry::main::distance_sq(q, p) * geometry::main::distance_sq(q, r) = geometry::main::angle_cos_den(p, q, r) = denominator
    first^2 * denominator = geometry::main::angle_cos_num(p, q, r)^2 * geometry::main::angle_cos_den(u, v, w) = geometry::main::angle_cos_num(u, v, w)^2 * geometry::main::angle_cos_den(p, q, r) = second^2 * denominator
    denominator != 0
    first^2 = (first^2 * denominator) / denominator = (second^2 * denominator) / denominator = second^2
    first * second = geometry::main::angle_cos_num(p, q, r) * geometry::main::angle_cos_num(u, v, w) >= 0
    first = second
    geometry::main::dot(geometry::main::vec(q, p), geometry::main::vec(q, r)) = geometry::main::angle_cos_num(p, q, r) = first = second = geometry::main::angle_cos_num(u, v, w) = geometry::main::dot(geometry::main::vec(v, u), geometry::main::vec(v, w))
    release thm geometry::main::sas_congruence(p, q, r, u, v, w)
    p != r
    u != w
    release thm geometry::main::distance_sq_symmetric(p, r)
    release thm geometry::main::distance_sq_symmetric(u, w)
    release thm geometry::main::distance_sq_symmetric(q, r)
    release thm geometry::main::distance_sq_symmetric(v, w)
    geometry::main::distance_sq(r, p) = geometry::main::distance_sq(p, r) = geometry::main::distance_sq(u, w) = geometry::main::distance_sq(w, u)
    geometry::main::distance_sq(r, q) = geometry::main::distance_sq(q, r) = geometry::main::distance_sq(v, w) = geometry::main::distance_sq(w, v)
    by def $geometry::main::are_segments_congruent(r, p, w, u)
    by def $geometry::main::are_triangles_congruent(p, q, r, u, v, w)
    by thm geometry_lemmas::angle_congruence_from_equal_sides_and_dot(p, q, r, u, v, w) => $geometry::main::are_angles_congruent(q, p, r, v, u, w)
    by thm geometry_lemmas::angle_congruence_from_equal_sides_and_dot(r, p, q, w, u, v) => $geometry::main::are_angles_congruent(p, r, q, u, w, v)

# Book I.5 has two source conclusions, represented by two theorems.
# The source uses auxiliary extensions, I.3 and I.4 and angle subtraction.
# This analytic route uses equal base dot products and positive extension
# scales; it checks both the base angles and the angles under the base.
thm proposition_5:
    ? forall a, b, c cart(R, R):
        $geometry::main::is_triangle(a, b, c)
        $geometry::main::are_segments_congruent(a, b, a, c)
        =>:
            $geometry::main::are_angles_congruent(a, b, c, a, c, b)
    release thm geometry_lemmas::triangle_vertices_distinct(a, b, c)
    release thm geometry::main::distance_sq_symmetric(a, b)
    release thm geometry::main::distance_sq_symmetric(a, c)
    release thm geometry::main::distance_sq_symmetric(b, c)
    geometry::main::distance_sq(b, a) = geometry::main::distance_sq(a, b) = geometry::main::distance_sq(a, c) = geometry::main::distance_sq(c, a)
    release thm geometry::main::isosceles_base_dot(a, b, c)
    by thm geometry_lemmas::angle_congruence_from_equal_sides_and_dot(b, a, c, c, a, b) => $geometry::main::are_angles_congruent(a, b, c, a, c, b)

thm proposition_5_under_base:
    ? forall a, b, c, d, f cart(R, R):
        $geometry::main::is_triangle(a, b, c)
        $geometry::main::are_segments_congruent(a, b, a, c)
        $geometry::main::is_on_extension(d, a, b)
        $geometry::main::is_on_extension(f, a, c)
        =>:
            $geometry::main::are_angles_congruent(c, b, d, b, c, f)
    release thm proposition_5(a, b, c)
    release thm geometry_lemmas::triangle_vertices_distinct(a, b, c)
    release thm geometry::main::distance_sq_symmetric(a, b)
    release thm geometry::main::distance_sq_symmetric(a, c)
    release thm geometry::main::distance_sq_symmetric(b, c)
    geometry::main::distance_sq(b, a) = geometry::main::distance_sq(a, b) = geometry::main::distance_sq(a, c) = geometry::main::distance_sq(c, a)
    release thm geometry::main::isosceles_base_dot(a, b, c)
    by thm geometry_lemmas::angle_congruence_from_equal_sides_and_dot(b, a, c, c, a, b) => $geometry::main::are_angles_congruent(a, b, c, a, c, b)
    obtain t from exist alpha R st {alpha > 1, d(1) = (1 - alpha) * a(1) + alpha * b(1), d(2) = (1 - alpha) * a(2) + alpha * b(2)}
    obtain s from exist beta R st {beta > 1, f(1) = (1 - beta) * a(1) + beta * c(1), f(2) = (1 - beta) * a(2) + beta * c(2)}
    have k R+ = t - 1
    have h R+ = s - 1
    1 - t = -(t - 1) = -k
    1 - s = -(s - 1) = -h
    release thm geometry::main::square_neg(k)
    release thm geometry::main::square_neg(h)
    (1 - t)^2 = (-k)^2 = k^2
    (1 - s)^2 = (-h)^2 = h^2
    have num R = geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c))
    have den R+ = geometry::main::angle_cos_den(a, b, c)
    d(1) - b(1) = ((1 - t) * a(1) + t * b(1)) - b(1) = -(t - 1) * (a(1) - b(1)) = -k * geometry::main::vec(b, a)(1)
    d(2) - b(2) = ((1 - t) * a(2) + t * b(2)) - b(2) = -(t - 1) * (a(2) - b(2)) = -k * geometry::main::vec(b, a)(2)
    f(1) - c(1) = ((1 - s) * a(1) + s * c(1)) - c(1) = -(s - 1) * (a(1) - c(1)) = -h * geometry::main::vec(c, a)(1)
    f(2) - c(2) = ((1 - s) * a(2) + s * c(2)) - c(2) = -(s - 1) * (a(2) - c(2)) = -h * geometry::main::vec(c, a)(2)
    geometry::main::vec(b, d)(1) = -k * geometry::main::vec(b, a)(1)
    geometry::main::vec(b, d)(2) = -k * geometry::main::vec(b, a)(2)
    geometry::main::vec(c, f)(1) = -h * geometry::main::vec(c, a)(1)
    geometry::main::vec(c, f)(2) = -h * geometry::main::vec(c, a)(2)
    release thm geometry::main::distance_sq_positive_of_ne(a, b)
    release thm geometry::main::distance_sq_positive_of_ne(a, c)
    d(1) = a(1) + t * (b(1) - a(1))
    d(2) = a(2) + t * (b(2) - a(2))
    f(1) = a(1) + s * (c(1) - a(1))
    f(2) = a(2) + s * (c(2) - a(2))
    release thm geometry::main::affine_distance_from_parameter(a, b, d, t)
    release thm geometry::main::affine_distance_from_parameter(a, c, f, s)
    release thm geometry::main::distance_sq_symmetric(b, d)
    release thm geometry::main::distance_sq_symmetric(c, f)
    geometry::main::distance_sq(b, d) = geometry::main::distance_sq(d, b) = (1 - t)^2 * geometry::main::distance_sq(a, b) = k^2 * geometry::main::distance_sq(a, b)
    geometry::main::distance_sq(c, f) = geometry::main::distance_sq(f, c) = (1 - s)^2 * geometry::main::distance_sq(a, c) = h^2 * geometry::main::distance_sq(a, c)
    geometry::main::distance_sq(b, d) $in R+
    geometry::main::distance_sq(c, f) $in R+
    by contra:
        ? b != d
        b = d
        release thm geometry::main::distance_sq_coordinate_formula(b, d)
        d(1) = b(1)
        d(2) = b(2)
        d(1) - b(1) = 0
        d(2) - b(2) = 0
        geometry::main::distance_sq(b, d) = (d(1) - b(1))^2 + (d(2) - b(2))^2 = 0^2 + 0^2 = 0
        impossible geometry::main::distance_sq(b, d) > 0
    by contra:
        ? c != f
        c = f
        release thm geometry::main::distance_sq_coordinate_formula(c, f)
        f(1) = c(1)
        f(2) = c(2)
        f(1) - c(1) = 0
        f(2) - c(2) = 0
        geometry::main::distance_sq(c, f) = (f(1) - c(1))^2 + (f(2) - c(2))^2 = 0^2 + 0^2 = 0
        impossible geometry::main::distance_sq(c, f) > 0
    release thm geometry::main::dot_symmetric(geometry::main::vec(b, a), geometry::main::vec(b, c))
    release thm geometry::main::dot_symmetric(geometry::main::vec(c, a), geometry::main::vec(c, b))
    geometry::main::dot(geometry::main::vec(b, c), geometry::main::vec(b, a)) = num
    geometry::main::dot(geometry::main::vec(c, b), geometry::main::vec(c, a)) = num
    release thm geometry::main::dot_coordinate_formula(geometry::main::vec(b, c), geometry::main::vec(b, a))
    geometry::main::vec(b, c)(1) * geometry::main::vec(b, a)(1) + geometry::main::vec(b, c)(2) * geometry::main::vec(b, a)(2) = geometry::main::dot(geometry::main::vec(b, c), geometry::main::vec(b, a)) = num
    release thm geometry::main::dot_coordinate_formula(geometry::main::vec(c, b), geometry::main::vec(c, a))
    geometry::main::vec(c, b)(1) * geometry::main::vec(c, a)(1) + geometry::main::vec(c, b)(2) * geometry::main::vec(c, a)(2) = geometry::main::dot(geometry::main::vec(c, b), geometry::main::vec(c, a)) = num
    geometry::main::angle_cos_num(c, b, d) = geometry::main::dot(geometry::main::vec(b, c), geometry::main::vec(b, d)) = geometry::main::vec(b, c)(1) * geometry::main::vec(b, d)(1) + geometry::main::vec(b, c)(2) * geometry::main::vec(b, d)(2) = geometry::main::vec(b, c)(1) * (-k * geometry::main::vec(b, a)(1)) + geometry::main::vec(b, c)(2) * (-k * geometry::main::vec(b, a)(2)) = -k * (geometry::main::vec(b, c)(1) * geometry::main::vec(b, a)(1) + geometry::main::vec(b, c)(2) * geometry::main::vec(b, a)(2)) = -k * num
    geometry::main::angle_cos_num(b, c, f) = geometry::main::dot(geometry::main::vec(c, b), geometry::main::vec(c, f)) = geometry::main::vec(c, b)(1) * geometry::main::vec(c, f)(1) + geometry::main::vec(c, b)(2) * geometry::main::vec(c, f)(2) = geometry::main::vec(c, b)(1) * (-h * geometry::main::vec(c, a)(1)) + geometry::main::vec(c, b)(2) * (-h * geometry::main::vec(c, a)(2)) = -h * (geometry::main::vec(c, b)(1) * geometry::main::vec(c, a)(1) + geometry::main::vec(c, b)(2) * geometry::main::vec(c, a)(2)) = -h * num
    den = geometry::main::angle_cos_den(a, b, c) = geometry::main::distance_sq(b, a) * geometry::main::distance_sq(b, c) = geometry::main::distance_sq(a, b) * geometry::main::distance_sq(b, c)
    release thm geometry::main::multiply_both_sides(den, geometry::main::distance_sq(a, b) * geometry::main::distance_sq(b, c), k^2)
    k^2 * den = den * k^2 = (geometry::main::distance_sq(a, b) * geometry::main::distance_sq(b, c)) * k^2 = k^2 * (geometry::main::distance_sq(a, b) * geometry::main::distance_sq(b, c))
    release thm geometry::main::multiply_both_sides(den, geometry::main::distance_sq(a, b) * geometry::main::distance_sq(b, c), h^2)
    h^2 * den = den * h^2 = (geometry::main::distance_sq(a, b) * geometry::main::distance_sq(b, c)) * h^2 = h^2 * (geometry::main::distance_sq(a, b) * geometry::main::distance_sq(b, c))
    geometry::main::angle_cos_den(c, b, d) = geometry::main::distance_sq(b, c) * geometry::main::distance_sq(b, d) = geometry::main::distance_sq(b, c) * (k^2 * geometry::main::distance_sq(a, b)) = k^2 * (geometry::main::distance_sq(a, b) * geometry::main::distance_sq(b, c)) = k^2 * den
    release thm geometry::main::multiply_both_sides(geometry::main::distance_sq(a, c), geometry::main::distance_sq(a, b), h^2)
    h^2 * geometry::main::distance_sq(a, c) = geometry::main::distance_sq(a, c) * h^2 = geometry::main::distance_sq(a, b) * h^2 = h^2 * geometry::main::distance_sq(a, b)
    geometry::main::distance_sq(c, f) = h^2 * geometry::main::distance_sq(a, c) = h^2 * geometry::main::distance_sq(a, b)
    geometry::main::angle_cos_den(b, c, f) = geometry::main::distance_sq(c, b) * geometry::main::distance_sq(c, f) = geometry::main::distance_sq(b, c) * geometry::main::distance_sq(c, f) = geometry::main::distance_sq(b, c) * (h^2 * geometry::main::distance_sq(a, c)) = geometry::main::distance_sq(b, c) * (h^2 * geometry::main::distance_sq(a, b)) = h^2 * (geometry::main::distance_sq(a, b) * geometry::main::distance_sq(b, c)) = h^2 * den
    k^2 * den $in R+
    h^2 * den $in R+
    geometry::main::angle_cos_den(c, b, d) > 0
    geometry::main::angle_cos_den(b, c, f) > 0
    geometry::main::angle_cos_num(c, b, d)^2 = (-k * num)^2
    geometry::main::angle_cos_num(b, c, f)^2 = (-h * num)^2
    geometry::main::angle_cos_num(c, b, d)^2 * geometry::main::angle_cos_den(b, c, f) = (-k * num)^2 * (h^2 * den) = k^2 * h^2 * num^2 * den = (-h * num)^2 * (k^2 * den) = geometry::main::angle_cos_num(b, c, f)^2 * geometry::main::angle_cos_den(c, b, d)
    k * h $in R+
    num^2 >= 0
    (k * h) * num^2 >= 0
    geometry::main::angle_cos_num(c, b, d) * geometry::main::angle_cos_num(b, c, f) = (-k * num) * (-h * num) = (k * h) * num^2 >= 0
    by def $geometry::main::are_angles_congruent(c, b, d, b, c, f)

# Book I.6: equal base angles force equal opposite sides.
# The source uses I.3/I.4 and a whole-versus-part contradiction; this proof
# uses the independently established analytic AAS interface.

thm proposition_6:
    ? forall a, b, c cart(R, R):
        $geometry::main::is_triangle(a, b, c)
        $geometry::main::are_angles_congruent(a, b, c, a, c, b)
        =>:
            $geometry::main::are_segments_congruent(a, b, a, c)
    release thm geometry_lemmas::triangle_vertices_distinct(a, b, c)
    release thm geometry::main::det_antisymmetric(geometry::main::vec(a, c), geometry::main::vec(a, b))
    by contra:
        ? geometry::main::det(geometry::main::vec(a, c), geometry::main::vec(a, b)) != 0
        geometry::main::det(geometry::main::vec(a, c), geometry::main::vec(a, b)) = 0
        geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) = -(-(geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)))) = -(geometry::main::det(geometry::main::vec(a, c), geometry::main::vec(a, b))) = -0 = 0
        impossible geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) != 0
    by def $geometry::main::is_triangle(a, c, b)
    release thm geometry::main::distance_sq_positive_of_ne(a, b)
    release thm geometry::main::distance_sq_positive_of_ne(a, c)
    geometry::main::distance_sq(a, b) $in R+
    geometry::main::distance_sq(a, c) $in R+
    geometry::main::distance_sq(a, b) * geometry::main::distance_sq(a, c) $in R+
    geometry::main::angle_cos_den(b, a, c) = geometry::main::distance_sq(a, b) * geometry::main::distance_sq(a, c) > 0
    geometry::main::angle_cos_den(c, a, b) = geometry::main::distance_sq(a, c) * geometry::main::distance_sq(a, b) = geometry::main::angle_cos_den(b, a, c) > 0
    release thm geometry::main::dot_symmetric(geometry::main::vec(a, b), geometry::main::vec(a, c))
    geometry::main::angle_cos_num(b, a, c) = geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c)) = geometry::main::dot(geometry::main::vec(a, c), geometry::main::vec(a, b)) = geometry::main::angle_cos_num(c, a, b)
    geometry::main::angle_cos_num(b, a, c)^2 * geometry::main::angle_cos_den(c, a, b) = geometry::main::angle_cos_num(c, a, b)^2 * geometry::main::angle_cos_den(c, a, b) = geometry::main::angle_cos_num(c, a, b)^2 * geometry::main::angle_cos_den(b, a, c)
    have shared_numerator R = geometry::main::angle_cos_num(b, a, c)
    shared_numerator^2 >= 0
    geometry::main::angle_cos_num(b, a, c)^2 = shared_numerator^2 >= 0
    geometry::main::angle_cos_num(b, a, c) * geometry::main::angle_cos_num(c, a, b) = geometry::main::angle_cos_num(b, a, c) * geometry::main::angle_cos_num(b, a, c) = geometry::main::angle_cos_num(b, a, c)^2 >= 0
    by def $geometry::main::are_angles_congruent(b, a, c, c, a, b)
    release thm geometry::main::distance_sq_symmetric(b, c)
    release thm geometry::main::triangle_congruence_AAS(a, b, c, a, c, b)
    by def $geometry::main::are_segments_congruent(a, b, a, c)


# Book I.7: equal respective distances from the endpoints determine at
# most one vertex on a given strict side of a nonzero base line.
# The analytic route uses projection and determinant sign, then an
# independently verified two-equation elimination.

thm proposition_7:
    ? forall a, b, c, d cart(R, R):
        a != b
        geometry::main::distance_sq(a, c) = geometry::main::distance_sq(a, d)
        geometry::main::distance_sq(b, c) = geometry::main::distance_sq(b, d)
        geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) * geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) > 0
        =>:
            c = d
    claim:
        ? forall x, y R:
            x^2 = y^2
            x * y >= 0
            =>:
                x = y
        by contra:
            ? x = y
            x != y
            x - y != 0
            (x - y) * (x + y) = x^2 - y^2 = 0
            x + y = 0 / (x - y) = 0
            y = -x
            x * y = x * (-x) = -(x^2)
            x^2 = -(-(x^2)) = -(x * y) <= 0
            x^2 >= 0
            x^2 = 0
            x = 0
            y = -x = 0
            x = y
            impossible x != y
    release thm geometry::main::twice_dot_from_distances_direct(b, a, c)
    release thm geometry::main::twice_dot_from_distances_direct(b, a, d)
    release thm geometry::main::distance_sq_symmetric(a, b)
    2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c)) = 2 * ((geometry::main::distance_sq(b, a) + geometry::main::distance_sq(a, c) - geometry::main::distance_sq(b, c)) / 2) = (geometry::main::distance_sq(b, a) + geometry::main::distance_sq(a, c) - geometry::main::distance_sq(b, c)) = geometry::main::distance_sq(a, b) + geometry::main::distance_sq(a, c) - geometry::main::distance_sq(b, c)
    2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, d)) = 2 * ((geometry::main::distance_sq(b, a) + geometry::main::distance_sq(a, d) - geometry::main::distance_sq(b, d)) / 2) = (geometry::main::distance_sq(b, a) + geometry::main::distance_sq(a, d) - geometry::main::distance_sq(b, d)) = geometry::main::distance_sq(a, b) + geometry::main::distance_sq(a, d) - geometry::main::distance_sq(b, d)
    2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c)) = geometry::main::distance_sq(a, b) + geometry::main::distance_sq(a, c) - geometry::main::distance_sq(b, c) = geometry::main::distance_sq(a, b) + geometry::main::distance_sq(a, d) - geometry::main::distance_sq(b, d) = 2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, d))
    geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c)) = (2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c))) / 2 = (2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, d))) / 2 = geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, d))
    release thm geometry::main::dot_squared_plus_det_squared(geometry::main::vec(a, b), geometry::main::vec(a, c))
    release thm geometry::main::dot_squared_plus_det_squared(geometry::main::vec(a, b), geometry::main::vec(a, d))
    geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, b)) = geometry::main::distance_sq(a, b)
    geometry::main::dot(geometry::main::vec(a, c), geometry::main::vec(a, c)) = geometry::main::distance_sq(a, c)
    geometry::main::dot(geometry::main::vec(a, d), geometry::main::vec(a, d)) = geometry::main::distance_sq(a, d)
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 = (geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 + geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))^2) - geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 = geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, b)) * geometry::main::dot(geometry::main::vec(a, c), geometry::main::vec(a, c)) - geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 = geometry::main::distance_sq(a, b) * geometry::main::distance_sq(a, c) - geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c))^2
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d))^2 = (geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, d))^2 + geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d))^2) - geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, d))^2 = geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, b)) * geometry::main::dot(geometry::main::vec(a, d), geometry::main::vec(a, d)) - geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, d))^2 = geometry::main::distance_sq(a, b) * geometry::main::distance_sq(a, d) - geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, d))^2
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 = geometry::main::distance_sq(a, b) * geometry::main::distance_sq(a, c) - geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 = geometry::main::distance_sq(a, b) * geometry::main::distance_sq(a, d) - geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 = geometry::main::distance_sq(a, b) * geometry::main::distance_sq(a, d) - geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, d))^2 = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d))^2
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) * geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) >= 0
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d))
    have dx R = b(1) - a(1)
    have dy R = b(2) - a(2)
    have vx R = c(1) - d(1)
    have vy R = c(2) - d(2)
    release thm geometry::main::vec_coordinate_formula(a, b)
    release thm geometry::main::vec_coordinate_formula(a, c)
    release thm geometry::main::vec_coordinate_formula(a, d)
    geometry::main::vec(a, b)(1) = dx
    geometry::main::vec(a, b)(2) = dy
    geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c)) = dx * (c(1) - a(1)) + dy * (c(2) - a(2))
    geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, d)) = dx * (d(1) - a(1)) + dy * (d(2) - a(2))
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) = dx * (c(2) - a(2)) - dy * (c(1) - a(1))
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) = dx * (d(2) - a(2)) - dy * (d(1) - a(1))
    dx * vx + dy * vy = dx * (c(1) - d(1)) + dy * (c(2) - d(2)) = (dx * (c(1) - a(1)) + dy * (c(2) - a(2))) - (dx * (d(1) - a(1)) + dy * (d(2) - a(2))) = geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c)) - geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, d)) = 0
    dx * vy - dy * vx = dx * (c(2) - d(2)) - dy * (c(1) - d(1)) = (dx * (c(2) - a(2)) - dy * (c(1) - a(1))) - (dx * (d(2) - a(2)) - dy * (d(1) - a(1))) = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) - geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) = 0
    release thm geometry::main::distance_sq_coordinate_formula(a, b)
    release thm geometry::main::distance_sq_positive_of_ne(a, b)
    dx^2 + dy^2 = (b(1) - a(1))^2 + (b(2) - a(2))^2 = geometry::main::distance_sq(a, b) > 0
    release thm geometry::main::dot_det_eliminate(dx, dy, vx, vy)
    c(1) - d(1) = vx = 0
    c(2) - d(2) = vy = 0
    c(1) = d(1)
    c(2) = d(2)
    c = (c(1), c(2)) = (d(1), d(2)) = d


# Book I.8: three equal corresponding sides give equal included angles.
# The analytic SSS interface and the signed-cosine bridge also establish
# full congruence and all three corresponding angles, a valid strengthening.

thm proposition_8:
    ? forall p, q, r, u, v, w cart(R, R):
        $geometry::main::is_triangle(p, q, r)
        $geometry::main::is_triangle(u, v, w)
        $geometry::main::are_segments_congruent(p, q, u, v)
        $geometry::main::are_segments_congruent(q, r, v, w)
        $geometry::main::are_segments_congruent(r, p, w, u)
        =>:
            $geometry::main::are_triangles_congruent(p, q, r, u, v, w)
            $geometry::main::are_angles_congruent(p, q, r, u, v, w)
            $geometry::main::are_angles_congruent(q, p, r, v, u, w)
            $geometry::main::are_angles_congruent(p, r, q, u, w, v)
    release thm geometry_lemmas::triangle_vertices_distinct(p, q, r)
    release thm geometry_lemmas::triangle_vertices_distinct(u, v, w)
    release thm geometry::main::distance_sq_symmetric(p, r)
    release thm geometry::main::distance_sq_symmetric(u, w)
    geometry::main::distance_sq(p, r) = geometry::main::distance_sq(r, p) = geometry::main::distance_sq(w, u) = geometry::main::distance_sq(u, w)
    release thm geometry::main::sss_congruence(p, q, r, u, v, w)
    by def $geometry::main::are_triangles_congruent(p, q, r, u, v, w)
    release thm geometry::main::distance_sq_symmetric(p, q)
    release thm geometry::main::distance_sq_symmetric(u, v)
    geometry::main::distance_sq(q, p) = geometry::main::distance_sq(p, q) = geometry::main::distance_sq(u, v) = geometry::main::distance_sq(v, u)
    by thm geometry_lemmas::angle_congruence_from_equal_sides_and_dot(q, p, r, v, u, w) => $geometry::main::are_angles_congruent(p, q, r, u, v, w)
    by thm geometry_lemmas::angle_congruence_from_equal_sides_and_dot(p, q, r, u, v, w) => $geometry::main::are_angles_congruent(q, p, r, v, u, w)
    release thm geometry::main::distance_sq_symmetric(q, r)
    release thm geometry::main::distance_sq_symmetric(v, w)
    geometry::main::distance_sq(r, q) = geometry::main::distance_sq(q, r) = geometry::main::distance_sq(v, w) = geometry::main::distance_sq(w, v)
    by thm geometry_lemmas::angle_congruence_from_equal_sides_and_dot(r, p, q, w, u, v) => $geometry::main::are_angles_congruent(p, r, q, u, w, v)

# Book I.9: a positive weighted-average witness for the internal bisector.
# The source uses I.3, I.1 and I.8. The analytic proof uses independently
# established metric and determinant laws in the real plane.
thm proposition_9:
    ? forall a, b, c cart(R, R):
        $geometry::main::is_triangle(a, b, c)
        =>:
            exist d cart(R, R) st {a != d, b != d, c != d, $geometry::main::is_on_segment(d, b, c), $geometry::main::are_angles_congruent(b, a, d, d, a, c)}
    release thm geometry_lemmas::triangle_vertices_distinct(a, b, c)
    release thm geometry::main::distance_sq_positive_of_ne(a, b)
    release thm geometry::main::distance_sq_positive_of_ne(a, c)
    have left_sq R+ = geometry::main::distance_sq(a, b)
    have right_sq R+ = geometry::main::distance_sq(a, c)
    have left R+ = sqrt(left_sq)
    have right R+ = sqrt(right_sq)
    sqrt(left_sq)^2 = left_sq
    left^2 = sqrt(left_sq)^2 = left_sq
    sqrt(right_sq)^2 = right_sq
    right^2 = sqrt(right_sq)^2 = right_sq
    have length_total R+ = left + right
    have t R+ = left / length_total
    left < length_total
    t = left / length_total < length_total / length_total = 1
    1 - t = 1 - left / length_total = (length_total - left) / length_total = right / length_total
    have cut cart(R, R) = ((right * b(1) + left * c(1)) / length_total, (right * b(2) + left * c(2)) / length_total)
    cut(1) = (right * b(1) + left * c(1)) / length_total = (right / length_total) * b(1) + (left / length_total) * c(1) = (1 - t) * b(1) + t * c(1)
    cut(2) = (right * b(2) + left * c(2)) / length_total = (right / length_total) * b(2) + (left / length_total) * c(2) = (1 - t) * b(2) + t * c(2)
    witness exist k R st {0 <= k, k <= 1, cut(1) = (1 - k) * b(1) + k * c(1), cut(2) = (1 - k) * b(2) + k * c(2)} from t
    by def $geometry::main::is_on_segment(cut, b, c)
    have u cart(R, R) = geometry::main::vec(a, b)
    have v cart(R, R) = geometry::main::vec(a, c)
    have w cart(R, R) = geometry::main::vec(a, cut)
    have cross R = geometry::main::det(u, v)
    have inner R = geometry::main::dot(u, v)
    by contra:
        ? not $geometry::main::is_collinear(a, b, c)
        $geometry::main::is_collinear(a, b, c)
        geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) = 0
        impossible geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) != 0
    release thm geometry::main::triangle_det_nonzero(a, b, c)
    cross = geometry::main::det(u, v) = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) != 0
    release thm geometry::main::triangle_det_square_positive(a, b, c)
    cross^2 > 0
    cross^2 $in R+
    length_total^2 $in R+
    left * right $in R+
    (left * right) * cross^2 $in R+
    ((left * right) * cross^2) / length_total^2 $in R+
    left * right * cross^2 / length_total^2 $in R+
    release thm geometry::main::vec_dot_self_is_distance(a, b)
    release thm geometry::main::vec_dot_self_is_distance(a, c)
    release thm geometry::main::dot_coordinate_formula(u, u)
    u(1)^2 + u(2)^2 = u(1) * u(1) + u(2) * u(2) = geometry::main::dot(u, u) = geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, b)) = geometry::main::distance_sq(a, b) = left_sq = left^2
    release thm geometry::main::dot_coordinate_formula(v, v)
    v(1)^2 + v(2)^2 = v(1) * v(1) + v(2) * v(2) = geometry::main::dot(v, v) = geometry::main::dot(geometry::main::vec(a, c), geometry::main::vec(a, c)) = geometry::main::distance_sq(a, c) = right_sq = right^2
    u(1) = geometry::main::vec(a, b)(1) = b(1) - a(1)
    v(1) = geometry::main::vec(a, c)(1) = c(1) - a(1)
    u(2) = geometry::main::vec(a, b)(2) = b(2) - a(2)
    v(2) = geometry::main::vec(a, c)(2) = c(2) - a(2)
    w(1) = cut(1) - a(1) = (right * b(1) + left * c(1)) / length_total - a(1) = (right * b(1) + left * c(1) - length_total * a(1)) / length_total = (right * b(1) + left * c(1) - (left + right) * a(1)) / length_total = (right * (b(1) - a(1)) + left * (c(1) - a(1))) / length_total = (right * u(1) + left * v(1)) / length_total
    w(2) = cut(2) - a(2) = (right * b(2) + left * c(2)) / length_total - a(2) = (right * b(2) + left * c(2) - length_total * a(2)) / length_total = (right * b(2) + left * c(2) - (left + right) * a(2)) / length_total = (right * (b(2) - a(2)) + left * (c(2) - a(2))) / length_total = (right * u(2) + left * v(2)) / length_total
    release thm geometry::main::dot_coordinate_formula(u, v)
    inner = geometry::main::dot(u, v) = u(1) * v(1) + u(2) * v(2)
    geometry::main::dot(u, w) = u(1) * w(1) + u(2) * w(2) = u(1) * ((right * u(1) + left * v(1)) / length_total) + u(2) * ((right * u(2) + left * v(2)) / length_total) = (right * (u(1)^2 + u(2)^2) + left * (u(1) * v(1) + u(2) * v(2))) / length_total = (right * (u(1)^2 + u(2)^2) + left * inner) / length_total = (right * left^2 + left * inner) / length_total = left * (left * right + inner) / length_total
    geometry::main::dot(w, v) = w(1) * v(1) + w(2) * v(2) = ((right * u(1) + left * v(1)) / length_total) * v(1) + ((right * u(2) + left * v(2)) / length_total) * v(2) = (right * (u(1) * v(1) + u(2) * v(2)) + left * (v(1)^2 + v(2)^2)) / length_total = (right * inner + left * (v(1)^2 + v(2)^2)) / length_total = (right * inner + left * right^2) / length_total = right * (left * right + inner) / length_total
    release thm geometry::main::det_coordinate_formula(u, v)
    cross = geometry::main::det(u, v) = u(1) * v(2) - u(2) * v(1)
    geometry::main::det(u, w) = u(1) * w(2) - u(2) * w(1) = u(1) * ((right * u(2) + left * v(2)) / length_total) - u(2) * ((right * u(1) + left * v(1)) / length_total) = left * (u(1) * v(2) - u(2) * v(1)) / length_total = left * cross / length_total
    geometry::main::det(w, v) = w(1) * v(2) - w(2) * v(1) = ((right * u(1) + left * v(1)) / length_total) * v(2) - ((right * u(2) + left * v(2)) / length_total) * v(1) = right * (u(1) * v(2) - u(2) * v(1)) / length_total = right * cross / length_total
    geometry::main::det(u, w) * geometry::main::det(w, v) = (left * cross / length_total) * (right * cross / length_total) = left * right * cross^2 / length_total^2 > 0
    geometry::main::dot(u, w) * geometry::main::det(w, v) = (left * (left * right + inner) / length_total) * (right * cross / length_total) = (left * cross / length_total) * (right * (left * right + inner) / length_total) = geometry::main::det(u, w) * geometry::main::dot(w, v)
    by contra:
        ? a != cut
        a = cut
        cut(1) = a(1)
        cut(2) = a(2)
        w(1) = cut(1) - a(1) = 0
        w(2) = cut(2) - a(2) = 0
        geometry::main::det(u, w) = u(1) * 0 - u(2) * 0 = 0
        geometry::main::det(u, w) * geometry::main::det(w, v) = 0
        impossible geometry::main::det(u, w) * geometry::main::det(w, v) > 0
    by contra:
        ? b != cut
        b = cut
        cut(1) = b(1)
        cut(2) = b(2)
        w(1) = cut(1) - a(1) = b(1) - a(1) = u(1)
        w(2) = cut(2) - a(2) = b(2) - a(2) = u(2)
        geometry::main::det(u, w) = u(1) * u(2) - u(2) * u(1) = 0
        geometry::main::det(u, w) * geometry::main::det(w, v) = 0
        impossible geometry::main::det(u, w) * geometry::main::det(w, v) > 0
    by contra:
        ? c != cut
        c = cut
        cut(1) = c(1)
        cut(2) = c(2)
        w(1) = cut(1) - a(1) = c(1) - a(1) = v(1)
        w(2) = cut(2) - a(2) = c(2) - a(2) = v(2)
        geometry::main::det(w, v) = v(1) * v(2) - v(2) * v(1) = 0
        geometry::main::det(u, w) * geometry::main::det(w, v) = 0
        impossible geometry::main::det(u, w) * geometry::main::det(w, v) > 0
    (b(1) - a(1)) * (cut(2) - a(2)) - (b(2) - a(2)) * (cut(1) - a(1)) = geometry::main::det(u, w)
    (cut(1) - a(1)) * (c(2) - a(2)) - (cut(2) - a(2)) * (c(1) - a(1)) = geometry::main::det(w, v)
    ((b(1) - a(1)) * (cut(2) - a(2)) - (b(2) - a(2)) * (cut(1) - a(1))) * ((cut(1) - a(1)) * (c(2) - a(2)) - (cut(2) - a(2)) * (c(1) - a(1))) = geometry::main::det(u, w) * geometry::main::det(w, v) > 0
    ((b(1) - a(1)) * (cut(1) - a(1)) + (b(2) - a(2)) * (cut(2) - a(2))) = geometry::main::dot(u, w)
    ((cut(1) - a(1)) * (c(1) - a(1)) + (cut(2) - a(2)) * (c(2) - a(2))) = geometry::main::dot(w, v)
    ((b(1) - a(1)) * (cut(1) - a(1)) + (b(2) - a(2)) * (cut(2) - a(2))) * ((cut(1) - a(1)) * (c(2) - a(2)) - (cut(2) - a(2)) * (c(1) - a(1))) = geometry::main::dot(u, w) * geometry::main::det(w, v) = geometry::main::det(u, w) * geometry::main::dot(w, v) = ((b(1) - a(1)) * (cut(2) - a(2)) - (b(2) - a(2)) * (cut(1) - a(1))) * ((cut(1) - a(1)) * (c(1) - a(1)) + (cut(2) - a(2)) * (c(2) - a(2)))
    release thm geometry::main::cross_ratio_same_det_sign_implies_angle_congruence(b, a, cut, cut, a, c)
    witness exist d cart(R, R) st {a != d, b != d, c != d, $geometry::main::is_on_segment(d, b, c), $geometry::main::are_angles_congruent(b, a, d, d, a, c)} from cut

# Book I.10: an analytic midpoint witness for a finite nonzero segment.
# The source constructs an equilateral triangle and bisects its apex angle;
# this proof instead verifies the coordinate average directly.
thm proposition_10:
    ? forall a, b cart(R, R):
        a != b
        =>:
            exist m cart(R, R) st {a != m, m != b, $geometry::main::is_on_segment(m, a, b), $geometry::main::are_segments_congruent(a, m, m, b)}
    have middle cart(R, R) = ((a(1) + b(1)) / 2, (a(2) + b(2)) / 2)
    middle(1) = (a(1) + b(1)) / 2
    middle(2) = (a(2) + b(2)) / 2
    by def $geometry::main::is_midpoint(middle, a, b)
    middle(1) = (a(1) + b(1)) / 2 = a(1) / 2 + b(1) / 2 = (1 / 2) * a(1) + (1 / 2) * b(1) = (1 - 1 / 2) * a(1) + (1 / 2) * b(1)
    middle(2) = (a(2) + b(2)) / 2 = a(2) / 2 + b(2) / 2 = (1 / 2) * a(2) + (1 / 2) * b(2) = (1 - 1 / 2) * a(2) + (1 / 2) * b(2)
    witness exist t R st {0 <= t, t <= 1, middle(1) = (1 - t) * a(1) + t * b(1), middle(2) = (1 - t) * a(2) + t * b(2)} from 1 / 2
    by def $geometry::main::is_on_segment(middle, a, b)
    release thm geometry::main::midpoint_equidistant(a, b, middle)
    release thm geometry::main::midpoint_half_distance(a, b, middle)
    release thm geometry::main::distance_sq_symmetric(b, middle)
    geometry::main::distance_sq(a, middle) = geometry::main::distance_sq(b, middle) = geometry::main::distance_sq(middle, b)
    release thm geometry::main::distance_sq_positive_of_ne(a, b)
    geometry::main::distance_sq(a, middle) = geometry::main::distance_sq(a, b) / 4 > 0
    geometry::main::distance_sq(middle, b) > 0
    by contra:
        ? a != middle
        a = middle
        middle(1) = a(1)
        middle(2) = a(2)
        release thm geometry::main::distance_sq_coordinate_formula(a, middle)
        middle(1) - a(1) = 0
        middle(2) - a(2) = 0
        geometry::main::distance_sq(a, middle) = (middle(1) - a(1))^2 + (middle(2) - a(2))^2 = 0^2 + 0^2 = 0
        impossible geometry::main::distance_sq(a, middle) > 0
    by contra:
        ? middle != b
        middle = b
        b(1) = middle(1)
        b(2) = middle(2)
        release thm geometry::main::distance_sq_coordinate_formula(middle, b)
        b(1) - middle(1) = 0
        b(2) - middle(2) = 0
        geometry::main::distance_sq(middle, b) = (b(1) - middle(1))^2 + (b(2) - middle(2))^2 = 0^2 + 0^2 = 0
        impossible geometry::main::distance_sq(middle, b) > 0
    by def $geometry::main::are_segments_congruent(a, middle, middle, b)
    witness exist m cart(R, R) st {a != m, m != b, $geometry::main::is_on_segment(m, a, b), $geometry::main::are_segments_congruent(a, m, m, b)} from middle

# Book I.11: construct a perpendicular at a supplied point of a straight line.
# The analytic witness rotates the line's nonzero direction by 90 degrees.
thm proposition_11:
    ? forall a, b, c cart(R, R):
        $geometry::main::is_on_line(c, a, b)
        =>:
            exist d cart(R, R) st {c != d, $geometry::main::is_perpendicular(a, b, c, d)}
    release thm geometry::main::point_difference_norm_pos(a, b)
    have dx R = b(1) - a(1)
    have dy R = b(2) - a(2)
    dx^2 + dy^2 = (b(1) - a(1))^2 + (b(2) - a(2))^2 > 0
    have endpoint cart(R, R) = (c(1) - dy, c(2) + dx)
    endpoint(1) = c(1) - dy
    endpoint(1) - c(1) = (c(1) - dy) - c(1) = -dy
    endpoint(2) = c(2) + dx
    endpoint(2) - c(2) = (c(2) + dx) - c(2) = dx
    by contra:
        ? c != endpoint
        c = endpoint
        endpoint(1) = c(1)
        endpoint(2) = c(2)
        endpoint(1) - c(1) = 0
        endpoint(2) - c(2) = 0
        -dy = 0
        dy = -(-dy) = -0 = 0
        dx = 0
        dx^2 + dy^2 = 0^2 + 0^2 = 0
        impossible dx^2 + dy^2 > 0
    geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(c, endpoint)) = dx * (-dy) + dy * dx = 0
    by def $geometry::main::is_perpendicular(a, b, c, endpoint)
    witness exist d cart(R, R) st {c != d, $geometry::main::is_perpendicular(a, b, c, d)} from endpoint

# Book I.12: a perpendicular from an external point to an infinite line.
# The analytic witness is the orthogonal projection on the supplied line.
thm proposition_12:
    ? forall a, b, p cart(R, R):
        a != b
        not $geometry::main::is_on_line(p, a, b)
        =>:
            exist f cart(R, R) st {$geometry::main::is_on_line(f, a, b), p != f, $geometry::main::is_perpendicular(p, f, a, b)}
    release thm geometry::main::point_difference_norm_pos(a, b)
    have norm_sq R+ = (b(1) - a(1))^2 + (b(2) - a(2))^2
    have projection R = (p(1) - a(1)) * (b(1) - a(1)) + (p(2) - a(2)) * (b(2) - a(2))
    have t R = projection / norm_sq
    have foot cart(R, R) = (a(1) + t * (b(1) - a(1)), a(2) + t * (b(2) - a(2)))
    foot(1) = a(1) + t * (b(1) - a(1))
    foot(2) = a(2) + t * (b(2) - a(2))
    foot(1) - a(1) = (a(1) + t * (b(1) - a(1))) - a(1) = t * (b(1) - a(1))
    foot(2) - a(2) = (a(2) + t * (b(2) - a(2))) - a(2) = t * (b(2) - a(2))
    geometry::main::det(geometry::main::vec(a, foot), geometry::main::vec(a, b)) = (foot(1) - a(1)) * (b(2) - a(2)) - (foot(2) - a(2)) * (b(1) - a(1)) = (t * (b(1) - a(1))) * (b(2) - a(2)) - (t * (b(2) - a(2))) * (b(1) - a(1)) = 0
    release obj def geometry::main::line_through_points
    foot $in geometry::main::line_through_points(a, b)
    by def $geometry::main::is_on_line(foot, a, b)
    projection = (projection / norm_sq) * norm_sq = t * norm_sq
    (p(1) - a(1)) * (b(1) - a(1)) + (p(2) - a(2)) * (b(2) - a(2)) = t * ((b(1) - a(1))^2 + (b(2) - a(2))^2)
    release thm geometry::main::foot_perp_parametric(a, b, p, foot, t)
    by contra:
        ? p != foot
        p = foot
        $geometry::main::is_on_line(p, a, b)
        impossible not $geometry::main::is_on_line(p, a, b)
    by def $geometry::main::is_perpendicular(p, foot, a, b)
    witness exist f cart(R, R) st {$geometry::main::is_on_line(f, a, b), p != f, $geometry::main::is_perpendicular(p, f, a, b)} from foot


release obj def angle_measure::ray_angle
release obj def angles::angle_cosine

# Book I, Proposition 13: adjacent angles at a strict interior base point sum to two right angles.
# The strict affine parameter makes the base rays opposite; principal radian measures sum to pi.
# Book I, Proposition 13: adjacent angles at a strict interior base point sum to two right angles.
# The strict affine parameter makes the base rays opposite; principal radian measures sum to pi.
thm proposition_13:
    ? forall a, b, q, p cart(R, R), t R+:
        a != b
        q != a
        q != b
        p != q
        not $geometry::main::is_collinear(a, b, p)
        t < 1
        q(1) = a(1) + t * (b(1) - a(1))
        q(2) = a(2) + t * (b(2) - a(2))
        =>:
            angle_measure::ray_angle(a, q, p) + angle_measure::ray_angle(p, q, b) = pi
    have x R = b(1) - a(1)
    have y R = b(2) - a(2)
    have u R = p(1) - q(1)
    have v R = p(2) - q(2)
    have n R = x * u + y * v
    a(1) - q(1) = a(1) - (a(1) + t * (b(1) - a(1))) = -t * (b(1) - a(1)) = -t * x
    a(2) - q(2) = a(2) - (a(2) + t * (b(2) - a(2))) = -t * (b(2) - a(2)) = -t * y
    b(1) - q(1) = b(1) - (a(1) + t * (b(1) - a(1))) = (1 - t) * (b(1) - a(1)) = (1 - t) * x
    b(2) - q(2) = b(2) - (a(2) + t * (b(2) - a(2))) = (1 - t) * (b(2) - a(2)) = (1 - t) * y
    geometry::main::angle_cos_num(a, q, p) = geometry::main::dot(geometry::main::vec(q, a), geometry::main::vec(q, p)) = (a(1) - q(1)) * (p(1) - q(1)) + (a(2) - q(2)) * (p(2) - q(2)) = (-t * x) * u + (-t * y) * v = -t * (x * u + y * v) = -t * n
    geometry::main::angle_cos_num(p, q, b) = geometry::main::dot(geometry::main::vec(q, p), geometry::main::vec(q, b)) = (p(1) - q(1)) * (b(1) - q(1)) + (p(2) - q(2)) * (b(2) - q(2)) = u * ((1 - t) * x) + v * ((1 - t) * y) = (1 - t) * (x * u + y * v) = (1 - t) * n
    release thm geometry::main::distance_sq_positive_of_ne(a, b)
    release thm geometry::main::distance_sq_positive_of_ne(q, p)
    have norm R+ = geometry::main::distance_sq(a, b) * geometry::main::distance_sq(q, p)
    release thm geometry::main::affine_distance_from_parameter(a, b, q, t)
    geometry::main::angle_cos_den(a, q, p) = geometry::main::distance_sq(q, a) * geometry::main::distance_sq(q, p) = (t^2 * geometry::main::distance_sq(a, b)) * geometry::main::distance_sq(q, p) = t^2 * (geometry::main::distance_sq(a, b) * geometry::main::distance_sq(q, p)) = t^2 * norm
    geometry::main::angle_cos_den(p, q, b) = geometry::main::distance_sq(q, p) * geometry::main::distance_sq(q, b) = geometry::main::distance_sq(q, p) * ((1 - t)^2 * geometry::main::distance_sq(a, b)) = (1 - t)^2 * (geometry::main::distance_sq(a, b) * geometry::main::distance_sq(q, p)) = (1 - t)^2 * norm
    release thm angles::angle_den_nonnegative(a, q, p)
    release thm angles::angle_root_den_nonzero(a, q, p)
    release thm angles::angle_den_nonnegative(p, q, b)
    release thm angles::angle_root_den_nonzero(p, q, b)
    have s R+ = 1 - t
    release thm angle_measure::scaled_positive_root_domain(t, norm)
    release thm angle_measure::scaled_positive_root_domain(s, norm)
    release thm angle_measure::opposite_scaled_cosine_cross_products(n, norm, t, s)
    t^2 * norm > 0
    s^2 * norm > 0
    have root_a R+ = sqrt(t^2 * norm)
    have root_b R+ = sqrt(s^2 * norm)
    (-t * n) * root_b = (-t * n) * sqrt(s^2 * norm) = -(s * n) * sqrt(t^2 * norm) = -(s * n) * root_a
    (-t * n) / root_a = ((-t * n) * root_b) / (root_a * root_b) = (-(s * n) * root_a) / (root_a * root_b) = -(s * n) / root_b = -((s * n) / root_b)
    sqrt(geometry::main::angle_cos_den(a, q, p)) = sqrt(t^2 * norm) = root_a
    angles::angle_cosine(a, q, p) = geometry::main::angle_cos_num(a, q, p) / sqrt(geometry::main::angle_cos_den(a, q, p)) = (-t * n) / root_a
    geometry::main::angle_cos_num(p, q, b) = (1 - t) * n = s * n
    geometry::main::angle_cos_den(p, q, b) = (1 - t)^2 * norm = s^2 * norm
    sqrt(geometry::main::angle_cos_den(p, q, b)) = sqrt(s^2 * norm) = root_b
    angles::angle_cosine(p, q, b) = geometry::main::angle_cos_num(p, q, b) / sqrt(geometry::main::angle_cos_den(p, q, b)) = (s * n) / root_b
    angles::angle_cosine(a, q, p) = (-t * n) / root_a = -((s * n) / root_b) = -angles::angle_cosine(p, q, b)
    angles::angle_cosine(p, q, b) = -(-angles::angle_cosine(p, q, b)) = -angles::angle_cosine(a, q, p)
    release thm angle_measure::opposite_cosines_give_supplementary_angles(a, q, p, p, q, b)


# Book I.14: supplementary adjacent angles on opposite sides force opposite rays.
# The determinant sign condition implements the source's "not lying on the same side".
thm proposition_14:
    ? forall a, q, c, d cart(R, R):
        a != q
        c != q
        d != q
        geometry::main::det(geometry::main::vec(q, a), geometry::main::vec(q, c)) * geometry::main::det(geometry::main::vec(q, a), geometry::main::vec(q, d)) < 0
        angle_measure::ray_angle(a, q, c) + angle_measure::ray_angle(d, q, a) = pi
        =>:
            geometry::main::det(geometry::main::vec(q, c), geometry::main::vec(q, d)) = 0
            geometry::main::dot(geometry::main::vec(q, c), geometry::main::vec(q, d)) < 0
    release thm angle_measure::supplementary_measures_imply_opposite_cosines(a, q, c, d, q, a)
    release thm geometry::main::distance_sq_positive_of_ne(q, a)
    release thm geometry::main::distance_sq_positive_of_ne(q, c)
    release thm geometry::main::distance_sq_positive_of_ne(q, d)
    have norm_a R+ = geometry::main::distance_sq(q, a)
    have norm_c R+ = geometry::main::distance_sq(q, c)
    have norm_d R+ = geometry::main::distance_sq(q, d)
    have n R = geometry::main::dot(geometry::main::vec(q, a), geometry::main::vec(q, c))
    have m R = geometry::main::dot(geometry::main::vec(q, a), geometry::main::vec(q, d))
    have delta_c R = geometry::main::det(geometry::main::vec(q, a), geometry::main::vec(q, c))
    have delta_d R = geometry::main::det(geometry::main::vec(q, a), geometry::main::vec(q, d))
    have den_1 R+ = norm_a * norm_c
    have den_2 R+ = norm_a * norm_d
    geometry::main::angle_cos_num(a, q, c) = geometry::main::dot(geometry::main::vec(q, a), geometry::main::vec(q, c)) = n
    release thm geometry::main::dot_commutative(q, d, q, a)
    geometry::main::angle_cos_num(d, q, a) = geometry::main::dot(geometry::main::vec(q, d), geometry::main::vec(q, a)) = geometry::main::dot(geometry::main::vec(q, a), geometry::main::vec(q, d)) = m
    geometry::main::angle_cos_den(a, q, c) = geometry::main::distance_sq(q, a) * geometry::main::distance_sq(q, c) = norm_a * norm_c = den_1
    geometry::main::angle_cos_den(d, q, a) = geometry::main::distance_sq(q, d) * geometry::main::distance_sq(q, a) = norm_d * norm_a = norm_a * norm_d = den_2
    release thm geometry::main::vec_dot_self_is_distance(q, a)
    release thm geometry::main::vec_dot_self_is_distance(q, c)
    release thm geometry::main::vec_dot_self_is_distance(q, d)
    release thm geometry::main::dot_squared_plus_det_squared(geometry::main::vec(q, a), geometry::main::vec(q, c))
    release thm geometry::main::dot_squared_plus_det_squared(geometry::main::vec(q, a), geometry::main::vec(q, d))
    n^2 + delta_c^2 = geometry::main::dot(geometry::main::vec(q, a), geometry::main::vec(q, c))^2 + geometry::main::det(geometry::main::vec(q, a), geometry::main::vec(q, c))^2 = geometry::main::dot(geometry::main::vec(q, a), geometry::main::vec(q, a)) * geometry::main::dot(geometry::main::vec(q, c), geometry::main::vec(q, c)) = norm_a * norm_c = den_1
    m^2 + delta_d^2 = geometry::main::dot(geometry::main::vec(q, a), geometry::main::vec(q, d))^2 + geometry::main::det(geometry::main::vec(q, a), geometry::main::vec(q, d))^2 = geometry::main::dot(geometry::main::vec(q, a), geometry::main::vec(q, a)) * geometry::main::dot(geometry::main::vec(q, d), geometry::main::vec(q, d)) = norm_a * norm_d = den_2
    delta_d * delta_c = delta_c * delta_d = geometry::main::det(geometry::main::vec(q, a), geometry::main::vec(q, c)) * geometry::main::det(geometry::main::vec(q, a), geometry::main::vec(q, d)) < 0
    release thm angles::angle_den_nonnegative(a, q, c)
    release thm angles::angle_root_den_nonzero(a, q, c)
    release thm angles::angle_den_nonnegative(d, q, a)
    release thm angles::angle_root_den_nonzero(d, q, a)
    m / sqrt(den_2) = geometry::main::angle_cos_num(d, q, a) / sqrt(geometry::main::angle_cos_den(d, q, a)) = angles::angle_cosine(d, q, a) = -angles::angle_cosine(a, q, c) = -(geometry::main::angle_cos_num(a, q, c) / sqrt(geometry::main::angle_cos_den(a, q, c))) = -(n / sqrt(den_1))
    release thm angle_measure::opposite_normalized_projections(m, n, delta_d, delta_c, den_2, den_1)
    n * delta_d - m * delta_c = -(m * delta_c - n * delta_d) = -0 = 0
    n * m + delta_c * delta_d = m * n + delta_d * delta_c < 0
    release thm angle_measure::planar_gram_coordinate_identities(a(1) - q(1), a(2) - q(2), c(1) - q(1), c(2) - q(2), d(1) - q(1), d(2) - q(2))
    n = geometry::main::dot(geometry::main::vec(q, a), geometry::main::vec(q, c)) = (a(1) - q(1)) * (c(1) - q(1)) + (a(2) - q(2)) * (c(2) - q(2))
    m = geometry::main::dot(geometry::main::vec(q, a), geometry::main::vec(q, d)) = (a(1) - q(1)) * (d(1) - q(1)) + (a(2) - q(2)) * (d(2) - q(2))
    delta_c = geometry::main::det(geometry::main::vec(q, a), geometry::main::vec(q, c)) = (a(1) - q(1)) * (c(2) - q(2)) - (a(2) - q(2)) * (c(1) - q(1))
    delta_d = geometry::main::det(geometry::main::vec(q, a), geometry::main::vec(q, d)) = (a(1) - q(1)) * (d(2) - q(2)) - (a(2) - q(2)) * (d(1) - q(1))
    release thm geometry::main::distance_sq_coordinate_formula(q, a)
    norm_a = geometry::main::distance_sq(q, a) = (a(1) - q(1))^2 + (a(2) - q(2))^2
    geometry::main::det(geometry::main::vec(q, c), geometry::main::vec(q, d)) = ((c(1) - q(1)) * (d(2) - q(2)) - (c(2) - q(2)) * (d(1) - q(1)))
    norm_a * geometry::main::det(geometry::main::vec(q, c), geometry::main::vec(q, d)) = ((a(1) - q(1))^2 + (a(2) - q(2))^2) * ((c(1) - q(1)) * (d(2) - q(2)) - (c(2) - q(2)) * (d(1) - q(1))) = ((a(1) - q(1)) * (c(1) - q(1)) + (a(2) - q(2)) * (c(2) - q(2))) * ((a(1) - q(1)) * (d(2) - q(2)) - (a(2) - q(2)) * (d(1) - q(1))) - ((a(1) - q(1)) * (d(1) - q(1)) + (a(2) - q(2)) * (d(2) - q(2))) * ((a(1) - q(1)) * (c(2) - q(2)) - (a(2) - q(2)) * (c(1) - q(1))) = n * delta_d - m * delta_c = 0
    geometry::main::dot(geometry::main::vec(q, c), geometry::main::vec(q, d)) = ((c(1) - q(1)) * (d(1) - q(1)) + (c(2) - q(2)) * (d(2) - q(2)))
    norm_a * geometry::main::dot(geometry::main::vec(q, c), geometry::main::vec(q, d)) = ((a(1) - q(1))^2 + (a(2) - q(2))^2) * ((c(1) - q(1)) * (d(1) - q(1)) + (c(2) - q(2)) * (d(2) - q(2))) = ((a(1) - q(1)) * (c(1) - q(1)) + (a(2) - q(2)) * (c(2) - q(2))) * ((a(1) - q(1)) * (d(1) - q(1)) + (a(2) - q(2)) * (d(2) - q(2))) + ((a(1) - q(1)) * (c(2) - q(2)) - (a(2) - q(2)) * (c(1) - q(1))) * ((a(1) - q(1)) * (d(2) - q(2)) - (a(2) - q(2)) * (d(1) - q(1))) = n * m + delta_c * delta_d < 0
    geometry::main::det(geometry::main::vec(q, c), geometry::main::vec(q, d)) = 0 / norm_a = 0
    geometry::main::dot(geometry::main::vec(q, c), geometry::main::vec(q, d)) = (norm_a * geometry::main::dot(geometry::main::vec(q, c), geometry::main::vec(q, d))) / norm_a < 0 / norm_a = 0


# Book I.15: both pairs of vertical angles at a genuine line intersection are equal.
thm proposition_15:
    ? forall a, b, c, d, o cart(R, R):
        a != b
        c != d
        $geometry::main::is_on_segment(o, a, b)
        a != o
        b != o
        $geometry::main::is_on_segment(o, c, d)
        c != o
        d != o
        not $geometry::main::is_collinear(a, o, c)
        =>:
            angle_measure::ray_angle(a, o, c) = angle_measure::ray_angle(b, o, d)
            angle_measure::ray_angle(a, o, d) = angle_measure::ray_angle(b, o, c)
    release thm geometry::main::vertical_angles_equal(a, b, c, d, o)
    by thm angle_measure::angle_relation_implies_equal_measure(a, o, c, b, o, d) => angle_measure::ray_angle(a, o, c) = angle_measure::ray_angle(b, o, d)
    release thm angle_measure::segment_membership_reverses_endpoints(o, c, d)
    release thm geometry::main::vertical_angles_equal(a, b, d, c, o)
    by thm angle_measure::angle_relation_implies_equal_measure(a, o, d, b, o, c) => angle_measure::ray_angle(a, o, d) = angle_measure::ray_angle(b, o, c)


# Book I.16: a triangle's exterior angle is larger than each opposite interior angle.
# Nondegenerate vertices and a proper extended ray are the domains of the displayed angles.
thm proposition_16:
    ? forall a, b, c, d cart(R, R):
        a != b
        a != c
        b != c
        d != c
        $geometry::main::is_triangle(a, b, c)
        $geometry::main::is_on_extension(d, b, c)
        =>:
            angle_measure::ray_angle(a, c, d) > angle_measure::ray_angle(b, a, c)
            angle_measure::ray_angle(a, c, d) > angle_measure::ray_angle(a, b, c)
    by def $geometry::main::is_triangle(a, b, c)
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 > 0
    release thm geometry::main::triangle_det_squared_vertex(a, b, c)
    geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c))^2 = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 > 0
    by contra:
        ? geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c)) != 0
        geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c)) = 0
        geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c))^2 = 0
        impossible geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c))^2 > 0
    by def $geometry::main::is_triangle(b, a, c)
    release thm angle_measure::two_internal_triangle_cosines_sum_positive(a, b, c)
    release thm angle_measure::two_internal_triangle_cosines_sum_positive(b, a, c)
    release thm angle_measure::angle_cosine_arms_symmetric(a, c, b)
    angles::angle_cosine(a, b, c) + angles::angle_cosine(a, c, b) = angles::angle_cosine(a, b, c) + angles::angle_cosine(b, c, a) > 0
    by def $geometry::main::is_on_extension(d, b, c)
    obtain t from exist coef R st {coef > 1, d(1) = (1 - coef) * b(1) + coef * c(1), d(2) = (1 - coef) * b(2) + coef * c(2)}
    have k R+ = t - 1
    d(1) - c(1) = ((1 - t) * b(1) + t * c(1)) - c(1) = -(t - 1) * (b(1) - c(1)) = -k * (b(1) - c(1))
    d(2) - c(2) = ((1 - t) * b(2) + t * c(2)) - c(2) = -(t - 1) * (b(2) - c(2)) = -k * (b(2) - c(2))
    release thm angle_measure::negative_ray_scale_changes_cosine_sign(a, c, b, d, k)
    angles::angle_cosine(b, a, c) = (angles::angle_cosine(b, a, c) + angles::angle_cosine(a, c, b)) - angles::angle_cosine(a, c, b) > 0 - angles::angle_cosine(a, c, b) = -angles::angle_cosine(a, c, b) = angles::angle_cosine(a, c, d)
    angles::angle_cosine(a, b, c) = (angles::angle_cosine(a, b, c) + angles::angle_cosine(a, c, b)) - angles::angle_cosine(a, c, b) > 0 - angles::angle_cosine(a, c, b) = -angles::angle_cosine(a, c, b) = angles::angle_cosine(a, c, d)
    release thm angle_measure::angle_cosine_bounded(a, c, d)
    release thm angle_measure::angle_cosine_bounded(b, a, c)
    release thm angle_measure::angle_cosine_bounded(a, b, c)
    release thm angle_measure::arccos_strictly_decreasing(angles::angle_cosine(a, c, d), angles::angle_cosine(b, a, c))
    release thm angle_measure::arccos_strictly_decreasing(angles::angle_cosine(a, c, d), angles::angle_cosine(a, b, c))
    angle_measure::ray_angle(a, c, d) = arccos(angles::angle_cosine(a, c, d)) > arccos(angles::angle_cosine(b, a, c)) = angle_measure::ray_angle(b, a, c)
    angle_measure::ray_angle(a, c, d) = arccos(angles::angle_cosine(a, c, d)) > arccos(angles::angle_cosine(a, b, c)) = angle_measure::ray_angle(a, b, c)


# Book I.17: each pair of interior triangle angles sums to less than two right angles.
thm proposition_17:
    ? forall a, b, c cart(R, R):
        a != b
        a != c
        b != c
        $geometry::main::is_triangle(a, b, c)
        =>:
            angle_measure::ray_angle(b, a, c) + angle_measure::ray_angle(a, b, c) < pi
            angle_measure::ray_angle(b, a, c) + angle_measure::ray_angle(a, c, b) < pi
            angle_measure::ray_angle(a, b, c) + angle_measure::ray_angle(a, c, b) < pi
    by def $geometry::main::is_triangle(a, b, c)
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 > 0
    release thm geometry::main::triangle_det_squared_vertex(a, b, c)
    geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c))^2 = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 > 0
    by contra:
        ? geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c)) != 0
        geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c)) = 0
        geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c))^2 = 0
        impossible geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c))^2 > 0
    by def $geometry::main::is_triangle(b, a, c)
    release thm geometry::main::det_antisymmetric(geometry::main::vec(a, c), geometry::main::vec(a, b))
    by contra:
        ? geometry::main::det(geometry::main::vec(a, c), geometry::main::vec(a, b)) != 0
        geometry::main::det(geometry::main::vec(a, c), geometry::main::vec(a, b)) = 0
        -geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) = 0
        geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) = -(-geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))) = -0 = 0
        impossible geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) != 0
    by def $geometry::main::is_triangle(a, c, b)
    release thm angle_measure::two_internal_triangle_cosines_sum_positive(a, b, c)
    release thm angle_measure::two_internal_triangle_cosines_sum_positive(b, a, c)
    release thm angle_measure::two_internal_triangle_cosines_sum_positive(a, c, b)
    release thm angle_measure::angle_cosine_arms_symmetric(a, c, b)
    release thm angle_measure::angle_cosine_arms_symmetric(b, a, c)
    angles::angle_cosine(a, b, c) + angles::angle_cosine(a, c, b) = angles::angle_cosine(a, b, c) + angles::angle_cosine(b, c, a) > 0
    angles::angle_cosine(b, a, c) + angles::angle_cosine(a, b, c) = angles::angle_cosine(c, a, b) + angles::angle_cosine(a, b, c) > 0
    release thm angle_measure::angle_cosine_bounded(b, a, c)
    release thm angle_measure::angle_cosine_bounded(a, b, c)
    release thm angle_measure::angle_cosine_bounded(a, c, b)
    release thm angle_measure::positive_cosine_sum_implies_angle_sum_below_pi(angles::angle_cosine(b, a, c), angles::angle_cosine(a, b, c))
    release thm angle_measure::positive_cosine_sum_implies_angle_sum_below_pi(angles::angle_cosine(b, a, c), angles::angle_cosine(a, c, b))
    release thm angle_measure::positive_cosine_sum_implies_angle_sum_below_pi(angles::angle_cosine(a, b, c), angles::angle_cosine(a, c, b))
    angle_measure::ray_angle(b, a, c) + angle_measure::ray_angle(a, b, c) = arccos(angles::angle_cosine(b, a, c)) + arccos(angles::angle_cosine(a, b, c)) < pi
    angle_measure::ray_angle(b, a, c) + angle_measure::ray_angle(a, c, b) = arccos(angles::angle_cosine(b, a, c)) + arccos(angles::angle_cosine(a, c, b)) < pi
    angle_measure::ray_angle(a, b, c) + angle_measure::ray_angle(a, c, b) = arccos(angles::angle_cosine(a, b, c)) + arccos(angles::angle_cosine(a, c, b)) < pi


release obj def angle_measure::segment_length


# Book I.18: a greater triangle side subtends a greater angle.
# Positive lengths and their squares have the same strict order.
thm proposition_18:
    ? forall a, b, c cart(R, R):
        a != b
        a != c
        b != c
        $geometry::main::is_triangle(a, b, c)
        geometry::main::distance_sq(a, c) > geometry::main::distance_sq(a, b)
        =>:
            angle_measure::ray_angle(a, b, c) > angle_measure::ray_angle(a, c, b)
    release thm angle_measure::greater_side_has_smaller_opposite_cosine(a, b, c)
    release thm angle_measure::angle_cosine_bounded(a, b, c)
    release thm angle_measure::angle_cosine_bounded(a, c, b)
    release thm angle_measure::arccos_strictly_decreasing(angles::angle_cosine(a, b, c), angles::angle_cosine(a, c, b))
    angle_measure::ray_angle(a, b, c) = arccos(angles::angle_cosine(a, b, c)) > arccos(angles::angle_cosine(a, c, b)) = angle_measure::ray_angle(a, c, b)


# Book I.19: a greater triangle angle has the greater opposite side.
thm proposition_19:
    ? forall a, b, c cart(R, R):
        a != b
        a != c
        b != c
        $geometry::main::is_triangle(a, b, c)
        angle_measure::ray_angle(a, b, c) > angle_measure::ray_angle(a, c, b)
        =>:
            geometry::main::distance_sq(a, c) > geometry::main::distance_sq(a, b)
    by contra:
        ? geometry::main::distance_sq(a, c) > geometry::main::distance_sq(a, b)
        geometry::main::distance_sq(a, c) <= geometry::main::distance_sq(a, b)
        by cases:
            ? angle_measure::ray_angle(a, b, c) <= angle_measure::ray_angle(a, c, b)
            case geometry::main::distance_sq(a, c) = geometry::main::distance_sq(a, b):
                geometry::main::distance_sq(a, b) = geometry::main::distance_sq(a, c)
                release thm geometry::main::distance_sq_symmetric(a, b)
                release thm geometry::main::distance_sq_symmetric(a, c)
                release thm geometry::main::distance_sq_symmetric(b, c)
                geometry::main::distance_sq(b, a) = geometry::main::distance_sq(a, b) = geometry::main::distance_sq(a, c) = geometry::main::distance_sq(c, a)
                release thm geometry::main::isosceles_base_dot(a, b, c)
                release thm geometry_lemmas::angle_congruence_from_equal_sides_and_dot(b, a, c, c, a, b)
                by thm angle_measure::angle_relation_implies_equal_measure(a, b, c, a, c, b) => angle_measure::ray_angle(a, b, c) = angle_measure::ray_angle(a, c, b)
                angle_measure::ray_angle(a, b, c) <= angle_measure::ray_angle(a, c, b)
            case geometry::main::distance_sq(a, c) < geometry::main::distance_sq(a, b):
                by def $geometry::main::is_triangle(a, b, c)
                release thm geometry::main::det_antisymmetric(geometry::main::vec(a, c), geometry::main::vec(a, b))
                by contra:
                    ? geometry::main::det(geometry::main::vec(a, c), geometry::main::vec(a, b)) != 0
                    geometry::main::det(geometry::main::vec(a, c), geometry::main::vec(a, b)) = 0
                    -geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) = 0
                    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) = -(-geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))) = -0 = 0
                    impossible geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) != 0
                by def $geometry::main::is_triangle(a, c, b)
                release thm proposition_18(a, c, b)
                angle_measure::ray_angle(a, b, c) < angle_measure::ray_angle(a, c, b)
                angle_measure::ray_angle(a, b, c) <= angle_measure::ray_angle(a, c, b)
        impossible angle_measure::ray_angle(a, b, c) > angle_measure::ray_angle(a, c, b)


# Book I.20: each pair of actual triangle side lengths exceeds the remaining length.
thm proposition_20:
    ? forall a, b, c cart(R, R):
        a != b
        a != c
        b != c
        $geometry::main::is_triangle(a, b, c)
        =>:
            angle_measure::segment_length(a, b) + angle_measure::segment_length(a, c) > angle_measure::segment_length(b, c)
            angle_measure::segment_length(a, b) + angle_measure::segment_length(b, c) > angle_measure::segment_length(a, c)
            angle_measure::segment_length(a, c) + angle_measure::segment_length(b, c) > angle_measure::segment_length(a, b)
    by def $geometry::main::is_triangle(a, b, c)
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 > 0
    release thm geometry::main::triangle_det_squared_vertex(a, b, c)
    geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c))^2 = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 > 0
    by contra:
        ? geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c)) != 0
        geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c)) = 0
        geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c))^2 = 0
        impossible geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c))^2 > 0
    by def $geometry::main::is_triangle(b, a, c)
    release thm angle_measure::cyclic_triangle_determinant(a, b, c)
    geometry::main::det(geometry::main::vec(c, a), geometry::main::vec(c, b)) != 0
    by def $geometry::main::is_triangle(c, a, b)
    release thm angle_measure::adjacent_triangle_lengths_exceed_opposite(a, b, c)
    release thm angle_measure::adjacent_triangle_lengths_exceed_opposite(b, a, c)
    release thm angle_measure::adjacent_triangle_lengths_exceed_opposite(c, a, b)
    release thm angle_measure::segment_length_is_symmetric(a, b)
    release thm angle_measure::segment_length_is_symmetric(a, c)
    release thm angle_measure::segment_length_is_symmetric(b, c)
    angle_measure::segment_length(a, b) + angle_measure::segment_length(b, c) = angle_measure::segment_length(b, a) + angle_measure::segment_length(b, c) > angle_measure::segment_length(a, c)
    angle_measure::segment_length(a, c) + angle_measure::segment_length(b, c) = angle_measure::segment_length(c, a) + angle_measure::segment_length(c, b) > angle_measure::segment_length(a, b)


# Book I.21: inner broken sides are shorter, while the inner angle is larger.
thm proposition_21:
    ? forall a, b, c, d cart(R, R):
        $angle_measure::strictly_inside_triangle(d, a, b, c)
        =>:
            angle_measure::segment_length(b, d) + angle_measure::segment_length(d, c) < angle_measure::segment_length(a, b) + angle_measure::segment_length(a, c)
            angle_measure::ray_angle(b, d, c) > angle_measure::ray_angle(b, a, c)
    by def $angle_measure::strictly_inside_triangle(d, a, b, c)
    obtain u, v from exist u0, v0 R+ st {u0 + v0 < 1, d(1) = (1 - u0 - v0) * a(1) + u0 * b(1) + v0 * c(1), d(2) = (1 - u0 - v0) * a(2) + u0 * b(2) + v0 * c(2)}
    release thm angle_measure::strict_barycentric_side_intersection(a, b, c, d, u, v)
    obtain auxiliary, t, r from exist middle cart(R, R), ratio, weight R+ st {ratio < 1, weight < 1, middle(1) = a(1) + ratio * (c(1) - a(1)), middle(2) = a(2) + ratio * (c(2) - a(2)), d(1) = b(1) + weight * (middle(1) - b(1)), d(2) = b(2) + weight * (middle(2) - b(2))}
    release thm angle_measure::side_intersection_triangles_nondegenerate(a, b, c, auxiliary, d, t, r)
    release thm geometry_lemmas::triangle_vertices_distinct(a, b, auxiliary)
    release thm geometry_lemmas::triangle_vertices_distinct(c, auxiliary, d)
    release thm proposition_20(a, b, auxiliary)
    release thm proposition_20(c, auxiliary, d)
    release thm angle_measure::strict_segment_length_addition(a, c, auxiliary, t)
    release thm angle_measure::strict_segment_length_addition(b, auxiliary, d, r)
    release thm angle_measure::segment_length_is_symmetric(d, c)
    release thm angle_measure::segment_length_is_symmetric(c, auxiliary)
    release thm angle_measure::segment_length_is_symmetric(d, auxiliary)
    angle_measure::segment_length(b, d) + angle_measure::segment_length(d, c) = angle_measure::segment_length(b, d) + angle_measure::segment_length(c, d) < angle_measure::segment_length(b, d) + (angle_measure::segment_length(c, auxiliary) + angle_measure::segment_length(auxiliary, d)) = angle_measure::segment_length(b, d) + (angle_measure::segment_length(c, auxiliary) + angle_measure::segment_length(d, auxiliary)) = angle_measure::segment_length(b, d) + (angle_measure::segment_length(auxiliary, c) + angle_measure::segment_length(d, auxiliary)) = (angle_measure::segment_length(b, d) + angle_measure::segment_length(d, auxiliary)) + angle_measure::segment_length(auxiliary, c) = angle_measure::segment_length(b, auxiliary) + angle_measure::segment_length(auxiliary, c) < (angle_measure::segment_length(a, b) + angle_measure::segment_length(a, auxiliary)) + angle_measure::segment_length(auxiliary, c) = angle_measure::segment_length(a, b) + (angle_measure::segment_length(a, auxiliary) + angle_measure::segment_length(auxiliary, c)) = angle_measure::segment_length(a, b) + angle_measure::segment_length(a, c)
    auxiliary(1) - a(1) = (a(1) + t * (c(1) - a(1))) - a(1) = t * (c(1) - a(1))
    auxiliary(2) - a(2) = (a(2) + t * (c(2) - a(2))) - a(2) = t * (c(2) - a(2))
    have alpha R+ = 1 / t
    alpha = 1 / t > t / t = 1
    c(1) = a(1) + (c(1) - a(1)) = a(1) + (1 / t) * (t * (c(1) - a(1))) = a(1) + alpha * (auxiliary(1) - a(1)) = (1 - alpha) * a(1) + alpha * auxiliary(1)
    c(2) = a(2) + (c(2) - a(2)) = a(2) + (1 / t) * (t * (c(2) - a(2))) = a(2) + alpha * (auxiliary(2) - a(2)) = (1 - alpha) * a(2) + alpha * auxiliary(2)
    witness exist coef R st {coef > 1, c(1) = (1 - coef) * a(1) + coef * auxiliary(1), c(2) = (1 - coef) * a(2) + coef * auxiliary(2)} from alpha
    by def $geometry::main::is_on_extension(c, a, auxiliary)
    have s R+ = 1 - r
    s = 1 - r < 1 - 0 = 1
    d(1) - auxiliary(1) = (b(1) + r * (auxiliary(1) - b(1))) - auxiliary(1) = (1 - r) * (b(1) - auxiliary(1)) = s * (b(1) - auxiliary(1))
    d(2) - auxiliary(2) = (b(2) + r * (auxiliary(2) - b(2))) - auxiliary(2) = (1 - r) * (b(2) - auxiliary(2)) = s * (b(2) - auxiliary(2))
    have beta R+ = 1 / s
    beta = 1 / s > s / s = 1
    b(1) = auxiliary(1) + (b(1) - auxiliary(1)) = auxiliary(1) + (1 / s) * (s * (b(1) - auxiliary(1))) = auxiliary(1) + beta * (d(1) - auxiliary(1)) = (1 - beta) * auxiliary(1) + beta * d(1)
    b(2) = auxiliary(2) + (b(2) - auxiliary(2)) = auxiliary(2) + (1 / s) * (s * (b(2) - auxiliary(2))) = auxiliary(2) + beta * (d(2) - auxiliary(2)) = (1 - beta) * auxiliary(2) + beta * d(2)
    witness exist coef R st {coef > 1, b(1) = (1 - coef) * auxiliary(1) + coef * d(1), b(2) = (1 - coef) * auxiliary(2) + coef * d(2)} from beta
    by def $geometry::main::is_on_extension(b, auxiliary, d)
    release thm proposition_16(c, auxiliary, d, b)
    by def $geometry::main::is_triangle(a, b, auxiliary)
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, auxiliary))^2 > 0
    release thm geometry::main::triangle_det_squared_vertex(a, b, auxiliary)
    geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, auxiliary))^2 = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, auxiliary))^2 > 0
    by contra:
        ? geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, auxiliary)) != 0
        geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, auxiliary)) = 0
        geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, auxiliary))^2 = 0
        impossible geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, auxiliary))^2 > 0
    by def $geometry::main::is_triangle(b, a, auxiliary)
    release thm proposition_16(b, a, auxiliary, c)
    release thm angle_measure::positive_ray_scale_preserves_angle(c, auxiliary, b, d, s)
    release thm angle_measure::positive_ray_scale_preserves_angle(b, a, c, auxiliary, t)
    release thm angle_measure::ray_angle_arms_symmetric(b, d, c)
    release thm angle_measure::ray_angle_arms_symmetric(b, auxiliary, c)
    angle_measure::ray_angle(b, d, c) = angle_measure::ray_angle(c, d, b) > angle_measure::ray_angle(c, auxiliary, d) = angle_measure::ray_angle(c, auxiliary, b) = angle_measure::ray_angle(b, auxiliary, c) > angle_measure::ray_angle(b, a, auxiliary) = angle_measure::ray_angle(b, a, c)


# The source draws two circles after transferring the three given lengths.
# The analytic proof constructs their intersection explicitly, with positive
# height ensured by all three strict triangle inequalities.
release obj def geometry::main::circle

# Book I.22: construct a triangle equal to three prescribed nonzero segments.
thm proposition_22:
    ? forall a1, a2, b1, b2, c1, c2 cart(R, R):
        a1 != a2
        b1 != b2
        c1 != c2
        angle_measure::segment_length(a1, a2) + angle_measure::segment_length(b1, b2) > angle_measure::segment_length(c1, c2)
        angle_measure::segment_length(a1, a2) + angle_measure::segment_length(c1, c2) > angle_measure::segment_length(b1, b2)
        angle_measure::segment_length(b1, b2) + angle_measure::segment_length(c1, c2) > angle_measure::segment_length(a1, a2)
        =>:
            exist p, q, w cart(R, R) st {$geometry::main::is_triangle(p, q, w), $geometry::main::are_segments_congruent(p, q, a1, a2), $geometry::main::are_segments_congruent(p, w, b1, b2), $geometry::main::are_segments_congruent(q, w, c1, c2)}
    have r R+ = angle_measure::segment_length(a1, a2)
    have s R+ = angle_measure::segment_length(b1, b2)
    have t R+ = angle_measure::segment_length(c1, c2)
    r + s = angle_measure::segment_length(a1, a2) + angle_measure::segment_length(b1, b2) > angle_measure::segment_length(c1, c2) = t
    r + t = angle_measure::segment_length(a1, a2) + angle_measure::segment_length(c1, c2) > angle_measure::segment_length(b1, b2) = s
    s + t = angle_measure::segment_length(b1, b2) + angle_measure::segment_length(c1, c2) > angle_measure::segment_length(a1, a2) = r
    release thm angle_measure::three_positive_sides_triangle_witness(r, s, t)
    obtain p, q, w from exist aa, bb, cc cart(R, R) st {$geometry::main::is_triangle(aa, bb, cc), geometry::main::distance_sq(aa, bb) = r^2, geometry::main::distance_sq(aa, cc) = s^2, geometry::main::distance_sq(bb, cc) = t^2, cc $in geometry::main::circle(aa, s), cc $in geometry::main::circle(bb, t)}
    release thm angle_measure::segment_length_square_is_squared_distance(a1, a2)
    release thm angle_measure::segment_length_square_is_squared_distance(b1, b2)
    release thm angle_measure::segment_length_square_is_squared_distance(c1, c2)
    geometry::main::distance_sq(p, q) = r^2 = angle_measure::segment_length(a1, a2)^2 = geometry::main::distance_sq(a1, a2)
    geometry::main::distance_sq(p, w) = s^2 = angle_measure::segment_length(b1, b2)^2 = geometry::main::distance_sq(b1, b2)
    geometry::main::distance_sq(q, w) = t^2 = angle_measure::segment_length(c1, c2)^2 = geometry::main::distance_sq(c1, c2)
    by def $geometry::main::are_segments_congruent(p, q, a1, a2)
    by def $geometry::main::are_segments_congruent(p, w, b1, b2)
    by def $geometry::main::are_segments_congruent(q, w, c1, c2)
    witness exist aa, bb, cc cart(R, R) st {$geometry::main::is_triangle(aa, bb, cc), $geometry::main::are_segments_congruent(aa, bb, a1, a2), $geometry::main::are_segments_congruent(aa, cc, b1, b2), $geometry::main::are_segments_congruent(bb, cc, c1, c2)} from p, q, w


# Book I.23: copy a genuine rectilinear angle onto a given nonzero base ray.
# Euclid constructs an equal-sided triangle using I.22 and then invokes SSS.
# Here a direct similarity sends the first source arm to the prescribed base;
# its dot/norm laws prove equal angles without assuming a circle intersection.
thm proposition_23:
    ? forall a, b, d, c, e1 cart(R, R):
        a != b
        $geometry::main::is_triangle(c, d, e1)
        =>:
            exist g cart(R, R) st {$geometry::main::is_triangle(a, b, g), $geometry::main::are_angles_congruent(b, a, g, d, c, e1)}
    release thm geometry_lemmas::triangle_vertices_distinct(c, d, e1)
    release thm geometry::main::distance_sq_positive_of_ne(c, d)
    release thm geometry::main::distance_sq_positive_of_ne(c, e1)
    release thm geometry::main::distance_sq_positive_of_ne(a, b)
    have k R+ = geometry::main::distance_sq(c, d)
    have v R+ = geometry::main::distance_sq(c, e1)
    have h R+ = geometry::main::distance_sq(a, b)
    have ux R = d(1) - c(1)
    have uy R = d(2) - c(2)
    have vx R = e1(1) - c(1)
    have vy R = e1(2) - c(2)
    have wx R = b(1) - a(1)
    have wy R = b(2) - a(2)
    have n R = ux * vx + uy * vy
    have z R = ux * vy - uy * vx
    release thm geometry::main::distance_sq_coordinate_formula(c, d)
    release thm geometry::main::distance_sq_coordinate_formula(c, e1)
    release thm geometry::main::distance_sq_coordinate_formula(a, b)
    k = ux^2 + uy^2
    v = vx^2 + vy^2
    h = wx^2 + wy^2
    n^2 + z^2 = (ux * vx + uy * vy)^2 + (ux * vy - uy * vx)^2 = (ux^2 + uy^2) * (vx^2 + vy^2) = k * v
    release thm geometry::main::collinear_det_expand(c, d, e1)
    geometry::main::det(geometry::main::vec(c, d), geometry::main::vec(c, e1)) = ux * vy - uy * vx = z
    z != 0
    have gx R = (n * wx - z * wy) / k
    have gy R = (n * wy + z * wx) / k
    have g cart(R, R) = (a(1) + gx, a(2) + gy)
    g(1) - a(1) = gx
    g(2) - a(2) = gy
    release thm geometry::main::collinear_det_expand(a, b, g)
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, g)) = wx * gy - wy * gx = wx * ((n * wy + z * wx) / k) - wy * ((n * wx - z * wy) / k) = z * (wx^2 + wy^2) / k = z * h / k
    by contra:
        ? z * h / k != 0
        z * h / k = 0
        z = (z * h / k) * (k / h) = 0 * (k / h) = 0
        impossible z != 0
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, g)) != 0
    by def $geometry::main::is_triangle(a, b, g)
    release thm geometry_lemmas::triangle_vertices_distinct(a, b, g)
    release thm geometry::main::distance_sq_coordinate_formula(a, g)
    geometry::main::distance_sq(a, g) = gx^2 + gy^2 = ((n * wx - z * wy) / k)^2 + ((n * wy + z * wx) / k)^2 = (n^2 + z^2) * (wx^2 + wy^2) / k^2 = (k * v) * h / k^2 = v * h / k
    release thm geometry::main::perpendicular_dot_expand(a, b, a, g)
    geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, g)) = wx * gx + wy * gy = wx * ((n * wx - z * wy) / k) + wy * ((n * wy + z * wx) / k) = n * (wx^2 + wy^2) / k = n * h / k
    release thm geometry::main::perpendicular_dot_expand(c, d, c, e1)
    geometry::main::dot(geometry::main::vec(c, d), geometry::main::vec(c, e1)) = ux * vx + uy * vy = n
    geometry::main::angle_cos_num(b, a, g) = n * h / k
    geometry::main::angle_cos_num(d, c, e1) = n
    v * h > 0
    h / k > 0
    (v * h) * (h / k) > 0
    v * h^2 / k = (v * h) * (h / k) > 0
    geometry::main::angle_cos_den(b, a, g) = geometry::main::distance_sq(a, b) * geometry::main::distance_sq(a, g) = h * (v * h / k) = v * h^2 / k
    geometry::main::angle_cos_den(b, a, g) > 0
    geometry::main::angle_cos_den(d, c, e1) = k * v > 0
    geometry::main::angle_cos_num(b, a, g)^2 * geometry::main::angle_cos_den(d, c, e1) = (n * h / k)^2 * (k * v) = n^2 * (v * h^2 / k) = geometry::main::angle_cos_num(d, c, e1)^2 * geometry::main::angle_cos_den(b, a, g)
    geometry::main::angle_cos_num(b, a, g) * geometry::main::angle_cos_num(d, c, e1) = (n * h / k) * n = n^2 * (h / k) >= 0
    by def $geometry::main::are_angles_congruent(b, a, g, d, c, e1)
    witness exist gg cart(R, R) st {$geometry::main::is_triangle(a, b, gg), $geometry::main::are_angles_congruent(b, a, gg, d, c, e1)} from g


# Book I.24: for two triangles with equal adjacent sides, the greater
# included angle faces the greater base. Euclid copies the angle with I.23,
# then uses SAS and I.19; here principal cosine order and the cosine law
# give the same strict base-length comparison directly.
thm proposition_24:
    ? forall a, b, c, d, e1, f cart(R, R):
        a != b
        a != c
        b != c
        d != e1
        d != f
        e1 != f
        $geometry::main::is_triangle(a, b, c)
        $geometry::main::is_triangle(d, e1, f)
        $geometry::main::are_segments_congruent(a, b, d, e1)
        $geometry::main::are_segments_congruent(a, c, d, f)
        angle_measure::ray_angle(b, a, c) > angle_measure::ray_angle(e1, d, f)
        =>:
            angle_measure::segment_length(b, c) > angle_measure::segment_length(e1, f)
    release thm angle_measure::ray_angle_range(b, a, c)
    release thm angle_measure::ray_angle_range(e1, d, f)
    release thm angle_measure::cosine_strictly_decreasing_on_principal_range(angle_measure::ray_angle(e1, d, f), angle_measure::ray_angle(b, a, c))
    release thm angle_measure::ray_angle_cosine(b, a, c)
    release thm angle_measure::ray_angle_cosine(e1, d, f)
    angles::angle_cosine(b, a, c) < angles::angle_cosine(e1, d, f)
    by def $geometry::main::are_segments_congruent(a, b, d, e1)
    by def $geometry::main::are_segments_congruent(a, c, d, f)
    release thm geometry::main::distance_sq_positive_of_ne(a, b)
    release thm geometry::main::distance_sq_positive_of_ne(a, c)
    geometry::main::angle_cos_den(b, a, c) = geometry::main::distance_sq(a, b) * geometry::main::distance_sq(a, c) > 0
    geometry::main::angle_cos_den(e1, d, f) = geometry::main::distance_sq(d, e1) * geometry::main::distance_sq(d, f) = geometry::main::angle_cos_den(b, a, c)
    release thm angles::angle_den_positive(b, a, c)
    have den R+ = sqrt(geometry::main::angle_cos_den(b, a, c))
    angles::angle_cosine(b, a, c) = geometry::main::angle_cos_num(b, a, c) / sqrt(geometry::main::angle_cos_den(b, a, c)) = geometry::main::angle_cos_num(b, a, c) / den
    release thm angles::angle_den_positive(e1, d, f)
    sqrt(geometry::main::angle_cos_den(e1, d, f)) = sqrt(geometry::main::angle_cos_den(b, a, c)) = den
    angles::angle_cosine(e1, d, f) = geometry::main::angle_cos_num(e1, d, f) / sqrt(geometry::main::angle_cos_den(e1, d, f)) = geometry::main::angle_cos_num(e1, d, f) / sqrt(geometry::main::angle_cos_den(b, a, c)) = geometry::main::angle_cos_num(e1, d, f) / den
    geometry::main::angle_cos_num(b, a, c) = (geometry::main::angle_cos_num(b, a, c) / den) * den = angles::angle_cosine(b, a, c) * den < angles::angle_cosine(e1, d, f) * den = (geometry::main::angle_cos_num(e1, d, f) / den) * den = geometry::main::angle_cos_num(e1, d, f)
    release thm geometry::main::cosine_law(b, a, c)
    release thm geometry::main::cosine_law(e1, d, f)
    release thm geometry::main::distance_sq_symmetric(a, b)
    release thm geometry::main::distance_sq_symmetric(d, e1)
    geometry::main::angle_cos_num(b, a, c) = geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c))
    geometry::main::angle_cos_num(e1, d, f) = geometry::main::dot(geometry::main::vec(d, e1), geometry::main::vec(d, f))
    geometry::main::distance_sq(b, c) = geometry::main::distance_sq(b, a) + geometry::main::distance_sq(a, c) - 2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c)) = geometry::main::distance_sq(a, b) + geometry::main::distance_sq(a, c) - 2 * geometry::main::angle_cos_num(b, a, c)
    geometry::main::distance_sq(e1, f) = geometry::main::distance_sq(e1, d) + geometry::main::distance_sq(d, f) - 2 * geometry::main::dot(geometry::main::vec(d, e1), geometry::main::vec(d, f)) = geometry::main::distance_sq(d, e1) + geometry::main::distance_sq(d, f) - 2 * geometry::main::angle_cos_num(e1, d, f)
    2 * geometry::main::angle_cos_num(b, a, c) < 2 * geometry::main::angle_cos_num(e1, d, f)
    have total R = geometry::main::distance_sq(a, b) + geometry::main::distance_sq(a, c)
    have n1 R = geometry::main::angle_cos_num(b, a, c)
    have n2 R = geometry::main::angle_cos_num(e1, d, f)
    n1 < n2
    -2 * n1 > -2 * n2
    total - 2 * n1 > total - 2 * n2
    geometry::main::distance_sq(d, e1) + geometry::main::distance_sq(d, f) = geometry::main::distance_sq(a, b) + geometry::main::distance_sq(a, c) = total
    geometry::main::distance_sq(b, c) = total - 2 * n1
    geometry::main::distance_sq(e1, f) = geometry::main::distance_sq(d, e1) + geometry::main::distance_sq(d, f) - 2 * geometry::main::angle_cos_num(e1, d, f) = (geometry::main::distance_sq(d, e1) + geometry::main::distance_sq(d, f)) - 2 * n2 = total - 2 * n2
    geometry::main::distance_sq(b, c) = total - 2 * n1 > total - 2 * n2 = geometry::main::distance_sq(e1, f)
    release thm angle_measure::segment_length_square_is_squared_distance(b, c)
    release thm angle_measure::segment_length_square_is_squared_distance(e1, f)
    angle_measure::segment_length(b, c)^2 = geometry::main::distance_sq(b, c) > geometry::main::distance_sq(e1, f) = angle_measure::segment_length(e1, f)^2
    have left R+ = angle_measure::segment_length(b, c)
    have right R+ = angle_measure::segment_length(e1, f)
    left^2 = angle_measure::segment_length(b, c)^2 > angle_measure::segment_length(e1, f)^2 = right^2
    by contra:
        ? left > right
        left <= right
        left * left <= left * right
        left * right <= right * right
        left^2 = left * left <= left * right <= right * right = right^2
        impossible left^2 > right^2
    angle_measure::segment_length(b, c) = left > right = angle_measure::segment_length(e1, f)


# Book I.25: with equal adjacent sides, the greater base faces the greater
# included angle. Euclid excludes equal angles by SAS and smaller angles by
# I.24; here the weak cosine order gives the same contradiction directly.

thm proposition_25:
    ? forall a, b, c, d, e1, f cart(R, R):
        a != b
        a != c
        b != c
        d != e1
        d != f
        e1 != f
        $geometry::main::is_triangle(a, b, c)
        $geometry::main::is_triangle(d, e1, f)
        $geometry::main::are_segments_congruent(a, b, d, e1)
        $geometry::main::are_segments_congruent(a, c, d, f)
        angle_measure::segment_length(b, c) > angle_measure::segment_length(e1, f)
        =>:
            angle_measure::ray_angle(b, a, c) > angle_measure::ray_angle(e1, d, f)
    release thm angle_measure::segment_length_square_is_squared_distance(b, c)
    release thm angle_measure::segment_length_square_is_squared_distance(e1, f)
    have left R+ = angle_measure::segment_length(b, c)
    have right R+ = angle_measure::segment_length(e1, f)
    left = angle_measure::segment_length(b, c) > angle_measure::segment_length(e1, f) = right
    left * left > left * right
    left * right > right * right
    left^2 = left * left > left * right > right * right = right^2
    geometry::main::distance_sq(b, c) = angle_measure::segment_length(b, c)^2 = left^2 > right^2 = angle_measure::segment_length(e1, f)^2 = geometry::main::distance_sq(e1, f)
    by contra:
        ? angle_measure::ray_angle(b, a, c) > angle_measure::ray_angle(e1, d, f)
        angle_measure::ray_angle(b, a, c) <= angle_measure::ray_angle(e1, d, f)
        release thm angle_measure::ray_angle_range(b, a, c)
        release thm angle_measure::ray_angle_range(e1, d, f)
        release thm angle_measure::cosine_weakly_decreasing_on_principal_range(angle_measure::ray_angle(b, a, c), angle_measure::ray_angle(e1, d, f))
        release thm angle_measure::ray_angle_cosine(b, a, c)
        release thm angle_measure::ray_angle_cosine(e1, d, f)
        angles::angle_cosine(b, a, c) >= angles::angle_cosine(e1, d, f)
        by def $geometry::main::are_segments_congruent(a, b, d, e1)
        by def $geometry::main::are_segments_congruent(a, c, d, f)
        release thm geometry::main::distance_sq_positive_of_ne(a, b)
        release thm geometry::main::distance_sq_positive_of_ne(a, c)
        geometry::main::angle_cos_den(b, a, c) = geometry::main::distance_sq(a, b) * geometry::main::distance_sq(a, c) > 0
        geometry::main::angle_cos_den(e1, d, f) = geometry::main::distance_sq(d, e1) * geometry::main::distance_sq(d, f) = geometry::main::angle_cos_den(b, a, c)
        release thm angles::angle_den_positive(b, a, c)
        have den R+ = sqrt(geometry::main::angle_cos_den(b, a, c))
        angles::angle_cosine(b, a, c) = geometry::main::angle_cos_num(b, a, c) / sqrt(geometry::main::angle_cos_den(b, a, c)) = geometry::main::angle_cos_num(b, a, c) / den
        release thm angles::angle_den_positive(e1, d, f)
        sqrt(geometry::main::angle_cos_den(e1, d, f)) = sqrt(geometry::main::angle_cos_den(b, a, c)) = den
        angles::angle_cosine(e1, d, f) = geometry::main::angle_cos_num(e1, d, f) / sqrt(geometry::main::angle_cos_den(e1, d, f)) = geometry::main::angle_cos_num(e1, d, f) / sqrt(geometry::main::angle_cos_den(b, a, c)) = geometry::main::angle_cos_num(e1, d, f) / den
        geometry::main::angle_cos_num(b, a, c) = (geometry::main::angle_cos_num(b, a, c) / den) * den = angles::angle_cosine(b, a, c) * den >= angles::angle_cosine(e1, d, f) * den = (geometry::main::angle_cos_num(e1, d, f) / den) * den = geometry::main::angle_cos_num(e1, d, f)
        release thm geometry::main::cosine_law(b, a, c)
        release thm geometry::main::cosine_law(e1, d, f)
        release thm geometry::main::distance_sq_symmetric(a, b)
        release thm geometry::main::distance_sq_symmetric(d, e1)
        geometry::main::angle_cos_num(b, a, c) = geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c))
        geometry::main::angle_cos_num(e1, d, f) = geometry::main::dot(geometry::main::vec(d, e1), geometry::main::vec(d, f))
        geometry::main::distance_sq(b, c) = geometry::main::distance_sq(b, a) + geometry::main::distance_sq(a, c) - 2 * geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c)) = geometry::main::distance_sq(a, b) + geometry::main::distance_sq(a, c) - 2 * geometry::main::angle_cos_num(b, a, c)
        geometry::main::distance_sq(e1, f) = geometry::main::distance_sq(e1, d) + geometry::main::distance_sq(d, f) - 2 * geometry::main::dot(geometry::main::vec(d, e1), geometry::main::vec(d, f)) = geometry::main::distance_sq(d, e1) + geometry::main::distance_sq(d, f) - 2 * geometry::main::angle_cos_num(e1, d, f)
        have total R = geometry::main::distance_sq(a, b) + geometry::main::distance_sq(a, c)
        have n1 R = geometry::main::angle_cos_num(b, a, c)
        have n2 R = geometry::main::angle_cos_num(e1, d, f)
        n1 >= n2
        -2 * n1 <= -2 * n2
        by cases:
            ? total - 2 * n1 <= total - 2 * n2
            case n1 > n2:
                -2 * n1 < -2 * n2
                n1 - n2 > 0
                have gap R+ = n1 - n2
                have base R = total - 2 * n1
                2 * gap > 0
                base + 2 * gap > base + 0 = base
                total - 2 * n2 = (total - 2 * n1) + 2 * (n1 - n2) = base + 2 * gap > base = total - 2 * n1
                total - 2 * n1 <= total - 2 * n2
            case n1 <= n2:
                n1 = n2
                total - 2 * n1 = total - 2 * n2
                total - 2 * n1 <= total - 2 * n2
        geometry::main::distance_sq(d, e1) + geometry::main::distance_sq(d, f) = geometry::main::distance_sq(a, b) + geometry::main::distance_sq(a, c) = total
        geometry::main::distance_sq(b, c) = total - 2 * n1
        geometry::main::distance_sq(e1, f) = geometry::main::distance_sq(d, e1) + geometry::main::distance_sq(d, f) - 2 * geometry::main::angle_cos_num(e1, d, f) = (geometry::main::distance_sq(d, e1) + geometry::main::distance_sq(d, f)) - 2 * n2 = total - 2 * n2
        geometry::main::distance_sq(b, c) = total - 2 * n1 <= total - 2 * n2 = geometry::main::distance_sq(e1, f)
        impossible geometry::main::distance_sq(b, c) > geometry::main::distance_sq(e1, f)


# Book I.26, included-side case: two equal corresponding angles and their
# common side determine both remaining sides and the remaining angle.
# Equal angle sines give a common side-square scale. Equal angle cosines,
# together with the fixed included side, force its positive square root to 1.

thm proposition_26_included_side:
    ? forall a, b, c, d, e1, f cart(R, R):
        $geometry::main::is_triangle(a, b, c)
        $geometry::main::is_triangle(d, e1, f)
        $geometry::main::are_angles_congruent(a, b, c, d, e1, f)
        $geometry::main::are_angles_congruent(b, c, a, e1, f, d)
        $geometry::main::are_segments_congruent(b, c, e1, f)
        =>:
            $geometry::main::are_segments_congruent(a, b, d, e1)
            $geometry::main::are_segments_congruent(a, c, d, f)
            $geometry::main::are_angles_congruent(b, a, c, e1, d, f)
    release thm geometry_lemmas::triangle_vertices_distinct(a, b, c)
    release thm geometry_lemmas::triangle_vertices_distinct(d, e1, f)
    by def $geometry::main::are_segments_congruent(b, c, e1, f)
    release thm geometry::main::distance_sq_positive_of_ne(a, b)
    release thm geometry::main::distance_sq_positive_of_ne(a, c)
    release thm geometry::main::distance_sq_positive_of_ne(b, c)
    release thm geometry::main::distance_sq_positive_of_ne(d, e1)
    release thm geometry::main::distance_sq_positive_of_ne(d, f)
    have x R+ = geometry::main::distance_sq(a, b)
    have y R+ = geometry::main::distance_sq(a, c)
    have z R+ = geometry::main::distance_sq(b, c)
    have X R+ = geometry::main::distance_sq(d, e1)
    have Y R+ = geometry::main::distance_sq(d, f)
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) != 0
    geometry::main::det(geometry::main::vec(d, e1), geometry::main::vec(d, f)) != 0
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 > 0
    geometry::main::det(geometry::main::vec(d, e1), geometry::main::vec(d, f))^2 > 0
    have H R+ = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))^2
    have H1 R+ = geometry::main::det(geometry::main::vec(d, e1), geometry::main::vec(d, f))^2
    release thm geometry::main::triangle_det_squared_vertex(a, b, c)
    release thm geometry::main::triangle_det_squared_vertex(d, e1, f)
    release thm angle_measure::cyclic_triangle_determinant(a, b, c)
    release thm angle_measure::cyclic_triangle_determinant(d, e1, f)
    geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c))^2 = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 = H
    geometry::main::det(geometry::main::vec(e1, d), geometry::main::vec(e1, f))^2 = geometry::main::det(geometry::main::vec(d, e1), geometry::main::vec(d, f))^2 = H1
    release thm geometry::main::det_antisymmetric(geometry::main::vec(c, a), geometry::main::vec(c, b))
    release thm geometry::main::det_antisymmetric(geometry::main::vec(f, d), geometry::main::vec(f, e1))
    geometry::main::det(geometry::main::vec(c, b), geometry::main::vec(c, a))^2 = geometry::main::det(geometry::main::vec(c, a), geometry::main::vec(c, b))^2 = H
    geometry::main::det(geometry::main::vec(f, e1), geometry::main::vec(f, d))^2 = geometry::main::det(geometry::main::vec(f, d), geometry::main::vec(f, e1))^2 = H1
    release thm geometry::main::distance_sq_symmetric(a, b)
    release thm geometry::main::distance_sq_symmetric(a, c)
    release thm geometry::main::distance_sq_symmetric(b, c)
    release thm geometry::main::distance_sq_symmetric(d, e1)
    release thm geometry::main::distance_sq_symmetric(d, f)
    release thm geometry::main::distance_sq_symmetric(e1, f)
    geometry::main::distance_sq(b, a) = geometry::main::distance_sq(a, b) = x
    geometry::main::distance_sq(c, a) = geometry::main::distance_sq(a, c) = y
    geometry::main::distance_sq(c, b) = geometry::main::distance_sq(b, c) = z
    geometry::main::distance_sq(e1, d) = geometry::main::distance_sq(d, e1) = X
    geometry::main::distance_sq(f, d) = geometry::main::distance_sq(d, f) = Y
    geometry::main::distance_sq(e1, f) = geometry::main::distance_sq(b, c) = z
    geometry::main::distance_sq(f, e1) = geometry::main::distance_sq(e1, f) = z
    geometry::main::angle_cos_den(a, b, c) = geometry::main::distance_sq(b, a)*geometry::main::distance_sq(b, c) = x*z
    geometry::main::angle_cos_den(d, e1, f) = geometry::main::distance_sq(e1, d)*geometry::main::distance_sq(e1, f) = X*z
    geometry::main::angle_cos_den(b, c, a) = geometry::main::distance_sq(c, b)*geometry::main::distance_sq(c, a) = z*y = y*z
    geometry::main::angle_cos_den(e1, f, d) = geometry::main::distance_sq(f, e1)*geometry::main::distance_sq(f, d) = z*Y = Y*z
    release thm geometry::main::congruent_angle_det_square_ratio(a, b, c, d, e1, f)
    release thm geometry::main::congruent_angle_det_square_ratio(b, c, a, e1, f, d)
    H*(X*z) = geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c))^2 * geometry::main::angle_cos_den(d, e1, f)
    geometry::main::det(geometry::main::vec(e1, d), geometry::main::vec(e1, f))^2 * geometry::main::angle_cos_den(a, b, c) = H1*(x*z)
    H*X*z = H*(X*z) = geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c))^2 * geometry::main::angle_cos_den(d, e1, f) = geometry::main::det(geometry::main::vec(e1, d), geometry::main::vec(e1, f))^2 * geometry::main::angle_cos_den(a, b, c) = H1*(x*z) = H1*x*z
    H*(Y*z) = geometry::main::det(geometry::main::vec(c, b), geometry::main::vec(c, a))^2 * geometry::main::angle_cos_den(e1, f, d)
    geometry::main::det(geometry::main::vec(f, e1), geometry::main::vec(f, d))^2 * geometry::main::angle_cos_den(b, c, a) = H1*(y*z)
    H*Y*z = H*(Y*z) = geometry::main::det(geometry::main::vec(c, b), geometry::main::vec(c, a))^2 * geometry::main::angle_cos_den(e1, f, d) = geometry::main::det(geometry::main::vec(f, e1), geometry::main::vec(f, d))^2 * geometry::main::angle_cos_den(b, c, a) = H1*(y*z) = H1*y*z
    release thm geometry::main::cancel_positive_right_factor(H*X, H1*x, z)
    release thm geometry::main::cancel_positive_right_factor(H*Y, H1*y, z)
    have ratio R+ = X/x
    X = ratio*x
    H1/H = (H1*x)/(H*x) = (H*X)/(H*x) = X/x = ratio
    Y = (H*Y)/H = (H1*y)/H = (H1/H)*y = ratio*y
    have scale R+ = sqrt(ratio)
    0 <= ratio
    scale^2 = sqrt(ratio)^2 = ratio
    have den_b R+ = sqrt(x*z)
    have den_c R+ = sqrt(y*z)
    have other_b R+ = sqrt(X*z)
    have other_c R+ = sqrt(Y*z)
    0 <= x*z
    0 <= y*z
    0 <= X*z
    0 <= Y*z
    den_b^2 = sqrt(x*z)^2 = x*z
    den_c^2 = sqrt(y*z)^2 = y*z
    other_b^2 = sqrt(X*z)^2 = X*z
    (scale*den_b)^2 = scale^2*den_b^2
    scale^2*den_b^2 = ratio*(x*z)
    ratio*(x*z) = (ratio*x)*z = X*z
    other_b^2 = (scale*den_b)^2
    other_c^2 = sqrt(Y*z)^2 = Y*z
    (scale*den_c)^2 = scale^2*den_c^2
    scale^2*den_c^2 = ratio*(y*z)
    ratio*(y*z) = (ratio*y)*z = Y*z
    other_c^2 = (scale*den_c)^2
    other_b*(scale*den_b) >= 0
    other_c*(scale*den_c) >= 0
    release thm angle_measure::same_square_and_sign_gives_equality(other_b, scale*den_b)
    release thm angle_measure::same_square_and_sign_gives_equality(other_c, scale*den_c)
    release thm angle_measure::angle_relation_implies_equal_cosine(a, b, c, d, e1, f)
    release thm angle_measure::angle_relation_implies_equal_cosine(b, c, a, e1, f, d)
    have nb R = geometry::main::angle_cos_num(a, b, c)
    have nc R = geometry::main::angle_cos_num(b, c, a)
    have Nb R = geometry::main::angle_cos_num(d, e1, f)
    have Nc R = geometry::main::angle_cos_num(e1, f, d)
    release thm angles::angle_root_den_nonzero(a, b, c)
    release thm angles::angle_root_den_nonzero(d, e1, f)
    release thm angles::angle_root_den_nonzero(b, c, a)
    release thm angles::angle_root_den_nonzero(e1, f, d)
    angles::angle_cosine(a, b, c) = geometry::main::angle_cos_num(a, b, c)/sqrt(geometry::main::angle_cos_den(a, b, c)) = nb/sqrt(geometry::main::angle_cos_den(a, b, c)) = nb/den_b
    angles::angle_cosine(d, e1, f) = geometry::main::angle_cos_num(d, e1, f)/sqrt(geometry::main::angle_cos_den(d, e1, f)) = Nb/sqrt(geometry::main::angle_cos_den(d, e1, f)) = Nb/other_b
    angles::angle_cosine(b, c, a) = geometry::main::angle_cos_num(b, c, a)/sqrt(geometry::main::angle_cos_den(b, c, a)) = nc/sqrt(geometry::main::angle_cos_den(b, c, a)) = nc/den_c
    angles::angle_cosine(e1, f, d) = geometry::main::angle_cos_num(e1, f, d)/sqrt(geometry::main::angle_cos_den(e1, f, d)) = Nc/sqrt(geometry::main::angle_cos_den(e1, f, d)) = Nc/other_c
    Nb = (Nb/other_b)*other_b = (nb/den_b)*(scale*den_b) = scale*nb
    Nc = (Nc/other_c)*other_c = (nc/den_c)*(scale*den_c) = scale*nc
    release thm geometry::main::dot_from_cosine_law(a, b, c)
    release thm geometry::main::dot_from_cosine_law(b, c, a)
    release thm geometry::main::dot_from_cosine_law(d, e1, f)
    release thm geometry::main::dot_from_cosine_law(e1, f, d)
    geometry::main::angle_cos_num(a, b, c) = geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c))
    geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c)) = (geometry::main::distance_sq(a, b)+geometry::main::distance_sq(b, c)-geometry::main::distance_sq(a, c))/2 = (x+z-y)/2
    nb = geometry::main::angle_cos_num(a, b, c) = geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c)) = (x+z-y)/2
    geometry::main::angle_cos_num(b, c, a) = geometry::main::dot(geometry::main::vec(c, b), geometry::main::vec(c, a))
    geometry::main::dot(geometry::main::vec(c, b), geometry::main::vec(c, a)) = (geometry::main::distance_sq(b, c)+geometry::main::distance_sq(c, a)-geometry::main::distance_sq(b, a))/2 = (z+y-x)/2 = (y+z-x)/2
    nc = geometry::main::angle_cos_num(b, c, a) = geometry::main::dot(geometry::main::vec(c, b), geometry::main::vec(c, a)) = (y+z-x)/2
    geometry::main::angle_cos_num(d, e1, f) = geometry::main::dot(geometry::main::vec(e1, d), geometry::main::vec(e1, f))
    geometry::main::dot(geometry::main::vec(e1, d), geometry::main::vec(e1, f)) = (geometry::main::distance_sq(d, e1)+geometry::main::distance_sq(e1, f)-geometry::main::distance_sq(d, f))/2 = (X+z-Y)/2
    Nb = geometry::main::angle_cos_num(d, e1, f) = geometry::main::dot(geometry::main::vec(e1, d), geometry::main::vec(e1, f)) = (X+z-Y)/2
    geometry::main::angle_cos_num(e1, f, d) = geometry::main::dot(geometry::main::vec(f, e1), geometry::main::vec(f, d))
    geometry::main::dot(geometry::main::vec(f, e1), geometry::main::vec(f, d)) = (geometry::main::distance_sq(e1, f)+geometry::main::distance_sq(f, d)-geometry::main::distance_sq(e1, d))/2 = (z+Y-X)/2 = (Y+z-X)/2
    Nc = geometry::main::angle_cos_num(e1, f, d) = geometry::main::dot(geometry::main::vec(f, e1), geometry::main::vec(f, d)) = (Y+z-X)/2
    nb+nc = (x+z-y)/2+(y+z-x)/2 = z
    Nb+Nc = (X+z-Y)/2+(Y+z-X)/2 = z
    z = Nb+Nc = scale*nb+scale*nc = scale*(nb+nc) = scale*z
    scale = (scale*z)/z = z/z = 1
    ratio = scale^2 = 1
    X = ratio*x = x
    Y = ratio*y = y
    by def $geometry::main::are_segments_congruent(a, b, d, e1)
    by def $geometry::main::are_segments_congruent(a, c, d, f)
    release thm geometry::main::sss_congruence(a, b, c, d, e1, f)
    release thm geometry_lemmas::angle_congruence_from_equal_sides_and_dot(a, b, c, d, e1, f)


# Book I.26, opposite-side case: two equal angles and a side opposite one
# of them determine the remaining sides and angle. Reversing both arms in
# CBA/FED denotes the same undirected source angles ABC/DEF.
# The reusable independent analytic AAS theorem proves the two missing sides;
# SSS then identifies the remaining angle, with no later source assumption.

thm proposition_26_opposite_side:
    ? forall a, b, c, d, e1, f cart(R, R):
        $geometry::main::is_triangle(a, b, c)
        $geometry::main::is_triangle(d, e1, f)
        $geometry::main::are_angles_congruent(c, b, a, f, e1, d)
        $geometry::main::are_angles_congruent(b, c, a, e1, f, d)
        $geometry::main::are_segments_congruent(a, b, d, e1)
        =>:
            $geometry::main::are_segments_congruent(b, c, e1, f)
            $geometry::main::are_segments_congruent(a, c, d, f)
            $geometry::main::are_angles_congruent(b, a, c, e1, d, f)
    release thm geometry_lemmas::triangle_vertices_distinct(a, b, c)
    release thm geometry_lemmas::triangle_vertices_distinct(d, e1, f)
    release thm angle_measure::cyclic_triangle_determinant(a, b, c)
    release thm angle_measure::cyclic_triangle_determinant(d, e1, f)
    geometry::main::det(geometry::main::vec(c, a), geometry::main::vec(c, b)) = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))
    geometry::main::det(geometry::main::vec(f, d), geometry::main::vec(f, e1)) = geometry::main::det(geometry::main::vec(d, e1), geometry::main::vec(d, f))
    geometry::main::det(geometry::main::vec(c, a), geometry::main::vec(c, b)) != 0
    geometry::main::det(geometry::main::vec(f, d), geometry::main::vec(f, e1)) != 0
    release thm geometry::main::det_antisymmetric(geometry::main::vec(c, a), geometry::main::vec(c, b))
    release thm geometry::main::det_antisymmetric(geometry::main::vec(f, d), geometry::main::vec(f, e1))
    by contra:
        ? geometry::main::det(geometry::main::vec(c, b), geometry::main::vec(c, a)) != 0
        geometry::main::det(geometry::main::vec(c, b), geometry::main::vec(c, a)) = 0
        geometry::main::det(geometry::main::vec(c, a), geometry::main::vec(c, b)) = -(-(geometry::main::det(geometry::main::vec(c, a), geometry::main::vec(c, b)))) = -(geometry::main::det(geometry::main::vec(c, b), geometry::main::vec(c, a))) = -0 = 0
        impossible geometry::main::det(geometry::main::vec(c, a), geometry::main::vec(c, b)) != 0
    by contra:
        ? geometry::main::det(geometry::main::vec(f, e1), geometry::main::vec(f, d)) != 0
        geometry::main::det(geometry::main::vec(f, e1), geometry::main::vec(f, d)) = 0
        geometry::main::det(geometry::main::vec(f, d), geometry::main::vec(f, e1)) = -(-(geometry::main::det(geometry::main::vec(f, d), geometry::main::vec(f, e1)))) = -(geometry::main::det(geometry::main::vec(f, e1), geometry::main::vec(f, d))) = -0 = 0
        impossible geometry::main::det(geometry::main::vec(f, d), geometry::main::vec(f, e1)) != 0
    by def $geometry::main::is_triangle(c, b, a)
    by def $geometry::main::is_triangle(f, e1, d)
    by def $geometry::main::are_segments_congruent(a, b, d, e1)
    release thm geometry::main::distance_sq_symmetric(a, b)
    release thm geometry::main::distance_sq_symmetric(d, e1)
    geometry::main::distance_sq(b, a) = geometry::main::distance_sq(a, b) = geometry::main::distance_sq(d, e1) = geometry::main::distance_sq(e1, d)
    release thm geometry::main::triangle_congruence_AAS(c, b, a, f, e1, d)
    release thm geometry::main::distance_sq_symmetric(b, c)
    release thm geometry::main::distance_sq_symmetric(e1, f)
    release thm geometry::main::distance_sq_symmetric(a, c)
    release thm geometry::main::distance_sq_symmetric(d, f)
    geometry::main::distance_sq(b, c) = geometry::main::distance_sq(c, b) = geometry::main::distance_sq(f, e1) = geometry::main::distance_sq(e1, f)
    geometry::main::distance_sq(a, c) = geometry::main::distance_sq(c, a) = geometry::main::distance_sq(f, d) = geometry::main::distance_sq(d, f)
    by def $geometry::main::are_segments_congruent(b, c, e1, f)
    by def $geometry::main::are_segments_congruent(a, c, d, f)
    release thm geometry::main::sss_congruence(a, b, c, d, e1, f)
    release thm geometry_lemmas::angle_congruence_from_equal_sides_and_dot(a, b, c, d, e1, f)


# Book I.27: equal alternate angles force two distinct lines to be parallel.
# p,q are the transversal intersections; a,b are on its opposite sides.
# Euclid excludes intersection using I.16. The analytic route combines equal
# normalized dots and opposite determinant signs to show antiparallel rays.
thm proposition_27:
    ? forall p, q, a, b cart(R, R):
        p != q
        p != a
        q != b
        $geometry::main::are_angles_congruent(a, p, q, p, q, b)
        geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, a))*geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(q, b)) < 0
        =>:
            $parallel::are_parallel_lines(p, a, q, b)
    have u cart(R, R) = geometry::main::vec(p, a)
    have v cart(R, R) = geometry::main::vec(q, b)
    have w cart(R, R) = geometry::main::vec(p, q)
    release thm geometry::main::vec_coordinate_formula(p, a)
    release thm geometry::main::vec_coordinate_formula(q, b)
    release thm geometry::main::vec_coordinate_formula(p, q)
    u(1) = a(1)-p(1)
    u(2) = a(2)-p(2)
    v(1) = b(1)-q(1)
    v(2) = b(2)-q(2)
    w(1) = q(1)-p(1)
    w(2) = q(2)-p(2)
    have n1 R = geometry::main::dot(w, u)
    have n2 R = geometry::main::dot(w, v)
    have d1 R = geometry::main::det(w, u)
    have d2 R = geometry::main::det(w, v)
    d1 = geometry::main::det(w, u) = geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, a))
    d2 = geometry::main::det(w, v) = geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(q, b))
    d1*d2 = geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, a))*geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(q, b)) < 0
    release thm geometry::main::dot_coordinate_formula(w, u)
    release thm geometry::main::dot_coordinate_formula(w, v)
    release thm geometry::main::det_coordinate_formula(w, u)
    release thm geometry::main::det_coordinate_formula(w, v)
    n1 = w(1)*u(1)+w(2)*u(2)
    n2 = w(1)*v(1)+w(2)*v(2)
    d1 = w(1)*u(2)-w(2)*u(1)
    d2 = w(1)*v(2)-w(2)*v(1)
    release thm geometry::main::dot_symmetric(u, w)
    geometry::main::angle_cos_num(a, p, q) = geometry::main::dot(u, w) = geometry::main::dot(w, u) = n1
    release thm geometry::main::perpendicular_dot_expand(q, p, q, b)
    p(1)-q(1) = -(q(1)-p(1)) = -w(1)
    p(2)-q(2) = -(q(2)-p(2)) = -w(2)
    geometry::main::angle_cos_num(p, q, b) = geometry::main::dot(geometry::main::vec(q, p), geometry::main::vec(q, b))
    geometry::main::dot(geometry::main::vec(q, p), geometry::main::vec(q, b)) = (p(1)-q(1))*(b(1)-q(1))+(p(2)-q(2))*(b(2)-q(2))
    (p(1)-q(1))*(b(1)-q(1))+(p(2)-q(2))*(b(2)-q(2)) = (-w(1))*v(1)+(-w(2))*v(2) = -(w(1)*v(1)+w(2)*v(2)) = -n2
    geometry::main::angle_cos_num(p, q, b) = -n2
    release thm geometry::main::det_antisymmetric(w, u)
    geometry::main::det(u, w) = -(geometry::main::det(w, u)) = -d1
    geometry::main::det(geometry::main::vec(p, a), geometry::main::vec(p, q)) = geometry::main::det(u, w)
    geometry::main::det(geometry::main::vec(p, a), geometry::main::vec(p, q)) = -d1
    release thm geometry::main::collinear_det_expand(q, p, b)
    geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, b)) = (p(1)-q(1))*(b(2)-q(2))-(p(2)-q(2))*(b(1)-q(1))
    (p(1)-q(1))*(b(2)-q(2))-(p(2)-q(2))*(b(1)-q(1)) = (-w(1))*v(2)-(-w(2))*v(1) = -(w(1)*v(2)-w(2)*v(1)) = -d2
    geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, b)) = -d2
    release thm angles::angle_den_positive(a, p, q)
    release thm angles::angle_den_positive(p, q, b)
    release thm angles::angle_den_nonnegative(a, p, q)
    release thm angles::angle_den_nonnegative(p, q, b)
    have r1 R+ = sqrt(geometry::main::angle_cos_den(a, p, q))
    have r2 R+ = sqrt(geometry::main::angle_cos_den(p, q, b))
    r1^2 = sqrt(geometry::main::angle_cos_den(a, p, q))^2 = geometry::main::angle_cos_den(a, p, q)
    r2^2 = sqrt(geometry::main::angle_cos_den(p, q, b))^2 = geometry::main::angle_cos_den(p, q, b)
    release thm angle_measure::angle_relation_implies_equal_cosine(a, p, q, p, q, b)
    angles::angle_cosine(a, p, q) = geometry::main::angle_cos_num(a, p, q)/sqrt(geometry::main::angle_cos_den(a, p, q)) = n1/r1
    angles::angle_cosine(p, q, b) = geometry::main::angle_cos_num(p, q, b)/sqrt(geometry::main::angle_cos_den(p, q, b)) = -n2/r2
    n1/r1 = -n2/r2
    n1*r2 = ((n1/r1)*r1)*r2 = ((-n2/r2)*r1)*r2 = -n2*r1
    release thm geometry::main::congruent_angle_det_square_ratio(a, p, q, p, q, b)
    release thm geometry::main::square_neg(d1)
    release thm geometry::main::square_neg(d2)
    geometry::main::det(geometry::main::vec(p, a), geometry::main::vec(p, q))^2 = (-d1)^2 = d1^2
    geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, b))^2 = (-d2)^2 = d2^2
    d1^2*geometry::main::angle_cos_den(p, q, b) = geometry::main::det(geometry::main::vec(p, a), geometry::main::vec(p, q))^2*geometry::main::angle_cos_den(p, q, b)
    d2^2*geometry::main::angle_cos_den(a, p, q) = geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, b))^2*geometry::main::angle_cos_den(a, p, q)
    d1^2*geometry::main::angle_cos_den(p, q, b) = d2^2*geometry::main::angle_cos_den(a, p, q)
    d1^2*r2^2 = d1^2*geometry::main::angle_cos_den(p, q, b) = d2^2*geometry::main::angle_cos_den(a, p, q) = d2^2*r1^2
    (d1*r2)^2 = d1^2*r2^2 = d2^2*r1^2 = (-d2*r1)^2
    -(d1*d2) > 0
    r1*r2 > 0
    (d1*r2)*(-d2*r1) = -(d1*d2)*(r1*r2) > 0
    (d1*r2)*(-d2*r1) >= 0
    release thm angle_measure::same_square_and_sign_gives_equality(d1*r2, -d2*r1)
    have zx R = r2*u(1)+r1*v(1)
    have zy R = r2*u(2)+r1*v(2)
    w(1)*zx+w(2)*zy = w(1)*(r2*u(1)+r1*v(1))+w(2)*(r2*u(2)+r1*v(2))
    w(1)*(r2*u(1)+r1*v(1))+w(2)*(r2*u(2)+r1*v(2)) = r2*(w(1)*u(1)+w(2)*u(2))+r1*(w(1)*v(1)+w(2)*v(2))
    r2*(w(1)*u(1)+w(2)*u(2))+r1*(w(1)*v(1)+w(2)*v(2)) = r2*n1+r1*n2
    r2*n1+r1*n2 = n1*r2+n2*r1 = (-n2*r1)+n2*r1 = 0
    w(1)*zx+w(2)*zy = 0
    w(1)*zy-w(2)*zx = w(1)*(r2*u(2)+r1*v(2))-w(2)*(r2*u(1)+r1*v(1))
    w(1)*(r2*u(2)+r1*v(2))-w(2)*(r2*u(1)+r1*v(1)) = r2*(w(1)*u(2)-w(2)*u(1))+r1*(w(1)*v(2)-w(2)*v(1))
    r2*(w(1)*u(2)-w(2)*u(1))+r1*(w(1)*v(2)-w(2)*v(1)) = r2*d1+r1*d2
    r2*d1+r1*d2 = d1*r2+d2*r1 = (-d2*r1)+d2*r1 = 0
    w(1)*zy-w(2)*zx = 0
    release thm geometry::main::distance_sq_coordinate_formula(p, q)
    release thm geometry::main::distance_sq_positive_of_ne(p, q)
    w(1)^2+w(2)^2 = (q(1)-p(1))^2+(q(2)-p(2))^2 = geometry::main::distance_sq(p, q) > 0
    release thm geometry::main::dot_det_eliminate(w(1), w(2), zx, zy)
    r1*v(1) = (r2*u(1)+r1*v(1))-r2*u(1) = zx-r2*u(1)
    v(1) = (r1*v(1))/r1 = (zx-r2*u(1))/r1 = (0-r2*u(1))/r1 = -r2*u(1)/r1
    r1*v(2) = (r2*u(2)+r1*v(2))-r2*u(2) = zy-r2*u(2)
    v(2) = (r1*v(2))/r1 = (zy-r2*u(2))/r1 = (0-r2*u(2))/r1 = -r2*u(2)/r1
    release thm geometry::main::det_coordinate_formula(u, v)
    geometry::main::det(u, v) = u(1)*v(2)-u(2)*v(1) = u(1)*(-r2*u(2)/r1)-u(2)*(-r2*u(1)/r1) = 0
    geometry::main::det(geometry::main::vec(p, a), geometry::main::vec(q, b)) = geometry::main::det(u, v) = 0
    by def $geometry::main::is_parallel(p, a, q, b)
    by contra:
        ? d1 != 0
        d1 = 0
        d1*d2 = 0*d2 = 0
        impossible d1*d2 < 0
    by contra:
        ? geometry::main::det(geometry::main::vec(p, a), geometry::main::vec(p, q)) != 0
        geometry::main::det(geometry::main::vec(p, a), geometry::main::vec(p, q)) = 0
        d1 = -(-(d1)) = -(geometry::main::det(geometry::main::vec(p, a), geometry::main::vec(p, q))) = -0 = 0
        impossible d1 != 0
    by def $parallel::are_parallel_lines(p, a, q, b)


# Shared I.28 step: supplementary normalized cosines on the same side of a
# transversal force distinct parallel lines. Reflect one ray and apply I.27.
thm same_side_opposite_cosines_make_parallel:
    ? forall p, q, a, b cart(R, R):
        p != q
        p != a
        q != b
        geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, a))*geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(q, b)) > 0
        angles::angle_cosine(a, p, q) = -angles::angle_cosine(p, q, b)
        =>:
            $parallel::are_parallel_lines(p, a, q, b)
    have opposite cart(R, R) = (2*p(1)-a(1), 2*p(2)-a(2))
    opposite(1) = 2*p(1)-a(1)
    opposite(2) = 2*p(2)-a(2)
    opposite(1)-p(1) = (2*p(1)-a(1))-p(1) = p(1)-a(1) = -(a(1)-p(1))
    opposite(2)-p(2) = (2*p(2)-a(2))-p(2) = p(2)-a(2) = -(a(2)-p(2))
    a(1) = 2*p(1)-(2*p(1)-a(1)) = 2*p(1)-opposite(1)
    a(2) = 2*p(2)-(2*p(2)-a(2)) = 2*p(2)-opposite(2)
    by contra:
        ? opposite != p
        opposite = p
        opposite(1) = p(1)
        opposite(2) = p(2)
        a(1) = 2*p(1)-opposite(1) = 2*p(1)-p(1) = p(1)
        a(2) = 2*p(2)-opposite(2) = 2*p(2)-p(2) = p(2)
        a = (a(1),a(2)) = (p(1),p(2)) = p
        impossible p != a
    release thm angle_measure::negative_ray_scale_changes_cosine_sign(q, p, a, opposite, 1)
    release thm angle_measure::angle_cosine_arms_symmetric(opposite, p, q)
    release thm angle_measure::angle_cosine_arms_symmetric(a, p, q)
    angles::angle_cosine(opposite, p, q) = angles::angle_cosine(q, p, opposite) = -angles::angle_cosine(q, p, a) = -angles::angle_cosine(a, p, q) = -(-angles::angle_cosine(p, q, b)) = angles::angle_cosine(p, q, b)
    release thm angle_measure::equal_cosines_imply_angle_relation(opposite, p, q, p, q, b)
    have u cart(R, R) = geometry::main::vec(p, a)
    have v cart(R, R) = geometry::main::vec(q, b)
    have w cart(R, R) = geometry::main::vec(p, q)
    have reflected cart(R, R) = geometry::main::vec(p, opposite)
    release thm geometry::main::vec_coordinate_formula(p, a)
    release thm geometry::main::vec_coordinate_formula(p, opposite)
    u(1) = a(1)-p(1)
    u(2) = a(2)-p(2)
    reflected(1) = opposite(1)-p(1) = -u(1)
    reflected(2) = opposite(2)-p(2) = -u(2)
    release thm geometry::main::det_coordinate_formula(w, u)
    release thm geometry::main::det_coordinate_formula(w, reflected)
    release thm geometry::main::det_coordinate_formula(u, v)
    release thm geometry::main::det_coordinate_formula(reflected, v)
    release thm geometry::main::det_coordinate_formula(u, w)
    release thm geometry::main::det_coordinate_formula(reflected, w)
    geometry::main::det(w, reflected) = w(1)*reflected(2)-w(2)*reflected(1) = w(1)*(-u(2))-w(2)*(-u(1)) = -(w(1)*u(2)-w(2)*u(1)) = -geometry::main::det(w, u)
    geometry::main::det(reflected, v) = reflected(1)*v(2)-reflected(2)*v(1) = (-u(1))*v(2)-(-u(2))*v(1) = -(u(1)*v(2)-u(2)*v(1)) = -geometry::main::det(u, v)
    geometry::main::det(reflected, w) = reflected(1)*w(2)-reflected(2)*w(1) = (-u(1))*w(2)-(-u(2))*w(1) = -(u(1)*w(2)-u(2)*w(1)) = -geometry::main::det(u, w)
    geometry::main::det(w, u)*geometry::main::det(w, v) = geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, a))*geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(q, b)) > 0
    geometry::main::det(w, reflected) = geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, opposite))
    geometry::main::det(w, u) = geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, a))
    geometry::main::det(w, v) = geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(q, b))
    -(geometry::main::det(w, u)*geometry::main::det(w, v)) < 0
    geometry::main::det(w, reflected)*geometry::main::det(w, v) = (-(geometry::main::det(w, u)))*geometry::main::det(w, v) = -(geometry::main::det(w, u)*geometry::main::det(w, v))
    geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, opposite))*geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(q, b)) = geometry::main::det(w, reflected)*geometry::main::det(w, v)
    geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, opposite))*geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(q, b)) < 0
    release thm proposition_27(p, q, opposite, b)
    by def $parallel::are_parallel_lines(p, opposite, q, b)
    $geometry::main::is_parallel(p, opposite, q, b)
    by def $geometry::main::is_parallel(p, opposite, q, b)
    geometry::main::det(reflected, v) = geometry::main::det(geometry::main::vec(p, opposite), geometry::main::vec(q, b)) = 0
    geometry::main::det(u, v) = -(-(geometry::main::det(u, v))) = -(geometry::main::det(reflected, v)) = -0 = 0
    geometry::main::det(geometry::main::vec(p, a), geometry::main::vec(q, b)) = geometry::main::det(u, v) = 0
    by def $geometry::main::is_parallel(p, a, q, b)
    by contra:
        ? geometry::main::det(u, w) != 0
        geometry::main::det(u, w) = 0
        geometry::main::det(reflected, w) = -(geometry::main::det(u, w)) = -0 = 0
        geometry::main::det(geometry::main::vec(p, opposite), geometry::main::vec(p, q)) = geometry::main::det(reflected, w) = 0
        impossible geometry::main::det(geometry::main::vec(p, opposite), geometry::main::vec(p, q)) != 0
    geometry::main::det(geometry::main::vec(p, a), geometry::main::vec(p, q)) = geometry::main::det(u, w)
    geometry::main::det(geometry::main::vec(p, a), geometry::main::vec(p, q)) != 0
    by def $parallel::are_parallel_lines(p, a, q, b)


# Book I.28, corresponding-angle case: external ray px is opposite to
# transversal ray pq. Equal external/internal corresponding angles yield
# supplementary same-side cosines, hence parallelism through I.27.

thm proposition_28_corresponding:
    ? forall p, q, a, b, x cart(R, R), t R+:
        p != q
        p != a
        q != b
        p != x
        x(1)-p(1) = -t*(q(1)-p(1))
        x(2)-p(2) = -t*(q(2)-p(2))
        geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, a))*geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(q, b)) > 0
        $geometry::main::are_angles_congruent(x, p, a, p, q, b)
        =>:
            $parallel::are_parallel_lines(p, a, q, b)
    release thm angle_measure::angle_relation_implies_equal_cosine(x, p, a, p, q, b)
    release thm angle_measure::negative_ray_scale_changes_cosine_sign(a, p, q, x, t)
    release thm angle_measure::angle_cosine_arms_symmetric(x, p, a)
    angles::angle_cosine(x, p, a) = angles::angle_cosine(a, p, x) = -angles::angle_cosine(a, p, q)
    angles::angle_cosine(a, p, q) = -(-angles::angle_cosine(a, p, q)) = -angles::angle_cosine(x, p, a) = -angles::angle_cosine(p, q, b)
    release thm same_side_opposite_cosines_make_parallel(p, q, a, b)


# Book I.28, same-side interior-angle case: a sum of two right angles
# makes the lines parallel. Opposite cosines reduce this directly to I.27.
thm proposition_28_interior_sum:
    ? forall p, q, a, b cart(R, R):
        p != q
        p != a
        q != b
        geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, a))*geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(q, b)) > 0
        angle_measure::ray_angle(a, p, q)+angle_measure::ray_angle(p, q, b) = pi
        =>:
            $parallel::are_parallel_lines(p, a, q, b)
    release thm angle_measure::supplementary_measures_imply_opposite_cosines(a, p, q, p, q, b)
    angles::angle_cosine(a, p, q) = -(-angles::angle_cosine(a, p, q)) = -angles::angle_cosine(p, q, b)
    release thm same_side_opposite_cosines_make_parallel(p, q, a, b)


# Book I.29: a transversal of parallel lines gives equal alternate angles,
# equal corresponding exterior/interior angles, and same-side interior sum pi.
# c and x are the opposite first-line and transversal rays, with positive
# scale parameters recording their source positions. The real-plane proof
# derives a negative parallel-ray scale, then preserves normalized cosines.
thm proposition_29:
    ? forall p, q, a, b, c, x cart(R, R), r, s R+:
        p != q
        p != a
        q != b
        p != c
        p != x
        $parallel::are_parallel_lines(p, a, q, b)
        geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, a))*geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(q, b)) < 0
        c(1)-p(1) = -s*(a(1)-p(1))
        c(2)-p(2) = -s*(a(2)-p(2))
        x(1)-p(1) = -r*(q(1)-p(1))
        x(2)-p(2) = -r*(q(2)-p(2))
        =>:
            $geometry::main::are_angles_congruent(a, p, q, p, q, b)
            $geometry::main::are_angles_congruent(x, p, c, p, q, b)
            angle_measure::ray_angle(c, p, q)+angle_measure::ray_angle(p, q, b) = pi
    by def $parallel::are_parallel_lines(p, a, q, b)
    $geometry::main::is_parallel(p, a, q, b)
    by def $geometry::main::is_parallel(p, a, q, b)
    have ux R = a(1)-p(1)
    have uy R = a(2)-p(2)
    have vx R = b(1)-q(1)
    have vy R = b(2)-q(2)
    have wx R = q(1)-p(1)
    have wy R = q(2)-p(2)
    release thm geometry::main::distance_sq_positive_of_ne(p, a)
    release thm geometry::main::distance_sq_coordinate_formula(p, a)
    have norm R+ = geometry::main::distance_sq(p, a)
    norm = (a(1)-p(1))^2+(a(2)-p(2))^2 = ux^2+uy^2
    release thm geometry::main::vec_coordinate_formula(p, a)
    release thm geometry::main::vec_coordinate_formula(q, b)
    release thm geometry::main::vec_coordinate_formula(p, q)
    geometry::main::vec(p, a)(1) = a(1)-p(1) = ux
    geometry::main::vec(p, a)(2) = a(2)-p(2) = uy
    geometry::main::vec(q, b)(1) = b(1)-q(1) = vx
    geometry::main::vec(q, b)(2) = b(2)-q(2) = vy
    geometry::main::vec(p, q)(1) = q(1)-p(1) = wx
    geometry::main::vec(p, q)(2) = q(2)-p(2) = wy
    release thm geometry::main::det_coordinate_formula(geometry::main::vec(p, a), geometry::main::vec(q, b))
    geometry::main::det(geometry::main::vec(p, a), geometry::main::vec(q, b)) = ux*vy-uy*vx = 0
    have projection R = ux*vx+uy*vy
    norm*vx = (ux^2+uy^2)*vx = ux*(ux*vx+uy*vy)-uy*(ux*vy-uy*vx) = ux*projection-uy*0 = ux*projection
    norm*vy = (ux^2+uy^2)*vy = uy*(ux*vx+uy*vy)+ux*(ux*vy-uy*vx) = uy*projection+ux*0 = uy*projection
    have ratio R = projection/norm
    ratio*ux = (projection/norm)*ux = (ux*projection)/norm
    vx = (norm*vx)/norm = (ux*projection)/norm
    vx = ratio*ux
    ratio*uy = (projection/norm)*uy = (uy*projection)/norm
    vy = (norm*vy)/norm = (uy*projection)/norm
    vy = ratio*uy
    have d1 R = wx*uy-wy*ux
    have d2 R = wx*vy-wy*vx
    release thm geometry::main::det_coordinate_formula(geometry::main::vec(p, q), geometry::main::vec(p, a))
    release thm geometry::main::det_coordinate_formula(geometry::main::vec(p, q), geometry::main::vec(q, b))
    geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, a)) = wx*uy-wy*ux = d1
    geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(q, b)) = wx*vy-wy*vx = d2
    d1*d2 = geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(p, a))*geometry::main::det(geometry::main::vec(p, q), geometry::main::vec(q, b)) < 0
    d2 = wx*vy-wy*vx = wx*(ratio*uy)-wy*(ratio*ux) = ratio*(wx*uy-wy*ux) = ratio*d1
    ratio*d1^2 = d1*(ratio*d1) = d1*d2 < 0
    by contra:
        ? ratio < 0
        ratio >= 0
        d1^2 >= 0
        ratio*d1^2 >= 0
        impossible ratio*d1^2 < 0
    -ratio > 0
    have k R+ = -ratio
    -k = -(-ratio) = ratio
    -k*(a(1)-p(1)) = ratio*ux = vx
    b(1)-q(1) = vx = -k*(a(1)-p(1))
    -k*(a(2)-p(2)) = ratio*uy = vy
    b(2)-q(2) = vy = -k*(a(2)-p(2))
    release thm angles::angle_den_positive(a, p, q)
    release thm angles::angle_den_nonnegative(a, p, q)
    release thm angles::angle_den_nonnegative(p, q, b)
    have den R+ = geometry::main::angle_cos_den(a, p, q)
    have root R+ = sqrt(den)
    have numerator R = geometry::main::angle_cos_num(a, p, q)
    release thm geometry::main::perpendicular_dot_expand(p, a, p, q)
    release thm geometry::main::perpendicular_dot_expand(q, p, q, b)
    geometry::main::angle_cos_num(a, p, q) = geometry::main::dot(geometry::main::vec(p, a), geometry::main::vec(p, q))
    geometry::main::dot(geometry::main::vec(p, a), geometry::main::vec(p, q)) = (a(1)-p(1))*(q(1)-p(1))+(a(2)-p(2))*(q(2)-p(2))
    numerator = geometry::main::angle_cos_num(a, p, q) = (a(1)-p(1))*(q(1)-p(1))+(a(2)-p(2))*(q(2)-p(2))
    p(1)-q(1) = -(q(1)-p(1))
    p(2)-q(2) = -(q(2)-p(2))
    geometry::main::angle_cos_num(p, q, b) = geometry::main::dot(geometry::main::vec(q, p), geometry::main::vec(q, b)) = (p(1)-q(1))*(b(1)-q(1))+(p(2)-q(2))*(b(2)-q(2))
    (p(1)-q(1))*(b(1)-q(1))+(p(2)-q(2))*(b(2)-q(2)) = (-(q(1)-p(1)))*(-k*(a(1)-p(1)))+(-(q(2)-p(2)))*(-k*(a(2)-p(2))) = k*((a(1)-p(1))*(q(1)-p(1))+(a(2)-p(2))*(q(2)-p(2))) = k*numerator
    geometry::main::angle_cos_num(p, q, b) = k*numerator
    release thm geometry::main::distance_sq_coordinate_formula(q, b)
    release thm geometry::main::distance_sq_coordinate_formula(p, a)
    geometry::main::distance_sq(q, b) = (b(1)-q(1))^2+(b(2)-q(2))^2 = (-k*(a(1)-p(1)))^2+(-k*(a(2)-p(2)))^2 = k^2*((a(1)-p(1))^2+(a(2)-p(2))^2) = k^2*geometry::main::distance_sq(p, a)
    release thm geometry::main::distance_sq_symmetric(p, q)
    geometry::main::distance_sq(q, p) = geometry::main::distance_sq(p, q)
    den = geometry::main::angle_cos_den(a, p, q) = geometry::main::distance_sq(p, a)*geometry::main::distance_sq(p, q)
    geometry::main::angle_cos_den(p, q, b) = geometry::main::distance_sq(q, p)*geometry::main::distance_sq(q, b)
    geometry::main::distance_sq(q, p)*geometry::main::distance_sq(q, b) = geometry::main::distance_sq(p, q)*(k^2*geometry::main::distance_sq(p, a))
    geometry::main::distance_sq(p, q)*(k^2*geometry::main::distance_sq(p, a)) = k^2*(geometry::main::distance_sq(p, a)*geometry::main::distance_sq(p, q)) = k^2*den
    geometry::main::angle_cos_den(p, q, b) = k^2*den
    release thm angle_measure::scaled_positive_root_domain(k, den)
    sqrt(geometry::main::angle_cos_den(p, q, b)) = sqrt(k^2*den) = sqrt(k^2)*sqrt(den) = |k|*root = k*root
    sqrt(geometry::main::angle_cos_den(a, p, q)) = sqrt(den) = root
    angles::angle_cosine(a, p, q) = geometry::main::angle_cos_num(a, p, q)/sqrt(geometry::main::angle_cos_den(a, p, q)) = numerator/root
    angles::angle_cosine(p, q, b) = geometry::main::angle_cos_num(p, q, b)/sqrt(geometry::main::angle_cos_den(p, q, b)) = (k*numerator)/(k*root) = numerator/root
    release thm angle_measure::equal_cosines_imply_angle_relation(a, p, q, p, q, b)
    release thm angle_measure::negative_ray_scale_changes_cosine_sign(q, p, a, c, s)
    release thm angle_measure::angle_cosine_arms_symmetric(c, p, q)
    release thm angle_measure::angle_cosine_arms_symmetric(a, p, q)
    angles::angle_cosine(c, p, q) = angles::angle_cosine(q, p, c) = -angles::angle_cosine(q, p, a) = -angles::angle_cosine(a, p, q) = -angles::angle_cosine(p, q, b)
    release thm angle_measure::negative_ray_scale_changes_cosine_sign(c, p, q, x, r)
    release thm angle_measure::angle_cosine_arms_symmetric(x, p, c)
    angles::angle_cosine(x, p, c) = angles::angle_cosine(c, p, x) = -angles::angle_cosine(c, p, q) = -(-angles::angle_cosine(a, p, q)) = angles::angle_cosine(a, p, q) = angles::angle_cosine(p, q, b)
    release thm angle_measure::equal_cosines_imply_angle_relation(x, p, c, p, q, b)
    angles::angle_cosine(p, q, b) = -(-angles::angle_cosine(p, q, b)) = -angles::angle_cosine(c, p, q)
    release thm angle_measure::opposite_cosines_give_supplementary_angles(c, p, q, p, q, b)


# Book I.30: different straight lines parallel to one common straight
# line are parallel to one another. Actual line-set inequality records the
# source's distinct named lines; coincident lines are handled separately.

thm proposition_30:
    ? forall a, b, c, d, e0, f cart(R, R):
        a != b
        c != d
        e0 != f
        $parallel::are_parallel_lines(a, b, e0, f)
        $parallel::are_parallel_lines(c, d, e0, f)
        geometry::main::line_through_points(a, b) != geometry::main::line_through_points(c, d)
        =>:
            $parallel::are_parallel_lines(a, b, c, d)
    thm local_planar_gram_determinant_identity:
        ? forall u, v, w cart(R, R):
            geometry::main::dot(u, u)*geometry::main::det(v, w) = geometry::main::dot(u, v)*geometry::main::det(u, w)-geometry::main::dot(u, w)*geometry::main::det(u, v)
        release thm angle_measure::planar_gram_coordinate_identities(u(1), u(2), v(1), v(2), w(1), w(2))
        release thm geometry::main::dot_coordinate_formula(u, u)
        release thm geometry::main::dot_coordinate_formula(u, v)
        release thm geometry::main::dot_coordinate_formula(u, w)
        release thm geometry::main::det_coordinate_formula(u, v)
        release thm geometry::main::det_coordinate_formula(u, w)
        release thm geometry::main::det_coordinate_formula(v, w)
        geometry::main::dot(u, u) = u(1)*u(1)+u(2)*u(2) = u(1)^2+u(2)^2
        geometry::main::dot(u, u)*geometry::main::det(v, w) = (u(1)^2+u(2)^2)*(v(1)*w(2)-v(2)*w(1))
        (u(1)^2+u(2)^2)*(v(1)*w(2)-v(2)*w(1)) = (u(1)*v(1)+u(2)*v(2))*(u(1)*w(2)-u(2)*w(1))-(u(1)*w(1)+u(2)*w(2))*(u(1)*v(2)-u(2)*v(1))
        (u(1)*v(1)+u(2)*v(2))*(u(1)*w(2)-u(2)*w(1))-(u(1)*w(1)+u(2)*w(2))*(u(1)*v(2)-u(2)*v(1)) = geometry::main::dot(u, v)*geometry::main::det(u, w)-geometry::main::dot(u, w)*geometry::main::det(u, v)
    thm local_parallel_directions_transitive:
        ? forall dir_u, dir_v, dir_w cart(R, R):
            geometry::main::dot(dir_u, dir_u) > 0
            geometry::main::det(dir_u, dir_v) = 0
            geometry::main::det(dir_u, dir_w) = 0
            =>:
                geometry::main::det(dir_v, dir_w) = 0
        release thm local_planar_gram_determinant_identity(dir_u, dir_v, dir_w)
        geometry::main::dot(dir_u, dir_u)*geometry::main::det(dir_v, dir_w) = geometry::main::dot(dir_u, dir_v)*0-geometry::main::dot(dir_u, dir_w)*0 = 0
        geometry::main::dot(dir_u, dir_u) != 0
        geometry::main::det(dir_v, dir_w) = (geometry::main::dot(dir_u, dir_u)*geometry::main::det(dir_v, dir_w))/geometry::main::dot(dir_u, dir_u) = 0/geometry::main::dot(dir_u, dir_u) = 0
    thm local_coincident_line_membership_transfer:
        ? forall member_a, member_b, member_c, member_d, member_p cart(R, R):
            member_a != member_b
            member_c != member_d
            geometry::main::det(geometry::main::vec(member_a, member_b), geometry::main::vec(member_c, member_d)) = 0
            geometry::main::det(geometry::main::vec(member_a, member_b), geometry::main::vec(member_a, member_c)) = 0
            member_p $in geometry::main::line_through_points(member_a, member_b)
            =>:
                member_p $in geometry::main::line_through_points(member_c, member_d)
        geometry::main::line_through_points(member_a, member_b) = {r cart(R, R): geometry::main::det(geometry::main::vec(member_a, r), geometry::main::vec(member_a, member_b)) = 0}
        member_p $in geometry::main::line_through_points(member_a, member_b)
        member_p $in {r cart(R, R): geometry::main::det(geometry::main::vec(member_a, r), geometry::main::vec(member_a, member_b)) = 0}
        release thm set_builder_member(member_p, {r cart(R, R): geometry::main::det(geometry::main::vec(member_a, r), geometry::main::vec(member_a, member_b)) = 0})
        have member_u cart(R, R) = geometry::main::vec(member_a, member_b)
        have member_v cart(R, R) = geometry::main::vec(member_c, member_d)
        have member_offset cart(R, R) = geometry::main::vec(member_a, member_c)
        have member_first_point cart(R, R) = geometry::main::vec(member_a, member_p)
        have member_second_point cart(R, R) = geometry::main::vec(member_c, member_p)
        release thm geometry::main::distance_sq_positive_of_ne(member_a, member_b)
        release thm geometry::main::vec_dot_self_is_distance(member_a, member_b)
        geometry::main::dot(member_u, member_u) = geometry::main::dot(geometry::main::vec(member_a, member_b), geometry::main::vec(member_a, member_b)) = geometry::main::distance_sq(member_a, member_b) > 0
        geometry::main::det(member_u, member_v) = geometry::main::det(geometry::main::vec(member_a, member_b), geometry::main::vec(member_c, member_d)) = 0
        geometry::main::det(member_u, member_offset) = geometry::main::det(geometry::main::vec(member_a, member_b), geometry::main::vec(member_a, member_c)) = 0
        release thm geometry::main::det_antisymmetric(member_first_point, member_u)
        geometry::main::det(member_first_point, member_u) = geometry::main::det(geometry::main::vec(member_a, member_p), geometry::main::vec(member_a, member_b)) = 0
        geometry::main::det(member_u, member_first_point) = -(geometry::main::det(member_first_point, member_u)) = -0 = 0
        release thm local_parallel_directions_transitive(member_u, member_v, member_offset)
        release thm local_parallel_directions_transitive(member_u, member_v, member_first_point)
        geometry::main::det(member_v, member_offset) = 0
        geometry::main::det(member_v, member_first_point) = 0
        release thm geometry::main::vec_coordinate_formula(member_a, member_c)
        release thm geometry::main::vec_coordinate_formula(member_a, member_p)
        release thm geometry::main::vec_coordinate_formula(member_c, member_p)
        member_offset(1) = member_c(1)-member_a(1)
        member_offset(2) = member_c(2)-member_a(2)
        member_first_point(1) = member_p(1)-member_a(1)
        member_first_point(2) = member_p(2)-member_a(2)
        member_second_point(1) = member_p(1)-member_c(1) = (member_p(1)-member_a(1))-(member_c(1)-member_a(1)) = member_first_point(1)-member_offset(1)
        member_second_point(2) = member_p(2)-member_c(2) = (member_p(2)-member_a(2))-(member_c(2)-member_a(2)) = member_first_point(2)-member_offset(2)
        release thm geometry::main::det_coordinate_formula(member_v, member_second_point)
        release thm geometry::main::det_coordinate_formula(member_v, member_first_point)
        release thm geometry::main::det_coordinate_formula(member_v, member_offset)
        geometry::main::det(member_v, member_second_point) = member_v(1)*member_second_point(2)-member_v(2)*member_second_point(1) = member_v(1)*(member_first_point(2)-member_offset(2))-member_v(2)*(member_first_point(1)-member_offset(1)) = (member_v(1)*member_first_point(2)-member_v(2)*member_first_point(1))-(member_v(1)*member_offset(2)-member_v(2)*member_offset(1)) = geometry::main::det(member_v, member_first_point)-geometry::main::det(member_v, member_offset) = 0-0 = 0
        release thm geometry::main::det_antisymmetric(member_v, member_second_point)
        geometry::main::det(member_second_point, member_v) = -(geometry::main::det(member_v, member_second_point)) = -0 = 0
        geometry::main::det(geometry::main::vec(member_c, member_p), geometry::main::vec(member_c, member_d)) = geometry::main::det(member_second_point, member_v) = 0
        member_p $in geometry::main::line_through_points(member_c, member_d)
    thm local_parallel_zero_offset_lines_equal:
        ? forall equal_a, equal_b, equal_c, equal_d cart(R, R):
            equal_a != equal_b
            equal_c != equal_d
            geometry::main::det(geometry::main::vec(equal_a, equal_b), geometry::main::vec(equal_c, equal_d)) = 0
            geometry::main::det(geometry::main::vec(equal_a, equal_b), geometry::main::vec(equal_a, equal_c)) = 0
            =>:
                geometry::main::line_through_points(equal_a, equal_b) = geometry::main::line_through_points(equal_c, equal_d)
        have equal_u cart(R, R) = geometry::main::vec(equal_a, equal_b)
        have equal_v cart(R, R) = geometry::main::vec(equal_c, equal_d)
        have equal_offset cart(R, R) = geometry::main::vec(equal_a, equal_c)
        have equal_reverse cart(R, R) = geometry::main::vec(equal_c, equal_a)
        release thm geometry::main::distance_sq_positive_of_ne(equal_a, equal_b)
        release thm geometry::main::vec_dot_self_is_distance(equal_a, equal_b)
        geometry::main::dot(equal_u, equal_u) = geometry::main::dot(geometry::main::vec(equal_a, equal_b), geometry::main::vec(equal_a, equal_b)) = geometry::main::distance_sq(equal_a, equal_b) > 0
        geometry::main::det(equal_u, equal_v) = geometry::main::det(geometry::main::vec(equal_a, equal_b), geometry::main::vec(equal_c, equal_d)) = 0
        geometry::main::det(equal_u, equal_offset) = geometry::main::det(geometry::main::vec(equal_a, equal_b), geometry::main::vec(equal_a, equal_c)) = 0
        release thm local_parallel_directions_transitive(equal_u, equal_v, equal_offset)
        release thm geometry::main::det_antisymmetric(equal_u, equal_v)
        geometry::main::det(equal_v, equal_u) = -(geometry::main::det(equal_u, equal_v)) = -0 = 0
        release thm geometry::main::vec_coordinate_formula(equal_a, equal_c)
        release thm geometry::main::vec_coordinate_formula(equal_c, equal_a)
        equal_offset(1) = equal_c(1)-equal_a(1)
        equal_offset(2) = equal_c(2)-equal_a(2)
        equal_reverse(1) = equal_a(1)-equal_c(1) = -(equal_c(1)-equal_a(1)) = -equal_offset(1)
        equal_reverse(2) = equal_a(2)-equal_c(2) = -(equal_c(2)-equal_a(2)) = -equal_offset(2)
        release thm geometry::main::det_coordinate_formula(equal_v, equal_offset)
        release thm geometry::main::det_coordinate_formula(equal_v, equal_reverse)
        geometry::main::det(equal_v, equal_reverse) = equal_v(1)*equal_reverse(2)-equal_v(2)*equal_reverse(1) = equal_v(1)*(-equal_offset(2))-equal_v(2)*(-equal_offset(1)) = -(equal_v(1)*equal_offset(2)-equal_v(2)*equal_offset(1)) = -(geometry::main::det(equal_v, equal_offset)) = -0 = 0
        geometry::main::det(geometry::main::vec(equal_c, equal_d), geometry::main::vec(equal_a, equal_b)) = geometry::main::det(equal_v, equal_u) = 0
        geometry::main::det(geometry::main::vec(equal_c, equal_d), geometry::main::vec(equal_c, equal_a)) = geometry::main::det(equal_v, equal_reverse) = 0
        geometry::main::line_through_points(equal_a, equal_b) = {r cart(R, R): geometry::main::det(geometry::main::vec(equal_a, r), geometry::main::vec(equal_a, equal_b)) = 0}
        geometry::main::line_through_points(equal_c, equal_d) = {r cart(R, R): geometry::main::det(geometry::main::vec(equal_c, r), geometry::main::vec(equal_c, equal_d)) = 0}
        claim:
            ? forall equal_p geometry::main::line_through_points(equal_a, equal_b):
                equal_p $in geometry::main::line_through_points(equal_c, equal_d)
            release thm set_builder_member(equal_p, {r geometry::main::line_through_points(equal_a, equal_b): 0=0})
            release thm local_coincident_line_membership_transfer(equal_a, equal_b, equal_c, equal_d, equal_p)
        claim:
            ? forall equal_p geometry::main::line_through_points(equal_c, equal_d):
                equal_p $in geometry::main::line_through_points(equal_a, equal_b)
            release thm set_builder_member(equal_p, {r geometry::main::line_through_points(equal_c, equal_d): 0=0})
            release thm local_coincident_line_membership_transfer(equal_c, equal_d, equal_a, equal_b, equal_p)
        by def geometry::main::line_through_points(equal_a, equal_b) $subset geometry::main::line_through_points(equal_c, equal_d)
        by def geometry::main::line_through_points(equal_c, equal_d) $subset geometry::main::line_through_points(equal_a, equal_b)
        by extension geometry::main::line_through_points(equal_a, equal_b) = geometry::main::line_through_points(equal_c, equal_d)
    by def $parallel::are_parallel_lines(a, b, e0, f)
    by def $parallel::are_parallel_lines(c, d, e0, f)
    $geometry::main::is_parallel(a, b, e0, f)
    by def $geometry::main::is_parallel(a, b, e0, f)
    $geometry::main::is_parallel(c, d, e0, f)
    by def $geometry::main::is_parallel(c, d, e0, f)
    have common cart(R, R) = geometry::main::vec(e0, f)
    have first cart(R, R) = geometry::main::vec(a, b)
    have second cart(R, R) = geometry::main::vec(c, d)
    release thm geometry::main::distance_sq_positive_of_ne(e0, f)
    release thm geometry::main::vec_dot_self_is_distance(e0, f)
    geometry::main::dot(common, common) = geometry::main::dot(geometry::main::vec(e0, f), geometry::main::vec(e0, f)) = geometry::main::distance_sq(e0, f) > 0
    geometry::main::det(first, common) = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(e0, f)) = 0
    geometry::main::det(second, common) = geometry::main::det(geometry::main::vec(c, d), geometry::main::vec(e0, f)) = 0
    release thm geometry::main::det_antisymmetric(first, common)
    release thm geometry::main::det_antisymmetric(second, common)
    geometry::main::det(common, first) = -(geometry::main::det(first, common)) = -0 = 0
    geometry::main::det(common, second) = -(geometry::main::det(second, common)) = -0 = 0
    release thm local_parallel_directions_transitive(common, first, second)
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(c, d)) = geometry::main::det(first, second) = 0
    by def $geometry::main::is_parallel(a, b, c, d)
    by contra:
        ? geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) != 0
        geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) = 0
        release thm local_parallel_zero_offset_lines_equal(a, b, c, d)
        impossible geometry::main::line_through_points(a, b) != geometry::main::line_through_points(c, d)
    by def $parallel::are_parallel_lines(a, b, c, d)

# Book I.31: through a point outside a given proper straight line, draw
# a distinct parallel line. The source copies an angle and applies I.27;
# here the translated endpoint gives an actual direction-preserving witness.
# Outside-line placement is explicit because Definition 23 excludes coincidence.

thm proposition_31:
    ? forall a, b, p cart(R, R):
        a != b
        not p $in geometry::main::line_through_points(a, b)
        =>:
            exist d cart(R, R) st {$parallel::are_parallel_lines(p, d, a, b)}
    have d cart(R, R) = (p(1)+b(1)-a(1), p(2)+b(2)-a(2))
    d(1) = p(1)+b(1)-a(1)
    d(2) = p(2)+b(2)-a(2)
    d(1)-p(1) = (p(1)+b(1)-a(1))-p(1) = b(1)-a(1)
    d(2)-p(2) = (p(2)+b(2)-a(2))-p(2) = b(2)-a(2)
    by contra:
        ? p != d
        p = d
        d(1) = p(1)
        d(2) = p(2)
        b(1)-a(1) = d(1)-p(1) = 0
        b(2)-a(2) = d(2)-p(2) = 0
        b(1) = a(1)
        b(2) = a(2)
        b = (b(1),b(2)) = (a(1),a(2)) = a
        impossible a != b
    release thm geometry::main::vec_coordinate_formula(p, d)
    release thm geometry::main::vec_coordinate_formula(a, b)
    geometry::main::vec(p, d)(1) = d(1)-p(1) = b(1)-a(1) = geometry::main::vec(a, b)(1)
    geometry::main::vec(p, d)(2) = d(2)-p(2) = b(2)-a(2) = geometry::main::vec(a, b)(2)
    release thm geometry::main::det_coordinate_formula(geometry::main::vec(p, d), geometry::main::vec(a, b))
    geometry::main::det(geometry::main::vec(p, d), geometry::main::vec(a, b)) = geometry::main::vec(a, b)(1)*geometry::main::vec(a, b)(2)-geometry::main::vec(a, b)(2)*geometry::main::vec(a, b)(1) = 0
    by def $geometry::main::is_parallel(p, d, a, b)
    by contra:
        ? geometry::main::det(geometry::main::vec(p, d), geometry::main::vec(p, a)) != 0
        geometry::main::det(geometry::main::vec(p, d), geometry::main::vec(p, a)) = 0
        release thm geometry::main::collinear_det_expand(p, d, a)
        release thm geometry::main::collinear_det_expand(a, p, b)
        geometry::main::det(geometry::main::vec(p, d), geometry::main::vec(p, a)) = (d(1)-p(1))*(a(2)-p(2))-(d(2)-p(2))*(a(1)-p(1))
        (d(1)-p(1))*(a(2)-p(2))-(d(2)-p(2))*(a(1)-p(1)) = (b(1)-a(1))*(a(2)-p(2))-(b(2)-a(2))*(a(1)-p(1)) = (p(1)-a(1))*(b(2)-a(2))-(p(2)-a(2))*(b(1)-a(1))
        geometry::main::det(geometry::main::vec(a, p), geometry::main::vec(a, b)) = geometry::main::det(geometry::main::vec(p, d), geometry::main::vec(p, a)) = 0
        p $in geometry::main::line_through_points(a, b)
        impossible not p $in geometry::main::line_through_points(a, b)
    by def $parallel::are_parallel_lines(p, d, a, b)
    witness exist q cart(R, R) st {$parallel::are_parallel_lines(p, q, a, b)} from d


thm proposition_32:
    ? forall a, b, c, d cart(R, R):
        a != b
        a != c
        b != c
        d != c
        $geometry::main::is_triangle(a, b, c)
        $geometry::main::is_on_extension(d, b, c)
        =>:
            angle_measure::ray_angle(a, c, d) = angle_measure::ray_angle(b, a, c)+angle_measure::ray_angle(a, b, c)
            angle_measure::ray_angle(b, a, c)+angle_measure::ray_angle(a, b, c)+angle_measure::ray_angle(a, c, b) = pi
    # Principal-angle completion used by triangle angle sum after its
    # geometric cosine-addition certificate and I.17 range have been proved.
    thm local_principal_three_angle_sum_from_cosine:
        ? forall alpha, beta, gamma R:
            0 <= alpha
            0 <= beta
            0 <= gamma
            gamma <= pi
            alpha+beta < pi
            cos(alpha+beta) = -cos(gamma)
            =>:
                alpha+beta+gamma = pi
        0 <= alpha+beta
        alpha+beta <= pi
        0 <= pi-gamma
        pi-gamma <= pi
        cos(pi-gamma) = -cos(gamma) = cos(alpha+beta)
        arccos(cos(pi-gamma)) = pi-gamma
        arccos(cos(alpha+beta)) = alpha+beta
        alpha+beta = arccos(cos(alpha+beta)) = arccos(cos(pi-gamma)) = pi-gamma
        alpha+beta+gamma = (pi-gamma)+gamma = pi
    # Squared-side law-of-cosines numerators for I.32. The Gram remainder
    # is the same at the two ends of a common side, and cosine addition
    # then reconstructs minus the third angle's normalized numerator.
    thm local_triangle_cosine_addition_numerator:
        ? forall x, y, z R:
            x*y-((x+y-z)/2)^2 = x*z-((x+z-y)/2)^2
            ((x+y-z)/2)*((x+z-y)/2)-(x*y-((x+y-z)/2)^2) = -x*((y+z-x)/2)
        x*y-((x+y-z)/2)^2 = x*z-((x+z-y)/2)^2
        ((x+y-z)/2)*((x+z-y)/2)-(x*y-((x+y-z)/2)^2) = -x*((y+z-x)/2)
    # Scalar bridge for Book I.32 angle addition: a positive normalized
    # determinant gives the positive sine of the principal interior angle.
    thm local_sine_from_positive_square:
        ? forall theta R, k R+:
            0 < theta
            theta < pi
            cos(theta)^2+k^2 = 1
            =>:
                sin(theta) = k
        sin(theta) > 0
        sin(theta)^2+cos(theta)^2 = 1
        sin(theta)^2 = 1-cos(theta)^2 = k^2
        sin(theta)*k > 0
        sin(theta)*k >= 0
        release thm angle_measure::same_square_and_sign_gives_equality(sin(theta), k)
    # Common-side normalization in Book I.32 cosine addition.
    thm local_positive_common_side_root_product:
        ? forall x, y, z R+:
            sqrt(x*y)*sqrt(x*z) = x*sqrt(y*z)
        x*y > 0
        x*z > 0
        y*z > 0
        sqrt(x*y) > 0
        sqrt(x*z) > 0
        sqrt(y*z) > 0
        sqrt(x*y)*sqrt(x*z) > 0
        x*sqrt(y*z) > 0
        (sqrt(x*y)*sqrt(x*z))^2 = sqrt(x*y)^2*sqrt(x*z)^2 = (x*y)*(x*z) = x^2*(y*z) = x^2*sqrt(y*z)^2 = (x*sqrt(y*z))^2
        (sqrt(x*y)*sqrt(x*z))*(x*sqrt(y*z)) > 0
        (sqrt(x*y)*sqrt(x*z))*(x*sqrt(y*z)) >= 0
        release thm angle_measure::same_square_and_sign_gives_equality(sqrt(x*y)*sqrt(x*z), x*sqrt(y*z))
    # Complete scalar spine of I.32. Geometric callers must separately
    # provide these side-square cosine formulas and positive Gram remainder.
    thm local_triangle_angle_sum_from_metric_cosines:
        ? forall alpha, beta, gamma R, x, y, z, gram R+:
            0 < alpha
            alpha < pi
            0 < beta
            beta < pi
            0 <= gamma
            gamma <= pi
            alpha+beta < pi
            cos(alpha)*sqrt(x*y) = (x+y-z)/2
            cos(beta)*sqrt(x*z) = (x+z-y)/2
            cos(gamma)*sqrt(y*z) = (y+z-x)/2
            gram = x*y-((x+y-z)/2)^2
            =>:
                alpha+beta+gamma = pi
        x*y > 0
        x*z > 0
        y*z > 0
        sqrt(x*y) > 0
        sqrt(x*z) > 0
        sqrt(y*z) > 0
        sqrt(gram) > 0
        sqrt(x*y) != 0
        sqrt(x*z) != 0
        sqrt(y*z) != 0
        cos(alpha) = (cos(alpha)*sqrt(x*y))/sqrt(x*y) = ((x+y-z)/2)/sqrt(x*y)
        cos(beta) = (cos(beta)*sqrt(x*z))/sqrt(x*z) = ((x+z-y)/2)/sqrt(x*z)
        cos(gamma) = (cos(gamma)*sqrt(y*z))/sqrt(y*z) = ((y+z-x)/2)/sqrt(y*z)
        sqrt(gram)^2 = gram
        sqrt(x*y)^2 = x*y
        sqrt(x*z)^2 = x*z
        sqrt(y*z)^2 = y*z
        have first_sine R+ = sqrt(gram)/sqrt(x*y)
        have second_sine R+ = sqrt(gram)/sqrt(x*z)
        release thm local_triangle_cosine_addition_numerator(x, y, z)
        gram = x*z-((x+z-y)/2)^2
        ((x+y-z)/2)^2+gram = ((x+y-z)/2)^2+(x*y-((x+y-z)/2)^2) = x*y
        ((x+z-y)/2)^2+gram = ((x+z-y)/2)^2+(x*z-((x+z-y)/2)^2) = x*z
        ((x+y-z)/2)*((x+z-y)/2)-gram = ((x+y-z)/2)*((x+z-y)/2)-(x*y-((x+y-z)/2)^2) = -x*((y+z-x)/2)
        cos(alpha)^2+first_sine^2 = (((x+y-z)/2)/sqrt(x*y))^2+(sqrt(gram)/sqrt(x*y))^2 = (((x+y-z)/2)^2+sqrt(gram)^2)/sqrt(x*y)^2 = (((x+y-z)/2)^2+gram)/(x*y) = (x*y)/(x*y) = 1
        cos(beta)^2+second_sine^2 = (((x+z-y)/2)/sqrt(x*z))^2+(sqrt(gram)/sqrt(x*z))^2 = (((x+z-y)/2)^2+sqrt(gram)^2)/sqrt(x*z)^2 = (((x+z-y)/2)^2+gram)/(x*z) = (x*z)/(x*z) = 1
        release thm local_sine_from_positive_square(alpha, first_sine)
        release thm local_sine_from_positive_square(beta, second_sine)
        release thm local_positive_common_side_root_product(x, y, z)
        sqrt(x*y)*sqrt(x*z) > 0
        sqrt(x*y)*sqrt(x*z) != 0
        x*sqrt(y*z) > 0
        x*sqrt(y*z) != 0
        cos(alpha+beta) = cos(alpha)*cos(beta)-sin(alpha)*sin(beta)
        cos(alpha)*cos(beta)-sin(alpha)*sin(beta) = (((x+y-z)/2)/sqrt(x*y))*(((x+z-y)/2)/sqrt(x*z))-(sqrt(gram)/sqrt(x*y))*(sqrt(gram)/sqrt(x*z)) = (((x+y-z)/2)*((x+z-y)/2)-sqrt(gram)^2)/(sqrt(x*y)*sqrt(x*z)) = (((x+y-z)/2)*((x+z-y)/2)-gram)/(x*sqrt(y*z)) = (-x*((y+z-x)/2))/(x*sqrt(y*z)) = -(((y+z-x)/2)/sqrt(y*z)) = -cos(gamma)
        cos(alpha+beta) = -cos(gamma)
        0 <= alpha
        0 <= beta
        release thm local_principal_three_angle_sum_from_cosine(alpha, beta, gamma)
    # Nondegenerate Gram data excludes both principal-angle endpoints.
    thm local_nonextremal_cosine_has_strict_angle:
        ? forall theta, numerator R, denominator R+:
            0 <= theta
            theta <= pi
            cos(theta)*sqrt(denominator) = numerator
            numerator^2 != denominator
            =>:
                0 < theta
                theta < pi
        by contra:
            ? 0 < theta
            theta <= 0
            theta = 0
            cos(theta) = cos(0) = 1
            numerator = cos(theta)*sqrt(denominator) = sqrt(denominator)
            numerator^2 = sqrt(denominator)^2 = denominator
            impossible numerator^2 != denominator
        by contra:
            ? theta < pi
            theta >= pi
            theta = pi
            cos(theta) = cos(pi) = -1
            numerator = cos(theta)*sqrt(denominator) = -sqrt(denominator)
            numerator^2 = (-sqrt(denominator))^2 = sqrt(denominator)^2 = denominator
            impossible numerator^2 != denominator
    by def $geometry::main::is_triangle(a, b, c)
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) != 0
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 > 0
    release thm geometry::main::distance_sq_positive_of_ne(a, b)
    release thm geometry::main::distance_sq_positive_of_ne(a, c)
    release thm geometry::main::distance_sq_positive_of_ne(b, c)
    have x R+ = geometry::main::distance_sq(a, b)
    have y R+ = geometry::main::distance_sq(a, c)
    have z R+ = geometry::main::distance_sq(b, c)
    have gram R+ = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))^2
    have alpha R = angle_measure::ray_angle(b, a, c)
    have beta R = angle_measure::ray_angle(a, b, c)
    have gamma R = angle_measure::ray_angle(a, c, b)
    release thm geometry::main::distance_sq_symmetric(a, b)
    release thm geometry::main::distance_sq_symmetric(a, c)
    release thm geometry::main::distance_sq_symmetric(b, c)
    release thm geometry::main::dot_from_cosine_law(b, a, c)
    geometry::main::angle_cos_num(b, a, c) = geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c)) = (x+y-z)/2
    geometry::main::angle_cos_den(b, a, c) = geometry::main::distance_sq(a, b)*geometry::main::distance_sq(a, c) = x*y
    release thm angle_measure::ray_angle_range(b, a, c)
    release thm angle_measure::ray_angle_cosine(b, a, c)
    x*y > 0
    sqrt(x*y) > 0
    sqrt(x*y) != 0
    release thm angles::angle_den_nonnegative(b, a, c)
    release thm angles::angle_root_den_nonzero(b, a, c)
    cos(alpha) = angles::angle_cosine(b, a, c) = geometry::main::angle_cos_num(b, a, c)/sqrt(geometry::main::angle_cos_den(b, a, c)) = ((x+y-z)/2)/sqrt(x*y)
    cos(alpha)*sqrt(x*y) = (((x+y-z)/2)/sqrt(x*y))*sqrt(x*y) = (x+y-z)/2
    release thm geometry::main::dot_from_cosine_law(a, b, c)
    geometry::main::angle_cos_num(a, b, c) = geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c)) = (x+z-y)/2
    geometry::main::angle_cos_den(a, b, c) = geometry::main::distance_sq(b, a)*geometry::main::distance_sq(b, c) = x*z
    release thm angle_measure::ray_angle_range(a, b, c)
    release thm angle_measure::ray_angle_cosine(a, b, c)
    x*z > 0
    sqrt(x*z) > 0
    sqrt(x*z) != 0
    release thm angles::angle_den_nonnegative(a, b, c)
    release thm angles::angle_root_den_nonzero(a, b, c)
    cos(beta) = angles::angle_cosine(a, b, c) = geometry::main::angle_cos_num(a, b, c)/sqrt(geometry::main::angle_cos_den(a, b, c)) = ((x+z-y)/2)/sqrt(x*z)
    cos(beta)*sqrt(x*z) = (((x+z-y)/2)/sqrt(x*z))*sqrt(x*z) = (x+z-y)/2
    release thm geometry::main::dot_from_cosine_law(a, c, b)
    geometry::main::angle_cos_num(a, c, b) = geometry::main::dot(geometry::main::vec(c, a), geometry::main::vec(c, b)) = (y+z-x)/2
    geometry::main::angle_cos_den(a, c, b) = geometry::main::distance_sq(c, a)*geometry::main::distance_sq(c, b) = y*z
    release thm angle_measure::ray_angle_range(a, c, b)
    release thm angle_measure::ray_angle_cosine(a, c, b)
    y*z > 0
    sqrt(y*z) > 0
    sqrt(y*z) != 0
    release thm angles::angle_den_nonnegative(a, c, b)
    release thm angles::angle_root_den_nonzero(a, c, b)
    cos(gamma) = angles::angle_cosine(a, c, b) = geometry::main::angle_cos_num(a, c, b)/sqrt(geometry::main::angle_cos_den(a, c, b)) = ((y+z-x)/2)/sqrt(y*z)
    cos(gamma)*sqrt(y*z) = (((y+z-x)/2)/sqrt(y*z))*sqrt(y*z) = (y+z-x)/2
    release thm geometry::main::vec_dot_self_is_distance(a, b)
    release thm geometry::main::vec_dot_self_is_distance(a, c)
    release thm geometry::main::dot_squared_plus_det_squared(geometry::main::vec(a, b), geometry::main::vec(a, c))
    ((x+y-z)/2)^2+gram = geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, c))^2+geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 = geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(a, b))*geometry::main::dot(geometry::main::vec(a, c), geometry::main::vec(a, c)) = x*y
    gram = x*y-((x+y-z)/2)^2
    gram > 0
    gram != 0
    gram != 0
    by contra:
        ? ((x+y-z)/2)^2 != x*y
        ((x+y-z)/2)^2 = x*y
        gram = x*y-((x+y-z)/2)^2 = x*y-(x*y) = 0
        impossible gram != 0
    release thm local_triangle_cosine_addition_numerator(x, y, z)
    gram = x*z-((x+z-y)/2)^2
    by contra:
        ? ((x+z-y)/2)^2 != x*z
        ((x+z-y)/2)^2 = x*z
        gram = x*z-((x+z-y)/2)^2 = x*z-(x*z) = 0
        impossible gram != 0
    0 <= alpha <= pi
    0 <= beta <= pi
    0 <= gamma <= pi
    release thm local_nonextremal_cosine_has_strict_angle(alpha, (x+y-z)/2, x*y)
    release thm local_nonextremal_cosine_has_strict_angle(beta, (x+z-y)/2, x*z)
    release thm proposition_17(a, b, c)
    alpha+beta = angle_measure::ray_angle(b, a, c)+angle_measure::ray_angle(a, b, c) < pi
    release thm local_triangle_angle_sum_from_metric_cosines(alpha, beta, gamma, x, y, z, gram)
    angle_measure::ray_angle(b, a, c)+angle_measure::ray_angle(a, b, c)+angle_measure::ray_angle(a, c, b) = alpha+beta+gamma = pi
    by def $geometry::main::is_on_extension(d, b, c)
    obtain t from exist coef R st {coef > 1, d(1) = (1-coef)*b(1)+coef*c(1), d(2) = (1-coef)*b(2)+coef*c(2)}
    have k R+ = t-1
    d(1)-c(1) = ((1-t)*b(1)+t*c(1))-c(1) = -(t-1)*(b(1)-c(1)) = -k*(b(1)-c(1))
    d(2)-c(2) = ((1-t)*b(2)+t*c(2))-c(2) = -(t-1)*(b(2)-c(2)) = -k*(b(2)-c(2))
    release thm angle_measure::negative_ray_scale_changes_cosine_sign(a, c, b, d, k)
    angles::angle_cosine(a, c, d) = -(angles::angle_cosine(a, c, b))
    angles::angle_cosine(a, c, b)+angles::angle_cosine(a, c, d) = angles::angle_cosine(a, c, b)+(-(angles::angle_cosine(a, c, b))) = 0
    release thm angle_measure::opposite_cosines_give_supplementary_angles(a, c, b, a, c, d)
    gamma+angle_measure::ray_angle(a, c, d) = angle_measure::ray_angle(a, c, b)+angle_measure::ray_angle(a, c, d) = pi
    angle_measure::ray_angle(a, c, d) = pi-gamma = (alpha+beta+gamma)-gamma = alpha+beta = angle_measure::ray_angle(b, a, c)+angle_measure::ray_angle(a, b, c)


# Book I.33: same-side joins of equal and parallel proper segments.
# Positive direction dot product expresses the noncrossed endpoint pairing.
thm proposition_33:
    ? forall a, b, c, d cart(R, R):
        $parallel::are_parallel_lines(a, b, c, d)
        $geometry::main::are_segments_congruent(a, b, c, d)
        geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(c, d)) > 0
        =>:
            $parallel::are_parallel_lines(a, c, b, d)
            $geometry::main::are_segments_congruent(a, c, b, d)
    by def $parallel::are_parallel_lines(a, b, c, d)
    $geometry::main::is_parallel(a, b, c, d)
    by def $geometry::main::is_parallel(a, b, c, d)
    by def $geometry::main::are_segments_congruent(a, b, c, d)
    have u cart(R, R) = geometry::main::vec(a, b)
    have v cart(R, R) = geometry::main::vec(c, d)
    release thm geometry::main::distance_sq_positive_of_ne(a, b)
    release thm geometry::main::vec_dot_self_is_distance(a, b)
    release thm geometry::main::vec_dot_self_is_distance(c, d)
    have n R+ = geometry::main::distance_sq(a, b)
    geometry::main::dot(u, u) = geometry::main::distance_sq(a, b) = n
    geometry::main::dot(v, v) = geometry::main::distance_sq(c, d) = n
    geometry::main::det(u, v) = 0
    geometry::main::dot(u, v) = geometry::main::dot(geometry::main::vec(a, b), geometry::main::vec(c, d)) > 0
    release thm geometry::main::dot_squared_plus_det_squared(u, v)
    geometry::main::det(u, v)^2 = 0^2 = 0
    geometry::main::dot(u, v)^2+geometry::main::det(u, v)^2 = geometry::main::dot(u, u)*geometry::main::dot(v, v)
    geometry::main::dot(u, v)^2 = geometry::main::dot(u, v)^2+0 = geometry::main::dot(u, v)^2+geometry::main::det(u, v)^2 = geometry::main::dot(u, u)*geometry::main::dot(v, v) = n*n = n^2
    geometry::main::dot(u, v)*n > 0
    geometry::main::dot(u, v)*n >= 0
    release thm angle_measure::same_square_and_sign_gives_equality(geometry::main::dot(u, v), n)
    release thm geometry::main::dot_coordinate_formula(u, u)
    release thm geometry::main::dot_coordinate_formula(v, v)
    release thm geometry::main::dot_coordinate_formula(u, v)
    (u(1)-v(1))^2+(u(2)-v(2))^2 = (u(1)*u(1)+u(2)*u(2))+(v(1)*v(1)+v(2)*v(2))-2*(u(1)*v(1)+u(2)*v(2)) = geometry::main::dot(u, u)+geometry::main::dot(v, v)-2*geometry::main::dot(u, v) = n+n-2*n = 0
    (u(1)-v(1))^2 >= 0
    (u(2)-v(2))^2 >= 0
    (u(1)-v(1))^2 = -((u(2)-v(2))^2) <= 0
    (u(1)-v(1))^2 = 0
    u(1)-v(1) = 0
    u(1) = v(1)
    (u(2)-v(2))^2 = -((u(1)-v(1))^2) = 0
    u(2)-v(2) = 0
    u(2) = v(2)
    release thm geometry::main::vec_coordinate_formula(a, b)
    release thm geometry::main::vec_coordinate_formula(c, d)
    b(1)-a(1) = u(1) = v(1) = d(1)-c(1)
    b(2)-a(2) = u(2) = v(2) = d(2)-c(2)
    d(1)-b(1) = (d(1)-c(1))+(c(1)-b(1)) = (b(1)-a(1))+(c(1)-b(1)) = c(1)-a(1)
    d(2)-b(2) = (d(2)-c(2))+(c(2)-b(2)) = (b(2)-a(2))+(c(2)-b(2)) = c(2)-a(2)
    by contra:
        ? a != c
        a = c
        c(1) = a(1)
        c(2) = a(2)
        c(1)-a(1) = 0
        c(2)-a(2) = 0
        release thm geometry::main::collinear_det_expand(a, b, c)
        geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) = (b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1)) = (b(1)-a(1))*0-(b(2)-a(2))*0 = 0
        impossible geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) != 0
    by contra:
        ? b != d
        b = d
        c(1)-a(1) = d(1)-b(1) = 0
        c(2)-a(2) = d(2)-b(2) = 0
        c(1) = a(1)
        c(2) = a(2)
        c = (c(1),c(2)) = (a(1),a(2)) = a
        impossible a != c
    release thm geometry::main::vec_coordinate_formula(a, c)
    release thm geometry::main::vec_coordinate_formula(b, d)
    geometry::main::vec(b, d)(1) = d(1)-b(1) = c(1)-a(1) = geometry::main::vec(a, c)(1)
    geometry::main::vec(b, d)(2) = d(2)-b(2) = c(2)-a(2) = geometry::main::vec(a, c)(2)
    release thm geometry::main::det_coordinate_formula(geometry::main::vec(a, c), geometry::main::vec(b, d))
    geometry::main::det(geometry::main::vec(a, c), geometry::main::vec(b, d)) = geometry::main::vec(a, c)(1)*geometry::main::vec(b, d)(2)-geometry::main::vec(a, c)(2)*geometry::main::vec(b, d)(1) = geometry::main::vec(a, c)(1)*geometry::main::vec(a, c)(2)-geometry::main::vec(a, c)(2)*geometry::main::vec(a, c)(1) = 0
    by def $geometry::main::is_parallel(a, c, b, d)
    release thm geometry::main::det_antisymmetric(geometry::main::vec(a, b), geometry::main::vec(a, c))
    by contra:
        ? -(geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))) != 0
        -(geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))) = 0
        geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) = -(-(geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)))) = -0 = 0
        impossible geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) != 0
    geometry::main::det(geometry::main::vec(a, c), geometry::main::vec(a, b)) = -(geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))) != 0
    by def $parallel::are_parallel_lines(a, c, b, d)
    release thm geometry::main::distance_sq_coordinate_formula(a, c)
    release thm geometry::main::distance_sq_coordinate_formula(b, d)
    geometry::main::distance_sq(b, d) = (d(1)-b(1))^2+(d(2)-b(2))^2 = (c(1)-a(1))^2+(c(2)-a(2))^2 = geometry::main::distance_sq(a, c)
    by def $geometry::main::are_segments_congruent(a, c, b, d)

release obj def area::triangle_area

# Book I.34: opposite sides and angles, and DB-diagonal equal area halves.
# Formal cyclic ABCD corresponds to source cyclic ACDB; DB is source BC.
thm proposition_34:
    ? forall a, b, c, d cart(R, R):
        $area::is_proper_parallelogram(a, b, c, d)
        =>:
            $geometry::main::are_segments_congruent(a, b, c, d)
            $geometry::main::are_segments_congruent(a, d, b, c)
            $geometry::main::are_angles_congruent(d, a, b, b, c, d)
            $geometry::main::are_angles_congruent(a, b, c, c, d, a)
            exist half R+ st {$area::has_triangle_area(a, b, d, half), $area::has_triangle_area(b, c, d, half), $area::has_parallelogram_area(a, b, c, d, 2*half)}
    thm local_parallelogram_coordinate_closure:
        ? forall par_a, par_b, par_c, par_d cart(R, R):
            $area::is_proper_parallelogram(par_a, par_b, par_c, par_d)
            =>:
                par_d(1) = par_a(1)+par_c(1)-par_b(1)
                par_d(2) = par_a(2)+par_c(2)-par_b(2)
        thm local_independent_directions_force_zero_offset:
            ? forall u1, u2, v1, v2, k1, k2 R:
                u1*v2-u2*v1 != 0
                u1*k2-u2*k1 = 0
                v1*k2-v2*k1 = 0
                =>:
                    k1 = 0
                    k2 = 0
            have determinant R = u1*v2-u2*v1
            determinant != 0
            determinant*k1 = (u1*v2-u2*v1)*k1 = v1*(u1*k2-u2*k1)-u1*(v1*k2-v2*k1) = v1*0-u1*0 = 0
            determinant*k2 = (u1*v2-u2*v1)*k2 = v2*(u1*k2-u2*k1)-u2*(v1*k2-v2*k1) = v2*0-u2*0 = 0
            k1 = (determinant*k1)/determinant = 0/determinant = 0
            k2 = (determinant*k2)/determinant = 0/determinant = 0
        by def $area::is_proper_parallelogram(par_a, par_b, par_c, par_d)
        $parallel::are_parallel_lines(par_a, par_b, par_d, par_c)
        by def $parallel::are_parallel_lines(par_a, par_b, par_d, par_c)
        $parallel::are_parallel_lines(par_a, par_d, par_b, par_c)
        by def $parallel::are_parallel_lines(par_a, par_d, par_b, par_c)
        $geometry::main::is_parallel(par_a, par_b, par_d, par_c)
        by def $geometry::main::is_parallel(par_a, par_b, par_d, par_c)
        $geometry::main::is_parallel(par_a, par_d, par_b, par_c)
        by def $geometry::main::is_parallel(par_a, par_d, par_b, par_c)
        have u1 R = par_b(1)-par_a(1)
        have u2 R = par_b(2)-par_a(2)
        have v1 R = par_d(1)-par_a(1)
        have v2 R = par_d(2)-par_a(2)
        have k1 R = par_a(1)+par_c(1)-par_b(1)-par_d(1)
        have k2 R = par_a(2)+par_c(2)-par_b(2)-par_d(2)
        release thm geometry::main::collinear_det_expand(par_a, par_b, par_d)
        u1*v2-u2*v1 = (par_b(1)-par_a(1))*(par_d(2)-par_a(2))-(par_b(2)-par_a(2))*(par_d(1)-par_a(1)) = geometry::main::det(geometry::main::vec(par_a, par_b), geometry::main::vec(par_a, par_d)) != 0
        release thm geometry::main::vec_coordinate_formula(par_a, par_b)
        release thm geometry::main::vec_coordinate_formula(par_a, par_d)
        release thm geometry::main::vec_coordinate_formula(par_d, par_c)
        release thm geometry::main::vec_coordinate_formula(par_b, par_c)
        release thm geometry::main::det_coordinate_formula(geometry::main::vec(par_a, par_b), geometry::main::vec(par_d, par_c))
        release thm geometry::main::det_coordinate_formula(geometry::main::vec(par_a, par_d), geometry::main::vec(par_b, par_c))
        geometry::main::det(geometry::main::vec(par_a, par_b), geometry::main::vec(par_d, par_c)) = (par_b(1)-par_a(1))*(par_c(2)-par_d(2))-(par_b(2)-par_a(2))*(par_c(1)-par_d(1))
        (par_b(1)-par_a(1))*(par_c(2)-par_d(2))-(par_b(2)-par_a(2))*(par_c(1)-par_d(1)) = geometry::main::det(geometry::main::vec(par_a, par_b), geometry::main::vec(par_d, par_c)) = 0
        geometry::main::det(geometry::main::vec(par_a, par_d), geometry::main::vec(par_b, par_c)) = (par_d(1)-par_a(1))*(par_c(2)-par_b(2))-(par_d(2)-par_a(2))*(par_c(1)-par_b(1))
        (par_d(1)-par_a(1))*(par_c(2)-par_b(2))-(par_d(2)-par_a(2))*(par_c(1)-par_b(1)) = geometry::main::det(geometry::main::vec(par_a, par_d), geometry::main::vec(par_b, par_c)) = 0
        u1*k2-u2*k1 = (par_b(1)-par_a(1))*(par_a(2)+par_c(2)-par_b(2)-par_d(2))-(par_b(2)-par_a(2))*(par_a(1)+par_c(1)-par_b(1)-par_d(1)) = (par_b(1)-par_a(1))*(par_c(2)-par_d(2))-(par_b(2)-par_a(2))*(par_c(1)-par_d(1)) = geometry::main::det(geometry::main::vec(par_a, par_b), geometry::main::vec(par_d, par_c)) = 0
        v1*k2-v2*k1 = (par_d(1)-par_a(1))*(par_a(2)+par_c(2)-par_b(2)-par_d(2))-(par_d(2)-par_a(2))*(par_a(1)+par_c(1)-par_b(1)-par_d(1)) = (par_d(1)-par_a(1))*(par_c(2)-par_b(2))-(par_d(2)-par_a(2))*(par_c(1)-par_b(1)) = geometry::main::det(geometry::main::vec(par_a, par_d), geometry::main::vec(par_b, par_c)) = 0
        release thm local_independent_directions_force_zero_offset(u1, u2, v1, v2, k1, k2)
        par_a(1)+par_c(1)-par_b(1) = (par_a(1)+par_c(1)-par_b(1)-par_d(1))+par_d(1) = k1+par_d(1) = 0+par_d(1) = par_d(1)
        par_a(2)+par_c(2)-par_b(2) = (par_a(2)+par_c(2)-par_b(2)-par_d(2))+par_d(2) = k2+par_d(2) = 0+par_d(2) = par_d(2)
    by def $area::is_proper_parallelogram(a, b, c, d)
    $parallel::are_parallel_lines(a, b, d, c)
    by def $parallel::are_parallel_lines(a, b, d, c)
    $parallel::are_parallel_lines(a, d, b, c)
    by def $parallel::are_parallel_lines(a, d, b, c)
    release thm local_parallelogram_coordinate_closure(a, b, c, d)
    a(1)+c(1)-d(1) = a(1)+c(1)-(a(1)+c(1)-b(1)) = b(1)
    a(2)+c(2)-d(2) = a(2)+c(2)-(a(2)+c(2)-b(2)) = b(2)
    release thm geometry::main::parallelogram_sides(a, b, c, d)
    release thm geometry::main::parallelogram_sides(a, d, c, b)
    release thm geometry::main::distance_sq_symmetric(a, b)
    release thm geometry::main::distance_sq_symmetric(a, d)
    release thm geometry::main::distance_sq_symmetric(b, c)
    release thm geometry::main::distance_sq_symmetric(c, d)
    geometry::main::distance_sq(a, b) = geometry::main::distance_sq(d, c) = geometry::main::distance_sq(c, d)
    geometry::main::distance_sq(a, d) = geometry::main::distance_sq(b, c)
    by def $geometry::main::are_segments_congruent(a, b, c, d)
    by def $geometry::main::are_segments_congruent(a, d, b, c)
    d(1)-a(1) = (a(1)+c(1)-b(1))-a(1) = c(1)-b(1)
    b(1)-c(1) = -(c(1)-b(1)) = -(d(1)-a(1))
    d(1)-c(1) = (a(1)+c(1)-b(1))-c(1) = a(1)-b(1) = -(b(1)-a(1))
    c(1)-d(1) = -(d(1)-c(1)) = -(a(1)-b(1))
    a(1)-d(1) = -(d(1)-a(1)) = -(c(1)-b(1))
    d(2)-a(2) = (a(2)+c(2)-b(2))-a(2) = c(2)-b(2)
    b(2)-c(2) = -(c(2)-b(2)) = -(d(2)-a(2))
    d(2)-c(2) = (a(2)+c(2)-b(2))-c(2) = a(2)-b(2) = -(b(2)-a(2))
    c(2)-d(2) = -(d(2)-c(2)) = -(a(2)-b(2))
    a(2)-d(2) = -(d(2)-a(2)) = -(c(2)-b(2))
    release thm geometry::main::perpendicular_dot_expand(c, b, c, d)
    release thm geometry::main::perpendicular_dot_expand(a, d, a, b)
    geometry::main::dot(geometry::main::vec(c, b), geometry::main::vec(c, d)) = (b(1)-c(1))*(d(1)-c(1))+(b(2)-c(2))*(d(2)-c(2)) = (-(d(1)-a(1)))*(-(b(1)-a(1)))+(-(d(2)-a(2)))*(-(b(2)-a(2))) = (d(1)-a(1))*(b(1)-a(1))+(d(2)-a(2))*(b(2)-a(2)) = geometry::main::dot(geometry::main::vec(a, d), geometry::main::vec(a, b))
    geometry::main::distance_sq(a, d) = geometry::main::distance_sq(b, c) = geometry::main::distance_sq(c, b)
    release thm geometry_lemmas::angle_congruence_from_equal_sides_and_dot(a, d, b, c, b, d)
    release thm geometry::main::perpendicular_dot_expand(d, c, d, a)
    release thm geometry::main::perpendicular_dot_expand(b, a, b, c)
    geometry::main::dot(geometry::main::vec(d, c), geometry::main::vec(d, a)) = (c(1)-d(1))*(a(1)-d(1))+(c(2)-d(2))*(a(2)-d(2)) = (-(a(1)-b(1)))*(-(c(1)-b(1)))+(-(a(2)-b(2)))*(-(c(2)-b(2))) = (a(1)-b(1))*(c(1)-b(1))+(a(2)-b(2))*(c(2)-b(2)) = geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c))
    geometry::main::distance_sq(b, a) = geometry::main::distance_sq(a, b) = geometry::main::distance_sq(c, d) = geometry::main::distance_sq(d, c)
    geometry::main::distance_sq(b, c) = geometry::main::distance_sq(a, d) = geometry::main::distance_sq(d, a)
    release thm geometry_lemmas::angle_congruence_from_equal_sides_and_dot(b, a, c, d, c, a)
    release thm geometry::main::collinear_det_expand(a, b, d)
    release thm geometry::main::collinear_det_expand(b, c, d)
    d(1)-b(1) = (d(1)-a(1))-(b(1)-a(1))
    d(2)-b(2) = (d(2)-a(2))-(b(2)-a(2))
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d)) = (c(1)-b(1))*(d(2)-b(2))-(c(2)-b(2))*(d(1)-b(1)) = (d(1)-a(1))*((d(2)-a(2))-(b(2)-a(2)))-(d(2)-a(2))*((d(1)-a(1))-(b(1)-a(1))) = (b(1)-a(1))*(d(2)-a(2))-(b(2)-a(2))*(d(1)-a(1)) = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d))
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d)) = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) != 0
    by def $geometry::main::is_triangle(a, b, d)
    by def $geometry::main::is_triangle(b, c, d)
    have half R+ = area::triangle_area(a, b, d)
    $area::has_triangle_area(a, b, d, half)
    by def $area::has_triangle_area(a, b, d, half)
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d))^2 = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2
    2*half = sqrt(geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d))^2) = sqrt(geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2)
    by def $area::has_triangle_area(b, c, d, half)
    witness exist first, second R+ st {$area::has_triangle_area(a, b, d, first), $area::has_triangle_area(b, c, d, second), 2*half = first+second} from half, half
    by def $area::has_parallelogram_area(a, b, c, d, 2*half)
    witness exist common R+ st {$area::has_triangle_area(a, b, d, common), $area::has_triangle_area(b, c, d, common), $area::has_parallelogram_area(a, b, c, d, 2*common)} from half

thm proposition_35:
    ? forall a, b, c, d, upper_start, f cart(R, R):
        $area::is_proper_parallelogram(a, b, c, d)
        $area::is_proper_parallelogram(upper_start, b, c, f)
        geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(d, f)) = 0
        =>:
            exist total R+ st {$area::has_parallelogram_area(a, b, c, d, total), $area::has_parallelogram_area(upper_start, b, c, f, total)}
    release thm proposition_34(a, b, c, d)
    obtain first_half from exist half R+ st {$area::has_triangle_area(a, b, d, half), $area::has_triangle_area(b, c, d, half), $area::has_parallelogram_area(a, b, c, d, 2*half)}
    release thm proposition_34(upper_start, b, c, f)
    obtain second_half from exist half R+ st {$area::has_triangle_area(upper_start, b, f, half), $area::has_triangle_area(b, c, f, half), $area::has_parallelogram_area(upper_start, b, c, f, 2*half)}
    release thm geometry::main::vec_coordinate_formula(b, c)
    release thm geometry::main::vec_coordinate_formula(d, f)
    release thm geometry::main::det_coordinate_formula(geometry::main::vec(b, c), geometry::main::vec(d, f))
    (c(1)-b(1))*(f(2)-d(2))-(c(2)-b(2))*(f(1)-d(1)) = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(d, f)) = 0
    release thm geometry::main::collinear_det_expand(b, c, d)
    release thm geometry::main::collinear_det_expand(b, c, f)
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, f)) = (c(1)-b(1))*(f(2)-b(2))-(c(2)-b(2))*(f(1)-b(1)) = ((c(1)-b(1))*(d(2)-b(2))-(c(2)-b(2))*(d(1)-b(1)))+((c(1)-b(1))*(f(2)-d(2))-(c(2)-b(2))*(f(1)-d(1))) = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))+0 = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, f))^2 = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2
    by def $area::has_triangle_area(b, c, d, first_half)
    by def $area::has_triangle_area(b, c, f, second_half)
    2*first_half = sqrt(geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2) = sqrt(geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, f))^2) = 2*second_half
    first_half = (2*first_half)/2 = (2*second_half)/2 = second_half
    witness exist total R+ st {$area::has_parallelogram_area(a, b, c, d, total), $area::has_parallelogram_area(upper_start, b, c, f, total)} from 2*first_half

# Shared by I36 and I38: equal nonzero parallel bases give equal unsigned area factors.

thm equal_parallel_base_determinants_squared:
    ? forall u1, u2, v1, v2, w1, w2 R:
        u1^2+u2^2 > 0
        u1^2+u2^2 = v1^2+v2^2
        u1*v2-u2*v1 = 0
        =>:
            (u1*w2-u2*w1)^2 = (v1*w2-v2*w1)^2
    have n R+ = u1^2+u2^2
    have cross R = u1*v2-u2*v1
    have first_det R = u1*w2-u2*w1
    have second_det R = v1*w2-v2*w1
    cross = 0
    n = v1^2+v2^2
    first_det^2 = (u1*w2-u2*w1)^2
    second_det^2 = (v1*w2-v2*w1)^2
    n*first_det^2 = n*(u1*w2-u2*w1)^2
    n*(u1*w2-u2*w1)^2 = (v1^2+v2^2)*(u1*w2-u2*w1)^2
    n*second_det^2 = n*(v1*w2-v2*w1)^2
    n*(v1*w2-v2*w1)^2 = (u1^2+u2^2)*(v1*w2-v2*w1)^2
    n*(second_det^2-first_det^2) = n*second_det^2-n*first_det^2 = (u1^2+u2^2)*(v1*w2-v2*w1)^2-(v1^2+v2^2)*(u1*w2-u2*w1)^2 = (u1*v2-u2*v1)*((u1*v2-u2*v1)*(w1^2+w2^2)-2*(u1*w2-u2*w1)*(v1*w1+v2*w2)) = cross*(cross*(w1^2+w2^2)-2*first_det*(v1*w1+v2*w2)) = 0*(0*(w1^2+w2^2)-2*first_det*(v1*w1+v2*w2)) = 0
    n != 0
    second_det^2-first_det^2 = (n*(second_det^2-first_det^2))/n = 0/n = 0
    second_det^2 = (second_det^2-first_det^2)+first_det^2 = 0+first_det^2 = first_det^2

# I.36: equal proper bases on one lower line and opposite vertices on one upper parallel.

thm proposition_36:
    ? forall a, b, c, d, upper_start, f, g, h cart(R, R):
        $area::is_proper_parallelogram(a, b, c, d)
        $area::is_proper_parallelogram(upper_start, f, g, h)
        $geometry::main::are_segments_congruent(b, c, f, g)
        geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, f)) = 0
        geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, g)) = 0
        geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(d, h)) = 0
        =>:
            exist total R+ st {$area::has_parallelogram_area(a, b, c, d, total), $area::has_parallelogram_area(upper_start, f, g, h, total)}
    by def $area::is_proper_parallelogram(a, b, c, d)
    $parallel::are_parallel_lines(a, d, b, c)
    by def $parallel::are_parallel_lines(a, d, b, c)
    by def $area::is_proper_parallelogram(upper_start, f, g, h)
    $parallel::are_parallel_lines(upper_start, h, f, g)
    by def $parallel::are_parallel_lines(upper_start, h, f, g)
    by def $geometry::main::are_segments_congruent(b, c, f, g)
    have u cart(R, R) = geometry::main::vec(b, c)
    have v cart(R, R) = geometry::main::vec(f, g)
    have height cart(R, R) = geometry::main::vec(b, d)
    have lower_shift cart(R, R) = geometry::main::vec(b, f)
    have upper_shift cart(R, R) = geometry::main::vec(d, h)
    release thm geometry::main::distance_sq_positive_of_ne(b, c)
    release thm geometry::main::vec_dot_self_is_distance(b, c)
    release thm geometry::main::vec_dot_self_is_distance(f, g)
    release thm geometry::main::dot_coordinate_formula(u, u)
    release thm geometry::main::dot_coordinate_formula(v, v)
    u(1)^2+u(2)^2 = u(1)*u(1)+u(2)*u(2) = geometry::main::dot(u, u) = geometry::main::distance_sq(b, c) > 0
    v(1)^2+v(2)^2 = v(1)*v(1)+v(2)*v(2) = geometry::main::dot(v, v) = geometry::main::distance_sq(f, g) = geometry::main::distance_sq(b, c) = u(1)^2+u(2)^2
    release thm geometry::main::vec_coordinate_formula(b, c)
    release thm geometry::main::vec_coordinate_formula(f, g)
    release thm geometry::main::vec_coordinate_formula(b, f)
    release thm geometry::main::vec_coordinate_formula(b, g)
    release thm geometry::main::vec_coordinate_formula(b, d)
    release thm geometry::main::vec_coordinate_formula(d, h)
    release thm geometry::main::vec_coordinate_formula(f, h)
    release thm geometry::main::det_coordinate_formula(u, lower_shift)
    u(1)*lower_shift(2)-u(2)*lower_shift(1) = geometry::main::det(u, lower_shift) = 0
    release thm geometry::main::det_coordinate_formula(u, upper_shift)
    u(1)*upper_shift(2)-u(2)*upper_shift(1) = geometry::main::det(u, upper_shift) = 0
    v(1) = g(1)-f(1) = (g(1)-b(1))-(f(1)-b(1))
    v(2) = g(2)-f(2) = (g(2)-b(2))-(f(2)-b(2))
    release thm geometry::main::det_coordinate_formula(u, geometry::main::vec(b, g))
    release thm geometry::main::det_coordinate_formula(u, v)
    geometry::main::vec(b, g)(1) = g(1)-b(1)
    geometry::main::vec(b, g)(2) = g(2)-b(2)
    lower_shift(1) = f(1)-b(1)
    lower_shift(2) = f(2)-b(2)
    geometry::main::det(u, geometry::main::vec(b, g)) = u(1)*geometry::main::vec(b, g)(2)-u(2)*geometry::main::vec(b, g)(1) = u(1)*(g(2)-b(2))-u(2)*(g(1)-b(1))
    geometry::main::det(u, lower_shift) = u(1)*lower_shift(2)-u(2)*lower_shift(1) = u(1)*(f(2)-b(2))-u(2)*(f(1)-b(1))
    geometry::main::det(u, geometry::main::vec(b, g)) = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, g)) = 0
    u(1)*v(2)-u(2)*v(1) = u(1)*((g(2)-b(2))-(f(2)-b(2)))-u(2)*((g(1)-b(1))-(f(1)-b(1))) = (u(1)*(g(2)-b(2))-u(2)*(g(1)-b(1)))-(u(1)*(f(2)-b(2))-u(2)*(f(1)-b(1))) = geometry::main::det(u, geometry::main::vec(b, g))-geometry::main::det(u, lower_shift) = 0-0 = 0
    release thm equal_parallel_base_determinants_squared(u(1), u(2), v(1), v(2), lower_shift(1), lower_shift(2))
    (u(1)*lower_shift(2)-u(2)*lower_shift(1))^2 = 0^2 = 0
    (v(1)*lower_shift(2)-v(2)*lower_shift(1))^2 = (u(1)*lower_shift(2)-u(2)*lower_shift(1))^2 = 0
    by contra:
        ? v(1)*lower_shift(2)-v(2)*lower_shift(1) = 0
        v(1)*lower_shift(2)-v(2)*lower_shift(1) != 0
        (v(1)*lower_shift(2)-v(2)*lower_shift(1))^2 > 0
        impossible (v(1)*lower_shift(2)-v(2)*lower_shift(1))^2 = 0
    release thm equal_parallel_base_determinants_squared(u(1), u(2), v(1), v(2), upper_shift(1), upper_shift(2))
    (u(1)*upper_shift(2)-u(2)*upper_shift(1))^2 = 0^2 = 0
    (v(1)*upper_shift(2)-v(2)*upper_shift(1))^2 = (u(1)*upper_shift(2)-u(2)*upper_shift(1))^2 = 0
    by contra:
        ? v(1)*upper_shift(2)-v(2)*upper_shift(1) = 0
        v(1)*upper_shift(2)-v(2)*upper_shift(1) != 0
        (v(1)*upper_shift(2)-v(2)*upper_shift(1))^2 > 0
        impossible (v(1)*upper_shift(2)-v(2)*upper_shift(1))^2 = 0
    release thm equal_parallel_base_determinants_squared(u(1), u(2), v(1), v(2), height(1), height(2))
    release thm geometry::main::det_coordinate_formula(u, height)
    release thm geometry::main::det_coordinate_formula(v, height)
    geometry::main::det(v, height)^2 = (v(1)*height(2)-v(2)*height(1))^2 = (u(1)*height(2)-u(2)*height(1))^2 = geometry::main::det(u, height)^2
    height(1) = d(1)-b(1)
    height(2) = d(2)-b(2)
    upper_shift(1) = h(1)-d(1)
    upper_shift(2) = h(2)-d(2)
    geometry::main::vec(f, h)(1) = h(1)-f(1)
    geometry::main::vec(f, h)(2) = h(2)-f(2)
    h(1)-f(1) = (d(1)-b(1))+(h(1)-d(1))-(f(1)-b(1)) = height(1)+upper_shift(1)-lower_shift(1)
    h(2)-f(2) = (d(2)-b(2))+(h(2)-d(2))-(f(2)-b(2)) = height(2)+upper_shift(2)-lower_shift(2)
    release thm geometry::main::det_coordinate_formula(v, geometry::main::vec(f, h))
    geometry::main::det(v, geometry::main::vec(f, h)) = v(1)*(h(2)-f(2))-v(2)*(h(1)-f(1)) = v(1)*(height(2)+upper_shift(2)-lower_shift(2))-v(2)*(height(1)+upper_shift(1)-lower_shift(1)) = (v(1)*height(2)-v(2)*height(1))+(v(1)*upper_shift(2)-v(2)*upper_shift(1))-(v(1)*lower_shift(2)-v(2)*lower_shift(1)) = (v(1)*height(2)-v(2)*height(1))+0-0 = geometry::main::det(v, height)
    geometry::main::det(v, geometry::main::vec(f, h))^2 = geometry::main::det(v, height)^2 = geometry::main::det(u, height)^2
    release thm proposition_34(a, b, c, d)
    obtain first_half from exist half R+ st {$area::has_triangle_area(a, b, d, half), $area::has_triangle_area(b, c, d, half), $area::has_parallelogram_area(a, b, c, d, 2*half)}
    release thm proposition_34(upper_start, f, g, h)
    obtain second_half from exist half R+ st {$area::has_triangle_area(upper_start, f, h, half), $area::has_triangle_area(f, g, h, half), $area::has_parallelogram_area(upper_start, f, g, h, 2*half)}
    by def $area::has_triangle_area(b, c, d, first_half)
    by def $area::has_triangle_area(f, g, h, second_half)
    geometry::main::det(u, height) = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))
    geometry::main::det(u, height)^2 = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2
    geometry::main::det(v, geometry::main::vec(f, h)) = geometry::main::det(geometry::main::vec(f, g), geometry::main::vec(f, h))
    geometry::main::det(v, geometry::main::vec(f, h))^2 = geometry::main::det(geometry::main::vec(f, g), geometry::main::vec(f, h))^2
    2*first_half = sqrt(geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2) = sqrt(geometry::main::det(u, height)^2)
    2*second_half = sqrt(geometry::main::det(geometry::main::vec(f, g), geometry::main::vec(f, h))^2) = sqrt(geometry::main::det(v, geometry::main::vec(f, h))^2)
    2*first_half = sqrt(geometry::main::det(u, height)^2) = sqrt(geometry::main::det(v, geometry::main::vec(f, h))^2) = 2*second_half
    first_half = (2*first_half)/2 = (2*second_half)/2 = second_half
    witness exist total R+ st {$area::has_parallelogram_area(a, b, c, d, total), $area::has_parallelogram_area(upper_start, f, g, h, total)} from 2*first_half

thm proposition_37:
    ? forall a, b, c, d cart(R, R):
        $geometry::main::is_triangle(b, c, a)
        $geometry::main::is_triangle(b, c, d)
        geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(a, d)) = 0
        =>:
            exist common R+ st {$area::has_triangle_area(b, c, a, common), $area::has_triangle_area(b, c, d, common)}
    release thm geometry::main::vec_coordinate_formula(b, c)
    release thm geometry::main::vec_coordinate_formula(a, d)
    geometry::main::vec(b, c)(1) = c(1)-b(1)
    geometry::main::vec(b, c)(2) = c(2)-b(2)
    geometry::main::vec(a, d)(1) = d(1)-a(1)
    geometry::main::vec(a, d)(2) = d(2)-a(2)
    release thm geometry::main::det_coordinate_formula(geometry::main::vec(b, c), geometry::main::vec(a, d))
    (c(1)-b(1))*(d(2)-a(2))-(c(2)-b(2))*(d(1)-a(1)) = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(a, d)) = 0
    release thm geometry::main::collinear_det_expand(b, c, a)
    release thm geometry::main::collinear_det_expand(b, c, d)
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d)) = (c(1)-b(1))*(d(2)-b(2))-(c(2)-b(2))*(d(1)-b(1)) = ((c(1)-b(1))*(a(2)-b(2))-(c(2)-b(2))*(a(1)-b(1)))+((c(1)-b(1))*(d(2)-a(2))-(c(2)-b(2))*(d(1)-a(1))) = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, a))+0 = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, a))
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2 = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, a))^2
    have common R+ = area::triangle_area(b, c, a)
    $area::has_triangle_area(b, c, a, common)
    by def $area::has_triangle_area(b, c, a, common)
    2*common = sqrt(geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, a))^2) = sqrt(geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2)
    by def $area::has_triangle_area(b, c, d, common)
    witness exist result R+ st {$area::has_triangle_area(b, c, a, result), $area::has_triangle_area(b, c, d, result)} from common

thm proposition_38:
    ? forall a, b, c, d, f, g cart(R, R):
        $geometry::main::is_triangle(b, c, a)
        $geometry::main::is_triangle(f, g, d)
        $geometry::main::are_segments_congruent(b, c, f, g)
        geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, f)) = 0
        geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, g)) = 0
        geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(a, d)) = 0
        =>:
            exist common R+ st {$area::has_triangle_area(b, c, a, common), $area::has_triangle_area(f, g, d, common)}
    release thm geometry_lemmas::triangle_vertices_distinct(b, c, a)
    by def $geometry::main::are_segments_congruent(b, c, f, g)
    have u cart(R, R) = geometry::main::vec(b, c)
    have v cart(R, R) = geometry::main::vec(f, g)
    have height cart(R, R) = geometry::main::vec(b, a)
    have lower_shift cart(R, R) = geometry::main::vec(b, f)
    have upper_shift cart(R, R) = geometry::main::vec(a, d)
    release thm geometry::main::distance_sq_positive_of_ne(b, c)
    release thm geometry::main::vec_dot_self_is_distance(b, c)
    release thm geometry::main::vec_dot_self_is_distance(f, g)
    release thm geometry::main::dot_coordinate_formula(u, u)
    release thm geometry::main::dot_coordinate_formula(v, v)
    u(1)^2+u(2)^2 = u(1)*u(1)+u(2)*u(2) = geometry::main::dot(u, u) = geometry::main::distance_sq(b, c) > 0
    v(1)^2+v(2)^2 = v(1)*v(1)+v(2)*v(2) = geometry::main::dot(v, v) = geometry::main::distance_sq(f, g) = geometry::main::distance_sq(b, c) = u(1)^2+u(2)^2
    release thm geometry::main::vec_coordinate_formula(b, c)
    release thm geometry::main::vec_coordinate_formula(f, g)
    release thm geometry::main::vec_coordinate_formula(b, f)
    release thm geometry::main::vec_coordinate_formula(b, g)
    release thm geometry::main::vec_coordinate_formula(b, a)
    release thm geometry::main::vec_coordinate_formula(a, d)
    release thm geometry::main::vec_coordinate_formula(f, d)
    release thm geometry::main::det_coordinate_formula(u, lower_shift)
    u(1)*lower_shift(2)-u(2)*lower_shift(1) = geometry::main::det(u, lower_shift) = 0
    release thm geometry::main::det_coordinate_formula(u, upper_shift)
    u(1)*upper_shift(2)-u(2)*upper_shift(1) = geometry::main::det(u, upper_shift) = 0
    v(1) = g(1)-f(1) = (g(1)-b(1))-(f(1)-b(1))
    v(2) = g(2)-f(2) = (g(2)-b(2))-(f(2)-b(2))
    release thm geometry::main::det_coordinate_formula(u, geometry::main::vec(b, g))
    release thm geometry::main::det_coordinate_formula(u, v)
    geometry::main::vec(b, g)(1) = g(1)-b(1)
    geometry::main::vec(b, g)(2) = g(2)-b(2)
    lower_shift(1) = f(1)-b(1)
    lower_shift(2) = f(2)-b(2)
    geometry::main::det(u, geometry::main::vec(b, g)) = u(1)*geometry::main::vec(b, g)(2)-u(2)*geometry::main::vec(b, g)(1) = u(1)*(g(2)-b(2))-u(2)*(g(1)-b(1))
    geometry::main::det(u, lower_shift) = u(1)*lower_shift(2)-u(2)*lower_shift(1) = u(1)*(f(2)-b(2))-u(2)*(f(1)-b(1))
    geometry::main::det(u, geometry::main::vec(b, g)) = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, g)) = 0
    u(1)*v(2)-u(2)*v(1) = u(1)*((g(2)-b(2))-(f(2)-b(2)))-u(2)*((g(1)-b(1))-(f(1)-b(1))) = (u(1)*(g(2)-b(2))-u(2)*(g(1)-b(1)))-(u(1)*(f(2)-b(2))-u(2)*(f(1)-b(1))) = geometry::main::det(u, geometry::main::vec(b, g))-geometry::main::det(u, lower_shift) = 0-0 = 0
    release thm equal_parallel_base_determinants_squared(u(1), u(2), v(1), v(2), lower_shift(1), lower_shift(2))
    (u(1)*lower_shift(2)-u(2)*lower_shift(1))^2 = 0^2 = 0
    (v(1)*lower_shift(2)-v(2)*lower_shift(1))^2 = (u(1)*lower_shift(2)-u(2)*lower_shift(1))^2 = 0
    by contra:
        ? v(1)*lower_shift(2)-v(2)*lower_shift(1) = 0
        v(1)*lower_shift(2)-v(2)*lower_shift(1) != 0
        (v(1)*lower_shift(2)-v(2)*lower_shift(1))^2 > 0
        impossible (v(1)*lower_shift(2)-v(2)*lower_shift(1))^2 = 0
    release thm equal_parallel_base_determinants_squared(u(1), u(2), v(1), v(2), upper_shift(1), upper_shift(2))
    (u(1)*upper_shift(2)-u(2)*upper_shift(1))^2 = 0^2 = 0
    (v(1)*upper_shift(2)-v(2)*upper_shift(1))^2 = (u(1)*upper_shift(2)-u(2)*upper_shift(1))^2 = 0
    by contra:
        ? v(1)*upper_shift(2)-v(2)*upper_shift(1) = 0
        v(1)*upper_shift(2)-v(2)*upper_shift(1) != 0
        (v(1)*upper_shift(2)-v(2)*upper_shift(1))^2 > 0
        impossible (v(1)*upper_shift(2)-v(2)*upper_shift(1))^2 = 0
    release thm equal_parallel_base_determinants_squared(u(1), u(2), v(1), v(2), height(1), height(2))
    release thm geometry::main::det_coordinate_formula(u, height)
    release thm geometry::main::det_coordinate_formula(v, height)
    geometry::main::det(v, height)^2 = (v(1)*height(2)-v(2)*height(1))^2 = (u(1)*height(2)-u(2)*height(1))^2 = geometry::main::det(u, height)^2
    height(1) = a(1)-b(1)
    height(2) = a(2)-b(2)
    upper_shift(1) = d(1)-a(1)
    upper_shift(2) = d(2)-a(2)
    geometry::main::vec(f, d)(1) = d(1)-f(1)
    geometry::main::vec(f, d)(2) = d(2)-f(2)
    d(1)-f(1) = (a(1)-b(1))+(d(1)-a(1))-(f(1)-b(1)) = height(1)+upper_shift(1)-lower_shift(1)
    d(2)-f(2) = (a(2)-b(2))+(d(2)-a(2))-(f(2)-b(2)) = height(2)+upper_shift(2)-lower_shift(2)
    release thm geometry::main::det_coordinate_formula(v, geometry::main::vec(f, d))
    geometry::main::det(v, geometry::main::vec(f, d)) = v(1)*(d(2)-f(2))-v(2)*(d(1)-f(1)) = v(1)*(height(2)+upper_shift(2)-lower_shift(2))-v(2)*(height(1)+upper_shift(1)-lower_shift(1)) = (v(1)*height(2)-v(2)*height(1))+(v(1)*upper_shift(2)-v(2)*upper_shift(1))-(v(1)*lower_shift(2)-v(2)*lower_shift(1)) = (v(1)*height(2)-v(2)*height(1))+0-0 = geometry::main::det(v, height)
    geometry::main::det(v, geometry::main::vec(f, d))^2 = geometry::main::det(v, height)^2 = geometry::main::det(u, height)^2
    have common R+ = area::triangle_area(b, c, a)
    $area::has_triangle_area(b, c, a, common)
    by def $area::has_triangle_area(b, c, a, common)
    geometry::main::det(u, height) = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, a))
    geometry::main::det(u, height)^2 = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, a))^2
    geometry::main::det(v, geometry::main::vec(f, d)) = geometry::main::det(geometry::main::vec(f, g), geometry::main::vec(f, d))
    geometry::main::det(v, geometry::main::vec(f, d))^2 = geometry::main::det(geometry::main::vec(f, g), geometry::main::vec(f, d))^2
    2*common = sqrt(geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, a))^2) = sqrt(geometry::main::det(u, height)^2)
    2*common = sqrt(geometry::main::det(u, height)^2) = sqrt(geometry::main::det(v, geometry::main::vec(f, d))^2)
    2*common = sqrt(geometry::main::det(v, geometry::main::vec(f, d))^2) = sqrt(geometry::main::det(geometry::main::vec(f, g), geometry::main::vec(f, d))^2)
    by def $area::has_triangle_area(f, g, d, common)
    witness exist result R+ st {$area::has_triangle_area(b, c, a, result), $area::has_triangle_area(f, g, d, result)} from common

thm proposition_39:
    ? forall a, b, c, d cart(R, R), common R+:
        a != d
        $area::has_triangle_area(b, c, a, common)
        $area::has_triangle_area(b, c, d, common)
        geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, a))*geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d)) > 0
        =>:
            $parallel::are_parallel_lines(b, c, a, d)
    by def $area::has_triangle_area(b, c, a, common)
    by def $area::has_triangle_area(b, c, d, common)
    release thm geometry_lemmas::triangle_vertices_distinct(b, c, a)
    have first_det R = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, a))
    have second_det R = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))
    sqrt(first_det^2) = sqrt(geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, a))^2) = 2*common
    sqrt(second_det^2) = sqrt(geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2) = 2*common
    first_det^2 >= 0
    second_det^2 >= 0
    sqrt(first_det^2)^2 = first_det^2
    sqrt(second_det^2)^2 = second_det^2
    first_det^2 = sqrt(first_det^2)^2 = (2*common)^2 = sqrt(second_det^2)^2 = second_det^2
    first_det*second_det = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, a))*geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d)) > 0
    first_det*second_det >= 0
    release thm angle_measure::same_square_and_sign_gives_equality(first_det, second_det)
    release thm geometry::main::collinear_det_expand(b, c, a)
    release thm geometry::main::collinear_det_expand(b, c, d)
    geometry::main::vec(b, c)(1) = c(1)-b(1)
    geometry::main::vec(b, c)(2) = c(2)-b(2)
    geometry::main::vec(a, d)(1) = d(1)-a(1)
    geometry::main::vec(a, d)(2) = d(2)-a(2)
    release thm geometry::main::det_coordinate_formula(geometry::main::vec(b, c), geometry::main::vec(a, d))
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(a, d)) = (c(1)-b(1))*(d(2)-a(2))-(c(2)-b(2))*(d(1)-a(1)) = ((c(1)-b(1))*(d(2)-b(2))-(c(2)-b(2))*(d(1)-b(1)))-((c(1)-b(1))*(a(2)-b(2))-(c(2)-b(2))*(a(1)-b(1))) = geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))-geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, a)) = second_det-first_det = 0
    by def $geometry::main::is_parallel(b, c, a, d)
    $geometry::main::is_triangle(b, c, a)
    by def $geometry::main::is_triangle(b, c, a)
    by def $parallel::are_parallel_lines(b, c, a, d)

thm proposition_40:
    ? forall a, b, c, d, f, g cart(R, R), common R+:
        a != d
        $area::has_triangle_area(b, c, a, common)
        $area::has_triangle_area(f, g, d, common)
        $geometry::main::are_segments_congruent(b, c, f, g)
        geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, f)) = 0
        geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, g)) = 0
        geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, a))*geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d)) > 0
        =>:
            $parallel::are_parallel_lines(b, c, a, d)
    by def $area::has_triangle_area(b, c, a, common)
    by def $area::has_triangle_area(f, g, d, common)
    by contra:
        ? geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d)) != 0
        geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d)) = 0
        geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, a))*geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d)) = 0
        impossible geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, a))*geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d)) > 0
    by def $geometry::main::is_triangle(b, c, d)
    release thm geometry::main::vec_coordinate_formula(d, d)
    geometry::main::vec(d, d)(1) = d(1)-d(1) = 0
    geometry::main::vec(d, d)(2) = d(2)-d(2) = 0
    release thm geometry::main::det_coordinate_formula(geometry::main::vec(b, c), geometry::main::vec(d, d))
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(d, d)) = geometry::main::vec(b, c)(1)*0-geometry::main::vec(b, c)(2)*0 = 0
    release thm proposition_38(d, b, c, d, f, g)
    obtain transferred from exist value R+ st {$area::has_triangle_area(b, c, d, value), $area::has_triangle_area(f, g, d, value)}
    by def $area::has_triangle_area(f, g, d, transferred)
    2*transferred = sqrt(geometry::main::det(geometry::main::vec(f, g), geometry::main::vec(f, d))^2) = 2*common
    transferred = (2*transferred)/2 = (2*common)/2 = common
    $area::has_triangle_area(b, c, d, common)
    release thm proposition_39(a, b, c, d, common)

thm proposition_41:
    ? forall a, b, c, d, vertex cart(R, R):
        $area::is_proper_parallelogram(a, b, c, d)
        $geometry::main::is_triangle(b, c, vertex)
        geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(d, vertex)) = 0
        =>:
            exist common R+ st {$area::has_triangle_area(b, c, vertex, common), $area::has_parallelogram_area(a, b, c, d, 2*common)}
    release thm proposition_34(a, b, c, d)
    obtain half from exist value R+ st {$area::has_triangle_area(a, b, d, value), $area::has_triangle_area(b, c, d, value), $area::has_parallelogram_area(a, b, c, d, 2*value)}
    by def $area::has_triangle_area(b, c, d, half)
    release thm proposition_37(d, b, c, vertex)
    obtain common from exist value R+ st {$area::has_triangle_area(b, c, d, value), $area::has_triangle_area(b, c, vertex, value)}
    by def $area::has_triangle_area(b, c, d, common)
    2*half = sqrt(geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2) = 2*common
    half = (2*half)/2 = (2*common)/2 = common
    witness exist value R+ st {$area::has_triangle_area(b, c, vertex, value), $area::has_parallelogram_area(a, b, c, d, 2*value)} from common

thm affine_parallelogram_witness:
    ? forall a, b, c, d cart(R, R):
        $geometry::main::is_triangle(a, b, d)
        c(1) = b(1)+d(1)-a(1)
        c(2) = b(2)+d(2)-a(2)
        =>:
            $area::is_proper_parallelogram(a, b, c, d)
    by def $geometry::main::is_triangle(a, b, d)
    release thm geometry_lemmas::triangle_vertices_distinct(a, b, d)
    release thm geometry::main::collinear_det_expand(a, b, d)
    by contra:
        ? d != c
        d = c
        c(1) = d(1)
        c(2) = d(2)
        b(1) = (b(1)+d(1)-a(1))-d(1)+a(1) = c(1)-d(1)+a(1) = d(1)-d(1)+a(1) = a(1)
        b(2) = (b(2)+d(2)-a(2))-d(2)+a(2) = c(2)-d(2)+a(2) = d(2)-d(2)+a(2) = a(2)
        geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) = (b(1)-a(1))*(d(2)-a(2))-(b(2)-a(2))*(d(1)-a(1)) = (a(1)-a(1))*(d(2)-a(2))-(a(2)-a(2))*(d(1)-a(1)) = 0
        impossible geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) != 0
    by contra:
        ? b != c
        b = c
        c(1) = b(1)
        c(2) = b(2)
        d(1) = (b(1)+d(1)-a(1))-b(1)+a(1) = c(1)-b(1)+a(1) = b(1)-b(1)+a(1) = a(1)
        d(2) = (b(2)+d(2)-a(2))-b(2)+a(2) = c(2)-b(2)+a(2) = b(2)-b(2)+a(2) = a(2)
        geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) = (b(1)-a(1))*(d(2)-a(2))-(b(2)-a(2))*(d(1)-a(1)) = (b(1)-a(1))*(a(2)-a(2))-(b(2)-a(2))*(a(1)-a(1)) = 0
        impossible geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) != 0
    c(1)-d(1) = (b(1)+d(1)-a(1))-d(1) = b(1)-a(1)
    c(1)-b(1) = (b(1)+d(1)-a(1))-b(1) = d(1)-a(1)
    c(2)-d(2) = (b(2)+d(2)-a(2))-d(2) = b(2)-a(2)
    c(2)-b(2) = (b(2)+d(2)-a(2))-b(2) = d(2)-a(2)
    release thm geometry::main::vec_coordinate_formula(a, b)
    geometry::main::vec(a, b)(1) = b(1)-a(1)
    geometry::main::vec(a, b)(2) = b(2)-a(2)
    release thm geometry::main::vec_coordinate_formula(a, d)
    geometry::main::vec(a, d)(1) = d(1)-a(1)
    geometry::main::vec(a, d)(2) = d(2)-a(2)
    release thm geometry::main::vec_coordinate_formula(d, c)
    geometry::main::vec(d, c)(1) = c(1)-d(1)
    geometry::main::vec(d, c)(2) = c(2)-d(2)
    release thm geometry::main::vec_coordinate_formula(b, c)
    geometry::main::vec(b, c)(1) = c(1)-b(1)
    geometry::main::vec(b, c)(2) = c(2)-b(2)
    release thm geometry::main::det_coordinate_formula(geometry::main::vec(a, b), geometry::main::vec(d, c))
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(d, c)) = (b(1)-a(1))*(c(2)-d(2))-(b(2)-a(2))*(c(1)-d(1)) = (b(1)-a(1))*(b(2)-a(2))-(b(2)-a(2))*(b(1)-a(1)) = 0
    by def $geometry::main::is_parallel(a, b, d, c)
    release thm geometry::main::det_coordinate_formula(geometry::main::vec(a, d), geometry::main::vec(b, c))
    geometry::main::det(geometry::main::vec(a, d), geometry::main::vec(b, c)) = (d(1)-a(1))*(c(2)-b(2))-(d(2)-a(2))*(c(1)-b(1)) = (d(1)-a(1))*(d(2)-a(2))-(d(2)-a(2))*(d(1)-a(1)) = 0
    by def $geometry::main::is_parallel(a, d, b, c)
    release thm geometry::main::collinear_det_expand(a, b, d)
    release thm geometry::main::collinear_det_expand(a, d, b)
    release thm geometry::main::det_antisymmetric(geometry::main::vec(a, d), geometry::main::vec(a, b))
    by contra:
        ? geometry::main::det(geometry::main::vec(a, d), geometry::main::vec(a, b)) != 0
        geometry::main::det(geometry::main::vec(a, d), geometry::main::vec(a, b)) = 0
        geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) = -(-geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d))) = -geometry::main::det(geometry::main::vec(a, d), geometry::main::vec(a, b)) = -0 = 0
        impossible geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) != 0
    by def $parallel::are_parallel_lines(a, b, d, c)
    by def $parallel::are_parallel_lines(a, d, b, c)
    by def $area::is_proper_parallelogram(a, b, c, d)

thm affine_parallelogram_area:
    ? forall a, b, c, d cart(R, R):
        $geometry::main::is_triangle(a, b, d)
        c(1) = b(1)+d(1)-a(1)
        c(2) = b(2)+d(2)-a(2)
        =>:
            exist common R+ st {$area::has_triangle_area(a, b, d, common), $area::has_parallelogram_area(a, b, c, d, 2*common)}
    release thm affine_parallelogram_witness(a, b, c, d)
    by def $geometry::main::is_triangle(a, b, d)
    release thm geometry::main::collinear_det_expand(a, b, d)
    release thm geometry::main::collinear_det_expand(b, c, d)
    c(1)-b(1) = (b(1)+d(1)-a(1))-b(1) = d(1)-a(1)
    c(2)-b(2) = (b(2)+d(2)-a(2))-b(2) = d(2)-a(2)
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d)) = (c(1)-b(1))*(d(2)-b(2))-(c(2)-b(2))*(d(1)-b(1)) = (d(1)-a(1))*(d(2)-b(2))-(d(2)-a(2))*(d(1)-b(1)) = (b(1)-a(1))*(d(2)-a(2))-(b(2)-a(2))*(d(1)-a(1)) = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) != 0
    by def $geometry::main::is_triangle(b, c, d)
    have common R+ = area::triangle_area(a, b, d)
    $area::has_triangle_area(a, b, d, common)
    by def $area::has_triangle_area(a, b, d, common)
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2 = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d))^2
    2*common = sqrt(geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d))^2) = sqrt(geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2)
    by def $area::has_triangle_area(b, c, d, common)
    witness exist first, second R+ st {$area::has_triangle_area(a, b, d, first), $area::has_triangle_area(b, c, d, second), 2*common = first+second} from common, common
    by def $area::has_parallelogram_area(a, b, c, d, 2*common)
    witness exist half R+ st {$area::has_triangle_area(a, b, d, half), $area::has_parallelogram_area(a, b, c, d, 2*half)} from common

thm proposition_42:
    ? forall a, b, c, p, q, r cart(R, R):
        $geometry::main::is_triangle(a, b, c)
        $geometry::main::is_triangle(q, p, r)
        =>:
            exist third, fourth cart(R, R), common R+ st {$area::has_triangle_area(a, b, c, common), $area::has_parallelogram_area(q, p, third, fourth, common), $geometry::main::are_angles_congruent(p, q, fourth, p, q, r)}
    by def $geometry::main::is_triangle(q, p, r)
    release thm geometry_lemmas::triangle_vertices_distinct(q, p, r)
    have common R+ = area::triangle_area(a, b, c)
    $area::has_triangle_area(a, b, c, common)
    have determinant R = geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, r))
    determinant != 0
    determinant^2 > 0
    sqrt(determinant^2) > 0
    have root R+ = sqrt(determinant^2)
    root != 0
    have scale R+ = common/root
    scale != 0
    have fourth cart(R, R) = (q(1)+scale*(r(1)-q(1)), q(2)+scale*(r(2)-q(2)))
    fourth(1) = q(1)+scale*(r(1)-q(1))
    fourth(2) = q(2)+scale*(r(2)-q(2))
    fourth(1)-q(1) = (q(1)+scale*(r(1)-q(1)))-q(1) = scale*(r(1)-q(1))
    fourth(2)-q(2) = (q(2)+scale*(r(2)-q(2)))-q(2) = scale*(r(2)-q(2))
    have third cart(R, R) = (p(1)+fourth(1)-q(1), p(2)+fourth(2)-q(2))
    third(1) = p(1)+fourth(1)-q(1)
    third(2) = p(2)+fourth(2)-q(2)
    release thm geometry::main::collinear_det_expand(q, p, r)
    release thm geometry::main::collinear_det_expand(q, p, fourth)
    geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, fourth)) = (p(1)-q(1))*(fourth(2)-q(2))-(p(2)-q(2))*(fourth(1)-q(1)) = (p(1)-q(1))*(scale*(r(2)-q(2)))-(p(2)-q(2))*(scale*(r(1)-q(1))) = scale*((p(1)-q(1))*(r(2)-q(2))-(p(2)-q(2))*(r(1)-q(1))) = scale*geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, r)) = scale*determinant
    by contra:
        ? geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, fourth)) != 0
        geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, fourth)) = 0
        scale*determinant = geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, fourth)) = 0
        determinant = (scale*determinant)/scale = 0/scale = 0
        impossible determinant != 0
    by def $geometry::main::is_triangle(q, p, fourth)
    release thm geometry_lemmas::triangle_vertices_distinct(q, p, fourth)
    release thm affine_parallelogram_area(q, p, third, fourth)
    obtain half from exist value R+ st {$area::has_triangle_area(q, p, fourth, value), $area::has_parallelogram_area(q, p, third, fourth, 2*value)}
    by def $area::has_triangle_area(q, p, fourth, half)
    geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, fourth))^2 = (scale*determinant)^2 = scale^2*determinant^2
    scale^2 >= 0
    determinant^2 >= 0
    sqrt(scale^2*determinant^2) = sqrt(scale^2)*sqrt(determinant^2)
    sqrt(scale^2) = |scale| = scale
    2*half = sqrt(geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, fourth))^2) = sqrt(scale^2*determinant^2) = sqrt(scale^2)*sqrt(determinant^2) = scale*root = (common/root)*root = common
    $area::has_parallelogram_area(q, p, third, fourth, common)
    release thm angle_measure::positive_ray_scale_preserves_cosine(p, q, r, fourth, scale)
    release thm angle_measure::equal_cosines_imply_angle_relation(p, q, fourth, p, q, r)
    witness exist third_point, fourth_point cart(R, R), value R+ st {$area::has_triangle_area(a, b, c, value), $area::has_parallelogram_area(q, p, third_point, fourth_point, value), $geometry::main::are_angles_congruent(p, q, fourth_point, p, q, r)} from third, fourth, common

thm parallelogram_coordinate_closure:
    ? forall par_a, par_b, par_c, par_d cart(R, R):
        $area::is_proper_parallelogram(par_a, par_b, par_c, par_d)
        =>:
            par_d(1) = par_a(1)+par_c(1)-par_b(1)
            par_d(2) = par_a(2)+par_c(2)-par_b(2)
    thm local_independent_directions_force_zero_offset:
        ? forall u1, u2, v1, v2, k1, k2 R:
            u1*v2-u2*v1 != 0
            u1*k2-u2*k1 = 0
            v1*k2-v2*k1 = 0
            =>:
                k1 = 0
                k2 = 0
        have determinant R = u1*v2-u2*v1
        determinant != 0
        determinant*k1 = (u1*v2-u2*v1)*k1 = v1*(u1*k2-u2*k1)-u1*(v1*k2-v2*k1) = v1*0-u1*0 = 0
        determinant*k2 = (u1*v2-u2*v1)*k2 = v2*(u1*k2-u2*k1)-u2*(v1*k2-v2*k1) = v2*0-u2*0 = 0
        k1 = (determinant*k1)/determinant = 0/determinant = 0
        k2 = (determinant*k2)/determinant = 0/determinant = 0
    by def $area::is_proper_parallelogram(par_a, par_b, par_c, par_d)
    $parallel::are_parallel_lines(par_a, par_b, par_d, par_c)
    by def $parallel::are_parallel_lines(par_a, par_b, par_d, par_c)
    $parallel::are_parallel_lines(par_a, par_d, par_b, par_c)
    by def $parallel::are_parallel_lines(par_a, par_d, par_b, par_c)
    $geometry::main::is_parallel(par_a, par_b, par_d, par_c)
    by def $geometry::main::is_parallel(par_a, par_b, par_d, par_c)
    $geometry::main::is_parallel(par_a, par_d, par_b, par_c)
    by def $geometry::main::is_parallel(par_a, par_d, par_b, par_c)
    have u1 R = par_b(1)-par_a(1)
    have u2 R = par_b(2)-par_a(2)
    have v1 R = par_d(1)-par_a(1)
    have v2 R = par_d(2)-par_a(2)
    have k1 R = par_a(1)+par_c(1)-par_b(1)-par_d(1)
    have k2 R = par_a(2)+par_c(2)-par_b(2)-par_d(2)
    release thm geometry::main::collinear_det_expand(par_a, par_b, par_d)
    u1*v2-u2*v1 = (par_b(1)-par_a(1))*(par_d(2)-par_a(2))-(par_b(2)-par_a(2))*(par_d(1)-par_a(1)) = geometry::main::det(geometry::main::vec(par_a, par_b), geometry::main::vec(par_a, par_d)) != 0
    release thm geometry::main::vec_coordinate_formula(par_a, par_b)
    release thm geometry::main::vec_coordinate_formula(par_a, par_d)
    release thm geometry::main::vec_coordinate_formula(par_d, par_c)
    release thm geometry::main::vec_coordinate_formula(par_b, par_c)
    release thm geometry::main::det_coordinate_formula(geometry::main::vec(par_a, par_b), geometry::main::vec(par_d, par_c))
    release thm geometry::main::det_coordinate_formula(geometry::main::vec(par_a, par_d), geometry::main::vec(par_b, par_c))
    geometry::main::det(geometry::main::vec(par_a, par_b), geometry::main::vec(par_d, par_c)) = (par_b(1)-par_a(1))*(par_c(2)-par_d(2))-(par_b(2)-par_a(2))*(par_c(1)-par_d(1))
    (par_b(1)-par_a(1))*(par_c(2)-par_d(2))-(par_b(2)-par_a(2))*(par_c(1)-par_d(1)) = geometry::main::det(geometry::main::vec(par_a, par_b), geometry::main::vec(par_d, par_c)) = 0
    geometry::main::det(geometry::main::vec(par_a, par_d), geometry::main::vec(par_b, par_c)) = (par_d(1)-par_a(1))*(par_c(2)-par_b(2))-(par_d(2)-par_a(2))*(par_c(1)-par_b(1))
    (par_d(1)-par_a(1))*(par_c(2)-par_b(2))-(par_d(2)-par_a(2))*(par_c(1)-par_b(1)) = geometry::main::det(geometry::main::vec(par_a, par_d), geometry::main::vec(par_b, par_c)) = 0
    u1*k2-u2*k1 = (par_b(1)-par_a(1))*(par_a(2)+par_c(2)-par_b(2)-par_d(2))-(par_b(2)-par_a(2))*(par_a(1)+par_c(1)-par_b(1)-par_d(1)) = (par_b(1)-par_a(1))*(par_c(2)-par_d(2))-(par_b(2)-par_a(2))*(par_c(1)-par_d(1)) = geometry::main::det(geometry::main::vec(par_a, par_b), geometry::main::vec(par_d, par_c)) = 0
    v1*k2-v2*k1 = (par_d(1)-par_a(1))*(par_a(2)+par_c(2)-par_b(2)-par_d(2))-(par_d(2)-par_a(2))*(par_a(1)+par_c(1)-par_b(1)-par_d(1)) = (par_d(1)-par_a(1))*(par_c(2)-par_b(2))-(par_d(2)-par_a(2))*(par_c(1)-par_b(1)) = geometry::main::det(geometry::main::vec(par_a, par_d), geometry::main::vec(par_b, par_c)) = 0
    release thm local_independent_directions_force_zero_offset(u1, u2, v1, v2, k1, k2)
    par_a(1)+par_c(1)-par_b(1) = (par_a(1)+par_c(1)-par_b(1)-par_d(1))+par_d(1) = k1+par_d(1) = 0+par_d(1) = par_d(1)
    par_a(2)+par_c(2)-par_b(2) = (par_a(2)+par_c(2)-par_b(2)-par_d(2))+par_d(2) = k2+par_d(2) = 0+par_d(2) = par_d(2)

thm parallelogram_area_is_absolute_determinant:
    ? forall a,b,c,d cart(R,R), total R+:
        $area::has_parallelogram_area(a,b,c,d,total)
        =>:
            total = sqrt(geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d))^2)
    by def $area::has_parallelogram_area(a,b,c,d,total)
    $area::is_proper_parallelogram(a,b,c,d)
    release thm parallelogram_coordinate_closure(a,b,c,d)
    c(1) = b(1)+(a(1)+c(1)-b(1))-a(1) = b(1)+d(1)-a(1)
    c(2) = b(2)+(a(2)+c(2)-b(2))-a(2) = b(2)+d(2)-a(2)
    have u cart(R,R) = geometry::main::vec(a,b)
    have v cart(R,R) = geometry::main::vec(a,d)
    geometry::main::det(u,v)^2 >= 0
    by def $area::has_parallelogram_area(a, b, c, d, total)
    obtain first, second from exist x, y R+ st {$area::has_triangle_area(a, b, d, x), $area::has_triangle_area(b, c, d, y), total = x+y}
    by def $area::has_triangle_area(a, b, d, first)
    by def $area::has_triangle_area(b, c, d, second)
    release thm geometry::main::collinear_det_expand(a, b, d)
    release thm geometry::main::collinear_det_expand(b, c, d)
    c(1)-b(1) = (b(1)+d(1)-a(1))-b(1) = d(1)-a(1)
    c(2)-b(2) = (b(2)+d(2)-a(2))-b(2) = d(2)-a(2)
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d)) = (c(1)-b(1))*(d(2)-b(2))-(c(2)-b(2))*(d(1)-b(1)) = (d(1)-a(1))*(d(2)-b(2))-(d(2)-a(2))*(d(1)-b(1)) = (b(1)-a(1))*(d(2)-a(2))-(b(2)-a(2))*(d(1)-a(1)) = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) = geometry::main::det(u, v)
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) = geometry::main::det(u, v)
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d))^2 = geometry::main::det(u, v)^2
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d))^2 >= 0
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d)) = geometry::main::det(u, v)
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2 = geometry::main::det(u, v)^2
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2 >= 0
    2*first = sqrt(geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d))^2) = sqrt(geometry::main::det(u, v)^2)
    2*second = sqrt(geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2) = sqrt(geometry::main::det(u, v)^2)
    have twice_area R = sqrt(geometry::main::det(u,v)^2)
    2*first = twice_area
    2*second = twice_area
    total = first+second = (2*first+2*second)/2 = (twice_area+twice_area)/2 = twice_area
    total = twice_area = sqrt(geometry::main::det(u,v)^2) = sqrt(geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d))^2)

# Incidence form: X is on the first side, Y on the second, and X+Y on the diagonal.

thm diagonal_incidence_complement_identity:
    ? forall u1,u2,v1,v2,x1,x2,y1,y2 R:
        u1*x2-u2*x1 = 0
        v1*y2-v2*y1 = 0
        (u1+v1)*(x2+y2)-(u2+v2)*(x1+y1) = 0
        =>:
            (u1-x1)*y2-(u2-x2)*y1 = x1*(v2-y2)-x2*(v1-y1)
    have left R = (u1-x1)*y2-(u2-x2)*y1
    have right R = x1*(v2-y2)-x2*(v1-y1)
    left-right = ((u1-x1)*y2-(u2-x2)*y1)-(x1*(v2-y2)-x2*(v1-y1)) = ((u1+v1)*(x2+y2)-(u2+v2)*(x1+y1))-(u1*x2-u2*x1)-(v1*y2-v2*y1) = 0-0-0 = 0
    left = (left-right)+right = 0+right = right
    (u1-x1)*y2-(u2-x2)*y1 = left = right = x1*(v2-y2)-x2*(v1-y1)

# General complement equality: proper outer and inner parallelograms, incidence on both sides and diagonal.

thm proposition_43_general_complements:
    ? forall a,b,c,d,edge,h,k,f,g cart(R,R), left_area,right_area R+:
        $area::is_proper_parallelogram(a,b,c,d)
        $area::is_proper_parallelogram(a,edge,k,h)
        $area::has_parallelogram_area(edge,b,f,k,left_area)
        $area::has_parallelogram_area(h,k,g,d,right_area)
        geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,edge)) = 0
        geometry::main::det(geometry::main::vec(a,d),geometry::main::vec(a,h)) = 0
        geometry::main::det(geometry::main::vec(a,c),geometry::main::vec(a,k)) = 0
        =>:
            left_area = right_area
    release thm parallelogram_coordinate_closure(a,b,c,d)
    release thm parallelogram_coordinate_closure(a,edge,k,h)
    c(1) = b(1)+(a(1)+c(1)-b(1))-a(1) = b(1)+d(1)-a(1)
    c(2) = b(2)+(a(2)+c(2)-b(2))-a(2) = b(2)+d(2)-a(2)
    k(1) = edge(1)+(a(1)+k(1)-edge(1))-a(1) = edge(1)+h(1)-a(1)
    k(2) = edge(2)+(a(2)+k(2)-edge(2))-a(2) = edge(2)+h(2)-a(2)
    have u1 R = b(1)-a(1)
    have u2 R = b(2)-a(2)
    have v1 R = d(1)-a(1)
    have v2 R = d(2)-a(2)
    have x1 R = edge(1)-a(1)
    have x2 R = edge(2)-a(2)
    have y1 R = h(1)-a(1)
    have y2 R = h(2)-a(2)
    release thm geometry::main::collinear_det_expand(a,b,edge)
    release thm geometry::main::collinear_det_expand(a,d,h)
    release thm geometry::main::collinear_det_expand(a,c,k)
    u1*x2-u2*x1 = (b(1)-a(1))*(edge(2)-a(2))-(b(2)-a(2))*(edge(1)-a(1)) = geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,edge)) = 0
    v1*y2-v2*y1 = (d(1)-a(1))*(h(2)-a(2))-(d(2)-a(2))*(h(1)-a(1)) = geometry::main::det(geometry::main::vec(a,d),geometry::main::vec(a,h)) = 0
    c(1)-a(1) = (b(1)+d(1)-a(1))-a(1) = (b(1)-a(1))+(d(1)-a(1)) = u1+v1
    c(2)-a(2) = (b(2)+d(2)-a(2))-a(2) = (b(2)-a(2))+(d(2)-a(2)) = u2+v2
    k(1)-a(1) = (edge(1)+h(1)-a(1))-a(1) = (edge(1)-a(1))+(h(1)-a(1)) = x1+y1
    k(2)-a(2) = (edge(2)+h(2)-a(2))-a(2) = (edge(2)-a(2))+(h(2)-a(2)) = x2+y2
    (u1+v1)*(x2+y2)-(u2+v2)*(x1+y1) = (c(1)-a(1))*(k(2)-a(2))-(c(2)-a(2))*(k(1)-a(1)) = geometry::main::det(geometry::main::vec(a,c),geometry::main::vec(a,k)) = 0
    release thm diagonal_incidence_complement_identity(u1,u2,v1,v2,x1,x2,y1,y2)
    b(1)-edge(1) = (b(1)-a(1))-(edge(1)-a(1)) = u1-x1
    k(1)-edge(1) = (edge(1)+h(1)-a(1))-edge(1) = h(1)-a(1) = y1
    k(1)-h(1) = (edge(1)+h(1)-a(1))-h(1) = edge(1)-a(1) = x1
    d(1)-h(1) = (d(1)-a(1))-(h(1)-a(1)) = v1-y1
    b(2)-edge(2) = (b(2)-a(2))-(edge(2)-a(2)) = u2-x2
    k(2)-edge(2) = (edge(2)+h(2)-a(2))-edge(2) = h(2)-a(2) = y2
    k(2)-h(2) = (edge(2)+h(2)-a(2))-h(2) = edge(2)-a(2) = x2
    d(2)-h(2) = (d(2)-a(2))-(h(2)-a(2)) = v2-y2
    release thm geometry::main::collinear_det_expand(edge,b,k)
    release thm geometry::main::collinear_det_expand(h,k,d)
    geometry::main::det(geometry::main::vec(edge,b),geometry::main::vec(edge,k)) = (b(1)-edge(1))*(k(2)-edge(2))-(b(2)-edge(2))*(k(1)-edge(1)) = (u1-x1)*y2-(u2-x2)*y1
    geometry::main::det(geometry::main::vec(h,k),geometry::main::vec(h,d)) = (k(1)-h(1))*(d(2)-h(2))-(k(2)-h(2))*(d(1)-h(1)) = x1*(v2-y2)-x2*(v1-y1)
    geometry::main::det(geometry::main::vec(edge,b),geometry::main::vec(edge,k)) = geometry::main::det(geometry::main::vec(h,k),geometry::main::vec(h,d))
    geometry::main::det(geometry::main::vec(edge,b),geometry::main::vec(edge,k))^2 = geometry::main::det(geometry::main::vec(h,k),geometry::main::vec(h,d))^2
    geometry::main::det(geometry::main::vec(edge,b),geometry::main::vec(edge,k))^2 >= 0
    geometry::main::det(geometry::main::vec(h,k),geometry::main::vec(h,d))^2 >= 0
    release thm parallelogram_area_is_absolute_determinant(edge,b,f,k,left_area)
    release thm parallelogram_area_is_absolute_determinant(h,k,g,d,right_area)
    left_area = sqrt(geometry::main::det(geometry::main::vec(edge,b),geometry::main::vec(edge,k))^2) = sqrt(geometry::main::det(geometry::main::vec(h,k),geometry::main::vec(h,d))^2) = right_area

thm proposition_44:
    ? forall a, b, c, base_start, base_end, p, q, r cart(R, R):
        $geometry::main::is_triangle(a, b, c)
        base_start != base_end
        $geometry::main::is_triangle(q, p, r)
        =>:
            exist third, fourth cart(R, R), common R+ st {$area::has_triangle_area(a, b, c, common), $area::has_parallelogram_area(base_start, base_end, third, fourth, common), $geometry::main::are_angles_congruent(base_end, base_start, fourth, p, q, r)}
    release thm proposition_23(base_start, base_end, p, q, r)
    obtain ray_point from exist g cart(R, R) st {$geometry::main::is_triangle(base_start, base_end, g), $geometry::main::are_angles_congruent(base_end, base_start, g, p, q, r)}
    release thm proposition_42(a, b, c, base_end, base_start, ray_point)
    obtain third, fourth, common from exist x, y cart(R, R), value R+ st {$area::has_triangle_area(a, b, c, value), $area::has_parallelogram_area(base_start, base_end, x, y, value), $geometry::main::are_angles_congruent(base_end, base_start, y, base_end, base_start, ray_point)}
    by def $geometry::main::are_angles_congruent(base_end, base_start, fourth, base_end, base_start, ray_point)
    by def $geometry::main::are_angles_congruent(base_end, base_start, ray_point, p, q, r)
    release thm angle_measure::angle_relation_implies_equal_cosine(base_end, base_start, fourth, base_end, base_start, ray_point)
    release thm angle_measure::angle_relation_implies_equal_cosine(base_end, base_start, ray_point, p, q, r)
    angles::angle_cosine(base_end, base_start, fourth) = angles::angle_cosine(base_end, base_start, ray_point) = angles::angle_cosine(p, q, r)
    release thm angle_measure::equal_cosines_imply_angle_relation(base_end, base_start, fourth, p, q, r)
    witness exist x, y cart(R, R), value R+ st {$area::has_triangle_area(a, b, c, value), $area::has_parallelogram_area(base_start, base_end, x, y, value), $geometry::main::are_angles_congruent(base_end, base_start, y, p, q, r)} from third, fourth, common

thm proposition_46:
    ? forall a, b cart(R, R):
        a != b
        =>:
            exist c, d cart(R, R) st {$geometry::main::is_square(a, b, c, d), $area::is_proper_parallelogram(a, b, c, d)}
    have dx R = b(1)-a(1)
    have dy R = b(2)-a(2)
    release thm geometry::main::distance_sq_positive_of_ne(a, b)
    release thm geometry::main::distance_sq_coordinate_formula(a, b)
    dx^2+dy^2 = (b(1)-a(1))^2+(b(2)-a(2))^2 = geometry::main::distance_sq(a, b) > 0
    have d cart(R, R) = (a(1)-dy, a(2)+dx)
    d(1) = a(1)-dy
    d(2) = a(2)+dx
    d(1)-a(1) = (a(1)-dy)-a(1) = -dy
    d(2)-a(2) = (a(2)+dx)-a(2) = dx
    have c cart(R, R) = (b(1)-dy, b(2)+dx)
    c(1) = b(1)-dy
    c(2) = b(2)+dx
    c(1) = b(1)-dy = b(1)+(a(1)-dy)-a(1) = b(1)+d(1)-a(1)
    c(2) = b(2)+dx = b(2)+(a(2)+dx)-a(2) = b(2)+d(2)-a(2)
    c(1)-b(1) = (b(1)-dy)-b(1) = -dy
    c(2)-b(2) = (b(2)+dx)-b(2) = dx
    release thm geometry::main::collinear_det_expand(a, b, d)
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) = (b(1)-a(1))*(d(2)-a(2))-(b(2)-a(2))*(d(1)-a(1)) = dx*dx-dy*(-dy) = dx^2+dy^2 > 0
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) != 0
    by def $geometry::main::is_triangle(a, b, d)
    release thm geometry_lemmas::triangle_vertices_distinct(a, b, d)
    release thm affine_parallelogram_witness(a, b, c, d)
    by def $area::is_proper_parallelogram(a, b, c, d)
    $parallel::are_parallel_lines(a, b, d, c)
    by def $parallel::are_parallel_lines(a, b, d, c)
    $parallel::are_parallel_lines(a, d, b, c)
    by def $parallel::are_parallel_lines(a, d, b, c)
    by def $geometry::main::is_parallelogram(a, b, c, d)
    release thm geometry::main::perpendicular_dot_expand(a, d, a, b)
    geometry::main::dot(geometry::main::vec(a, d), geometry::main::vec(a, b)) = (d(1)-a(1))*(b(1)-a(1))+(d(2)-a(2))*(b(2)-a(2)) = (-dy)*dx+dx*dy = 0
    by def $geometry::main::is_right_angle(d, a, b)
    by def $geometry::main::is_rectangle(a, b, c, d)
    release thm geometry::main::distance_sq_coordinate_formula(b, c)
    geometry::main::distance_sq(b, c) = (c(1)-b(1))^2+(c(2)-b(2))^2 = (-dy)^2+dx^2 = dx^2+dy^2 = geometry::main::distance_sq(a, b)
    by def $geometry::main::are_segments_congruent(a, b, b, c)
    by def $geometry::main::is_square(a, b, c, d)
    witness exist third, fourth cart(R, R) st {$geometry::main::is_square(a, b, third, fourth), $area::is_proper_parallelogram(a, b, third, fourth)} from c, d


# The area of an actual square is the squared length of its prescribed first edge.

thm square_area_is_squared_side:
    ? forall a, b, c, d cart(R, R), total R+:
        $geometry::main::is_square(a, b, c, d)
        $area::has_parallelogram_area(a, b, c, d, total)
        =>:
            total = geometry::main::distance_sq(a, b)
    by def $geometry::main::is_square(a, b, c, d)
    $geometry::main::is_rectangle(a, b, c, d)
    $geometry::main::is_parallelogram(a, b, c, d)
    by def $geometry::main::is_rectangle(a, b, c, d)
    by def $geometry::main::is_parallelogram(a, b, c, d)
    $geometry::main::is_parallel(a, b, d, c)
    by def $geometry::main::is_parallel(a, b, d, c)
    $geometry::main::is_parallel(a, d, b, c)
    by def $geometry::main::is_parallel(a, d, b, c)
    $geometry::main::is_right_angle(d, a, b)
    by def $geometry::main::is_right_angle(d, a, b)
    $geometry::main::are_segments_congruent(a, b, b, c)
    by def $geometry::main::are_segments_congruent(a, b, b, c)
    release thm geometry::main::square_orthogonal_parallel_quadrilateral_coordinates(a, b, c, d)
    d(1) = a(1)+c(1)-b(1)
    c(1) = b(1)+(a(1)+c(1)-b(1))-a(1) = b(1)+d(1)-a(1)
    d(2) = a(2)+c(2)-b(2)
    c(2) = b(2)+(a(2)+c(2)-b(2))-a(2) = b(2)+d(2)-a(2)
    release thm geometry::main::parallelogram_sides(a, b, c, d)
    geometry::main::distance_sq(a, d) = geometry::main::distance_sq(b, c) = geometry::main::distance_sq(a, b)
    release thm geometry::main::distance_sq_positive_of_ne(a, b)
    have side_square R+ = geometry::main::distance_sq(a, b)
    have u cart(R, R) = geometry::main::vec(a, b)
    have v cart(R, R) = geometry::main::vec(a, d)
    release thm geometry::main::dot_symmetric(u, v)
    geometry::main::dot(u, v) = geometry::main::dot(v, u) = 0
    release thm geometry::main::vec_dot_self_is_distance(a, b)
    release thm geometry::main::vec_dot_self_is_distance(a, d)
    geometry::main::dot(u, u) = side_square
    geometry::main::dot(v, v) = side_square
    release thm geometry::main::dot_squared_plus_det_squared(u, v)
    geometry::main::det(u, v)^2 = geometry::main::dot(u, v)^2+geometry::main::det(u, v)^2 = geometry::main::dot(u, u)*geometry::main::dot(v, v) = side_square*side_square = side_square^2
    geometry::main::det(u, v)^2 = side_square^2
    geometry::main::det(u, v)^2 >= 0
    side_square^2 >= 0
    sqrt(geometry::main::det(u, v)^2) = sqrt(side_square^2) = |side_square| = side_square
    by def $area::has_parallelogram_area(a, b, c, d, total)
    obtain first, second from exist x, y R+ st {$area::has_triangle_area(a, b, d, x), $area::has_triangle_area(b, c, d, y), total = x+y}
    by def $area::has_triangle_area(a, b, d, first)
    by def $area::has_triangle_area(b, c, d, second)
    release thm geometry::main::collinear_det_expand(a, b, d)
    release thm geometry::main::collinear_det_expand(b, c, d)
    c(1)-b(1) = (b(1)+d(1)-a(1))-b(1) = d(1)-a(1)
    c(2)-b(2) = (b(2)+d(2)-a(2))-b(2) = d(2)-a(2)
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d)) = (c(1)-b(1))*(d(2)-b(2))-(c(2)-b(2))*(d(1)-b(1)) = (d(1)-a(1))*(d(2)-b(2))-(d(2)-a(2))*(d(1)-b(1)) = (b(1)-a(1))*(d(2)-a(2))-(b(2)-a(2))*(d(1)-a(1)) = geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) = geometry::main::det(u, v)
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d)) = geometry::main::det(u, v)
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d))^2 = geometry::main::det(u, v)^2
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d))^2 >= 0
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d)) = geometry::main::det(u, v)
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2 = geometry::main::det(u, v)^2
    geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2 >= 0
    2*first = sqrt(geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, d))^2) = sqrt(geometry::main::det(u, v)^2) = side_square
    2*second = sqrt(geometry::main::det(geometry::main::vec(b, c), geometry::main::vec(b, d))^2) = sqrt(geometry::main::det(u, v)^2) = side_square
    total = first+second = (2*first+2*second)/2 = (side_square+side_square)/2 = side_square = geometry::main::distance_sq(a, b)


# I.47: actual squares on all three sides.

thm proposition_47:
    ? forall a, b, c, ab_c, ab_d, bc_c, bc_d, ac_c, ac_d cart(R, R), first, second, opposite R+:
        $geometry::main::is_triangle(a, b, c)
        $geometry::main::is_right_angle(a, b, c)
        $geometry::main::is_square(a, b, ab_c, ab_d)
        $area::has_parallelogram_area(a, b, ab_c, ab_d, first)
        $geometry::main::is_square(b, c, bc_c, bc_d)
        $area::has_parallelogram_area(b, c, bc_c, bc_d, second)
        $geometry::main::is_square(a, c, ac_c, ac_d)
        $area::has_parallelogram_area(a, c, ac_c, ac_d, opposite)
        =>:
            opposite = first+second
    release thm square_area_is_squared_side(a, b, ab_c, ab_d, first)
    release thm square_area_is_squared_side(b, c, bc_c, bc_d, second)
    release thm square_area_is_squared_side(a, c, ac_c, ac_d, opposite)
    by def $geometry::main::is_right_angle(a, b, c)
    release thm geometry::main::pythagorean_theorem(a, b, c)
    opposite = geometry::main::distance_sq(a, c) = geometry::main::distance_sq(a, b)+geometry::main::distance_sq(b, c) = first+second


# I.48: actual squares on all three sides.

thm proper_square_area_exists:
    ? forall a, b, c, d cart(R, R):
        $geometry::main::is_square(a,b,c,d)
        $area::is_proper_parallelogram(a,b,c,d)
        =>:
            exist total R+ st {$area::has_parallelogram_area(a,b,c,d,total)}
    $geometry::main::is_rectangle(a,b,c,d)
    $geometry::main::is_parallelogram(a,b,c,d)
    $geometry::main::is_right_angle(d,a,b)
    $parallel::are_parallel_lines(a,b,d,c)
    $parallel::are_parallel_lines(a,d,b,c)
    $geometry::main::is_parallel(a,b,d,c)
    $geometry::main::is_parallel(a,d,b,c)
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d)) != 0
    by def $geometry::main::is_triangle(a,b,d)
    release thm geometry::main::square_orthogonal_parallel_quadrilateral_coordinates(a,b,c,d)
    d(1) = a(1)+c(1)-b(1)
    d(2) = a(2)+c(2)-b(2)
    c(1) = b(1)+(a(1)+c(1)-b(1))-a(1) = b(1)+d(1)-a(1)
    c(2) = b(2)+(a(2)+c(2)-b(2))-a(2) = b(2)+d(2)-a(2)
    release thm affine_parallelogram_area(a,b,c,d)
    obtain half from exist half R+ st {$area::has_triangle_area(a,b,d,half), $area::has_parallelogram_area(a,b,c,d,2*half)}
    witness exist total R+ st {$area::has_parallelogram_area(a,b,c,d,total)} from 2*half

thm three_squares_on_triangle:
    ? forall a,b,c cart(R,R):
        $geometry::main::is_triangle(a,b,c)
        =>:
            exist ab_c,ab_d,bc_c,bc_d,ac_c,ac_d cart(R,R), first,second,opposite R+ st {$geometry::main::is_square(a,b,ab_c,ab_d), $area::has_parallelogram_area(a,b,ab_c,ab_d,first), $geometry::main::is_square(b,c,bc_c,bc_d), $area::has_parallelogram_area(b,c,bc_c,bc_d,second), $geometry::main::is_square(a,c,ac_c,ac_d), $area::has_parallelogram_area(a,c,ac_c,ac_d,opposite)}
    release thm geometry_lemmas::triangle_vertices_distinct(a,b,c)
    release thm proposition_46(a,b)
    obtain ab_c,ab_d from exist u,v cart(R,R) st {$geometry::main::is_square(a,b,u,v), $area::is_proper_parallelogram(a,b,u,v)}
    release thm proper_square_area_exists(a,b,ab_c,ab_d)
    obtain first from exist value R+ st {$area::has_parallelogram_area(a,b,ab_c,ab_d,value)}
    release thm proposition_46(b,c)
    obtain bc_c,bc_d from exist u,v cart(R,R) st {$geometry::main::is_square(b,c,u,v), $area::is_proper_parallelogram(b,c,u,v)}
    release thm proper_square_area_exists(b,c,bc_c,bc_d)
    obtain second from exist value R+ st {$area::has_parallelogram_area(b,c,bc_c,bc_d,value)}
    release thm proposition_46(a,c)
    obtain ac_c,ac_d from exist u,v cart(R,R) st {$geometry::main::is_square(a,c,u,v), $area::is_proper_parallelogram(a,c,u,v)}
    release thm proper_square_area_exists(a,c,ac_c,ac_d)
    obtain opposite from exist value R+ st {$area::has_parallelogram_area(a,c,ac_c,ac_d,value)}
    witness exist out_ab_c,out_ab_d,out_bc_c,out_bc_d,out_ac_c,out_ac_d cart(R,R), out_first,out_second,out_opposite R+ st {$geometry::main::is_square(a,b,out_ab_c,out_ab_d), $area::has_parallelogram_area(a,b,out_ab_c,out_ab_d,out_first), $geometry::main::is_square(b,c,out_bc_c,out_bc_d), $area::has_parallelogram_area(b,c,out_bc_c,out_bc_d,out_second), $geometry::main::is_square(a,c,out_ac_c,out_ac_d), $area::has_parallelogram_area(a,c,out_ac_c,out_ac_d,out_opposite)} from ab_c,ab_d,bc_c,bc_d,ac_c,ac_d,first,second,opposite

thm pythagorean_square_construction:
    ? forall a,b,c cart(R,R):
        $geometry::main::is_triangle(a,b,c)
        $geometry::main::is_right_angle(a,b,c)
        =>:
            exist ab_c,ab_d,bc_c,bc_d,ac_c,ac_d cart(R,R), first,second,opposite R+ st {$geometry::main::is_square(a,b,ab_c,ab_d), $area::has_parallelogram_area(a,b,ab_c,ab_d,first), $geometry::main::is_square(b,c,bc_c,bc_d), $area::has_parallelogram_area(b,c,bc_c,bc_d,second), $geometry::main::is_square(a,c,ac_c,ac_d), $area::has_parallelogram_area(a,c,ac_c,ac_d,opposite), opposite = first+second}
    release thm three_squares_on_triangle(a,b,c)
    obtain ab_c,ab_d,bc_c,bc_d,ac_c,ac_d,first,second,opposite from exist ab_c,ab_d,bc_c,bc_d,ac_c,ac_d cart(R,R), first,second,opposite R+ st {$geometry::main::is_square(a,b,ab_c,ab_d), $area::has_parallelogram_area(a,b,ab_c,ab_d,first), $geometry::main::is_square(b,c,bc_c,bc_d), $area::has_parallelogram_area(b,c,bc_c,bc_d,second), $geometry::main::is_square(a,c,ac_c,ac_d), $area::has_parallelogram_area(a,c,ac_c,ac_d,opposite)}
    release thm proposition_47(a,b,c,ab_c,ab_d,bc_c,bc_d,ac_c,ac_d,first,second,opposite)
    witness exist out_ab_c,out_ab_d,out_bc_c,out_bc_d,out_ac_c,out_ac_d cart(R,R), out_first,out_second,out_opposite R+ st {$geometry::main::is_square(a,b,out_ab_c,out_ab_d), $area::has_parallelogram_area(a,b,out_ab_c,out_ab_d,out_first), $geometry::main::is_square(b,c,out_bc_c,out_bc_d), $area::has_parallelogram_area(b,c,out_bc_c,out_bc_d,out_second), $geometry::main::is_square(a,c,out_ac_c,out_ac_d), $area::has_parallelogram_area(a,c,out_ac_c,out_ac_d,out_opposite), out_opposite = out_first+out_second} from ab_c,ab_d,bc_c,bc_d,ac_c,ac_d,first,second,opposite

thm proposition_48:
    ? forall a, b, c, ab_c, ab_d, bc_c, bc_d, ac_c, ac_d cart(R, R), first, second, opposite R+:
        $geometry::main::is_triangle(a, b, c)
        $geometry::main::is_square(a, b, ab_c, ab_d)
        $area::has_parallelogram_area(a, b, ab_c, ab_d, first)
        $geometry::main::is_square(b, c, bc_c, bc_d)
        $area::has_parallelogram_area(b, c, bc_c, bc_d, second)
        $geometry::main::is_square(a, c, ac_c, ac_d)
        $area::has_parallelogram_area(a, c, ac_c, ac_d, opposite)
        opposite = first+second
        =>:
            $geometry::main::is_right_angle(a, b, c)
    release thm square_area_is_squared_side(a, b, ab_c, ab_d, first)
    release thm square_area_is_squared_side(b, c, bc_c, bc_d, second)
    release thm square_area_is_squared_side(a, c, ac_c, ac_d, opposite)
    release thm geometry_lemmas::triangle_vertices_distinct(a, b, c)
    release thm geometry::main::dot_from_cosine_law(a, b, c)
    geometry::main::dot(geometry::main::vec(b, a), geometry::main::vec(b, c)) = (geometry::main::distance_sq(a, b)+geometry::main::distance_sq(b, c)-geometry::main::distance_sq(a, c))/2 = (first+second-opposite)/2 = (opposite-opposite)/2 = 0
    by def $geometry::main::is_right_angle(a, b, c)
