release obj def geometry::main::vec

release obj def geometry::main::dot

release obj def geometry::main::det

release obj def geometry::main::distance_sq

release obj def geometry::main::angle_cos_num

release obj def geometry::main::angle_cos_den

thm triangle_vertices_distinct:
    ? forall a, b, c cart(R, R):
        $geometry::main::is_triangle(a, b, c)
        =>:
            a != b
            a != c
            b != c
    claim:
        ? forall aa, bb, cc cart(R, R):
            $geometry::main::is_triangle(aa, bb, cc)
            =>:
                aa != cc
        by contra:
            ? aa != cc
            aa = cc
            cc(1) = aa(1)
            cc(2) = aa(2)
            geometry::main::vec(aa, cc)(1) = cc(1) - aa(1) = aa(1) - aa(1) = 0
            geometry::main::vec(aa, cc)(2) = cc(2) - aa(2) = aa(2) - aa(2) = 0
            geometry::main::det(geometry::main::vec(aa, bb), geometry::main::vec(aa, cc)) = geometry::main::vec(aa, bb)(1) * geometry::main::vec(aa, cc)(2) - geometry::main::vec(aa, bb)(2) * geometry::main::vec(aa, cc)(1) = geometry::main::vec(aa, bb)(1) * 0 - geometry::main::vec(aa, bb)(2) * 0 = 0
            impossible geometry::main::det(geometry::main::vec(aa, bb), geometry::main::vec(aa, cc)) != 0
    a != c
    release thm geometry::main::det_antisymmetric(geometry::main::vec(a, c), geometry::main::vec(a, b))
    by contra:
        ? geometry::main::det(geometry::main::vec(a, c), geometry::main::vec(a, b)) != 0
        geometry::main::det(geometry::main::vec(a, c), geometry::main::vec(a, b)) = 0
        0 = geometry::main::det(geometry::main::vec(a, c), geometry::main::vec(a, b)) = -(geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)))
        geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) = -(-(geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)))) = -(geometry::main::det(geometry::main::vec(a, c), geometry::main::vec(a, b))) = -0 = 0
        impossible geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) != 0
    by def $geometry::main::is_triangle(a, c, b)
    a != b
    release thm geometry::main::triangle_det_squared_vertex(a, b, c)
    by contra:
        ? geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c)) != 0
        geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c)) = 0
        geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c))^2 = geometry::main::det(geometry::main::vec(b, a), geometry::main::vec(b, c))^2 = 0^2 = 0
        geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) = 0
        impossible geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, c)) != 0
    by def $geometry::main::is_triangle(b, a, c)
    b != c

