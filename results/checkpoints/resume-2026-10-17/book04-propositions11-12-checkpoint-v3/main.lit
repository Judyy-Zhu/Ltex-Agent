thm five_point_similarity_centroid:
    ? forall center,a,b,c,d,fifth cart(R,R), scale R+, vertices fn(k Z) cart(R,R):
        a(1)+b(1)+c(1)+d(1)+fifth(1) = 0
        a(2)+b(2)+c(2)+d(2)+fifth(2) = 0
        vertices(0) = scale_and_translate_point(a,center,scale)
        vertices(1) = scale_and_translate_point(b,center,scale)
        vertices(2) = scale_and_translate_point(c,center,scale)
        vertices(3) = scale_and_translate_point(d,center,scale)
        vertices(4) = scale_and_translate_point(fifth,center,scale)
        =>:
            center(1) = (vertices(0)(1)+vertices(1)(1)+vertices(2)(1)+vertices(3)(1)+vertices(4)(1))/5
            center(2) = (vertices(0)(2)+vertices(1)(2)+vertices(2)(2)+vertices(3)(2)+vertices(4)(2))/5
    have image0 cart(R,R) = scale_and_translate_point(a,center,scale)
    vertices(0) = image0
    have image1 cart(R,R) = scale_and_translate_point(b,center,scale)
    vertices(1) = image1
    have image2 cart(R,R) = scale_and_translate_point(c,center,scale)
    vertices(2) = image2
    have image3 cart(R,R) = scale_and_translate_point(d,center,scale)
    vertices(3) = image3
    have image4 cart(R,R) = scale_and_translate_point(fifth,center,scale)
    vertices(4) = image4
    image0(1) = scale_and_translate_point(a,center,scale)(1) = center(1)+scale*a(1)
    vertices(0)(1) = image0(1) = center(1)+scale*a(1)
    image1(1) = scale_and_translate_point(b,center,scale)(1) = center(1)+scale*b(1)
    vertices(1)(1) = image1(1) = center(1)+scale*b(1)
    image2(1) = scale_and_translate_point(c,center,scale)(1) = center(1)+scale*c(1)
    vertices(2)(1) = image2(1) = center(1)+scale*c(1)
    image3(1) = scale_and_translate_point(d,center,scale)(1) = center(1)+scale*d(1)
    vertices(3)(1) = image3(1) = center(1)+scale*d(1)
    image4(1) = scale_and_translate_point(fifth,center,scale)(1) = center(1)+scale*fifth(1)
    vertices(4)(1) = image4(1) = center(1)+scale*fifth(1)
    vertices(0)(1)+vertices(1)(1)+vertices(2)(1)+vertices(3)(1)+vertices(4)(1) = (center(1)+scale*a(1))+vertices(1)(1)+vertices(2)(1)+vertices(3)(1)+vertices(4)(1) = (center(1)+scale*a(1))+(center(1)+scale*b(1))+vertices(2)(1)+vertices(3)(1)+vertices(4)(1) = (center(1)+scale*a(1))+(center(1)+scale*b(1))+(center(1)+scale*c(1))+vertices(3)(1)+vertices(4)(1) = (center(1)+scale*a(1))+(center(1)+scale*b(1))+(center(1)+scale*c(1))+(center(1)+scale*d(1))+vertices(4)(1) = (center(1)+scale*a(1))+(center(1)+scale*b(1))+(center(1)+scale*c(1))+(center(1)+scale*d(1))+(center(1)+scale*fifth(1)) = 5*center(1)+scale*(a(1)+b(1)+c(1)+d(1)+fifth(1)) = 5*center(1)+scale*0 = 5*center(1)
    center(1) = (5*center(1))/5 = (vertices(0)(1)+vertices(1)(1)+vertices(2)(1)+vertices(3)(1)+vertices(4)(1))/5
    image0(2) = scale_and_translate_point(a,center,scale)(2) = center(2)+scale*a(2)
    vertices(0)(2) = image0(2) = center(2)+scale*a(2)
    image1(2) = scale_and_translate_point(b,center,scale)(2) = center(2)+scale*b(2)
    vertices(1)(2) = image1(2) = center(2)+scale*b(2)
    image2(2) = scale_and_translate_point(c,center,scale)(2) = center(2)+scale*c(2)
    vertices(2)(2) = image2(2) = center(2)+scale*c(2)
    image3(2) = scale_and_translate_point(d,center,scale)(2) = center(2)+scale*d(2)
    vertices(3)(2) = image3(2) = center(2)+scale*d(2)
    image4(2) = scale_and_translate_point(fifth,center,scale)(2) = center(2)+scale*fifth(2)
    vertices(4)(2) = image4(2) = center(2)+scale*fifth(2)
    vertices(0)(2)+vertices(1)(2)+vertices(2)(2)+vertices(3)(2)+vertices(4)(2) = (center(2)+scale*a(2))+vertices(1)(2)+vertices(2)(2)+vertices(3)(2)+vertices(4)(2) = (center(2)+scale*a(2))+(center(2)+scale*b(2))+vertices(2)(2)+vertices(3)(2)+vertices(4)(2) = (center(2)+scale*a(2))+(center(2)+scale*b(2))+(center(2)+scale*c(2))+vertices(3)(2)+vertices(4)(2) = (center(2)+scale*a(2))+(center(2)+scale*b(2))+(center(2)+scale*c(2))+(center(2)+scale*d(2))+vertices(4)(2) = (center(2)+scale*a(2))+(center(2)+scale*b(2))+(center(2)+scale*c(2))+(center(2)+scale*d(2))+(center(2)+scale*fifth(2)) = 5*center(2)+scale*(a(2)+b(2)+c(2)+d(2)+fifth(2)) = 5*center(2)+scale*0 = 5*center(2)
    center(2) = (5*center(2))/5 = (vertices(0)(2)+vertices(1)(2)+vertices(2)(2)+vertices(3)(2)+vertices(4)(2))/5


