                        right_index+1 = 3
                        vertices(left_index) = vertices(3)
                        vertices(left_index+1) = vertices(4)
                        vertices(right_index) = vertices(2)
                        vertices(right_index+1) = vertices(3)
                        $entry::segments_meet_only_at_common_endpoints(vertices(3),vertices(4),vertices(2),vertices(3))
                        $entry::segments_meet_only_at_common_endpoints(vertices(left_index),vertices(left_index+1),vertices(right_index),vertices(right_index+1))
                    case right_index = 3:
                        by contra:
                            ? $entry::segments_meet_only_at_common_endpoints(vertices(left_index),vertices(left_index+1),vertices(right_index),vertices(right_index+1))
                            not $entry::segments_meet_only_at_common_endpoints(vertices(left_index),vertices(left_index+1),vertices(right_index),vertices(right_index+1))
                            left_index = right_index
                            impossible left_index != right_index
                    case right_index = 4:
                        right_index+1 = 5
                        vertices(left_index) = vertices(3)
                        vertices(left_index+1) = vertices(4)
                        vertices(right_index) = vertices(4)
                        vertices(right_index+1) = vertices(5)
                        $entry::segments_meet_only_at_common_endpoints(vertices(3),vertices(4),vertices(4),vertices(5))
                        $entry::segments_meet_only_at_common_endpoints(vertices(left_index),vertices(left_index+1),vertices(right_index),vertices(right_index+1))
            case left_index = 4:
                left_index+1 = 5
                by cases:
                    ? $entry::segments_meet_only_at_common_endpoints(vertices(left_index),vertices(left_index+1),vertices(right_index),vertices(right_index+1))
                    case right_index = 0:
                        right_index+1 = 1
                        vertices(left_index) = vertices(4)
                        vertices(left_index+1) = vertices(5)
                        vertices(right_index) = vertices(0)
                        vertices(right_index+1) = vertices(1)
                        $entry::segments_meet_only_at_common_endpoints(vertices(4),vertices(5),vertices(0),vertices(1))
                        $entry::segments_meet_only_at_common_endpoints(vertices(left_index),vertices(left_index+1),vertices(right_index),vertices(right_index+1))
                    case right_index = 1:
                        right_index+1 = 2
                        vertices(left_index) = vertices(4)
                        vertices(left_index+1) = vertices(5)
                        vertices(right_index) = vertices(1)
                        vertices(right_index+1) = vertices(2)
                        $entry::segments_meet_only_at_common_endpoints(vertices(4),vertices(5),vertices(1),vertices(2))
                        $entry::segments_meet_only_at_common_endpoints(vertices(left_index),vertices(left_index+1),vertices(right_index),vertices(right_index+1))
                    case right_index = 2:
                        right_index+1 = 3
                        vertices(left_index) = vertices(4)
                        vertices(left_index+1) = vertices(5)
                        vertices(right_index) = vertices(2)
                        vertices(right_index+1) = vertices(3)
                        $entry::segments_meet_only_at_common_endpoints(vertices(4),vertices(5),vertices(2),vertices(3))
                        $entry::segments_meet_only_at_common_endpoints(vertices(left_index),vertices(left_index+1),vertices(right_index),vertices(right_index+1))
                    case right_index = 3:
                        right_index+1 = 4
                        vertices(left_index) = vertices(4)
                        vertices(left_index+1) = vertices(5)
                        vertices(right_index) = vertices(3)
                        vertices(right_index+1) = vertices(4)
                        $entry::segments_meet_only_at_common_endpoints(vertices(4),vertices(5),vertices(3),vertices(4))
                        $entry::segments_meet_only_at_common_endpoints(vertices(left_index),vertices(left_index+1),vertices(right_index),vertices(right_index+1))
                    case right_index = 4:
                        by contra:
                            ? $entry::segments_meet_only_at_common_endpoints(vertices(left_index),vertices(left_index+1),vertices(right_index),vertices(right_index+1))
                            not $entry::segments_meet_only_at_common_endpoints(vertices(left_index),vertices(left_index+1),vertices(right_index),vertices(right_index+1))
                            left_index = right_index
                            impossible left_index != right_index
    by def $entry::is_simple_polygonal_cycle(5,vertices)


thm sss_dot_equal:
    ? forall p, q, r, u, v, w cart(R, R):
        geometry::main::distance_sq(p, q) = geometry::main::distance_sq(u, v)
        geometry::main::distance_sq(q, r) = geometry::main::distance_sq(v, w)
        geometry::main::distance_sq(p, r) = geometry::main::distance_sq(u, w)
        =>:
            geometry::main::dot(geometry::main::vec(q, p), geometry::main::vec(q, r)) = geometry::main::dot(geometry::main::vec(v, u), geometry::main::vec(v, w))
    release thm geometry::main::dot_from_cosine_law(p,q,r)
    release thm geometry::main::dot_from_cosine_law(u,v,w)
    geometry::main::distance_sq(p,q)+geometry::main::distance_sq(q,r) = geometry::main::distance_sq(u,v)+geometry::main::distance_sq(v,w)
    geometry::main::distance_sq(p,q)+geometry::main::distance_sq(q,r)-geometry::main::distance_sq(p,r) = geometry::main::distance_sq(u,v)+geometry::main::distance_sq(v,w)-geometry::main::distance_sq(u,w)
    geometry::main::dot(geometry::main::vec(q,p),geometry::main::vec(q,r)) = (geometry::main::distance_sq(p,q)+geometry::main::distance_sq(q,r)-geometry::main::distance_sq(p,r))/2 = (geometry::main::distance_sq(u,v)+geometry::main::distance_sq(v,w)-geometry::main::distance_sq(u,w))/2 = geometry::main::dot(geometry::main::vec(v,u),geometry::main::vec(v,w))


thm angle_congruence_from_equal_sides_and_dot:
    ? forall aa, bb, cc, dd, ff, gg cart(R, R):
        bb != aa
        cc != aa
        ff != dd
        gg != dd
        geometry::main::distance_sq(aa, bb) = geometry::main::distance_sq(dd, ff)
        geometry::main::distance_sq(aa, cc) = geometry::main::distance_sq(dd, gg)
        geometry::main::dot(geometry::main::vec(aa, bb), geometry::main::vec(aa, cc)) = geometry::main::dot(geometry::main::vec(dd, ff), geometry::main::vec(dd, gg))
        =>:
            $geometry::main::are_angles_congruent(bb, aa, cc, ff, dd, gg)
    release thm geometry::main::distance_sq_positive_of_ne(aa, bb)
    release thm geometry::main::distance_sq_positive_of_ne(aa, cc)
    geometry::main::distance_sq(aa, bb) $in R+
    geometry::main::distance_sq(aa, cc) $in R+
    geometry::main::distance_sq(aa, bb) * geometry::main::distance_sq(aa, cc) $in R+
    geometry::main::angle_cos_den(bb, aa, cc) = geometry::main::distance_sq(aa, bb) * geometry::main::distance_sq(aa, cc) > 0
    geometry::main::angle_cos_den(ff, dd, gg) = geometry::main::distance_sq(dd, ff) * geometry::main::distance_sq(dd, gg) = geometry::main::distance_sq(aa, bb) * geometry::main::distance_sq(aa, cc) = geometry::main::angle_cos_den(bb, aa, cc) > 0
    geometry::main::angle_cos_num(bb, aa, cc) = geometry::main::dot(geometry::main::vec(aa, bb), geometry::main::vec(aa, cc)) = geometry::main::dot(geometry::main::vec(dd, ff), geometry::main::vec(dd, gg)) = geometry::main::angle_cos_num(ff, dd, gg)
    geometry::main::angle_cos_num(bb, aa, cc)^2 * geometry::main::angle_cos_den(ff, dd, gg) = geometry::main::angle_cos_num(ff, dd, gg)^2 * geometry::main::angle_cos_den(ff, dd, gg) = geometry::main::angle_cos_num(ff, dd, gg)^2 * geometry::main::angle_cos_den(bb, aa, cc)
    geometry::main::angle_cos_num(bb, aa, cc) * geometry::main::angle_cos_num(ff, dd, gg) = geometry::main::angle_cos_num(bb, aa, cc) * geometry::main::angle_cos_num(bb, aa, cc) = geometry::main::angle_cos_num(bb, aa, cc)^2 >= 0
    by def $geometry::main::are_angles_congruent(bb, aa, cc, ff, dd, gg)


thm five_vertex_function_exists:
    ? forall a,b,c,d,fifth cart(R,R):
        exist vertices fn(k Z) cart(R,R) st {vertices(0) = a, vertices(1) = b, vertices(2) = c, vertices(3) = d, vertices(4) = fifth, vertices(5) = a}
    have fn fourth_choice(k Z) cart(R,R) by cases:
        case k = 4: fifth
        case k != 4: a
    have fn third_choice(k Z) cart(R,R) by cases:
        case k = 3: d
        case k != 3: fourth_choice(k)
    have fn second_choice(k Z) cart(R,R) by cases:
        case k = 2: c
        case k != 2: third_choice(k)
    have fn vertices(k Z) cart(R,R) by cases:
        case k = 1: b
        case k != 1: second_choice(k)
    vertices(0) = second_choice(0) = third_choice(0) = fourth_choice(0) = a
    vertices(1) = b
    vertices(2) = second_choice(2) = c
    vertices(3) = second_choice(3) = third_choice(3) = d
    vertices(4) = second_choice(4) = third_choice(4) = fourth_choice(4) = fifth
    vertices(5) = second_choice(5) = third_choice(5) = fourth_choice(5) = a
    witness exist cycle fn(k Z) cart(R,R) st {cycle(0) = a, cycle(1) = b, cycle(2) = c, cycle(3) = d, cycle(4) = fifth, cycle(5) = a} from vertices


have fn scale_and_translate_point(p,center cart(R,R),scale R+) cart(R,R) = (center(1)+scale*p(1),center(2)+scale*p(2))


thm scale_and_translate_coordinate_differences:
    ? forall p,q,center cart(R,R), scale R+:
        scale_and_translate_point(p,center,scale)(1)-scale_and_translate_point(q,center,scale)(1) = scale*(p(1)-q(1))
        scale_and_translate_point(p,center,scale)(2)-scale_and_translate_point(q,center,scale)(2) = scale*(p(2)-q(2))
    scale_and_translate_point(p,center,scale)(1) = center(1)+scale*p(1)
    scale_and_translate_point(p,center,scale)(2) = center(2)+scale*p(2)
    scale_and_translate_point(q,center,scale)(1) = center(1)+scale*q(1)
    scale_and_translate_point(q,center,scale)(2) = center(2)+scale*q(2)
    scale_and_translate_point(p,center,scale)(1)-scale_and_translate_point(q,center,scale)(1) = (center(1)+scale*p(1))-(center(1)+scale*q(1)) = scale*(p(1)-q(1))
    scale_and_translate_point(p,center,scale)(2)-scale_and_translate_point(q,center,scale)(2) = (center(2)+scale*p(2))-(center(2)+scale*q(2)) = scale*(p(2)-q(2))


thm scale_and_translate_squared_distance:
    ? forall p,q,center cart(R,R), scale R+:
        geometry::main::distance_sq(scale_and_translate_point(p,center,scale),scale_and_translate_point(q,center,scale)) = scale^2*geometry::main::distance_sq(p,q)
    release thm scale_and_translate_coordinate_differences(q,p,center,scale)
    release thm similar_triangles_ratio(p,p,q,scale_and_translate_point(p,center,scale),scale_and_translate_point(p,center,scale),scale_and_translate_point(q,center,scale),scale)


thm scale_and_translate_signed_determinant:
    ? forall p,q,r,center cart(R,R), scale R+:
        geometry::main::det(geometry::main::vec(scale_and_translate_point(p,center,scale),scale_and_translate_point(q,center,scale)),geometry::main::vec(scale_and_translate_point(p,center,scale),scale_and_translate_point(r,center,scale))) = scale^2*geometry::main::det(geometry::main::vec(p,q),geometry::main::vec(p,r))
    have first cart(R,R) = scale_and_translate_point(p,center,scale)
    have second cart(R,R) = scale_and_translate_point(q,center,scale)
    have third cart(R,R) = scale_and_translate_point(r,center,scale)
    release thm scale_and_translate_coordinate_differences(q,p,center,scale)
    release thm scale_and_translate_coordinate_differences(r,p,center,scale)
    second(1)-first(1) = scale_and_translate_point(q,center,scale)(1)-scale_and_translate_point(p,center,scale)(1) = scale*(q(1)-p(1))
    second(2)-first(2) = scale_and_translate_point(q,center,scale)(2)-scale_and_translate_point(p,center,scale)(2) = scale*(q(2)-p(2))
    third(1)-first(1) = scale_and_translate_point(r,center,scale)(1)-scale_and_translate_point(p,center,scale)(1) = scale*(r(1)-p(1))
    third(2)-first(2) = scale_and_translate_point(r,center,scale)(2)-scale_and_translate_point(p,center,scale)(2) = scale*(r(2)-p(2))
    release thm similar_triangles_det(q,p,r,second,first,third,scale)
    release thm geometry::main::collinear_det_expand(p,q,r)
    release thm geometry::main::collinear_det_expand(first,second,third)
    geometry::main::det(geometry::main::vec(first,second),geometry::main::vec(first,third)) = (second(1)-first(1))*(third(2)-first(2))-(second(2)-first(2))*(third(1)-first(1)) = scale^2*((q(1)-p(1))*(r(2)-p(2))-(q(2)-p(2))*(r(1)-p(1))) = scale^2*geometry::main::det(geometry::main::vec(p,q),geometry::main::vec(p,r))


thm scale_and_translate_unit_circle_point:
    ? forall p,center cart(R,R), radius R+:
        p $in geometry::main::circle((0,0),1)
        =>:
            scale_and_translate_point(p,center,radius) $in geometry::main::circle(center,radius)
    have origin cart(R,R) = (0,0)
    origin(1) = 0
    origin(2) = 0
    geometry::main::circle(origin,1) = geometry::main::circle((0,0),1)
    p $in geometry::main::circle((0,0),1)
    p $in geometry::main::circle(origin,1)
    have image cart(R,R) = scale_and_translate_point(p,center,radius)
    image(1) = scale_and_translate_point(p,center,radius)(1) = center(1)+radius*p(1) = center(1)+(radius/1)*(p(1)-0) = center(1)+(radius/1)*(p(1)-origin(1))
    image(2) = scale_and_translate_point(p,center,radius)(2) = center(2)+radius*p(2) = center(2)+(radius/1)*(p(2)-0) = center(2)+(radius/1)*(p(2)-origin(2))
    release thm rescale_circle_point(origin,center,p,image,1,radius)


thm five_positive_side_vertices_give_simple_cycle:
    ? forall a,b,c,d,fifth cart(R,R), vertices fn(k Z) cart(R,R):
        vertices(0) = a
        vertices(1) = b
        vertices(2) = c
        vertices(3) = d
        vertices(4) = fifth
        vertices(5) = a
        geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c)) > 0
        geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d)) > 0
        geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,fifth)) > 0
        geometry::main::det(geometry::main::vec(b,c),geometry::main::vec(b,d)) > 0
        geometry::main::det(geometry::main::vec(b,c),geometry::main::vec(b,fifth)) > 0
        geometry::main::det(geometry::main::vec(b,c),geometry::main::vec(b,a)) > 0
        geometry::main::det(geometry::main::vec(c,d),geometry::main::vec(c,fifth)) > 0
        geometry::main::det(geometry::main::vec(c,d),geometry::main::vec(c,a)) > 0
        geometry::main::det(geometry::main::vec(c,d),geometry::main::vec(c,b)) > 0
        geometry::main::det(geometry::main::vec(d,fifth),geometry::main::vec(d,a)) > 0
        geometry::main::det(geometry::main::vec(d,fifth),geometry::main::vec(d,b)) > 0
        geometry::main::det(geometry::main::vec(d,fifth),geometry::main::vec(d,c)) > 0
        geometry::main::det(geometry::main::vec(fifth,a),geometry::main::vec(fifth,b)) > 0
        geometry::main::det(geometry::main::vec(fifth,a),geometry::main::vec(fifth,c)) > 0
        geometry::main::det(geometry::main::vec(fifth,a),geometry::main::vec(fifth,d)) > 0
        =>:
            $entry::is_simple_polygonal_cycle(5,vertices)
    by def $geometry::main::is_triangle(a,b,c)
    release thm geometry_lemmas::triangle_vertices_distinct(a,b,c)
    release thm working::proper_triangle_consecutive_segments_common_endpoint(a,b,c)
    by def $geometry::main::is_triangle(b,c,d)
    release thm geometry_lemmas::triangle_vertices_distinct(b,c,d)
    release thm working::proper_triangle_consecutive_segments_common_endpoint(b,c,d)
    by def $geometry::main::is_triangle(c,d,fifth)
    release thm geometry_lemmas::triangle_vertices_distinct(c,d,fifth)
    release thm working::proper_triangle_consecutive_segments_common_endpoint(c,d,fifth)
    by def $geometry::main::is_triangle(d,fifth,a)
    release thm geometry_lemmas::triangle_vertices_distinct(d,fifth,a)
    release thm working::proper_triangle_consecutive_segments_common_endpoint(d,fifth,a)
    by def $geometry::main::is_triangle(fifth,a,b)
    release thm geometry_lemmas::triangle_vertices_distinct(fifth,a,b)
    release thm working::proper_triangle_consecutive_segments_common_endpoint(fifth,a,b)
    release thm working::common_endpoint_condition_symmetric(fifth,a,a,b)
    a != b
    c != d
    release thm strict_half_plane_segments_have_no_extra_intersection(a,b,c,d)
    a != b
    d != fifth
    release thm strict_half_plane_segments_have_no_extra_intersection(a,b,d,fifth)
    b != c
    d != fifth
    release thm strict_half_plane_segments_have_no_extra_intersection(b,c,d,fifth)
    b != c
    fifth != a
    release thm strict_half_plane_segments_have_no_extra_intersection(b,c,fifth,a)
    c != d
    fifth != a
    release thm strict_half_plane_segments_have_no_extra_intersection(c,d,fifth,a)
    vertices(5) = a = vertices(0)
    vertices(0) != vertices(1)
    $entry::segments_meet_only_at_common_endpoints(vertices(0),vertices(1),vertices(1),vertices(2))
    vertices(0) != vertices(2)
    $entry::segments_meet_only_at_common_endpoints(vertices(0),vertices(1),vertices(2),vertices(3))
    vertices(0) != vertices(3)
    $entry::segments_meet_only_at_common_endpoints(vertices(0),vertices(1),vertices(3),vertices(4))
    vertices(0) != vertices(4)
    $entry::segments_meet_only_at_common_endpoints(vertices(0),vertices(1),vertices(4),vertices(5))
    vertices(1) != vertices(2)
    $entry::segments_meet_only_at_common_endpoints(vertices(1),vertices(2),vertices(2),vertices(3))
    vertices(1) != vertices(3)
    $entry::segments_meet_only_at_common_endpoints(vertices(1),vertices(2),vertices(3),vertices(4))
    vertices(1) != vertices(4)
    $entry::segments_meet_only_at_common_endpoints(vertices(1),vertices(2),vertices(4),vertices(5))
    vertices(2) != vertices(3)
    $entry::segments_meet_only_at_common_endpoints(vertices(2),vertices(3),vertices(3),vertices(4))
    vertices(2) != vertices(4)
    $entry::segments_meet_only_at_common_endpoints(vertices(2),vertices(3),vertices(4),vertices(5))
    vertices(3) != vertices(4)
    $entry::segments_meet_only_at_common_endpoints(vertices(3),vertices(4),vertices(4),vertices(5))
    release thm five_vertex_conditions_give_simple_cycle(vertices)


thm book04_proposition_11:
    ? forall center cart(R,R), radius R+:
        exist vertices fn(k Z) cart(R,R), side_sq R+ st {$working::polygon_inscribed_in_circle(5,vertices,center,radius), geometry::main::distance_sq(vertices(0),vertices(1)) = side_sq, geometry::main::distance_sq(vertices(1),vertices(2)) = side_sq, geometry::main::distance_sq(vertices(2),vertices(3)) = side_sq, geometry::main::distance_sq(vertices(3),vertices(4)) = side_sq, geometry::main::distance_sq(vertices(4),vertices(0)) = side_sq, $geometry::main::are_angles_congruent(vertices(4),vertices(0),vertices(1),vertices(0),vertices(1),vertices(2)), $geometry::main::are_angles_congruent(vertices(4),vertices(0),vertices(1),vertices(1),vertices(2),vertices(3)), $geometry::main::are_angles_congruent(vertices(4),vertices(0),vertices(1),vertices(2),vertices(3),vertices(4)), $geometry::main::are_angles_congruent(vertices(4),vertices(0),vertices(1),vertices(3),vertices(4),vertices(0)), geometry::main::det(geometry::main::vec(vertices(0),vertices(1)),geometry::main::vec(vertices(0),vertices(2))) > 0, geometry::main::det(geometry::main::vec(vertices(0),vertices(1)),geometry::main::vec(vertices(0),vertices(3))) > 0, geometry::main::det(geometry::main::vec(vertices(0),vertices(1)),geometry::main::vec(vertices(0),vertices(4))) > 0, geometry::main::det(geometry::main::vec(vertices(1),vertices(2)),geometry::main::vec(vertices(1),vertices(3))) > 0, geometry::main::det(geometry::main::vec(vertices(1),vertices(2)),geometry::main::vec(vertices(1),vertices(4))) > 0, geometry::main::det(geometry::main::vec(vertices(1),vertices(2)),geometry::main::vec(vertices(1),vertices(0))) > 0, geometry::main::det(geometry::main::vec(vertices(2),vertices(3)),geometry::main::vec(vertices(2),vertices(4))) > 0, geometry::main::det(geometry::main::vec(vertices(2),vertices(3)),geometry::main::vec(vertices(2),vertices(0))) > 0, geometry::main::det(geometry::main::vec(vertices(2),vertices(3)),geometry::main::vec(vertices(2),vertices(1))) > 0, geometry::main::det(geometry::main::vec(vertices(3),vertices(4)),geometry::main::vec(vertices(3),vertices(0))) > 0, geometry::main::det(geometry::main::vec(vertices(3),vertices(4)),geometry::main::vec(vertices(3),vertices(1))) > 0, geometry::main::det(geometry::main::vec(vertices(3),vertices(4)),geometry::main::vec(vertices(3),vertices(2))) > 0, geometry::main::det(geometry::main::vec(vertices(4),vertices(0)),geometry::main::vec(vertices(4),vertices(1))) > 0, geometry::main::det(geometry::main::vec(vertices(4),vertices(0)),geometry::main::vec(vertices(4),vertices(2))) > 0, geometry::main::det(geometry::main::vec(vertices(4),vertices(0)),geometry::main::vec(vertices(4),vertices(3))) > 0}
    release thm golden_cut_parameter_exists
    obtain t from exist t R+ st {t < 1, t^2 = 1-t}
    release thm golden_triangle_positive_height(t)
    obtain h from exist h R+ st {h^2 = 1-((1+t)/2)^2}
    (1+t)^2 = 1+2*t+t^2 = 1+2*t+(1-t) = 2+t
    h^2 = 1-((1+t)/2)^2 = 1-(1+t)^2/4 = 1-(2+t)/4 = (2-t)/4
    2-t > 2-1 = 1 > 0
    3+t > 0
    radius^2 > 0
    radius^2*(2-t) > 0
    radius^2*(3+t) > 0
    have side_sq R+ = radius^2*(2-t)
    have diagonal_sq R+ = radius^2*(3+t)
    have a cart(R,R) = (0,1)
    have b cart(R,R) = (-(1+t)*h,t/2)
    have c cart(R,R) = (-h,-(1+t)/2)
    have d cart(R,R) = (h,-(1+t)/2)
    have fifth cart(R,R) = ((1+t)*h,t/2)
    release thm golden_pentagon_metric_certificate(t,h,a,b,c,d,fifth)
    release thm golden_pentagon_strict_side_orientation(t,h,a,b,c,d,fifth)
    have first_vertex cart(R,R) = scale_and_translate_point(a,center,radius)
