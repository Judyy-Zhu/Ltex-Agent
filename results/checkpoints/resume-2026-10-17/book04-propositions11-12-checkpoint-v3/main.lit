thm similar_triangles_ratio:
    ? forall p, q, r, u, v, w cart(R, R), k R:
        u(1) - v(1) = k * (p(1) - q(1))
        u(2) - v(2) = k * (p(2) - q(2))
        w(1) - v(1) = k * (r(1) - q(1))
        w(2) - v(2) = k * (r(2) - q(2))
        =>:
            geometry::main::distance_sq(u, w) = k^2 * geometry::main::distance_sq(p, r)
    release thm geometry::main::distance_sq_coordinate_formula(u, w)
    release thm geometry::main::distance_sq_coordinate_formula(p, r)
    w(1) - u(1) = (w(1) - v(1)) - (u(1) - v(1))
    (w(1) - v(1)) - (u(1) - v(1)) = k * (r(1) - q(1)) - k * (p(1) - q(1))
    k * (r(1) - q(1)) - k * (p(1) - q(1)) = k * (r(1) - p(1))
    w(1) - u(1) = k * (r(1) - p(1))
    w(2) - u(2) = (w(2) - v(2)) - (u(2) - v(2))
    (w(2) - v(2)) - (u(2) - v(2)) = k * (r(2) - q(2)) - k * (p(2) - q(2))
    k * (r(2) - q(2)) - k * (p(2) - q(2)) = k * (r(2) - p(2))
    w(2) - u(2) = k * (r(2) - p(2))
    (w(1) - u(1))^2 = (k * (r(1) - p(1)))^2 = k^2 * (r(1) - p(1))^2
    (w(2) - u(2))^2 = (k * (r(2) - p(2)))^2 = k^2 * (r(2) - p(2))^2
    (w(1) - u(1))^2 + (w(2) - u(2))^2 = k^2 * (r(1) - p(1))^2 + k^2 * (r(2) - p(2))^2
    k^2 * (r(1) - p(1))^2 + k^2 * (r(2) - p(2))^2 = k^2 * ((r(1) - p(1))^2 + (r(2) - p(2))^2)
    geometry::main::distance_sq(u, w) = (w(1) - u(1))^2 + (w(2) - u(2))^2 = k^2 * ((r(1) - p(1))^2 + (r(2) - p(2))^2) = k^2 * geometry::main::distance_sq(p, r)


thm similar_triangles_det:
    ? forall p, q, r, u, v, w cart(R, R), k R:
        u(1) - v(1) = k * (p(1) - q(1))
        u(2) - v(2) = k * (p(2) - q(2))
        w(1) - v(1) = k * (r(1) - q(1))
        w(2) - v(2) = k * (r(2) - q(2))
        =>:
            (u(1) - v(1)) * (w(2) - v(2)) - (u(2) - v(2)) * (w(1) - v(1)) = k^2 * ((p(1) - q(1)) * (r(2) - q(2)) - (p(2) - q(2)) * (r(1) - q(1)))
    release thm geometry::main::vec_coordinate_formula(v, u)
    release thm geometry::main::vec_coordinate_formula(v, w)
    release thm geometry::main::vec_coordinate_formula(q, p)
    release thm geometry::main::vec_coordinate_formula(q, r)
    release thm geometry::main::det_coordinate_formula(geometry::main::vec(v, u), geometry::main::vec(v, w))
    release thm geometry::main::det_coordinate_formula(geometry::main::vec(q, p), geometry::main::vec(q, r))
    (u(1) - v(1)) * (w(2) - v(2)) = (k * (p(1) - q(1))) * (k * (r(2) - q(2)))
    (k * (p(1) - q(1))) * (k * (r(2) - q(2))) = k^2 * ((p(1) - q(1)) * (r(2) - q(2)))
    (u(1) - v(1)) * (w(2) - v(2)) = k^2 * ((p(1) - q(1)) * (r(2) - q(2)))
    (u(2) - v(2)) * (w(1) - v(1)) = (k * (p(2) - q(2))) * (k * (r(1) - q(1)))
    (k * (p(2) - q(2))) * (k * (r(1) - q(1))) = k^2 * ((p(2) - q(2)) * (r(1) - q(1)))
    (u(2) - v(2)) * (w(1) - v(1)) = k^2 * ((p(2) - q(2)) * (r(1) - q(1)))
    (u(1) - v(1)) * (w(2) - v(2)) - (u(2) - v(2)) * (w(1) - v(1)) = k^2 * ((p(1) - q(1)) * (r(2) - q(2))) - k^2 * ((p(2) - q(2)) * (r(1) - q(1)))
    k^2 * ((p(1) - q(1)) * (r(2) - q(2))) - k^2 * ((p(2) - q(2)) * (r(1) - q(1))) = k^2 * ((p(1) - q(1)) * (r(2) - q(2)) - (p(2) - q(2)) * (r(1) - q(1)))
    geometry::main::det(geometry::main::vec(v, u), geometry::main::vec(v, w)) = (u(1) - v(1)) * (w(2) - v(2)) - (u(2) - v(2)) * (w(1) - v(1))
    geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, r)) = (p(1) - q(1)) * (r(2) - q(2)) - (p(2) - q(2)) * (r(1) - q(1))
    k^2 * ((p(1) - q(1)) * (r(2) - q(2)) - (p(2) - q(2)) * (r(1) - q(1))) = k^2 * geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, r))
    geometry::main::det(geometry::main::vec(v, u), geometry::main::vec(v, w)) = k^2 * geometry::main::det(geometry::main::vec(q, p), geometry::main::vec(q, r))


# A positive similarity sends a circumference point to the prescribed circle.
thm rescale_circle_point:
    ? forall source,target,p,image cart(R,R), old_radius,new_radius R+:
        p $in geometry::main::circle(source,old_radius)
        image(1) = target(1)+(new_radius/old_radius)*(p(1)-source(1))
        image(2) = target(2)+(new_radius/old_radius)*(p(2)-source(2))
        =>:
            image $in geometry::main::circle(target,new_radius)
    geometry::main::circle(source,old_radius) = {q cart(R,R): geometry::main::distance_sq(source,q) = old_radius*old_radius}
    p $in geometry::main::circle(source,old_radius)
    p $in {q cart(R,R): geometry::main::distance_sq(source,q) = old_radius*old_radius}
    release thm set_builder_member(p,{q cart(R,R): geometry::main::distance_sq(source,q) = old_radius*old_radius})
    have k R+ = new_radius/old_radius
    image(1) = target(1)+(new_radius/old_radius)*(p(1)-source(1)) = target(1)+k*(p(1)-source(1))
    image(1)-target(1) = (target(1)+k*(p(1)-source(1)))-target(1) = k*(p(1)-source(1))
    image(2) = target(2)+(new_radius/old_radius)*(p(2)-source(2)) = target(2)+k*(p(2)-source(2))
    image(2)-target(2) = (target(2)+k*(p(2)-source(2)))-target(2) = k*(p(2)-source(2))
    release thm similar_triangles_ratio(p,source,source,image,target,target,k)
    release thm geometry::main::distance_sq_symmetric(p,source)
    release thm geometry::main::distance_sq_symmetric(image,target)
    geometry::main::distance_sq(source,p) = old_radius*old_radius
    geometry::main::distance_sq(target,image) = geometry::main::distance_sq(image,target) = k^2*geometry::main::distance_sq(p,source) = k^2*geometry::main::distance_sq(source,p) = k^2*(old_radius*old_radius) = (new_radius/old_radius)^2*old_radius^2 = new_radius^2 = new_radius*new_radius
    geometry::main::circle(target,new_radius) = {q cart(R,R): geometry::main::distance_sq(target,q) = new_radius*new_radius}
    image $in geometry::main::circle(target,new_radius)


release obj def geometry::main::line_through_points


prop is_tangent_line_at(contact, a, b, o cart(R, R), radius R+):
    a != b
    contact $in geometry::main::line_through_points(a, b)
    contact $in geometry::main::circle(o, radius)
    forall p cart(R, R):
        p $in geometry::main::line_through_points(a, b)
        =>:
            geometry::main::distance_sq(o, p) >= radius^2


prop is_on_circle(p, o cart(R, R), r R+):
    geometry::main::distance_sq(o, p) = r * r


thm point_difference_norm_pos:
    ? forall a, b cart(R, R):
        a != b
        =>:
            (b(1) - a(1))^2 + (b(2) - a(2))^2 > 0
    (b(1) - a(1))^2 >= 0
    (b(2) - a(2))^2 >= 0
    (b(1) - a(1))^2 + (b(2) - a(2))^2 >= 0
    by contra:
        ? (b(1) - a(1))^2 + (b(2) - a(2))^2 > 0
        (b(1) - a(1))^2 + (b(2) - a(2))^2 <= 0
        (b(1) - a(1))^2 + (b(2) - a(2))^2 = 0
        (b(1) - a(1))^2 <= (b(1) - a(1))^2 + (b(2) - a(2))^2
        (b(1) - a(1))^2 <= 0
        (b(1) - a(1))^2 = 0
        (b(2) - a(2))^2 <= (b(1) - a(1))^2 + (b(2) - a(2))^2
        (b(2) - a(2))^2 <= 0
        (b(2) - a(2))^2 = 0
        b(1) - a(1) = 0
        b(2) - a(2) = 0
        b(1) = a(1)
        b(2) = a(2)
        release thm tuple_equal_from_coordinates(a, (a(1), a(2)))
        release thm tuple_equal_from_coordinates(b, (b(1), b(2)))
        a = (a(1), a(2)) = (b(1), b(2)) = b
        impossible a != b


thm radial_perpendicular_distance_identity:
    ? forall o, a, q cart(R, R), radius R+:
        $is_on_circle(a, o, radius)
        geometry::main::dot(geometry::main::vec(o, a), geometry::main::vec(a, q)) = 0
        =>:
            geometry::main::distance_sq(o, q) = radius^2+geometry::main::distance_sq(a, q)
    by def $is_on_circle(a, o, radius)
    release thm geometry::main::perpendicular_dot_expand(o, a, a, q)
    (a(1)-o(1))*(q(1)-a(1))+(a(2)-o(2))*(q(2)-a(2)) = 0
    release thm geometry::main::distance_sq_coordinate_formula(o, q)
    release thm geometry::main::distance_sq_coordinate_formula(o, a)
    release thm geometry::main::distance_sq_coordinate_formula(a, q)
    geometry::main::distance_sq(o, q) = (q(1)-o(1))^2+(q(2)-o(2))^2 = ((a(1)-o(1))+(q(1)-a(1)))^2+((a(2)-o(2))+(q(2)-a(2)))^2 = ((a(1)-o(1))^2+(a(2)-o(2))^2)+((q(1)-a(1))^2+(q(2)-a(2))^2)+2*((a(1)-o(1))*(q(1)-a(1))+(a(2)-o(2))*(q(2)-a(2))) = geometry::main::distance_sq(o, a)+geometry::main::distance_sq(a, q)+2*0 = geometry::main::distance_sq(o, a)+geometry::main::distance_sq(a, q) = radius*radius+geometry::main::distance_sq(a, q) = radius^2+geometry::main::distance_sq(a, q)


# A radius perpendicular to a line at its circumference point certifies tangency.
# The contact can lie anywhere on the line, not just at a named endpoint.
thm radius_perpendicular_at_line_point_gives_tangency:
    ? forall o,contact,a,b cart(R,R), radius R+:
        a != b
        contact $in geometry::main::line_through_points(a,b)
        $is_on_circle(contact,o,radius)
        geometry::main::dot(geometry::main::vec(o,contact),geometry::main::vec(a,b)) = 0
        =>:
            $is_tangent_line_at(contact,a,b,o,radius)
    by def $is_on_circle(contact,o,radius)
    geometry::main::circle(o,radius) = {p cart(R,R): geometry::main::distance_sq(o,p) = radius*radius}
    contact $in geometry::main::circle(o,radius)
    claim:
        ? forall q cart(R,R):
            q $in geometry::main::line_through_points(a,b)
            =>:
                geometry::main::distance_sq(o,q) >= radius^2
        geometry::main::line_through_points(a,b) = {p cart(R,R): geometry::main::det(geometry::main::vec(a,p),geometry::main::vec(a,b)) = 0}
        q $in geometry::main::line_through_points(a,b)
        contact $in geometry::main::line_through_points(a,b)
        q $in {p cart(R,R): geometry::main::det(geometry::main::vec(a,p),geometry::main::vec(a,b)) = 0}
        contact $in {p cart(R,R): geometry::main::det(geometry::main::vec(a,p),geometry::main::vec(a,b)) = 0}
        release thm set_builder_member(q,{p cart(R,R): geometry::main::det(geometry::main::vec(a,p),geometry::main::vec(a,b)) = 0})
        release thm set_builder_member(contact,{p cart(R,R): geometry::main::det(geometry::main::vec(a,p),geometry::main::vec(a,b)) = 0})
        release thm geometry::main::collinear_det_expand(a,q,b)
        release thm geometry::main::collinear_det_expand(a,contact,b)
        have ux R = contact(1)-o(1)
        have uy R = contact(2)-o(2)
        have vx R = b(1)-a(1)
        have vy R = b(2)-a(2)
        have wx R = q(1)-contact(1)
        have wy R = q(2)-contact(2)
        (q(1)-a(1))*vy-(q(2)-a(2))*vx = geometry::main::det(geometry::main::vec(a,q),geometry::main::vec(a,b)) = 0
        (contact(1)-a(1))*vy-(contact(2)-a(2))*vx = geometry::main::det(geometry::main::vec(a,contact),geometry::main::vec(a,b)) = 0
        wx = q(1)-contact(1) = (q(1)-a(1))-(contact(1)-a(1))
        wy = q(2)-contact(2) = (q(2)-a(2))-(contact(2)-a(2))
        wx*vy-wy*vx = (q(1)-contact(1))*vy-(q(2)-contact(2))*vx = ((q(1)-a(1))*vy-(q(2)-a(2))*vx)-((contact(1)-a(1))*vy-(contact(2)-a(2))*vx) = 0-0 = 0
        vx*wy-vy*wx = -(wx*vy-wy*vx) = 0
        release thm geometry::main::perpendicular_dot_expand(o,contact,a,b)
        ux*vx+uy*vy = (contact(1)-o(1))*(b(1)-a(1))+(contact(2)-o(2))*(b(2)-a(2)) = geometry::main::dot(geometry::main::vec(o,contact),geometry::main::vec(a,b)) = 0
        release thm point_difference_norm_pos(a,b)
        vx^2+vy^2 = (b(1)-a(1))^2+(b(2)-a(2))^2 > 0
        (vx^2+vy^2)*(ux*wx+uy*wy) = (ux*vx+uy*vy)*(vx*wx+vy*wy)+(vx*uy-vy*ux)*(vx*wy-vy*wx) = 0*(vx*wx+vy*wy)+(vx*uy-vy*ux)*0 = 0
        ux*wx+uy*wy = ((vx^2+vy^2)*(ux*wx+uy*wy))/(vx^2+vy^2) = 0/(vx^2+vy^2) = 0
        release thm geometry::main::perpendicular_dot_expand(o,contact,contact,q)
        geometry::main::dot(geometry::main::vec(o,contact),geometry::main::vec(contact,q)) = (contact(1)-o(1))*(q(1)-contact(1))+(contact(2)-o(2))*(q(2)-contact(2)) = ux*wx+uy*wy = 0
        release thm radial_perpendicular_distance_identity(o,contact,q,radius)
        release thm geometry::main::distance_sq_nonnegative(contact,q)
        geometry::main::distance_sq(o,q) = radius^2+geometry::main::distance_sq(contact,q) >= radius^2
    by def $is_tangent_line_at(contact,a,b,o,radius)


claim:
    ? forall a,b cart(R,R):
        geometry::main::distance_sq(a,b) >= 0
    release thm geometry::main::distance_sq_nonnegative(a,b)


thm golden_triangle_positive_height:
    ? forall t R+:
        t < 1
        =>:
            exist height R+ st {height^2 = 1-((1+t)/2)^2}
    have u R = (1+t)/2
    0 < (1+t)/2
    1+t < 1+1 = 2
    (1+t)/2 < 2/2 = 1
    0 < u < 1
    1-u > 0
    1+u > 0
    (1-u)*(1+u) > 0
    1-u^2 = (1-u)*(1+u) > 0
    have height_sq R+ = 1-u^2
    have height R+ = sqrt(height_sq)
    height^2 = (sqrt(height_sq))^2 = height_sq = 1-u^2 = 1-((1+t)/2)^2
    witness exist h R+ st {h^2 = 1-((1+t)/2)^2} from height


thm golden_cut_parameter_exists:
    ? exist t R+ st {t < 1, t^2 = 1-t}
    have root R+ = sqrt(5)
    root^2 = sqrt(5)^2 = 5
    by contra:
        ? root > 1
        root <= 1
        1-root >= 0
        1+root > 0
        (1-root)*(1+root) >= 0
        (1-root)*(1+root) = 1-root^2 = -4
        impossible (1-root)*(1+root) >= 0
    by contra:
        ? root < 3
        root >= 3
        root-3 >= 0
        root+3 > 0
        (root-3)*(root+3) >= 0
        (root-3)*(root+3) = root^2-9 = -4
        impossible (root-3)*(root+3) >= 0
    root-1 > 0
    have t R+ = (root-1)/2
    root-1 < 3-1 = 2
    (root-1)/2 < 2/2 = 1
    t = (root-1)/2 < 1
    t^2 = ((root-1)/2)^2 = (root^2-2*root+1)/4 = (5-2*root+1)/4 = 1-(root-1)/2 = 1-t
    witness exist k R+ st {k < 1, k^2 = 1-k} from t


thm golden_pentagon_scalar_metrics:
    ? forall t,h R+:
        t < 1
        t^2 = 1-t
        h^2 = (2-t)/4
        =>:
            ((1+t)*h)^2+(t/2)^2 = 1
            h^2+((1+t)/2)^2 = 1
            ((1+t)*h)^2+(t/2-1)^2 = 2-t
            ((1+t)*h-h)^2+(t/2+(1+t)/2)^2 = 2-t
            4*h^2 = 2-t
            h^2+(1+(1+t)/2)^2 = 3+t
            4*((1+t)*h)^2 = 3+t
            ((1+t)*h+h)^2+(t/2+(1+t)/2)^2 = 3+t
    (1+t)^2 = 1+2*t+t^2 = 1+2*t+(1-t) = 2+t
    ((1+t)*h)^2 = (1+t)^2*h^2 = (2+t)*((2-t)/4) = (4-t^2)/4 = (4-(1-t))/4 = (3+t)/4
    (t/2)^2 = t^2/4 = (1-t)/4
    ((1+t)/2)^2 = (1+t)^2/4 = (2+t)/4
    ((1+t)*h)^2+(t/2)^2 = (3+t)/4+(1-t)/4 = 1
    h^2+((1+t)/2)^2 = (2-t)/4+(2+t)/4 = 1
    (t/2-1)^2 = (t^2-4*t+4)/4 = ((1-t)-4*t+4)/4 = (5-5*t)/4
    ((1+t)*h)^2+(t/2-1)^2 = (3+t)/4+(5-5*t)/4 = 2-t
    ((1+t)*h-h)^2 = (t*h)^2 = t^2*h^2 = (1-t)*((2-t)/4) = (2-3*t+t^2)/4 = (2-3*t+(1-t))/4 = (3-4*t)/4
    (t/2+(1+t)/2)^2 = ((1+2*t)/2)^2 = (1+4*t+4*t^2)/4 = (1+4*t+4*(1-t))/4 = 5/4
    ((1+t)*h-h)^2+(t/2+(1+t)/2)^2 = (3-4*t)/4+5/4 = 2-t
    4*h^2 = 4*((2-t)/4) = 2-t
    (1+(1+t)/2)^2 = ((3+t)/2)^2 = (9+6*t+t^2)/4 = (9+6*t+(1-t))/4 = (10+5*t)/4
    h^2+(1+(1+t)/2)^2 = (2-t)/4+(10+5*t)/4 = 3+t
    4*((1+t)*h)^2 = 4*((3+t)/4) = 3+t
    (2+t)^2 = 4+4*t+t^2 = 4+4*t+(1-t) = 5+3*t
    ((1+t)*h+h)^2 = ((2+t)*h)^2 = (2+t)^2*h^2 = (5+3*t)*((2-t)/4) = (10+t-3*t^2)/4 = (10+t-3*(1-t))/4 = (7+4*t)/4
    ((1+t)*h+h)^2+(t/2+(1+t)/2)^2 = (7+4*t)/4+5/4 = 3+t


thm golden_pentagon_strict_side_orientation:
    ? forall t,h R+, a,b,c,d,fifth cart(R,R):
        t < 1
        t^2 = 1-t
        a = (0,1)
        b = (-(1+t)*h,t/2)
        c = (-h,-(1+t)/2)
        d = (h,-(1+t)/2)
        fifth = ((1+t)*h,t/2)
        =>:
            geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c)) > 0
            geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d)) > 0
            geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,fifth)) > 0
            geometry::main::det(geometry::main::vec(b,c),geometry::main::vec(b,d)) > 0
            geometry::main::det(geometry::main::vec(b,c),geometry::main::vec(b,fifth)) > 0
            geometry::main::det(geometry::main::vec(b,c),geometry::main::vec(b,a)) > 0
            geometry::main::det(geometry::main::vec(c,d),geometry::main::vec(c,fifth)) > 0
            geometry::main::det(geometry::main::vec(c,d),geometry::main::vec(c,a)) > 0
            geometry::main::det(geometry::main::vec(c,d),geometry::main::vec(c,b)) > 0
            geometry::main::det(geometry::main::vec(d,fifth),geometry::main::vec(d,a)) > 0
            geometry::main::det(geometry::main::vec(d,fifth),geometry::main::vec(d,b)) > 0
            geometry::main::det(geometry::main::vec(d,fifth),geometry::main::vec(d,c)) > 0
            geometry::main::det(geometry::main::vec(fifth,a),geometry::main::vec(fifth,b)) > 0
            geometry::main::det(geometry::main::vec(fifth,a),geometry::main::vec(fifth,c)) > 0
            geometry::main::det(geometry::main::vec(fifth,a),geometry::main::vec(fifth,d)) > 0
    a(1) = 0
    a(2) = 1
    b(1) = -(1+t)*h
    b(2) = t/2
    c(1) = -h
    c(2) = -(1+t)/2
    d(1) = h
    d(2) = -(1+t)/2
    fifth(1) = (1+t)*h
    fifth(2) = t/2
    1+2*t > 0
    3+t > 0
    h*(1+2*t) > 0
    h*(3+t) > 0
    release thm geometry::main::collinear_det_expand(a,b,c)
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c)) = (b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1)) = ((-(1+t)*h)-(0))*((-(1+t)/2)-(1))-((t/2)-(1))*((-h)-(0)) = h*(((1/2))+((5/2))*t+((1/2))*t^2) = h*(((1/2))+((5/2))*t+((1/2))*(1-t)) = h*(1+2*t) > 0
    release thm geometry::main::collinear_det_expand(a,b,d)
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d)) = (b(1)-a(1))*(d(2)-a(2))-(b(2)-a(2))*(d(1)-a(1)) = ((-(1+t)*h)-(0))*((-(1+t)/2)-(1))-((t/2)-(1))*((h)-(0)) = h*(((5/2))+((3/2))*t+((1/2))*t^2) = h*(((5/2))+((3/2))*t+((1/2))*(1-t)) = h*(3+t) > 0
    release thm geometry::main::collinear_det_expand(a,b,fifth)
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,fifth)) = (b(1)-a(1))*(fifth(2)-a(2))-(b(2)-a(2))*(fifth(1)-a(1)) = ((-(1+t)*h)-(0))*((t/2)-(1))-((t/2)-(1))*(((1+t)*h)-(0)) = h*((2)+(1)*t+(-1)*t^2) = h*((2)+(1)*t+(-1)*(1-t)) = h*(1+2*t) > 0
    release thm geometry::main::collinear_det_expand(b,c,d)
    geometry::main::det(geometry::main::vec(b,c),geometry::main::vec(b,d)) = (c(1)-b(1))*(d(2)-b(2))-(c(2)-b(2))*(d(1)-b(1)) = ((-h)-(-(1+t)*h))*((-(1+t)/2)-(t/2))-((-(1+t)/2)-(t/2))*((h)-(-(1+t)*h)) = h*((1)+(2)*t+(0)*t^2) = h*((1)+(2)*t+(0)*(1-t)) = h*(1+2*t) > 0
    release thm geometry::main::collinear_det_expand(b,c,fifth)
    geometry::main::det(geometry::main::vec(b,c),geometry::main::vec(b,fifth)) = (c(1)-b(1))*(fifth(2)-b(2))-(c(2)-b(2))*(fifth(1)-b(1)) = ((-h)-(-(1+t)*h))*((t/2)-(t/2))-((-(1+t)/2)-(t/2))*(((1+t)*h)-(-(1+t)*h)) = h*((1)+(3)*t+(2)*t^2) = h*((1)+(3)*t+(2)*(1-t)) = h*(3+t) > 0
    release thm geometry::main::collinear_det_expand(b,c,a)
    geometry::main::det(geometry::main::vec(b,c),geometry::main::vec(b,a)) = (c(1)-b(1))*(a(2)-b(2))-(c(2)-b(2))*(a(1)-b(1)) = ((-h)-(-(1+t)*h))*((1)-(t/2))-((-(1+t)/2)-(t/2))*((0)-(-(1+t)*h)) = h*(((1/2))+((5/2))*t+((1/2))*t^2) = h*(((1/2))+((5/2))*t+((1/2))*(1-t)) = h*(1+2*t) > 0
    release thm geometry::main::collinear_det_expand(c,d,fifth)
    geometry::main::det(geometry::main::vec(c,d),geometry::main::vec(c,fifth)) = (d(1)-c(1))*(fifth(2)-c(2))-(d(2)-c(2))*(fifth(1)-c(1)) = ((h)-(-h))*((t/2)-(-(1+t)/2))-((-(1+t)/2)-(-(1+t)/2))*(((1+t)*h)-(-h)) = h*((1)+(2)*t+(0)*t^2) = h*((1)+(2)*t+(0)*(1-t)) = h*(1+2*t) > 0
    release thm geometry::main::collinear_det_expand(c,d,a)
    geometry::main::det(geometry::main::vec(c,d),geometry::main::vec(c,a)) = (d(1)-c(1))*(a(2)-c(2))-(d(2)-c(2))*(a(1)-c(1)) = ((h)-(-h))*((1)-(-(1+t)/2))-((-(1+t)/2)-(-(1+t)/2))*((0)-(-h)) = h*((3)+(1)*t+(0)*t^2) = h*((3)+(1)*t+(0)*(1-t)) = h*(3+t) > 0
    release thm geometry::main::collinear_det_expand(c,d,b)
    geometry::main::det(geometry::main::vec(c,d),geometry::main::vec(c,b)) = (d(1)-c(1))*(b(2)-c(2))-(d(2)-c(2))*(b(1)-c(1)) = ((h)-(-h))*((t/2)-(-(1+t)/2))-((-(1+t)/2)-(-(1+t)/2))*((-(1+t)*h)-(-h)) = h*((1)+(2)*t+(0)*t^2) = h*((1)+(2)*t+(0)*(1-t)) = h*(1+2*t) > 0
    release thm geometry::main::collinear_det_expand(d,fifth,a)
    geometry::main::det(geometry::main::vec(d,fifth),geometry::main::vec(d,a)) = (fifth(1)-d(1))*(a(2)-d(2))-(fifth(2)-d(2))*(a(1)-d(1)) = (((1+t)*h)-(h))*((1)-(-(1+t)/2))-((t/2)-(-(1+t)/2))*((0)-(h)) = h*(((1/2))+((5/2))*t+((1/2))*t^2) = h*(((1/2))+((5/2))*t+((1/2))*(1-t)) = h*(1+2*t) > 0
    release thm geometry::main::collinear_det_expand(d,fifth,b)
    geometry::main::det(geometry::main::vec(d,fifth),geometry::main::vec(d,b)) = (fifth(1)-d(1))*(b(2)-d(2))-(fifth(2)-d(2))*(b(1)-d(1)) = (((1+t)*h)-(h))*((t/2)-(-(1+t)/2))-((t/2)-(-(1+t)/2))*((-(1+t)*h)-(h)) = h*((1)+(3)*t+(2)*t^2) = h*((1)+(3)*t+(2)*(1-t)) = h*(3+t) > 0
    release thm geometry::main::collinear_det_expand(d,fifth,c)
    geometry::main::det(geometry::main::vec(d,fifth),geometry::main::vec(d,c)) = (fifth(1)-d(1))*(c(2)-d(2))-(fifth(2)-d(2))*(c(1)-d(1)) = (((1+t)*h)-(h))*((-(1+t)/2)-(-(1+t)/2))-((t/2)-(-(1+t)/2))*((-h)-(h)) = h*((1)+(2)*t+(0)*t^2) = h*((1)+(2)*t+(0)*(1-t)) = h*(1+2*t) > 0
    release thm geometry::main::collinear_det_expand(fifth,a,b)
    geometry::main::det(geometry::main::vec(fifth,a),geometry::main::vec(fifth,b)) = (a(1)-fifth(1))*(b(2)-fifth(2))-(a(2)-fifth(2))*(b(1)-fifth(1)) = ((0)-((1+t)*h))*((t/2)-(t/2))-((1)-(t/2))*((-(1+t)*h)-((1+t)*h)) = h*((2)+(1)*t+(-1)*t^2) = h*((2)+(1)*t+(-1)*(1-t)) = h*(1+2*t) > 0
    release thm geometry::main::collinear_det_expand(fifth,a,c)
    geometry::main::det(geometry::main::vec(fifth,a),geometry::main::vec(fifth,c)) = (a(1)-fifth(1))*(c(2)-fifth(2))-(a(2)-fifth(2))*(c(1)-fifth(1)) = ((0)-((1+t)*h))*((-(1+t)/2)-(t/2))-((1)-(t/2))*((-h)-((1+t)*h)) = h*(((5/2))+((3/2))*t+((1/2))*t^2) = h*(((5/2))+((3/2))*t+((1/2))*(1-t)) = h*(3+t) > 0
    release thm geometry::main::collinear_det_expand(fifth,a,d)
    geometry::main::det(geometry::main::vec(fifth,a),geometry::main::vec(fifth,d)) = (a(1)-fifth(1))*(d(2)-fifth(2))-(a(2)-fifth(2))*(d(1)-fifth(1)) = ((0)-((1+t)*h))*((-(1+t)/2)-(t/2))-((1)-(t/2))*((h)-((1+t)*h)) = h*(((1/2))+((5/2))*t+((1/2))*t^2) = h*(((1/2))+((5/2))*t+((1/2))*(1-t)) = h*(1+2*t) > 0


thm positive_convex_combination:
    ? forall first,second R+, t R:
        0 <= t
        t <= 1
        =>:
            (1-t)*first+t*second > 0
    by cases:
        ? (1-t)*first+t*second > 0
        case t < 1:
            1-t > 0
            (1-t)*first > 0
            t*second >= 0
            (1-t)*first+t*second >= (1-t)*first > 0
        case t >= 1:
            t = 1
            (1-t)*first+t*second = (1-1)*first+1*second = second > 0


thm affine_point_determinant_linearity:
    ? forall o, h, x, y, z cart(R, R), t R:
        z(1) = (1 - t) * x(1) + t * y(1)
        z(2) = (1 - t) * x(2) + t * y(2)
        =>:
            geometry::main::det(geometry::main::vec(o, h), geometry::main::vec(o, z)) = (1 - t) * geometry::main::det(geometry::main::vec(o, h), geometry::main::vec(o, x)) + t * geometry::main::det(geometry::main::vec(o, h), geometry::main::vec(o, y))
    z(1) - o(1) = ((1 - t) * x(1) + t * y(1)) - o(1) = (1 - t) * (x(1) - o(1)) + t * (y(1) - o(1))
    z(2) - o(2) = ((1 - t) * x(2) + t * y(2)) - o(2) = (1 - t) * (x(2) - o(2)) + t * (y(2) - o(2))
    release thm geometry::main::collinear_det_expand(o, h, z)
    release thm geometry::main::collinear_det_expand(o, h, x)
    release thm geometry::main::collinear_det_expand(o, h, y)
    geometry::main::det(geometry::main::vec(o, h), geometry::main::vec(o, z)) = (h(1) - o(1)) * (z(2) - o(2)) - (h(2) - o(2)) * (z(1) - o(1)) = (h(1) - o(1)) * ((1 - t) * (x(2) - o(2)) + t * (y(2) - o(2))) - (h(2) - o(2)) * ((1 - t) * (x(1) - o(1)) + t * (y(1) - o(1))) = (1 - t) * ((h(1) - o(1)) * (x(2) - o(2)) - (h(2) - o(2)) * (x(1) - o(1))) + t * ((h(1) - o(1)) * (y(2) - o(2)) - (h(2) - o(2)) * (y(1) - o(1))) = (1 - t) * geometry::main::det(geometry::main::vec(o, h), geometry::main::vec(o, x)) + t * geometry::main::det(geometry::main::vec(o, h), geometry::main::vec(o, y))



thm segment_stays_in_strict_half_plane:
    ? forall a,b,c,d,p cart(R,R):
        geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c)) > 0
        geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d)) > 0
        $entry::is_on_segment(p,c,d)
        =>:
            geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,p)) > 0
    by def $entry::is_on_segment(p,c,d)
    obtain t from exist t R st {0 <= t, t <= 1, p(1) = (1-t)*c(1)+t*d(1), p(2) = (1-t)*c(2)+t*d(2)}
    release thm affine_point_determinant_linearity(a,b,c,d,p,t)
    have first R+ = geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c))
    have second R+ = geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d))
    release thm positive_convex_combination(first,second,t)
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,p)) = (1-t)*geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c))+t*geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d)) = (1-t)*first+t*second > 0


thm strict_half_plane_excludes_segment_intersection:
    ? forall a,b,c,d,p cart(R,R):
        geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c)) > 0
        geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d)) > 0
        $entry::is_on_segment(p,c,d)
        =>:
            not $entry::is_on_segment(p,a,b)
    release thm segment_stays_in_strict_half_plane(a,b,c,d,p)
    by contra:
        ? not $entry::is_on_segment(p,a,b)
        $entry::is_on_segment(p,a,b)
        by def $entry::is_on_segment(p,a,b)
        obtain t from exist t R st {0 <= t, t <= 1, p(1) = (1-t)*a(1)+t*b(1), p(2) = (1-t)*a(2)+t*b(2)}
        release thm affine_point_determinant_linearity(a,b,a,b,p,t)
        release thm geometry::main::collinear_det_expand(a,b,a)
        geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,a)) = (b(1)-a(1))*(a(2)-a(2))-(b(2)-a(2))*(a(1)-a(1)) = 0
        release thm geometry::main::collinear_det_expand(a,b,b)
        geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,b)) = (b(1)-a(1))*(b(2)-a(2))-(b(2)-a(2))*(b(1)-a(1)) = 0
        geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,p)) = (1-t)*geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,a))+t*geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,b)) = (1-t)*0+t*0 = 0
        impossible geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,p)) > 0


thm golden_pentagon_metric_certificate:
    ? forall t,h R+, a,b,c,d,fifth cart(R,R):
        t < 1
        t^2 = 1-t
        h^2 = (2-t)/4
        a = (0,1)
        b = (-(1+t)*h,t/2)
        c = (-h,-(1+t)/2)
        d = (h,-(1+t)/2)
        fifth = ((1+t)*h,t/2)
        =>:
            geometry::main::distance_sq((0,0),a) = 1
            geometry::main::distance_sq((0,0),b) = 1
            geometry::main::distance_sq((0,0),c) = 1
            geometry::main::distance_sq((0,0),d) = 1
            geometry::main::distance_sq((0,0),fifth) = 1
            geometry::main::distance_sq(a,b) = 2-t
            geometry::main::distance_sq(a,c) = 3+t
            geometry::main::distance_sq(b,c) = 2-t
            geometry::main::distance_sq(b,d) = 3+t
            geometry::main::distance_sq(c,d) = 2-t
            geometry::main::distance_sq(c,fifth) = 3+t
            geometry::main::distance_sq(d,fifth) = 2-t
            geometry::main::distance_sq(d,a) = 3+t
            geometry::main::distance_sq(fifth,a) = 2-t
            geometry::main::distance_sq(fifth,b) = 3+t
    release thm golden_pentagon_scalar_metrics(t,h)
    have center cart(R,R) = (0,0)
    center(1) = 0
    center(2) = 0
    a(1) = 0
    a(2) = 1
    b(1) = -(1+t)*h
    b(2) = t/2
    c(1) = -h
    c(2) = -(1+t)/2
    d(1) = h
    d(2) = -(1+t)/2
    fifth(1) = (1+t)*h
    fifth(2) = t/2
    release thm geometry::main::distance_sq_coordinate_formula(center,a)
    a(1)-center(1) = (0)-(0)
    a(2)-center(2) = (1)-(0)
    (a(1)-center(1))^2+(a(2)-center(2))^2 = ((0)-(0))^2+(a(2)-center(2))^2 = ((0)-(0))^2+((1)-(0))^2
    geometry::main::distance_sq((0,0),a) = geometry::main::distance_sq(center,a) = (a(1)-center(1))^2+(a(2)-center(2))^2 = ((0)-(0))^2+((1)-(0))^2 = (0)^2+(1)^2 = 1 = 1
    release thm geometry::main::distance_sq_coordinate_formula(center,b)
    b(1)-center(1) = (-(1+t)*h)-(0)
    b(2)-center(2) = (t/2)-(0)
    (b(1)-center(1))^2+(b(2)-center(2))^2 = ((-(1+t)*h)-(0))^2+(b(2)-center(2))^2 = ((-(1+t)*h)-(0))^2+((t/2)-(0))^2
    geometry::main::distance_sq((0,0),b) = geometry::main::distance_sq(center,b) = (b(1)-center(1))^2+(b(2)-center(2))^2 = ((-(1+t)*h)-(0))^2+((t/2)-(0))^2 = (-(1+t)*h)^2+(t/2)^2 = ((1+t)*h)^2+(t/2)^2 = 1
    release thm geometry::main::distance_sq_coordinate_formula(center,c)
    c(1)-center(1) = (-h)-(0)
    c(2)-center(2) = (-(1+t)/2)-(0)
    (c(1)-center(1))^2+(c(2)-center(2))^2 = ((-h)-(0))^2+(c(2)-center(2))^2 = ((-h)-(0))^2+((-(1+t)/2)-(0))^2
    geometry::main::distance_sq((0,0),c) = geometry::main::distance_sq(center,c) = (c(1)-center(1))^2+(c(2)-center(2))^2 = ((-h)-(0))^2+((-(1+t)/2)-(0))^2 = (-h)^2+(-(1+t)/2)^2 = h^2+((1+t)/2)^2 = 1
    release thm geometry::main::distance_sq_coordinate_formula(center,d)
    d(1)-center(1) = (h)-(0)
    d(2)-center(2) = (-(1+t)/2)-(0)
    (d(1)-center(1))^2+(d(2)-center(2))^2 = ((h)-(0))^2+(d(2)-center(2))^2 = ((h)-(0))^2+((-(1+t)/2)-(0))^2
    geometry::main::distance_sq((0,0),d) = geometry::main::distance_sq(center,d) = (d(1)-center(1))^2+(d(2)-center(2))^2 = ((h)-(0))^2+((-(1+t)/2)-(0))^2 = (h)^2+(-(1+t)/2)^2 = h^2+((1+t)/2)^2 = 1
    release thm geometry::main::distance_sq_coordinate_formula(center,fifth)
    fifth(1)-center(1) = ((1+t)*h)-(0)
    fifth(2)-center(2) = (t/2)-(0)
    (fifth(1)-center(1))^2+(fifth(2)-center(2))^2 = (((1+t)*h)-(0))^2+(fifth(2)-center(2))^2 = (((1+t)*h)-(0))^2+((t/2)-(0))^2
    geometry::main::distance_sq((0,0),fifth) = geometry::main::distance_sq(center,fifth) = (fifth(1)-center(1))^2+(fifth(2)-center(2))^2 = (((1+t)*h)-(0))^2+((t/2)-(0))^2 = ((1+t)*h)^2+(t/2)^2 = ((1+t)*h)^2+(t/2)^2 = 1
    release thm geometry::main::distance_sq_coordinate_formula(a,b)
    b(1)-a(1) = (-(1+t)*h)-(0)
    b(2)-a(2) = (t/2)-(1)
    (b(1)-a(1))^2+(b(2)-a(2))^2 = ((-(1+t)*h)-(0))^2+(b(2)-a(2))^2 = ((-(1+t)*h)-(0))^2+((t/2)-(1))^2
    geometry::main::distance_sq(a,b) = (b(1)-a(1))^2+(b(2)-a(2))^2 = ((-(1+t)*h)-(0))^2+((t/2)-(1))^2 = ((1+t)*h)^2+(t/2-1)^2 = 2-t
    release thm geometry::main::distance_sq_coordinate_formula(a,c)
    c(1)-a(1) = (-h)-(0)
    c(2)-a(2) = (-(1+t)/2)-(1)
    (c(1)-a(1))^2+(c(2)-a(2))^2 = ((-h)-(0))^2+(c(2)-a(2))^2 = ((-h)-(0))^2+((-(1+t)/2)-(1))^2
    geometry::main::distance_sq(a,c) = (c(1)-a(1))^2+(c(2)-a(2))^2 = ((-h)-(0))^2+((-(1+t)/2)-(1))^2 = h^2+(1+(1+t)/2)^2 = 3+t
    release thm geometry::main::distance_sq_coordinate_formula(b,c)
    c(1)-b(1) = (-h)-(-(1+t)*h)
    c(2)-b(2) = (-(1+t)/2)-(t/2)
    (c(1)-b(1))^2+(c(2)-b(2))^2 = ((-h)-(-(1+t)*h))^2+(c(2)-b(2))^2 = ((-h)-(-(1+t)*h))^2+((-(1+t)/2)-(t/2))^2
    geometry::main::distance_sq(b,c) = (c(1)-b(1))^2+(c(2)-b(2))^2 = ((-h)-(-(1+t)*h))^2+((-(1+t)/2)-(t/2))^2 = ((1+t)*h-h)^2+(t/2+(1+t)/2)^2 = 2-t
    release thm geometry::main::distance_sq_coordinate_formula(b,d)
    d(1)-b(1) = (h)-(-(1+t)*h)
    d(2)-b(2) = (-(1+t)/2)-(t/2)
    (d(1)-b(1))^2+(d(2)-b(2))^2 = ((h)-(-(1+t)*h))^2+(d(2)-b(2))^2 = ((h)-(-(1+t)*h))^2+((-(1+t)/2)-(t/2))^2
    geometry::main::distance_sq(b,d) = (d(1)-b(1))^2+(d(2)-b(2))^2 = ((h)-(-(1+t)*h))^2+((-(1+t)/2)-(t/2))^2 = ((1+t)*h+h)^2+(t/2+(1+t)/2)^2 = 3+t
    release thm geometry::main::distance_sq_coordinate_formula(c,d)
    d(1)-c(1) = (h)-(-h)
    d(2)-c(2) = (-(1+t)/2)-(-(1+t)/2)
    (d(1)-c(1))^2+(d(2)-c(2))^2 = ((h)-(-h))^2+(d(2)-c(2))^2 = ((h)-(-h))^2+((-(1+t)/2)-(-(1+t)/2))^2
    geometry::main::distance_sq(c,d) = (d(1)-c(1))^2+(d(2)-c(2))^2 = ((h)-(-h))^2+((-(1+t)/2)-(-(1+t)/2))^2 = 4*h^2 = 2-t
    release thm geometry::main::distance_sq_coordinate_formula(c,fifth)
    fifth(1)-c(1) = ((1+t)*h)-(-h)
    fifth(2)-c(2) = (t/2)-(-(1+t)/2)
    (fifth(1)-c(1))^2+(fifth(2)-c(2))^2 = (((1+t)*h)-(-h))^2+(fifth(2)-c(2))^2 = (((1+t)*h)-(-h))^2+((t/2)-(-(1+t)/2))^2
    geometry::main::distance_sq(c,fifth) = (fifth(1)-c(1))^2+(fifth(2)-c(2))^2 = (((1+t)*h)-(-h))^2+((t/2)-(-(1+t)/2))^2 = ((1+t)*h+h)^2+(t/2+(1+t)/2)^2 = 3+t
    release thm geometry::main::distance_sq_coordinate_formula(d,fifth)
    fifth(1)-d(1) = ((1+t)*h)-(h)
    fifth(2)-d(2) = (t/2)-(-(1+t)/2)
    (fifth(1)-d(1))^2+(fifth(2)-d(2))^2 = (((1+t)*h)-(h))^2+(fifth(2)-d(2))^2 = (((1+t)*h)-(h))^2+((t/2)-(-(1+t)/2))^2
    geometry::main::distance_sq(d,fifth) = (fifth(1)-d(1))^2+(fifth(2)-d(2))^2 = (((1+t)*h)-(h))^2+((t/2)-(-(1+t)/2))^2 = ((1+t)*h-h)^2+(t/2+(1+t)/2)^2 = 2-t
    release thm geometry::main::distance_sq_coordinate_formula(d,a)
    a(1)-d(1) = (0)-(h)
    a(2)-d(2) = (1)-(-(1+t)/2)
    (a(1)-d(1))^2+(a(2)-d(2))^2 = ((0)-(h))^2+(a(2)-d(2))^2 = ((0)-(h))^2+((1)-(-(1+t)/2))^2
    geometry::main::distance_sq(d,a) = (a(1)-d(1))^2+(a(2)-d(2))^2 = ((0)-(h))^2+((1)-(-(1+t)/2))^2 = h^2+(1+(1+t)/2)^2 = 3+t
    release thm geometry::main::distance_sq_coordinate_formula(fifth,a)
    a(1)-fifth(1) = (0)-((1+t)*h)
    a(2)-fifth(2) = (1)-(t/2)
    (a(1)-fifth(1))^2+(a(2)-fifth(2))^2 = ((0)-((1+t)*h))^2+(a(2)-fifth(2))^2 = ((0)-((1+t)*h))^2+((1)-(t/2))^2
    geometry::main::distance_sq(fifth,a) = (a(1)-fifth(1))^2+(a(2)-fifth(2))^2 = ((0)-((1+t)*h))^2+((1)-(t/2))^2 = ((1+t)*h)^2+(t/2-1)^2 = 2-t
    release thm geometry::main::distance_sq_coordinate_formula(fifth,b)
    b(1)-fifth(1) = (-(1+t)*h)-((1+t)*h)
    b(2)-fifth(2) = (t/2)-(t/2)
    (b(1)-fifth(1))^2+(b(2)-fifth(2))^2 = ((-(1+t)*h)-((1+t)*h))^2+(b(2)-fifth(2))^2 = ((-(1+t)*h)-((1+t)*h))^2+((t/2)-(t/2))^2
    geometry::main::distance_sq(fifth,b) = (b(1)-fifth(1))^2+(b(2)-fifth(2))^2 = ((-(1+t)*h)-((1+t)*h))^2+((t/2)-(t/2))^2 = 4*((1+t)*h)^2 = 3+t

thm strict_half_plane_segments_have_no_extra_intersection:
    ? forall a,b,c,d cart(R,R):
        a != b
        c != d
        geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c)) > 0
        geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d)) > 0
        =>:
            $entry::segments_meet_only_at_common_endpoints(a,b,c,d)
    claim:
        ? forall p cart(R,R):
            $entry::is_on_segment(p,a,b)
            $entry::is_on_segment(p,c,d)
            p != a
            =>:
                p = b
        by contra:
            ? p = b
            p != b
            release thm strict_half_plane_excludes_segment_intersection(a,b,c,d,p)
            impossible $entry::is_on_segment(p,a,b)
    claim:
        ? forall p cart(R,R):
            $entry::is_on_segment(p,a,b)
            $entry::is_on_segment(p,c,d)
            p != c
            =>:
                p = d
        by contra:
            ? p = d
            p != d
            release thm strict_half_plane_excludes_segment_intersection(a,b,c,d,p)
            impossible $entry::is_on_segment(p,a,b)
    by def $entry::segments_meet_only_at_common_endpoints(a,b,c,d)


thm integer_index_below_five_cases:
    ? forall k Z:
        0 <= k
        k < 5
        =>:
            k = 0 or k = 1 or k = 2 or k = 3 or k = 4
    by contra:
        ? k = 0 or k = 1 or k = 2 or k = 3 or k = 4
        k != 0
        k != 1
        k != 2
        k != 3
        k != 4
        by contra:
            ? k > 0
            k <= 0
            k = 0
            impossible k != 0
        k >= 1
        by contra:
            ? k > 1
            k <= 1
            k = 1
            impossible k != 1
        k >= 2
        by contra:
            ? k > 2
            k <= 2
            k = 2
            impossible k != 2
        k >= 3
        by contra:
            ? k > 3
            k <= 3
            k = 3
            impossible k != 3
        k >= 4
        k <= 4
        k = 4
        impossible k != 4


thm five_vertex_conditions_give_simple_cycle:
    ? forall vertices fn(k Z) cart(R,R):
        vertices(5) = vertices(0)
        vertices(0) != vertices(1)
        $entry::segments_meet_only_at_common_endpoints(vertices(0),vertices(1),vertices(1),vertices(2))
        vertices(0) != vertices(2)
        $entry::segments_meet_only_at_common_endpoints(vertices(0),vertices(1),vertices(2),vertices(3))
        vertices(0) != vertices(3)
        $entry::segments_meet_only_at_common_endpoints(vertices(0),vertices(1),vertices(3),vertices(4))
        vertices(0) != vertices(4)
        $entry::segments_meet_only_at_common_endpoints(vertices(0),vertices(1),vertices(4),vertices(5))
        vertices(1) != vertices(2)
        $entry::segments_meet_only_at_common_endpoints(vertices(1),vertices(2),vertices(2),vertices(3))
        vertices(1) != vertices(3)
        $entry::segments_meet_only_at_common_endpoints(vertices(1),vertices(2),vertices(3),vertices(4))
        vertices(1) != vertices(4)
        $entry::segments_meet_only_at_common_endpoints(vertices(1),vertices(2),vertices(4),vertices(5))
        vertices(2) != vertices(3)
        $entry::segments_meet_only_at_common_endpoints(vertices(2),vertices(3),vertices(3),vertices(4))
        vertices(2) != vertices(4)
        $entry::segments_meet_only_at_common_endpoints(vertices(2),vertices(3),vertices(4),vertices(5))
        vertices(3) != vertices(4)
        $entry::segments_meet_only_at_common_endpoints(vertices(3),vertices(4),vertices(4),vertices(5))
        =>:
            $entry::is_simple_polygonal_cycle(5,vertices)
    release thm working::common_endpoint_condition_symmetric(vertices(0),vertices(1),vertices(1),vertices(2))
    release thm working::common_endpoint_condition_symmetric(vertices(0),vertices(1),vertices(2),vertices(3))
    release thm working::common_endpoint_condition_symmetric(vertices(0),vertices(1),vertices(3),vertices(4))
    release thm working::common_endpoint_condition_symmetric(vertices(0),vertices(1),vertices(4),vertices(5))
    release thm working::common_endpoint_condition_symmetric(vertices(1),vertices(2),vertices(2),vertices(3))
    release thm working::common_endpoint_condition_symmetric(vertices(1),vertices(2),vertices(3),vertices(4))
    release thm working::common_endpoint_condition_symmetric(vertices(1),vertices(2),vertices(4),vertices(5))
    release thm working::common_endpoint_condition_symmetric(vertices(2),vertices(3),vertices(3),vertices(4))
    release thm working::common_endpoint_condition_symmetric(vertices(2),vertices(3),vertices(4),vertices(5))
    release thm working::common_endpoint_condition_symmetric(vertices(3),vertices(4),vertices(4),vertices(5))
    claim:
        ? forall k Z:
            0 <= k
            k < 5
            =>:
                vertices(k) != vertices(k+1)
        release thm integer_index_below_five_cases(k)
        by cases:
            ? vertices(k) != vertices(k+1)
            case k = 0:
                k+1 = 1
                vertices(k) = vertices(0)
                vertices(k+1) = vertices(1)
                vertices(0) != vertices(1)
                vertices(k) != vertices(k+1)
            case k = 1:
                k+1 = 2
                vertices(k) = vertices(1)
                vertices(k+1) = vertices(2)
                vertices(1) != vertices(2)
                vertices(k) != vertices(k+1)
            case k = 2:
                k+1 = 3
                vertices(k) = vertices(2)
                vertices(k+1) = vertices(3)
                vertices(2) != vertices(3)
                vertices(k) != vertices(k+1)
            case k = 3:
                k+1 = 4
                vertices(k) = vertices(3)
                vertices(k+1) = vertices(4)
                vertices(3) != vertices(4)
                vertices(k) != vertices(k+1)
            case k = 4:
                k+1 = 5
                vertices(k) = vertices(4)
                vertices(k+1) = vertices(5)
                vertices(4) != vertices(5)
                vertices(k) != vertices(k+1)
    claim:
        ? forall left_index,right_index Z:
            0 <= left_index
            left_index < right_index
            right_index < 5
            =>:
                vertices(left_index) != vertices(right_index)
        left_index < 5
        0 <= right_index
        release thm integer_index_below_five_cases(left_index)
        release thm integer_index_below_five_cases(right_index)
        by cases:
            ? vertices(left_index) != vertices(right_index)
            case left_index = 0:
                by cases:
                    ? vertices(left_index) != vertices(right_index)
                    case right_index = 0:
                        by contra:
                            ? vertices(left_index) != vertices(right_index)
                            vertices(left_index) = vertices(right_index)
                            left_index >= right_index
                            impossible left_index < right_index
                    case right_index = 1:
                        vertices(left_index) = vertices(0)
                        vertices(right_index) = vertices(1)
                        vertices(left_index) != vertices(right_index)
                    case right_index = 2:
                        vertices(left_index) = vertices(0)
                        vertices(right_index) = vertices(2)
                        vertices(left_index) != vertices(right_index)
                    case right_index = 3:
                        vertices(left_index) = vertices(0)
                        vertices(right_index) = vertices(3)
                        vertices(left_index) != vertices(right_index)
                    case right_index = 4:
                        vertices(left_index) = vertices(0)
                        vertices(right_index) = vertices(4)
                        vertices(left_index) != vertices(right_index)
            case left_index = 1:
                by cases:
                    ? vertices(left_index) != vertices(right_index)
                    case right_index = 0:
                        by contra:
                            ? vertices(left_index) != vertices(right_index)
                            vertices(left_index) = vertices(right_index)
                            left_index >= right_index
                            impossible left_index < right_index
                    case right_index = 1:
                        by contra:
                            ? vertices(left_index) != vertices(right_index)
                            vertices(left_index) = vertices(right_index)
                            left_index >= right_index
                            impossible left_index < right_index
                    case right_index = 2:
                        vertices(left_index) = vertices(1)
                        vertices(right_index) = vertices(2)
                        vertices(left_index) != vertices(right_index)
                    case right_index = 3:
                        vertices(left_index) = vertices(1)
                        vertices(right_index) = vertices(3)
                        vertices(left_index) != vertices(right_index)
                    case right_index = 4:
                        vertices(left_index) = vertices(1)
                        vertices(right_index) = vertices(4)
                        vertices(left_index) != vertices(right_index)
            case left_index = 2:
                by cases:
                    ? vertices(left_index) != vertices(right_index)
                    case right_index = 0:
                        by contra:
                            ? vertices(left_index) != vertices(right_index)
                            vertices(left_index) = vertices(right_index)
                            left_index >= right_index
                            impossible left_index < right_index
                    case right_index = 1:
                        by contra:
                            ? vertices(left_index) != vertices(right_index)
                            vertices(left_index) = vertices(right_index)
                            left_index >= right_index
                            impossible left_index < right_index
                    case right_index = 2:
                        by contra:
                            ? vertices(left_index) != vertices(right_index)
                            vertices(left_index) = vertices(right_index)
                            left_index >= right_index
                            impossible left_index < right_index
                    case right_index = 3:
                        vertices(left_index) = vertices(2)
                        vertices(right_index) = vertices(3)
                        vertices(left_index) != vertices(right_index)
                    case right_index = 4:
                        vertices(left_index) = vertices(2)
                        vertices(right_index) = vertices(4)
                        vertices(left_index) != vertices(right_index)
            case left_index = 3:
                by cases:
                    ? vertices(left_index) != vertices(right_index)
                    case right_index = 0:
                        by contra:
                            ? vertices(left_index) != vertices(right_index)
                            vertices(left_index) = vertices(right_index)
                            left_index >= right_index
                            impossible left_index < right_index
                    case right_index = 1:
                        by contra:
                            ? vertices(left_index) != vertices(right_index)
                            vertices(left_index) = vertices(right_index)
                            left_index >= right_index
                            impossible left_index < right_index
                    case right_index = 2:
                        by contra:
                            ? vertices(left_index) != vertices(right_index)
                            vertices(left_index) = vertices(right_index)
                            left_index >= right_index
                            impossible left_index < right_index
                    case right_index = 3:
                        by contra:
                            ? vertices(left_index) != vertices(right_index)
                            vertices(left_index) = vertices(right_index)
                            left_index >= right_index
                            impossible left_index < right_index
                    case right_index = 4:
                        vertices(left_index) = vertices(3)
                        vertices(right_index) = vertices(4)
                        vertices(left_index) != vertices(right_index)
            case left_index = 4:
                by cases:
                    ? vertices(left_index) != vertices(right_index)
                    case right_index = 0:
                        by contra:
                            ? vertices(left_index) != vertices(right_index)
                            vertices(left_index) = vertices(right_index)
                            left_index >= right_index
                            impossible left_index < right_index
                    case right_index = 1:
                        by contra:
                            ? vertices(left_index) != vertices(right_index)
                            vertices(left_index) = vertices(right_index)
                            left_index >= right_index
                            impossible left_index < right_index
                    case right_index = 2:
                        by contra:
                            ? vertices(left_index) != vertices(right_index)
                            vertices(left_index) = vertices(right_index)
                            left_index >= right_index
                            impossible left_index < right_index
                    case right_index = 3:
                        by contra:
                            ? vertices(left_index) != vertices(right_index)
                            vertices(left_index) = vertices(right_index)
                            left_index >= right_index
                            impossible left_index < right_index
                    case right_index = 4:
                        by contra:
                            ? vertices(left_index) != vertices(right_index)
                            vertices(left_index) = vertices(right_index)
                            left_index >= right_index
                            impossible left_index < right_index
    claim:
        ? forall left_index,right_index Z:
            0 <= left_index
            left_index < 5
            0 <= right_index
            right_index < 5
            left_index != right_index
            =>:
                $entry::segments_meet_only_at_common_endpoints(vertices(left_index),vertices(left_index+1),vertices(right_index),vertices(right_index+1))
        release thm integer_index_below_five_cases(left_index)
        release thm integer_index_below_five_cases(right_index)
        by cases:
            ? $entry::segments_meet_only_at_common_endpoints(vertices(left_index),vertices(left_index+1),vertices(right_index),vertices(right_index+1))
            case left_index = 0:
