                    case right_index = 0:
                        by contra:
                            ? $entry::segments_meet_only_at_common_endpoints(vertices(left_index),vertices(left_index+1),vertices(right_index),vertices(right_index+1))
                            not $entry::segments_meet_only_at_common_endpoints(vertices(left_index),vertices(left_index+1),vertices(right_index),vertices(right_index+1))
