cycle(3),cycle(4)),geometry::main::vec(cycle(3),cycle(2))) > 0, geometry::main::det(geometry::main::vec(cycle(4),cycle(0)),geometry::main::vec(cycle(4),cycle(1))) > 0, geometry::main::det(geometry::main::vec(cycle(4),cycle(0)),geometry::main::vec(cycle(4),cycle(2))) > 0, geometry::main::det(geometry::main::vec(cycle(4),cycle(0)),geometry::main::vec(cycle(4),cycle(3))) > 0} from vertices,side_sq


thm golden_pentagon_outer_radius:
    ? forall t, radius R+:
        t < 1
        t^2 = 1-t
        =>:
            exist outer_radius R+ st {outer_radius^2-outer_radius^2*(2-t)/4 = radius^2}
    1+t > 0
    (1+t)/2 > 0
    have u R+ = (1+t)/2
    u^2 = ((1+t)/2)^2 = (1+2*t+t^2)/4 = (1+2*t+(1-t))/4 = (1+2*t+1-t)/4 = (2+t)/4 = 1-(2-t)/4
    radius/u > 0
    have outer_radius R+ = radius/u
    outer_radius^2-outer_radius^2*(2-t)/4 = outer_radius^2*(1-(2-t)/4) = outer_radius^2*u^2 = (radius/u)^2*u^2 = radius^2
    witness exist outer R+ st {outer^2-outer^2*(2-t)/4 = radius^2} from outer_radius


thm chord_midpoint_radius_identity:
    ? forall o, a, b, m cart(R, R), radius R+:
        a != b
        $is_on_circle(a, o, radius)
        $is_on_circle(b, o, radius)
        m(1) = (a(1)+b(1))/2
        m(2) = (a(2)+b(2))/2
        =>:
            geometry::main::distance_sq(o, m)+geometry::main::distance_sq(a, b)/4 = radius^2
    by def $is_on_circle(a, o, radius)
    by def $is_on_circle(b, o, radius)
    release thm geometry::main::distance_sq_coordinate_formula(o, a)
    release thm geometry::main::distance_sq_coordinate_formula(o, b)
    release thm geometry::main::distance_sq_coordinate_formula(o, m)
    release thm geometry::main::distance_sq_coordinate_formula(a, b)
    2*geometry::main::distance_sq(o, m)+geometry::main::distance_sq(a, b)/2 = 2*((m(1)-o(1))^2+(m(2)-o(2))^2)+((b(1)-a(1))^2+(b(2)-a(2))^2)/2 = 2*(((a(1)+b(1))/2-o(1))^2+((a(2)+b(2))/2-o(2))^2)+((b(1)-a(1))^2+(b(2)-a(2))^2)/2 = (a(1)-o(1))^2+(a(2)-o(2))^2+(b(1)-o(1))^2+(b(2)-o(2))^2 = ((a(1)-o(1))^2+(a(2)-o(2))^2)+((b(1)-o(1))^2+(b(2)-o(2))^2) = geometry::main::distance_sq(o, a)+geometry::main::distance_sq(o, b) = radius*radius+radius*radius = 2*radius^2
    geometry::main::distance_sq(o, m)+geometry::main::distance_sq(a, b)/4 = (2*geometry::main::distance_sq(o, m)+geometry::main::distance_sq(a, b)/2)/2 = (2*radius^2)/2 = radius^2



thm chord_midpoint_contact_geometry:
    ? forall a,b,m,o cart(R,R):
        a != b
        geometry::main::distance_sq(o,a) = geometry::main::distance_sq(o,b)
        m(1) = (a(1)+b(1))/2
        m(2) = (a(2)+b(2))/2
        =>:
            $entry::is_on_segment(m,a,b)
            m $in geometry::main::line_through_points(a,b)
            geometry::main::dot(geometry::main::vec(o,m),geometry::main::vec(a,b)) = 0
    m(1) = (a(1)+b(1))/2 = (1-1/2)*a(1)+(1/2)*b(1)
    m(2) = (a(2)+b(2))/2 = (1-1/2)*a(2)+(1/2)*b(2)
    witness exist t R st {0 <= t, t <= 1, m(1) = (1-t)*a(1)+t*b(1), m(2) = (1-t)*a(2)+t*b(2)} from 1/2
    by def $entry::is_on_segment(m,a,b)
    release thm geometry::main::collinear_det_expand(a,m,b)
    geometry::main::det(geometry::main::vec(a,m),geometry::main::vec(a,b)) = (m(1)-a(1))*(b(2)-a(2))-(m(2)-a(2))*(b(1)-a(1)) = ((a(1)+b(1))/2-a(1))*(b(2)-a(2))-((a(2)+b(2))/2-a(2))*(b(1)-a(1)) = 0
    release thm set_builder_member(m,{q cart(R,R): geometry::main::det(geometry::main::vec(a,q),geometry::main::vec(a,b)) = 0})
    m $in geometry::main::line_through_points(a,b)
    release thm geometry::main::distance_sq_coordinate_formula(o,a)
    release thm geometry::main::distance_sq_coordinate_formula(o,b)
    release thm geometry::main::perpendicular_dot_expand(o,m,a,b)
    2*geometry::main::dot(geometry::main::vec(o,m),geometry::main::vec(a,b)) = 2*((m(1)-o(1))*(b(1)-a(1))+(m(2)-o(2))*(b(2)-a(2))) = 2*(((a(1)+b(1))/2-o(1))*(b(1)-a(1))+((a(2)+b(2))/2-o(2))*(b(2)-a(2))) = ((b(1)-o(1))^2+(b(2)-o(2))^2)-((a(1)-o(1))^2+(a(2)-o(2))^2) = geometry::main::distance_sq(o,b)-geometry::main::distance_sq(o,a) = 0
    geometry::main::dot(geometry::main::vec(o,m),geometry::main::vec(a,b)) = (2*geometry::main::dot(geometry::main::vec(o,m),geometry::main::vec(a,b)))/2 = 0


thm concentric_chord_midpoint_tangency:
    ? forall o,a,b,m cart(R,R), outer_radius,radius R+:
        a != b
        $is_on_circle(a,o,outer_radius)
        $is_on_circle(b,o,outer_radius)
        m(1) = (a(1)+b(1))/2
        m(2) = (a(2)+b(2))/2
        outer_radius^2-geometry::main::distance_sq(a,b)/4 = radius^2
        =>:
            $entry::is_on_segment(m,a,b)
            $is_tangent_line_at(m,a,b,o,radius)
    by def $is_on_circle(a,o,outer_radius)
    by def $is_on_circle(b,o,outer_radius)
    geometry::main::distance_sq(o,a) = outer_radius*outer_radius = geometry::main::distance_sq(o,b)
    release thm chord_midpoint_contact_geometry(a,b,m,o)
    release thm chord_midpoint_radius_identity(o,a,b,m,outer_radius)
    geometry::main::distance_sq(o,m) = (geometry::main::distance_sq(o,m)+geometry::main::distance_sq(a,b)/4)-geometry::main::distance_sq(a,b)/4 = outer_radius^2-geometry::main::distance_sq(a,b)/4 = radius^2 = radius*radius
    by def $is_on_circle(m,o,radius)
    release thm radius_perpendicular_at_line_point_gives_tangency(o,m,a,b,radius)


thm five_vertex_centroid_strict_side:
    ? forall a,b,c,d,fifth,o cart(R,R):
        o(1) = (a(1)+b(1)+c(1)+d(1)+fifth(1))/5
        o(2) = (a(2)+b(2)+c(2)+d(2)+fifth(2))/5
        geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c)) > 0
        geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d)) > 0
        geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,fifth)) > 0
        =>:
            geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,o)) > 0
    release thm geometry::main::collinear_det_expand(a,b,c)
    release thm geometry::main::collinear_det_expand(a,b,d)
    release thm geometry::main::collinear_det_expand(a,b,fifth)
    release thm geometry::main::collinear_det_expand(a,b,o)
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c))+geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d))+geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,fifth)) > 0
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c))+geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d))+geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,fifth)) = ((b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1)))+geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d))+geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,fifth)) = ((b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1)))+((b(1)-a(1))*(d(2)-a(2))-(b(2)-a(2))*(d(1)-a(1)))+geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,fifth)) = ((b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1)))+((b(1)-a(1))*(d(2)-a(2))-(b(2)-a(2))*(d(1)-a(1)))+((b(1)-a(1))*(fifth(2)-a(2))-(b(2)-a(2))*(fifth(1)-a(1)))
    geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,o)) = ((b(1)-a(1))*(o(2)-a(2))-(b(2)-a(2))*(o(1)-a(1))) = (b(1)-a(1))*((a(2)+b(2)+c(2)+d(2)+fifth(2))/5-a(2))-(b(2)-a(2))*((a(1)+b(1)+c(1)+d(1)+fifth(1))/5-a(1)) = (((b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1)))+((b(1)-a(1))*(d(2)-a(2))-(b(2)-a(2))*(d(1)-a(1)))+((b(1)-a(1))*(fifth(2)-a(2))-(b(2)-a(2))*(fifth(1)-a(1))))/5 = (geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,c))+geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,d))+geometry::main::det(geometry::main::vec(a,b),geometry::main::vec(a,fifth)))/5 > 0


thm golden_pentagon_centroid_coordinates:
    ? forall t,h R, a,b,c,d,fifth cart(R,R):
        a = (0,1)
        b = (-(1+t)*h,t/2)
        c = (-h,-(1+t)/2)
        d = (h,-(1+t)/2)
        fifth = ((1+t)*h,t/2)
        =>:
            a(1)+b(1)+c(1)+d(1)+fifth(1) = 0
            a(2)+b(2)+c(2)+d(2)+fifth(2) = 0
    a(1) = 0
    b(1) = (-(1+t)*h)
    c(1) = (-h)
    d(1) = h
    fifth(1) = ((1+t)*h)
