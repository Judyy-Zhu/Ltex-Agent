    a(2) = 0
    have b cart(R, R) = (0, 1)
    b(1) = 0
    b(2) = 1
    have center cart(R, R) = (3, 4)
    center(1) = 3
    center(2) = 4
    have c cart(R, R) = (3, 5)
    c(1) = 3
    c(2) = 5
    have d cart(R, R) = (2, 4)
    d(1) = 2
    d(2) = 4
    a(1) != b(1)
    by contra:
        ? a != b
        a = b
        a(1) = b(1)
        impossible a(1) != b(1)
    a(1) != o(1)
    by contra:
        ? a != o
        a = o
        a(1) = o(1)
        impossible a(1) != o(1)
    b(2) != o(2)
    by contra:
        ? b != o
        b = o
        b(2) = o(2)
        impossible b(2) != o(2)
    c(1) != d(1)
    by contra:
        ? c != d
        c = d
        c(1) = d(1)
        impossible c(1) != d(1)
    c(2) != center(2)
    by contra:
        ? c != center
        c = center
        c(2) = center(2)
        impossible c(2) != center(2)
    d(1) != center(1)
    by contra:
        ? d != center
        d = center
        d(1) = center(1)
        impossible d(1) != center(1)
    geometry::main::distance_sq(o, a) = 1
    by def $geometry::main::is_on_circle(a, o, 1)
    geometry::main::distance_sq(o, b) = 1
    by def $geometry::main::is_on_circle(b, o, 1)
    geometry::main::distance_sq(center, c) = 1
    by def $geometry::main::is_on_circle(c, center, 1)
    geometry::main::distance_sq(center, d) = 1
    by def $geometry::main::is_on_circle(d, center, 1)
    geometry::main::distance_sq(a, b) = 2
    geometry::main::distance_sq(c, d) = 2
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, o)) = 1
    geometry::main::det(geometry::main::vec(c, d), geometry::main::vec(c, center)) = 1
    release thm proposition_28_minor(o, a, b, center, c, d, 1, side, side)
    obtain translation, co, si, orientation from exist t cart(R, R), h, k, orientation_sign R st {$is_plane_rigid_motion_between_regions(chosen_circle_arc(o, a, b, 1, side), chosen_circle_arc(center, c, d, 1, side), t, h, k, orientation_sign)}
    witness exist oo, aa, bb, cc, dd, ee, t cart(R, R), h, k, orientation_sign R st {oo = (0, 0), aa = (1, 0), bb = (0, 1), cc = (3, 4), dd = (3, 5), ee = (2, 4), aa != bb, aa != oo, bb != oo, dd != ee, dd != cc, ee != cc, $geometry::main::is_on_circle(aa, oo, 1), $geometry::main::is_on_circle(bb, oo, 1), $geometry::main::is_on_circle(dd, cc, 1), $geometry::main::is_on_circle(ee, cc, 1), $is_plane_rigid_motion_between_regions(chosen_circle_arc(oo, aa, bb, 1, side), chosen_circle_arc(cc, dd, ee, 1, side), t, h, k, orientation_sign)} from o, a, b, center, c, d, translation, co, si, orientation

