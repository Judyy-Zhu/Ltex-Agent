        ? a != b
        a = b
        1 = a(1) = b(1) = 0
        impossible 1 != 0
    by contra:
        ? a != p
        a = p
        1 = a(1) = p(1) = 3/5
        impossible 1 != 3/5
    by contra:
        ? b != p
        b = p
        0 = b(1) = p(1) = 3/5
        impossible 0 != 3/5
    by contra:
        ? a != o
        a = o
        1 = a(1) = o(1) = 0
        impossible 1 != 0
    by contra:
        ? b != o
        b = o
        1 = b(2) = o(2) = 0
        impossible 1 != 0
    release thm geometry::main::distance_sq_coordinate_formula(o, a)
