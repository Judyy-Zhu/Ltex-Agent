    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, o)) = 1
    geometry::main::det(geometry::main::vec(a, b), geometry::main::vec(a, p)) = 2
    by def $is_angle_in_circular_segment(o, a, b, p, 1, 1, angle_measure::ray_angle(a, p, b))
    release thm proposition_31_greater_segment(o, a, b, p, 1, 1, angle_measure::ray_angle(a, p, b))


