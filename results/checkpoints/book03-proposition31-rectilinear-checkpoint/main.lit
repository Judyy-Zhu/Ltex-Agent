    have o cart(R, R) = (0, 0)
    o(1) = 0
    o(2) = 0
    have a cart(R, R) = (1, 0)
    a(1) = 1
    a(2) = 0
    have b cart(R, R) = (0, 1)
    b(1) = 0
    b(2) = 1
    have p cart(R, R) = (3/5, 4/5)
