    release thm geometry::main::distance_sq_coordinate_formula(o, p)
    geometry::main::distance_sq(o, p) = (p(1)-o(1))^2+(p(2)-o(2))^2 = 1 = 1*1
    by def $geometry::main::is_on_circle(p, o, 1)
