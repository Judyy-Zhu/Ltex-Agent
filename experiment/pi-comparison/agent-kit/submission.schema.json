{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent submission, not evaluator result",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "language", "agent_claim", "source_files", "interfaces_file", "clause_mapping", "dependencies", "assumptions", "final_receipt_id", "unfinished"],
  "properties": {
    "task_id": {"type": "string"},
    "language": {"enum": ["lean", "litex"]},
    "agent_claim": {"enum": ["complete", "incomplete", "environment_blocked"]},
    "source_files": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "interfaces_file": {"type": ["string", "null"]},
    "clause_mapping": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["clause_id", "declarations", "explanation"], "properties": {"clause_id": {"type": "string"}, "declarations": {"type": "array", "items": {"type": "string"}}, "explanation": {"type": "string"}}}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "final_receipt_id": {"type": ["string", "null"]},
    "unfinished": {"type": "array", "items": {"type": "string"}}
  }
}
