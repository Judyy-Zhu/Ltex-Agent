# Circle chords and line contact, used by Book III.
release obj def geometry::main::vec
release obj def geometry::main::det
release obj def geometry::main::distance_sq
release obj def geometry::main::circle
release obj def geometry::main::line_through_points

# Proper chord has two distinct endpoints on the specified positive-radius circle.
prop is_chord(a, b, o cart(R, R), radius R+):
    a != b
    a $in geometry::main::circle(o, radius)
    b $in geometry::main::circle(o, radius)

# III.Def2: a proper infinite line touches the circumference and never enters the disk interior.
# Exact single contact and radius-perpendicularity are separate theorems, not assumptions here.
prop is_tangent_line_at(contact, a, b, o cart(R, R), radius R+):
    a != b
    contact $in geometry::main::line_through_points(a, b)
    contact $in geometry::main::circle(o, radius)
    forall p cart(R, R):
        p $in geometry::main::line_through_points(a, b)
        =>:
            geometry::main::distance_sq(o, p) >= radius^2

# A positive-radius circle has a tangent at its upper axial point.
thm horizontal_tangent_exists:
    ? forall radius R+:
        exist a, b cart(R, R) st {$is_tangent_line_at(a, a, b, (0, 0), radius)}
    have o cart(R, R) = (0, 0)
    have a cart(R, R) = (0, radius)
    have b cart(R, R) = (1, radius)
    o(1) = 0
    o(2) = 0
    a(1) = 0
    a(2) = radius
    b(1) = 1
    b(2) = radius
    by contra:
        ? a != b
        a = b
        0 = a(1) = b(1) = 1
        impossible 0 != 1
    release thm geometry::main::collinear_det_expand(a, a, b)
    geometry::main::det(geometry::main::vec(a, a), geometry::main::vec(a, b)) = 0
    a $in geometry::main::line_through_points(a, b)
    release thm geometry::main::distance_sq_coordinate_formula(o, a)
    a(1)-o(1) = 0
    a(2)-o(2) = radius
    (a(1)-o(1))^2 = 0
    (a(2)-o(2))^2 = radius^2
    geometry::main::distance_sq(o, a) = (a(1)-o(1))^2+(a(2)-o(2))^2 = 0+radius^2 = radius^2 = radius*radius
    a $in geometry::main::circle(o, radius)
    claim:
        ? forall p cart(R, R):
            p $in geometry::main::line_through_points(a, b)
            =>:
                geometry::main::distance_sq(o, p) >= radius^2
        geometry::main::line_through_points(a, b) = {q cart(R, R): geometry::main::det(geometry::main::vec(a, q), geometry::main::vec(a, b)) = 0}
        p $in geometry::main::line_through_points(a, b)
        release thm set_builder_member(p, {q geometry::main::line_through_points(a, b): 0 = 0})
        geometry::main::det(geometry::main::vec(a, p), geometry::main::vec(a, b)) = 0
        release thm geometry::main::collinear_det_expand(a, p, b)
        (p(1)-a(1))*(b(2)-a(2))-(p(2)-a(2))*(b(1)-a(1)) = 0
        b(2)-a(2) = 0
        b(1)-a(1) = 1
        (p(1)-a(1))*0-(p(2)-a(2))*1 = 0
        -(p(2)-a(2)) = (p(1)-a(1))*0-(p(2)-a(2))*1 = 0
        p(2)-a(2) = -(-(p(2)-a(2))) = -0 = 0
        p(2) = (p(2)-a(2))+a(2) = 0+a(2) = a(2) = radius
        release thm geometry::main::distance_sq_coordinate_formula(o, p)
        (p(1)-o(1))^2 = p(1)^2
        (p(2)-o(2))^2 = radius^2
        geometry::main::distance_sq(o, p) = (p(1)-o(1))^2+(p(2)-o(2))^2 = p(1)^2+radius^2
        p(1)^2 >= 0
        p(1)^2+radius^2 >= radius^2
        geometry::main::distance_sq(o, p) >= radius^2
    by def $is_tangent_line_at(a, a, b, o, radius)
    witness exist aa, bb cart(R, R) st {$is_tangent_line_at(aa, aa, bb, (0, 0), radius)} from a, b
